// qi-graph · 遍历 —— 邻接与遍历：出入边、邻居、度、BFS / DFS、最短路径、连通分量
//
// 邻接全部走 g:out:<id> / g:in:<id> 这两条「每个节点一条值」的键，一次遍历
// 摸多少节点就读多少条，**不调 前缀列键**。唯一的例外是 连通分量数：它本来就要
// 看全图，走一次节点前缀扫是它的定义。
//
// 邻居查询要拿到对端 id 得把边 JSON 读出来（邻接表里只存边 id），所以邻居的成本是
// O(度) 次 取 + 解码。边一多想更快，把对端 id 冗余进邻接表就行 —— 现在没这么做，
// 是为了让键空间只有一种真相。

包 Graph;

导入 标准库.JSON 作为 J;
导入 标准库.列表 作为 表列;
导入 标准库.哈希表;
导入 KV::{可用};
导入 Graph.图::{图库, 键_出, 键_入, 键_边, 有节点, 读JSON, 数组转列表, 列全部节点};

// 方向常量：0 = 出（顺着边），1 = 入（逆着边），2 = 不分方向
公开 函数 方向_出() : 整数 { 返回 0; }
公开 函数 方向_入() : 整数 { 返回 1; }
公开 函数 方向_双() : 整数 { 返回 2; }

// ── 边表 ──────────────────────────────────────────────────────────

// 出边 / 入边 id 的字符串列表句柄（调用方 列表::删除列表）
公开 函数 出边(图: 整数, id: 字符串) : 整数 { 返回 键上列表(图, 键_出(id)); }
公开 函数 入边(图: 整数, id: 字符串) : 整数 { 返回 键上列表(图, 键_入(id)); }

函数 键上列表(图: 整数, 键: 字符串) : 整数 {
    如果 (可用(图) == 0) {
        返回 表列::创建字符串列表();
    }
    变量 组: 整数 = 读JSON(图, 键);
    变量 出: 整数 = 数组转列表(组);
    如果 (组 > 0) {
        J.删除(组);
    }
    返回 出;
}

公开 函数 出度(图: 整数, id: 字符串) : 整数 { 返回 键上长度(图, 键_出(id)); }
公开 函数 入度(图: 整数, id: 字符串) : 整数 { 返回 键上长度(图, 键_入(id)); }
公开 函数 度(图: 整数, id: 字符串) : 整数 { 返回 出度(图, id) + 入度(图, id); }

函数 键上长度(图: 整数, 键: 字符串) : 整数 {
    变量 组: 整数 = 读JSON(图, 键);
    如果 (组 <= 0) {
        返回 0;
    }
    变量 n: 整数 = J.数组长度(组);
    J.删除(组);
    返回 n;
}

// ── 邻居 ──────────────────────────────────────────────────────────

// 把 id 沿 方向 的邻居追加到 出表（去重靠 已见 哈希表；已见 传 0 就不去重）。
// 边类型 传空串 = 任意类型。返回追加了几个。
函数 收集邻居(图: 整数, id: 字符串, 方向: 整数, 边类型: 字符串, 已见: 整数, 出表: 整数) : 整数 {
    变量 加了: 整数 = 0;
    如果 (方向 == 0 或 方向 == 2) {
        加了 = 加了 + 收集一侧(图, 键_出(id), "to", 边类型, 已见, 出表);
    }
    如果 (方向 == 1 或 方向 == 2) {
        加了 = 加了 + 收集一侧(图, 键_入(id), "from", 边类型, 已见, 出表);
    }
    返回 加了;
}

函数 收集一侧(图: 整数, 邻接键: 字符串, 对端字段: 字符串, 边类型: 字符串, 已见: 整数, 出表: 整数) : 整数 {
    变量 组: 整数 = 读JSON(图, 邻接键);
    如果 (组 <= 0) {
        返回 0;
    }
    变量 加了: 整数 = 0;
    变量 n: 整数 = J.数组长度(组);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 边: 整数 = 读JSON(图, 键_边(J.数组获取字符串(组, i)));
        如果 (边 > 0) {
            如果 (边类型 == "" 或 J.获取字符串(边, "type") == 边类型) {
                变量 对端: 字符串 = J.获取字符串(边, 对端字段);
                如果 (已见 == 0) {
                    表列::添加字符串(出表, 对端);
                    加了 = 加了 + 1;
                } 否则 {
                    如果 (哈希表::包含键(已见, 对端) == 0) {
                        哈希表::设置整数(已见, 对端, 1);
                        表列::添加字符串(出表, 对端);
                        加了 = 加了 + 1;
                    }
                }
            }
            J.删除(边);
        }
        i = i + 1;
    }
    J.删除(组);
    返回 加了;
}

// 邻居 id 列表（去重；同一对节点之间多条边只算一次）。三参版不限边类型。
公开 函数 出邻居(图: 整数, id: 字符串) : 整数 { 返回 邻居(图, id, 0, ""); }
公开 函数 出邻居(图: 整数, id: 字符串, 边类型: 字符串) : 整数 { 返回 邻居(图, id, 0, 边类型); }
公开 函数 入邻居(图: 整数, id: 字符串) : 整数 { 返回 邻居(图, id, 1, ""); }
公开 函数 入邻居(图: 整数, id: 字符串, 边类型: 字符串) : 整数 { 返回 邻居(图, id, 1, 边类型); }
公开 函数 双向邻居(图: 整数, id: 字符串) : 整数 { 返回 邻居(图, id, 2, ""); }

公开 函数 邻居(图: 整数, id: 字符串, 方向: 整数, 边类型: 字符串) : 整数 {
    变量 出表: 整数 = 表列::创建字符串列表();
    如果 (可用(图) == 0) {
        返回 出表;
    }
    变量 已见: 整数 = 哈希表::创建整数表();
    收集邻居(图, id, 方向, 边类型, 已见, 出表);
    哈希表::释放表(已见);
    返回 出表;
}

// ── 广度优先 ──────────────────────────────────────────────────────

// 从 起点 顺着出边按层展开，返回按层序排列的节点 id 列表（起点在第 0 位）。
// 最大深度 = 最多走几跳；传负数不限。起点不存在返回空列表。
公开 函数 广度遍历(图: 整数, 起点: 字符串, 最大深度: 整数) : 整数 {
    返回 广度遍历带方向(图, 起点, 最大深度, "", 0);
}
公开 函数 广度遍历(图: 整数, 起点: 字符串, 最大深度: 整数, 边类型: 字符串) : 整数 {
    返回 广度遍历带方向(图, 起点, 最大深度, 边类型, 0);
}

公开 函数 广度遍历带方向(图: 整数, 起点: 字符串, 最大深度: 整数, 边类型: 字符串, 方向: 整数) : 整数 {
    变量 序: 整数 = 表列::创建字符串列表();
    如果 (可用(图) == 0 或 有节点(图, 起点) == 0) {
        返回 序;
    }
    // 队列就是结果表本身：BFS 出队的顺序就是层序，用一个游标往前走
    变量 深: 整数 = 表列::创建整数列表();
    变量 已见: 整数 = 哈希表::创建整数表();
    表列::添加字符串(序, 起点);
    表列::添加整数(深, 0);
    哈希表::设置整数(已见, 起点, 1);
    变量 头: 整数 = 0;
    当 (头 < 表列::字符串列表大小(序)) {
        变量 当前: 字符串 = 表列::获取字符串(序, 头);
        变量 层: 整数 = 表列::获取整数(深, 头);
        头 = 头 + 1;
        如果 (最大深度 < 0 或 层 < 最大深度) {
            变量 前: 整数 = 表列::字符串列表大小(序);
            变量 加了: 整数 = 收集邻居(图, 当前, 方向, 边类型, 已见, 序);
            变量 t: 整数 = 0;
            当 (t < 加了) {
                表列::添加整数(深, 层 + 1);
                t = t + 1;
            }
        }
    }
    哈希表::释放表(已见);
    表列::删除列表(深);
    返回 序;
}

// ── 深度优先 ──────────────────────────────────────────────────────

// 先序 DFS，顺着出边；同一节点的邻居按邻接表顺序先后进入。最大深度 语义同 BFS。
公开 函数 深度遍历(图: 整数, 起点: 字符串, 最大深度: 整数) : 整数 {
    返回 深度遍历(图, 起点, 最大深度, "");
}

公开 函数 深度遍历(图: 整数, 起点: 字符串, 最大深度: 整数, 边类型: 字符串) : 整数 {
    变量 序: 整数 = 表列::创建字符串列表();
    如果 (可用(图) == 0 或 有节点(图, 起点) == 0) {
        返回 序;
    }
    变量 已见: 整数 = 哈希表::创建整数表();
    深搜(图, 起点, 0, 最大深度, 边类型, 已见, 序);
    哈希表::释放表(已见);
    返回 序;
}

// 递归版：字符串列表没有弹出，显式栈反而绕；递归深度最多是节点数
函数 深搜(图: 整数, 当前: 字符串, 层: 整数, 最大深度: 整数, 边类型: 字符串, 已见: 整数, 序: 整数) : 整数 {
    哈希表::设置整数(已见, 当前, 1);
    表列::添加字符串(序, 当前);
    如果 (最大深度 >= 0 与 层 >= 最大深度) {
        返回 1;
    }
    变量 邻: 整数 = 表列::创建字符串列表();
    收集邻居(图, 当前, 0, 边类型, 0, 邻);
    变量 n: 整数 = 表列::字符串列表大小(邻);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 v: 字符串 = 表列::获取字符串(邻, i);
        如果 (哈希表::包含键(已见, v) == 0) {
            深搜(图, v, 层 + 1, 最大深度, 边类型, 已见, 序);
        }
        i = i + 1;
    }
    表列::删除列表(邻);
    返回 1;
}

// ── 最短路径 ──────────────────────────────────────────────────────

// 无权最短路径（BFS，顺着出边）。返回从 起 到 止 的节点 id 序列，含两端；
// 不可达或任一端不存在返回空列表；起 == 止 返回只有它自己的列表。
公开 函数 最短路径(图: 整数, 起: 字符串, 止: 字符串) : 整数 {
    返回 最短路径(图, 起, 止, "");
}

公开 函数 最短路径(图: 整数, 起: 字符串, 止: 字符串, 边类型: 字符串) : 整数 {
    变量 路: 整数 = 表列::创建字符串列表();
    如果 (可用(图) == 0 或 有节点(图, 起) == 0 或 有节点(图, 止) == 0) {
        返回 路;
    }
    如果 (起 == 止) {
        表列::添加字符串(路, 起);
        返回 路;
    }
    变量 队: 整数 = 表列::创建字符串列表();
    变量 已见: 整数 = 哈希表::创建整数表();
    变量 父: 整数 = 哈希表::创建字符串表();
    表列::添加字符串(队, 起);
    哈希表::设置整数(已见, 起, 1);
    变量 头: 整数 = 0;
    变量 到了: 整数 = 0;
    当 (到了 == 0 与 头 < 表列::字符串列表大小(队)) {
        变量 当前: 字符串 = 表列::获取字符串(队, 头);
        头 = 头 + 1;
        变量 前: 整数 = 表列::字符串列表大小(队);
        变量 加了: 整数 = 收集邻居(图, 当前, 0, 边类型, 已见, 队);
        变量 t: 整数 = 0;
        当 (t < 加了) {
            变量 v: 字符串 = 表列::获取字符串(队, 前 + t);
            哈希表::设置字符串(父, v, 当前);
            如果 (v == 止) {
                到了 = 1;
            }
            t = t + 1;
        }
    }
    如果 (到了 == 1) {
        // 从终点沿父指针倒着走，再翻过来
        变量 倒: 整数 = 表列::创建字符串列表();
        变量 游标: 字符串 = 止;
        表列::添加字符串(倒, 游标);
        当 (游标 != 起) {
            游标 = 哈希表::获取字符串(父, 游标);
            表列::添加字符串(倒, 游标);
        }
        变量 i: 整数 = 表列::字符串列表大小(倒) - 1;
        当 (i >= 0) {
            表列::添加字符串(路, 表列::获取字符串(倒, i));
            i = i - 1;
        }
        表列::删除列表(倒);
    }
    哈希表::释放表(父);
    哈希表::释放表(已见);
    表列::删除列表(队);
    返回 路;
}

// 顺着出边能不能从 起 走到 止
公开 函数 可达(图: 整数, 起: 字符串, 止: 字符串) : 整数 {
    变量 路: 整数 = 最短路径(图, 起, 止, "");
    变量 n: 整数 = 表列::字符串列表大小(路);
    表列::删除列表(路);
    如果 (n > 0) {
        返回 1;
    }
    返回 0;
}

// ── 连通分量 ──────────────────────────────────────────────────────

// 弱连通分量数（不看边的方向）。要看全图，所以走一次节点前缀扫。
公开 函数 连通分量数(图: 整数) : 整数 {
    如果 (可用(图) == 0) {
        返回 0;
    }
    变量 全部: 整数 = 列全部节点(图);
    变量 已见: 整数 = 哈希表::创建整数表();
    变量 分量: 整数 = 0;
    变量 n: 整数 = 表列::字符串列表大小(全部);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 种子: 字符串 = 表列::获取字符串(全部, i);
        如果 (哈希表::包含键(已见, 种子) == 0) {
            分量 = 分量 + 1;
            // 从这个种子双向 BFS，把整个分量标成已见
            变量 队: 整数 = 表列::创建字符串列表();
            表列::添加字符串(队, 种子);
            哈希表::设置整数(已见, 种子, 1);
            变量 头: 整数 = 0;
            当 (头 < 表列::字符串列表大小(队)) {
                变量 当前: 字符串 = 表列::获取字符串(队, 头);
                头 = 头 + 1;
                收集邻居(图, 当前, 2, "", 已见, 队);
            }
            表列::删除列表(队);
        }
        i = i + 1;
    }
    哈希表::释放表(已见);
    表列::删除列表(全部);
    返回 分量;
}

// ── 链式方法 ──────────────────────────────────────────────────────

公开 函数 (自身 图库) 出边(id: 字符串) : 整数 { 返回 出边(自身.句柄, id); }
公开 函数 (自身 图库) 入边(id: 字符串) : 整数 { 返回 入边(自身.句柄, id); }
公开 函数 (自身 图库) 出邻居(id: 字符串) : 整数 { 返回 出邻居(自身.句柄, id); }
公开 函数 (自身 图库) 出邻居(id: 字符串, 边类型: 字符串) : 整数 { 返回 出邻居(自身.句柄, id, 边类型); }
公开 函数 (自身 图库) 入邻居(id: 字符串) : 整数 { 返回 入邻居(自身.句柄, id); }
公开 函数 (自身 图库) 入邻居(id: 字符串, 边类型: 字符串) : 整数 { 返回 入邻居(自身.句柄, id, 边类型); }
公开 函数 (自身 图库) 度(id: 字符串) : 整数 { 返回 度(自身.句柄, id); }
公开 函数 (自身 图库) 出度(id: 字符串) : 整数 { 返回 出度(自身.句柄, id); }
公开 函数 (自身 图库) 入度(id: 字符串) : 整数 { 返回 入度(自身.句柄, id); }
公开 函数 (自身 图库) 广度遍历(起点: 字符串, 最大深度: 整数) : 整数 { 返回 广度遍历(自身.句柄, 起点, 最大深度); }
公开 函数 (自身 图库) 深度遍历(起点: 字符串, 最大深度: 整数) : 整数 { 返回 深度遍历(自身.句柄, 起点, 最大深度); }
公开 函数 (自身 图库) 最短路径(起: 字符串, 止: 字符串) : 整数 { 返回 最短路径(自身.句柄, 起, 止); }
公开 函数 (自身 图库) 可达(起: 字符串, 止: 字符串) : 整数 { 返回 可达(自身.句柄, 起, 止); }
公开 函数 (自身 图库) 连通分量数() : 整数 { 返回 连通分量数(自身.句柄); }
