// qi-graph · 图模式 —— 把一张图的结构摘成能塞进提示词的一段话
//
// 对应 Negro《Knowledge Graphs and LLMs in Action》第 14 章 14.6 节
// 「From schema to LLM-ready context」。那一节要解决的问题是：让模型照着图写查询，
// 光把问题丢给它没用，得先告诉它这张图里**有什么类、什么关系、什么属性**。
// 而直接把技术模式全倒给它同样没用 —— 内部字段、调试标签、一次性属性会淹掉重点。
// 所以是三步：抽取 → 按 跳过 表蒸馏成概念模式 → 挂上人写的说明。
//
// ── 一处刻意的改编 ──
// 书里渲染成 Cypher（`(:Vehicle)-[:OWNED_BY]->(:Person)`），因为它讲的是 Neo4j。
// 这里**不能照抄**：模型拿到模式之后要写的是 qi-graph 的 模式匹配 —— JSON 三元组数组，
// 不是 Cypher。照抄只会教会它写一种这个库根本不认的语法。
// 所以 图模式文本 末尾附一段「怎么查」，把三元组格式和一个例子一起给出去。
// 节点/关系那两行仍借用 Cypher 那种 `(:类 {属性: 类型})` 的写法 —— 它只是**描述**，
// 不是要模型照写；这种形状模型见得最多，认得最准。
//
// ── 类型是怎么认出来的 ──
// qi-kv 里存的是 JSON，没有声明式模式，类型只能从实际值反推：
//   获取字符串 拿得到非空 → STRING（只有真的 Value::String 才拿得到，数字拿不到）
//   取显示值 是 真/假     → BOOLEAN
//   首字符 [ 或 {        → LIST / OBJECT
//   全数字（带不带小数点）→ INTEGER / FLOAT
// 唯一含糊的是**空字符串**：显示值和「没这个键」都是 ""，一律当 STRING。
// 同一个属性在不同节点上类型不一致时记成 混合。
//
// ── 代价 ──
// 要扫全部节点和全部边（模式本来就是全局的）。图大时传 采样上限 —— 采样出来的
// 模式会在 "采样" 字段里注明，别把它当成完整模式去做「这个属性一定存在」的判断。

包 Graph;

导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 标准库.哈希表;
导入 标准库.字节切片;
导入 KV::{可用};
导入 Graph.图::{图库, 取属性, 取标签, 取边, 列全部节点, 列全部边, 数组转列表};

// ── 小工具 ────────────────────────────────────────────────────────

函数 比串(a: 字符串, b: 字符串) : 整数 {
    变量 x: 整数 = 字节切片::从字符串(a);
    变量 y: 整数 = 字节切片::从字符串(b);
    变量 r: 整数 = 字节切片::比较(x, y);
    字节切片::释放切片(x);
    字节切片::释放切片(y);
    返回 r;
}

// 选择排序出一份新的有序表（qi 的字符串列表没有 设置字符串，原地排不了）。
// 模式是要给人读、要进提示词的，顺序必须稳定 —— 不然同一张图两次导出不一样。
函数 排一遍(表: 整数) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 用过: 整数 = 哈希表::创建整数表();
    变量 轮: 整数 = 0;
    当 (轮 < n) {
        变量 最小: 字符串 = "";
        变量 有: 整数 = 0;
        变量 i: 整数 = 0;
        当 (i < n) {
            变量 s: 字符串 = 表列::获取字符串(表, i);
            如果 (哈希表::包含键(用过, s) == 0) {
                如果 (有 == 0 或 比串(s, 最小) < 0) {
                    最小 = s;
                    有 = 1;
                }
            }
            i = i + 1;
        }
        如果 (有 == 0) {
            跳出;
        }
        哈希表::设置整数(用过, 最小, 1);
        表列::添加字符串(出, 最小);
        轮 = 轮 + 1;
    }
    哈希表::释放表(用过);
    返回 出;
}

// 集合里没有就追加（顺便当去重的列表用）
函数 收一个(集: 整数, 表: 整数, 值: 字符串) {
    如果 (哈希表::包含键(集, 值) == 0) {
        哈希表::设置整数(集, 值, 1);
        表列::添加字符串(表, 值);
    }
}

// 计数表 +1
函数 加一(表: 整数, 键: 字符串) {
    哈希表::设置整数(表, 键, 哈希表::获取整数(表, 键) + 1);
}

// 复合键：标签/边类型里不可能有冒号（键_标签 / 键_类型 都拿它分段，合法段 拦着），
// 所以「标签:属性名」拆第一个冒号就还原得回来 —— 属性名里带冒号也不怕。
函数 合键(前: 字符串, 后: 字符串) : 字符串 {
    返回 前 + ":" + 后;
}

函数 拆后半(合: 字符串) : 字符串 {
    变量 位: 整数 = 字符串::查找(合, ":");
    如果 (位 < 0) {
        返回 合;
    }
    返回 字符串::子串(合, 位 + 1, 字符串::字节长度(合) - 位 - 1);
}

// 从实际值反推类型，见文件抬头
函数 认类型(对象: 整数, 键: 字符串) : 字符串 {
    变量 s: 字符串 = J.获取字符串(对象, 键);
    如果 (字符串::字节长度(s) > 0) {
        返回 "STRING";
    }
    变量 显: 字符串 = J.取显示值(对象, 键);
    如果 (字符串::字节长度(显) == 0) {
        返回 "STRING";
    }
    如果 (显 == "真" 或 显 == "假") {
        返回 "BOOLEAN";
    }
    变量 头: 字符串 = 字符串::子串(显, 0, 1);
    如果 (头 == "[") {
        返回 "LIST";
    }
    如果 (头 == "{") {
        返回 "OBJECT";
    }
    // 数字：允许开头一个负号，中间至多一个小数点
    变量 n: 整数 = 字符串::字节长度(显);
    变量 i: 整数 = 0;
    如果 (头 == "-") {
        i = 1;
    }
    变量 点数: 整数 = 0;
    变量 数字数: 整数 = 0;
    变量 像数: 整数 = 1;
    当 (i < n) {
        变量 c: 字符串 = 字符串::子串(显, i, 1);
        如果 (c == ".") {
            点数 = 点数 + 1;
        } 否则 {
            如果 (c >= "0" 与 c <= "9") {
                数字数 = 数字数 + 1;
            } 否则 {
                像数 = 0;
            }
        }
        i = i + 1;
    }
    如果 (像数 == 1 与 数字数 > 0 与 点数 <= 1) {
        如果 (点数 == 1) {
            返回 "FLOAT";
        }
        返回 "INTEGER";
    }
    返回 "STRING";
}

// 记一次「某个属性在某个类/关系上出现过，类型是 X」
函数 记属性(类型映射: 整数, 计数表: 整数, 键集: 整数, 键表: 整数,
             归属: 字符串, 属名: 字符串, 类型名: 字符串) {
    变量 合: 字符串 = 合键(归属, 属名);
    收一个(键集, 键表, 合);
    加一(计数表, 合);
    变量 旧: 字符串 = 哈希表::获取字符串(类型映射, 合);
    如果 (字符串::字节长度(旧) == 0) {
        哈希表::设置字符串(类型映射, 合, 类型名);
    } 否则 {
        如果 (旧 != 类型名 与 旧 != "混合") {
            哈希表::设置字符串(类型映射, 合, "混合");
        }
    }
}

// ── 抽取技术模式 ──────────────────────────────────────────────────

公开 函数 图模式JSON(图: 整数) : 字符串 {
    返回 图模式JSON(图, 0);
}

// 采样上限 <= 0 = 全扫。返回：
//   {"采样":false,"类":[{"名":…,"数量":…,"属性":[{"名":…,"类型":…,"出现":…,"必填":…}]}],
//    "关系":[{"类型":…,"数量":…,"端点":[{"起":…,"止":…,"数量":…}],"属性":[…]}]}
公开 函数 图模式JSON(图: 整数, 采样上限: 整数) : 字符串 {
    变量 根: 整数 = J.创建对象();
    如果 (可用(图) == 0) {
        J.设置布尔(根, "打开", 0);
        变量 空: 字符串 = J.转字符串(根);
        J.删除(根);
        返回 空;
    }

    变量 类集: 整数 = 哈希表::创建整数表();
    变量 类表: 整数 = 表列::创建字符串列表();
    变量 类计数: 整数 = 哈希表::创建整数表();
    变量 属键集: 整数 = 哈希表::创建整数表();
    变量 属键表: 整数 = 表列::创建字符串列表();
    变量 属计数: 整数 = 哈希表::创建整数表();
    变量 属类型: 整数 = 哈希表::创建字符串表();
    变量 无标签数: 整数 = 0;
    变量 截断: 整数 = 0;

    // 一、扫节点
    变量 全点: 整数 = 列全部节点(图);
    变量 点数: 整数 = 表列::字符串列表大小(全点);
    变量 看点: 整数 = 点数;
    如果 (采样上限 > 0 与 采样上限 < 看点) {
        看点 = 采样上限;
        截断 = 1;
    }
    变量 i: 整数 = 0;
    当 (i < 看点) {
        变量 id: 字符串 = 表列::获取字符串(全点, i);
        变量 标组: 整数 = J.解码(取标签(图, id));
        变量 标表: 整数 = 数组转列表(标组);
        如果 (标组 > 0) {
            J.删除(标组);
        }
        变量 标数: 整数 = 表列::字符串列表大小(标表);
        如果 (标数 == 0) {
            无标签数 = 无标签数 + 1;
        }
        变量 属对象: 整数 = J.解码(取属性(图, id));
        变量 t: 整数 = 0;
        当 (t < 标数) {
            变量 标: 字符串 = 表列::获取字符串(标表, t);
            收一个(类集, 类表, 标);
            加一(类计数, 标);
            如果 (属对象 > 0) {
                // 键列表 给的是 字符串数组（不是列表句柄），只能用 对于…在 走
                对于 属名 在 J.键列表(属对象) {
                    记属性(属类型, 属计数, 属键集, 属键表, 标, 属名, 认类型(属对象, 属名));
                }
            }
            t = t + 1;
        }
        如果 (属对象 > 0) {
            J.删除(属对象);
        }
        表列::删除列表(标表);
        i = i + 1;
    }
    表列::删除列表(全点);

    // 二、扫边
    变量 型集: 整数 = 哈希表::创建整数表();
    变量 型表: 整数 = 表列::创建字符串列表();
    变量 型计数: 整数 = 哈希表::创建整数表();
    变量 端集: 整数 = 哈希表::创建整数表();
    变量 端表: 整数 = 表列::创建字符串列表();
    变量 端计数: 整数 = 哈希表::创建整数表();
    变量 边属键集: 整数 = 哈希表::创建整数表();
    变量 边属键表: 整数 = 表列::创建字符串列表();
    变量 边属计数: 整数 = 哈希表::创建整数表();
    变量 边属类型: 整数 = 哈希表::创建字符串表();

    变量 全边: 整数 = 列全部边(图);
    变量 边数: 整数 = 表列::字符串列表大小(全边);
    变量 看边: 整数 = 边数;
    如果 (采样上限 > 0 与 采样上限 < 看边) {
        看边 = 采样上限;
        截断 = 1;
    }
    变量 e: 整数 = 0;
    当 (e < 看边) {
        变量 边对象: 整数 = J.解码(取边(图, 表列::获取字符串(全边, e)));
        如果 (边对象 > 0) {
            变量 型: 字符串 = J.获取字符串(边对象, "type");
            收一个(型集, 型表, 型);
            加一(型计数, 型);
            // 端点：取两端各自的**第一个**标签（多标签节点只取第一个，够用且不爆炸）
            变量 起标: 字符串 = 首标签(图, J.获取字符串(边对象, "from"));
            变量 止标: 字符串 = 首标签(图, J.获取字符串(边对象, "to"));
            变量 端键: 字符串 = 型 + ":" + 起标 + ">" + 止标;
            收一个(端集, 端表, 端键);
            加一(端计数, 端键);
            // 边属性（除去 type/from/to 三个结构字段）
            变量 边属: 整数 = J.获取对象(边对象, "props");
            如果 (边属 > 0) {
                对于 名 在 J.键列表(边属) {
                    记属性(边属类型, 边属计数, 边属键集, 边属键表, 型, 名, 认类型(边属, 名));
                }
                J.删除(边属);
            }
            J.删除(边对象);
        }
        e = e + 1;
    }
    表列::删除列表(全边);

    // 三、组装
    J.设置布尔(根, "打开", 1);
    J.设置布尔(根, "采样", 截断);
    J.设置整数(根, "节点总数", 点数);
    J.设置整数(根, "边总数", 边数);
    J.设置整数(根, "无标签节点数", 无标签数);

    变量 类组: 整数 = J.创建数组();
    变量 类序: 整数 = 排一遍(类表);
    变量 a: 整数 = 0;
    当 (a < 表列::字符串列表大小(类序)) {
        变量 标: 字符串 = 表列::获取字符串(类序, a);
        变量 项: 整数 = J.创建对象();
        J.设置字符串(项, "名", 标);
        J.设置整数(项, "数量", 哈希表::获取整数(类计数, 标));
        J.设置数组(项, "属性", 属性数组(属键表, 属类型, 属计数, 标, 哈希表::获取整数(类计数, 标)));
        J.数组添加对象(类组, 项);
        a = a + 1;
    }
    表列::删除列表(类序);
    J.设置数组(根, "类", 类组);

    变量 关组: 整数 = J.创建数组();
    变量 型序: 整数 = 排一遍(型表);
    变量 b: 整数 = 0;
    当 (b < 表列::字符串列表大小(型序)) {
        变量 型: 字符串 = 表列::获取字符串(型序, b);
        变量 项: 整数 = J.创建对象();
        J.设置字符串(项, "类型", 型);
        J.设置整数(项, "数量", 哈希表::获取整数(型计数, 型));
        // 端点
        变量 端组: 整数 = J.创建数组();
        变量 端序: 整数 = 排一遍(端表);
        变量 c: 整数 = 0;
        当 (c < 表列::字符串列表大小(端序)) {
            变量 合: 字符串 = 表列::获取字符串(端序, c);
            如果 (归属是(合, 型) == 1) {
                变量 对: 字符串 = 拆后半(合);
                变量 箭: 整数 = 字符串::查找(对, ">");
                变量 端: 整数 = J.创建对象();
                J.设置字符串(端, "起", 字符串::子串(对, 0, 箭));
                J.设置字符串(端, "止", 字符串::子串(对, 箭 + 1, 字符串::字节长度(对) - 箭 - 1));
                J.设置整数(端, "数量", 哈希表::获取整数(端计数, 合));
                J.数组添加对象(端组, 端);
            }
            c = c + 1;
        }
        表列::删除列表(端序);
        J.设置数组(项, "端点", 端组);
        J.设置数组(项, "属性", 属性数组(边属键表, 边属类型, 边属计数, 型, 哈希表::获取整数(型计数, 型)));
        J.数组添加对象(关组, 项);
        b = b + 1;
    }
    表列::删除列表(型序);
    J.设置数组(根, "关系", 关组);

    哈希表::释放表(边属类型);
    哈希表::释放表(边属计数);
    哈希表::释放表(边属键集);
    表列::删除列表(边属键表);
    哈希表::释放表(端计数);
    哈希表::释放表(端集);
    表列::删除列表(端表);
    哈希表::释放表(型计数);
    哈希表::释放表(型集);
    表列::删除列表(型表);
    哈希表::释放表(属类型);
    哈希表::释放表(属计数);
    哈希表::释放表(属键集);
    表列::删除列表(属键表);
    哈希表::释放表(类计数);
    哈希表::释放表(类集);
    表列::删除列表(类表);

    变量 出: 字符串 = J.转字符串(根);
    J.删除(根);
    返回 出;
}

// 合成键的前半段是不是这个归属
函数 归属是(合: 字符串, 归属: 字符串) : 整数 {
    变量 位: 整数 = 字符串::查找(合, ":");
    如果 (位 < 0) {
        返回 0;
    }
    如果 (字符串::子串(合, 0, 位) == 归属) {
        返回 1;
    }
    返回 0;
}

函数 首标签(图: 整数, id: 字符串) : 字符串 {
    变量 组: 整数 = J.解码(取标签(图, id));
    变量 出: 字符串 = "";
    如果 (组 > 0) {
        如果 (J.数组长度(组) > 0) {
            出 = J.数组获取字符串(组, 0);
        }
        J.删除(组);
    }
    返回 出;
}

函数 属性数组(键表: 整数, 类型映射: 整数, 计数表: 整数, 归属: 字符串, 总数: 整数) : 整数 {
    变量 组: 整数 = J.创建数组();
    变量 序: 整数 = 排一遍(键表);
    变量 i: 整数 = 0;
    当 (i < 表列::字符串列表大小(序)) {
        变量 合: 字符串 = 表列::获取字符串(序, i);
        如果 (归属是(合, 归属) == 1) {
            变量 出现: 整数 = 哈希表::获取整数(计数表, 合);
            变量 项: 整数 = J.创建对象();
            J.设置字符串(项, "名", 拆后半(合));
            J.设置字符串(项, "类型", 哈希表::获取字符串(类型映射, 合));
            J.设置整数(项, "出现", 出现);
            如果 (出现 >= 总数 与 总数 > 0) {
                J.设置布尔(项, "必填", 1);
            } 否则 {
                J.设置布尔(项, "必填", 0);
            }
            J.数组添加对象(组, 项);
        }
        i = i + 1;
    }
    表列::删除列表(序);
    返回 组;
}

// ── 渲染成 LLM 上下文 ─────────────────────────────────────────────

公开 函数 图模式文本(图: 整数) : 字符串 {
    返回 图模式文本(图, "");
}

// 配置JSON（都可省）：
//   {"跳过":{"类":["内部"],"关系":["调试用"],"属性":["密码","内部备注"]},
//    "说明":{"类":{"人":"一个自然人"},
//            "关系":{"认识":"社交关系，无向语义但存成有向两条"},
//            "属性":{"人":{"年龄":"周岁，缺失表示未采集"}}},
//    "含用法":1, "最少出现":2}
//
// 跳过 是书里的 skip list：把内部字段、调试标签这些「不属于概念模式」的挡在提示词外面。
// 说明 是书里的 annotations：专家脑子里那本「BLK 其实是 black」的小抄，写成内联注释。
// 最少出现 是本地加的：出现次数少于它的属性不进文本 —— 一次性的脏字段比缺字段更误导模型。
公开 函数 图模式文本(图: 整数, 配置JSON: 字符串) : 字符串 {
    变量 模式: 整数 = J.解码(图模式JSON(图));
    如果 (模式 <= 0) {
        返回 "";
    }
    变量 配: 整数 = 0;
    如果 (字符串::字节长度(配置JSON) > 0) {
        配 = J.解码(配置JSON);
    }
    变量 跳类: 整数 = 取子对象(配, "跳过", "类");
    变量 跳关: 整数 = 取子对象(配, "跳过", "关系");
    变量 跳属: 整数 = 取子对象(配, "跳过", "属性");
    变量 说类: 整数 = 取子对象(配, "说明", "类");
    变量 说关: 整数 = 取子对象(配, "说明", "关系");
    变量 说属: 整数 = 取子对象(配, "说明", "属性");
    变量 最少: 整数 = 1;
    如果 (配 > 0) {
        变量 m: 整数 = J.获取整数(配, "最少出现");
        如果 (m > 0) {
            最少 = m;
        }
    }
    变量 含用法: 整数 = 1;
    如果 (配 > 0) {
        如果 (J.取显示值(配, "含用法") == "0") {
            含用法 = 0;
        }
    }

    变量 出: 字符串 = "## 图模式\n";
    如果 (J.获取布尔(模式, "采样") == 1) {
        出 = 出 + "（采样得出，不完整）\n";
    }
    出 = 出 + "共 " + J.获取整数(模式, "节点总数") + " 个节点、"
        + J.获取整数(模式, "边总数") + " 条边。\n\n### 节点类\n";

    变量 类组: 整数 = J.获取数组(模式, "类");
    变量 i: 整数 = 0;
    当 (i < J.数组长度(类组)) {
        变量 项: 整数 = J.数组获取对象(类组, i);
        变量 名: 字符串 = J.获取字符串(项, "名");
        如果 (在数组里(跳类, 名) == 0) {
            出 = 出 + "(:" + 名 + " {" + 属性行(J.获取数组(项, "属性"), 跳属,
                子说明(说属, 名), 最少) + "})"
                + "   共 " + J.获取整数(项, "数量") + " 个"
                + 注释(说类, 名) + "\n";
        }
        i = i + 1;
    }

    出 = 出 + "\n### 关系\n";
    变量 关组: 整数 = J.获取数组(模式, "关系");
    变量 b: 整数 = 0;
    当 (b < J.数组长度(关组)) {
        变量 项: 整数 = J.数组获取对象(关组, b);
        变量 型: 字符串 = J.获取字符串(项, "类型");
        如果 (在数组里(跳关, 型) == 0) {
            变量 属文: 字符串 = 属性行(J.获取数组(项, "属性"), 跳属, 子说明(说属, 型), 最少);
            变量 中: 字符串 = "-[:" + 型;
            如果 (字符串::字节长度(属文) > 0) {
                中 = 中 + " {" + 属文 + "}";
            }
            中 = 中 + "]->";
            变量 端组: 整数 = J.获取数组(项, "端点");
            变量 c: 整数 = 0;
            当 (c < J.数组长度(端组)) {
                变量 端: 整数 = J.数组获取对象(端组, c);
                出 = 出 + "(:" + J.获取字符串(端, "起") + ")" + 中
                    + "(:" + J.获取字符串(端, "止") + ")"
                    + "   共 " + J.获取整数(端, "数量") + " 条";
                如果 (c == 0) {
                    出 = 出 + 注释(说关, 型);
                }
                出 = 出 + "\n";
                c = c + 1;
            }
        }
        b = b + 1;
    }

    如果 (含用法 == 1) {
        出 = 出 + 用法段();
    }

    如果 (配 > 0) {
        J.删除(配);
    }
    J.删除(模式);
    返回 出;
}

// 这一段是本模块存在的理由：模式讲清楚了，还得告诉模型**用什么语法查**。
// 书里这儿给的是 Cypher，那是 Neo4j 的事。这里教 图语句 的文本语法而不是
// 模式匹配 的原始 JSON —— 理由同 Borwankar《Vector Databases》第 9 章设计 VQL 的
// 理由：模型写带关键字的一行式远比写嵌套 JSON 可靠，JSON 少个括号整条就废了，
// 而且它还得先猜对字段叫 match 还是 pattern、where 的键要不要带 props. 前缀。
函数 用法段() : 字符串 {
    返回 "\n### 怎么查\n"
        + "用 查(图, 语句)。语法（方括号是可选）：\n"
        + "  匹配 路径 [, 路径]*\n"
        + "  [其中 条件 [且 条件]*]\n"
        + "  [返回 变量 [, 变量]*]\n"
        + "  [限制 N]\n"
        + "路径写成 (节点)-[:边类型]->(节点)，可以串下去；`?x` 开头是变量，其余是常量 id。\n"
        + "节点可以带标签约束 (?x:某个类)；反向边写 <-[:边类型]-；类型留空 -[]-> 表示任意。\n"
        + "条件写 ?变量.属性 运算 值，运算支持 > >= < <= = != 包含。\n"
        + "例：\n"
        + "  匹配 (?人:人)-[:认识]->(?友:人)-[:住在]->(成都)\n"
        + "  其中 ?人.年龄 > 30\n"
        + "  返回 ?人, ?友\n"
        + "  限制 10\n"
        + "结果是 [{\"?人\":\"张三\",\"?友\":\"李四\"}, …]；语法错会回 {\"错\":\"…\"}，照着改就行。\n"
        + "**把带常量的路径写在前面** —— 两端都是变量且类型也不定时会扫全库。\n";
}

函数 取子对象(配: 整数, 一层: 字符串, 二层: 字符串) : 整数 {
    如果 (配 <= 0) {
        返回 0;
    }
    变量 层: 整数 = J.获取对象(配, 一层);
    如果 (层 <= 0) {
        返回 0;
    }
    如果 (一层 == "跳过") {
        返回 J.获取数组(层, 二层);
    }
    返回 J.获取对象(层, 二层);
}

函数 子说明(说属: 整数, 归属: 字符串) : 整数 {
    如果 (说属 <= 0) {
        返回 0;
    }
    返回 J.获取对象(说属, 归属);
}

函数 在数组里(组: 整数, 值: 字符串) : 整数 {
    如果 (组 <= 0) {
        返回 0;
    }
    变量 i: 整数 = 0;
    当 (i < J.数组长度(组)) {
        如果 (J.数组获取字符串(组, i) == 值) {
            返回 1;
        }
        i = i + 1;
    }
    返回 0;
}

函数 注释(说明表: 整数, 名: 字符串) : 字符串 {
    如果 (说明表 <= 0) {
        返回 "";
    }
    变量 文: 字符串 = J.获取字符串(说明表, 名);
    如果 (字符串::字节长度(文) == 0) {
        返回 "";
    }
    返回 "   /* " + 文 + " */";
}

函数 属性行(属组: 整数, 跳属: 整数, 说明表: 整数, 最少: 整数) : 字符串 {
    变量 出: 字符串 = "";
    如果 (属组 <= 0) {
        返回 出;
    }
    变量 头一个: 整数 = 1;
    变量 i: 整数 = 0;
    当 (i < J.数组长度(属组)) {
        变量 项: 整数 = J.数组获取对象(属组, i);
        变量 名: 字符串 = J.获取字符串(项, "名");
        如果 (在数组里(跳属, 名) == 0 与 J.获取整数(项, "出现") >= 最少) {
            如果 (头一个 == 0) {
                出 = 出 + ", ";
            }
            出 = 出 + 名 + ": " + J.获取字符串(项, "类型");
            如果 (J.获取布尔(项, "必填") == 0) {
                出 = 出 + "?";
            }
            变量 注: 字符串 = "";
            如果 (说明表 > 0) {
                变量 文: 字符串 = J.获取字符串(说明表, 名);
                如果 (字符串::字节长度(文) > 0) {
                    注 = " /* " + 文 + " */";
                }
            }
            出 = 出 + 注;
            头一个 = 0;
        }
        i = i + 1;
    }
    返回 出;
}

// ── 图库 上的方法形式 ─────────────────────────────────────────────

公开 函数 (自身 图库) 图模式JSON() : 字符串 { 返回 图模式JSON(自身.句柄); }
公开 函数 (自身 图库) 图模式文本() : 字符串 { 返回 图模式文本(自身.句柄); }
公开 函数 (自身 图库) 图模式文本(配置JSON: 字符串) : 字符串 { 返回 图模式文本(自身.句柄, 配置JSON); }
