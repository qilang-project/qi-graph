// qi-graph · 推理 —— 子类/子属性闭包、类型推断、定义域值域校验、简单规则推理
//
// 推理是**物化**的：推出来的三元组真的写进库（带 inferred 标记，spo 值里存规则 + 前提），
// 之后的 查 / 值 / 是实例 直接看得到，不用每次重算。撤销推理 把它们全部清掉。
//
// 物化规则四条，朴素迭代到不动点（一轮没有新增就停）：
//   子属性   (s p o) ∧ p ⊑* q            → (s q o)      ⊑* 是 父属性是 的传递闭包
//   传递     p 传递 ∧ (a p b) ∧ (b p c)   → (a p c)
//   对称     p 对称 ∧ (a p b)            → (b p a)
//   逆属性   p 逆 q ∧ (a p b)            → (b q a)      两个方向都登记，所以两边都会触发
//
// 类层次（父类是）不物化，走闭包函数按需算：所有祖先类 / 所有类型 / 是实例。

包 Graph;

导入 标准库.字符串;
导入 标准库.JSON;
导入 标准库.列表 作为 表列;
导入 标准库.哈希表;
导入 Graph.本体::{谓_类型是, 谓_父类是, 谓_父属性是, 谓_定义域, 谓_值域, 是字面量类型, 是模式谓词,
                  传递闭包, 个体类型, 值, 主语, 邻接, 类存在, 属性存在, 属性整数字段, 属性字符串字段,
                  列出属性, 列出类, 列出主语, 加推出三元组, 撤销, 三元组标记, 宾键, 条目宾键, 宾键显示,
                  本体可用, 字符串列表含, 本体库};

// ── 类层次闭包 ────────────────────────────────────────────────────

// 全部祖先类（传递闭包，去重，不含自己；菱形只出现一次，自环也停）
公开 函数 所有祖先类(本: 整数, 类: 字符串) : 整数 { 返回 传递闭包(本, 类, 谓_父类是(), 0); }

// 全部后代类
公开 函数 所有子类(本: 整数, 类: 字符串) : 整数 { 返回 传递闭包(本, 类, 谓_父类是(), 1); }

// 全部祖先属性
公开 函数 所有父属性(本: 整数, 属性: 字符串) : 整数 { 返回 传递闭包(本, 属性, 谓_父属性是(), 0); }

// 自反：一个类算自己的子类
公开 函数 是子类(本: 整数, 子: 字符串, 祖: 字符串) : 整数 {
    如果 (子 == 祖) { 返回 1; }
    变量 祖们: 整数 = 所有祖先类(本, 子);
    变量 r: 整数 = 字符串列表含(祖们, 祖);
    表列::删除列表(祖们);
    返回 r;
}

// 直接类型 + 它们的全部祖先，去重
公开 函数 所有类型(本: 整数, 个体: 字符串) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    变量 已见: 整数 = 哈希表.创建整数表();
    变量 直: 整数 = 个体类型(本, 个体);
    变量 n: 整数 = 表列::字符串列表大小(直);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 c: 字符串 = 表列::获取字符串(直, i);
        如果 (哈希表.包含键(已见, c) == 0) {
            哈希表.设置整数(已见, c, 1);
            表列::添加字符串(出, c);
        }
        变量 祖们: 整数 = 所有祖先类(本, c);
        变量 m: 整数 = 表列::字符串列表大小(祖们);
        变量 j: 整数 = 0;
        当 (j < m) {
            变量 a: 字符串 = 表列::获取字符串(祖们, j);
            如果 (哈希表.包含键(已见, a) == 0) {
                哈希表.设置整数(已见, a, 1);
                表列::添加字符串(出, a);
            }
            j = j + 1;
        }
        表列::删除列表(祖们);
        i = i + 1;
    }
    表列::删除列表(直);
    哈希表.释放表(已见);
    返回 出;
}

公开 函数 是实例(本: 整数, 个体: 字符串, 类: 字符串) : 整数 {
    变量 全: 整数 = 所有类型(本, 个体);
    变量 r: 整数 = 字符串列表含(全, 类);
    表列::删除列表(全);
    返回 r;
}

// ── 校验 ──────────────────────────────────────────────────────────

函数 推_问题(问题们: 整数, 种类: 字符串, s: 字符串, p: 字符串, o: 字符串, 说明: 字符串) : 整数 {
    变量 q: 整数 = JSON.创建对象();
    JSON.设置字符串(q, "kind", 种类);
    JSON.设置字符串(q, "s", s);
    JSON.设置字符串(q, "p", p);
    JSON.设置字符串(q, "o", o);
    JSON.设置字符串(q, "msg", 说明);
    JSON.数组添加对象(问题们, q);
    JSON.删除(q);
    返回 1;
}

// 检查一条非模式三元组：定义域、值域、函数性（函数性只在同一 (s,p) 第二次出现时报一次）
函数 推_查一条(本: 整数, 问题们: 整数, s: 字符串, p: 字符串, 条: 整数, 计数: 整数) : 整数 {
    变量 键: 字符串 = 条目宾键(条);
    变量 显: 字符串 = 宾键显示(键);
    如果 (属性存在(本, p) == 0) {
        返回 推_问题(问题们, "unknown_property", s, p, 显, "谓词「" + p + "」没有定义");
    }
    变量 定域: 字符串 = 属性字符串字段(本, p, "domain");
    如果 (字符串::字节长度(定域) > 0 与 是实例(本, s, 定域) == 0) {
        推_问题(问题们, "domain", s, p, 显, "主语「" + s + "」不是「" + 定域 + "」的实例");
    }
    变量 值域: 字符串 = 属性字符串字段(本, p, "range");
    如果 (字符串::字节长度(值域) > 0) {
        变量 是字面: 整数 = 字符串::开始于(键, "lit=");
        如果 (是字面量类型(值域) == 1) {
            变量 o: 整数 = JSON.获取对象(条, "o");
            变量 dt: 字符串 = "";
            如果 (o != 0) {
                dt = JSON.获取字符串(o, "dt");
                JSON.删除(o);
            }
            如果 (是字面 == 0 或 dt != 值域) {
                推_问题(问题们, "range", s, p, 显, "宾语应是「" + 值域 + "」字面量");
            }
        } 否则 如果 (是字面 == 1 或 是实例(本, 显, 值域) == 0) {
            推_问题(问题们, "range", s, p, 显, "宾语「" + 显 + "」不是「" + 值域 + "」的实例");
        }
    }
    如果 (属性整数字段(本, p, "functional") == 1) {
        变量 次: 整数 = 哈希表.获取整数(计数, p) + 1;
        哈希表.设置整数(计数, p, 次);
        如果 (次 == 2) {
            推_问题(问题们, "functional", s, p, 显, "函数性属性「" + p + "」在「" + s + "」上有多个值");
        }
    }
    返回 1;
}

// 全库体检。返回 JSON 数组：[{"kind","s","p","o","msg"}]
//   kind ∈ domain | range | functional | unknown_class | unknown_property
公开 函数 校验(本: 整数) : 字符串 {
    变量 问题们: 整数 = JSON.创建数组();
    如果 (本体可用(本) == 0) {
        JSON.删除(问题们);
        返回 "[]";
    }
    // 1) 类定义引用的父类
    变量 类们: 整数 = 列出类(本);
    变量 nc: 整数 = 表列::字符串列表大小(类们);
    变量 i: 整数 = 0;
    当 (i < nc) {
        变量 c: 字符串 = 表列::获取字符串(类们, i);
        变量 父们: 整数 = 值(本, c, 谓_父类是());
        变量 np: 整数 = 表列::字符串列表大小(父们);
        变量 j: 整数 = 0;
        当 (j < np) {
            变量 父: 字符串 = 表列::获取字符串(父们, j);
            如果 (类存在(本, 父) == 0) {
                推_问题(问题们, "unknown_class", c, 谓_父类是(), 父, "父类「" + 父 + "」没有定义");
            }
            j = j + 1;
        }
        表列::删除列表(父们);
        i = i + 1;
    }
    表列::删除列表(类们);
    // 2) 属性定义引用的类 / 属性
    变量 属性们: 整数 = 列出属性(本);
    变量 na: 整数 = 表列::字符串列表大小(属性们);
    i = 0;
    当 (i < na) {
        变量 p: 字符串 = 表列::获取字符串(属性们, i);
        变量 d: 字符串 = 属性字符串字段(本, p, "domain");
        如果 (字符串::字节长度(d) > 0 与 类存在(本, d) == 0) {
            推_问题(问题们, "unknown_class", p, 谓_定义域(), d, "定义域「" + d + "」没有定义");
        }
        变量 r: 字符串 = 属性字符串字段(本, p, "range");
        如果 (字符串::字节长度(r) > 0 与 是字面量类型(r) == 0 与 类存在(本, r) == 0) {
            推_问题(问题们, "unknown_class", p, 谓_值域(), r, "值域「" + r + "」没有定义");
        }
        变量 父p: 字符串 = 属性字符串字段(本, p, "parent");
        如果 (字符串::字节长度(父p) > 0 与 属性存在(本, 父p) == 0) {
            推_问题(问题们, "unknown_property", p, 谓_父属性是(), 父p, "父属性「" + 父p + "」没有定义");
        }
        变量 逆p: 字符串 = 属性字符串字段(本, p, "inverse");
        如果 (字符串::字节长度(逆p) > 0 与 属性存在(本, 逆p) == 0) {
            推_问题(问题们, "unknown_property", p, "逆属性是", 逆p, "逆属性「" + 逆p + "」没有定义");
        }
        i = i + 1;
    }
    表列::删除列表(属性们);
    // 3) 每条三元组
    变量 主们: 整数 = 列出主语(本);
    变量 ns: 整数 = 表列::字符串列表大小(主们);
    i = 0;
    当 (i < ns) {
        变量 s: 字符串 = 表列::获取字符串(主们, i);
        变量 邻: 整数 = 邻接(本, s);
        变量 计数: 整数 = 哈希表.创建整数表();
        变量 n: 整数 = JSON.数组长度(邻);
        变量 k: 整数 = 0;
        当 (k < n) {
            变量 条: 整数 = JSON.数组获取对象(邻, k);
            变量 p: 字符串 = JSON.获取字符串(条, "p");
            如果 (p == 谓_类型是()) {
                变量 c: 字符串 = 条目宾键(条);
                如果 (类存在(本, c) == 0) {
                    推_问题(问题们, "unknown_class", s, p, c, "类「" + c + "」没有定义");
                }
            } 否则 如果 (是模式谓词(p) == 0) {
                推_查一条(本, 问题们, s, p, 条, 计数);
            }
            JSON.删除(条);
            k = k + 1;
        }
        哈希表.释放表(计数);
        JSON.删除(邻);
        i = i + 1;
    }
    表列::删除列表(主们);
    变量 文: 字符串 = JSON.转字符串(问题们);
    JSON.删除(问题们);
    返回 文;
}

// ── 物化推理 ──────────────────────────────────────────────────────

// 解释 JSON：{"rule":"…","from":[{"s","p","o"},…]}；宾语一律写宾键（个体 id 或 lit=值）
函数 推_解释(规则: 字符串, s1: 字符串, p1: 字符串, o1: 字符串, s2: 字符串, p2: 字符串, o2: 字符串) : 字符串 {
    变量 j: 整数 = JSON.创建对象();
    JSON.设置字符串(j, "rule", 规则);
    变量 前提们: 整数 = JSON.创建数组();
    变量 a: 整数 = JSON.创建对象();
    JSON.设置字符串(a, "s", s1);
    JSON.设置字符串(a, "p", p1);
    JSON.设置字符串(a, "o", o1);
    JSON.数组添加对象(前提们, a);
    JSON.删除(a);
    如果 (字符串::字节长度(p2) > 0) {
        变量 b: 整数 = JSON.创建对象();
        JSON.设置字符串(b, "s", s2);
        JSON.设置字符串(b, "p", p2);
        JSON.设置字符串(b, "o", o2);
        JSON.数组添加对象(前提们, b);
        JSON.删除(b);
    }
    JSON.设置数组(j, "from", 前提们);
    JSON.删除(前提们);
    变量 文: 字符串 = JSON.转字符串(j);
    JSON.删除(j);
    返回 文;
}

函数 推_个体对象(id: 字符串) : 整数 {
    变量 o: 整数 = JSON.创建对象();
    JSON.设置字符串(o, "iri", id);
    返回 o;
}

// 对一条 (s p o) 套四条规则；返回新增数。传/对/逆 是本轮的属性标志缓存
函数 推_一条(本: 整数, s: 字符串, p: 字符串, 条: 整数, 传: 整数, 对: 整数, 逆: 整数) : 整数 {
    变量 新增: 整数 = 0;
    变量 o: 整数 = JSON.获取对象(条, "o");
    如果 (o == 0) { 返回 0; }
    变量 ok: 字符串 = 宾键(o);

    // 子属性：沿 父属性是 的闭包全部抬上去（字面量宾语也抬）
    变量 父们: 整数 = 所有父属性(本, p);
    变量 np: 整数 = 表列::字符串列表大小(父们);
    变量 i: 整数 = 0;
    当 (i < np) {
        变量 q: 字符串 = 表列::获取字符串(父们, i);
        新增 = 新增 + 加推出三元组(本, s, q, o, 推_解释("子属性", s, p, ok, p, 谓_父属性是(), q));
        i = i + 1;
    }
    表列::删除列表(父们);

    如果 (JSON.是否包含键(o, "iri") == 1) {
        变量 oi: 字符串 = JSON.获取字符串(o, "iri");
        如果 (哈希表.包含键(对, p) == 1) {
            变量 回: 整数 = 推_个体对象(s);
            新增 = 新增 + 加推出三元组(本, oi, p, 回, 推_解释("对称", s, p, oi, "", "", ""));
            JSON.删除(回);
        }
        如果 (哈希表.包含键(逆, p) == 1) {
            变量 q: 字符串 = 哈希表.获取字符串(逆, p);
            变量 回2: 整数 = 推_个体对象(s);
            新增 = 新增 + 加推出三元组(本, oi, q, 回2, 推_解释("逆属性", s, p, oi, p, "逆属性是", q));
            JSON.删除(回2);
        }
        如果 (哈希表.包含键(传, p) == 1) {
            变量 更远: 整数 = 值(本, oi, p);
            变量 m: 整数 = 表列::字符串列表大小(更远);
            变量 j: 整数 = 0;
            当 (j < m) {
                变量 c: 字符串 = 表列::获取字符串(更远, j);
                变量 远: 整数 = 推_个体对象(c);
                新增 = 新增 + 加推出三元组(本, s, p, 远, 推_解释("传递", s, p, oi, oi, p, c));
                JSON.删除(远);
                j = j + 1;
            }
            表列::删除列表(更远);
        }
    }
    JSON.删除(o);
    返回 新增;
}

// 一轮：对当前库里每条三元组套一遍规则。主语列表和每个主语的邻接都是快照，
// 本轮新写的会在下一轮被看到 —— 这正是「迭代到不动点」要的
函数 推_一轮(本: 整数) : 整数 {
    变量 传: 整数 = 哈希表.创建整数表();
    变量 对: 整数 = 哈希表.创建整数表();
    变量 逆: 整数 = 哈希表.创建字符串表();
    变量 属性们: 整数 = 列出属性(本);
    变量 na: 整数 = 表列::字符串列表大小(属性们);
    变量 i: 整数 = 0;
    当 (i < na) {
        变量 p: 字符串 = 表列::获取字符串(属性们, i);
        如果 (属性整数字段(本, p, "transitive") == 1) { 哈希表.设置整数(传, p, 1); }
        如果 (属性整数字段(本, p, "symmetric") == 1) { 哈希表.设置整数(对, p, 1); }
        变量 q: 字符串 = 属性字符串字段(本, p, "inverse");
        如果 (字符串::字节长度(q) > 0) { 哈希表.设置字符串(逆, p, q); }
        i = i + 1;
    }
    表列::删除列表(属性们);

    变量 新增: 整数 = 0;
    变量 主们: 整数 = 列出主语(本);
    变量 ns: 整数 = 表列::字符串列表大小(主们);
    i = 0;
    当 (i < ns) {
        变量 s: 字符串 = 表列::获取字符串(主们, i);
        变量 邻: 整数 = 邻接(本, s);
        变量 n: 整数 = JSON.数组长度(邻);
        变量 k: 整数 = 0;
        当 (k < n) {
            变量 条: 整数 = JSON.数组获取对象(邻, k);
            变量 p: 字符串 = JSON.获取字符串(条, "p");
            如果 (是模式谓词(p) == 0) {
                新增 = 新增 + 推_一条(本, s, p, 条, 传, 对, 逆);
            }
            JSON.删除(条);
            k = k + 1;
        }
        JSON.删除(邻);
        i = i + 1;
    }
    表列::删除列表(主们);
    哈希表.释放表(传);
    哈希表.释放表(对);
    哈希表.释放表(逆);
    返回 新增;
}

// 四条规则迭代到不动点，返回新增的三元组数。重复跑是幂等的（第二次返回 0）
公开 函数 物化推理(本: 整数) : 整数 {
    如果 (本体可用(本) == 0) { 返回 0; }
    变量 总: 整数 = 0;
    变量 本轮: 整数 = 1;
    当 (本轮 > 0) {
        本轮 = 推_一轮(本);
        总 = 总 + 本轮;
    }
    返回 总;
}

// 清掉所有推出来的三元组，返回清掉的条数。断言的一条不动
公开 函数 撤销推理(本: 整数) : 整数 {
    如果 (本体可用(本) == 0) { 返回 0; }
    变量 数: 整数 = 0;
    变量 主们: 整数 = 列出主语(本);
    变量 ns: 整数 = 表列::字符串列表大小(主们);
    变量 i: 整数 = 0;
    当 (i < ns) {
        变量 s: 字符串 = 表列::获取字符串(主们, i);
        变量 邻: 整数 = 邻接(本, s);
        变量 n: 整数 = JSON.数组长度(邻);
        变量 k: 整数 = 0;
        当 (k < n) {
            变量 条: 整数 = JSON.数组获取对象(邻, k);
            如果 (JSON.是否包含键(条, "inferred") == 1) {
                数 = 数 + 撤销(本, s, JSON.获取字符串(条, "p"), 条目宾键(条));
            }
            JSON.删除(条);
            k = k + 1;
        }
        JSON.删除(邻);
        i = i + 1;
    }
    表列::删除列表(主们);
    返回 数;
}

// 推出来的三元组数
公开 函数 推出三元组数(本: 整数) : 整数 {
    变量 数: 整数 = 0;
    变量 主们: 整数 = 列出主语(本);
    变量 ns: 整数 = 表列::字符串列表大小(主们);
    变量 i: 整数 = 0;
    当 (i < ns) {
        变量 邻: 整数 = 邻接(本, 表列::获取字符串(主们, i));
        变量 n: 整数 = JSON.数组长度(邻);
        变量 k: 整数 = 0;
        当 (k < n) {
            变量 条: 整数 = JSON.数组获取对象(邻, k);
            如果 (JSON.是否包含键(条, "inferred") == 1) { 数 = 数 + 1; }
            JSON.删除(条);
            k = k + 1;
        }
        JSON.删除(邻);
        i = i + 1;
    }
    表列::删除列表(主们);
    返回 数;
}

// ── 解释 ──────────────────────────────────────────────────────────

函数 推_三元组文(s: 字符串, p: 字符串, o: 字符串) : 字符串 {
    返回 s + " " + p + " " + 宾键显示(o);
}

// 这条三元组是断言的，还是由哪条规则从哪些前提推出来的（给人看）。宾 是个体 id 或 lit=值
公开 函数 解释(本: 整数, 主: 字符串, 谓: 字符串, 宾: 字符串) : 字符串 {
    变量 标记: 字符串 = 三元组标记(本, 主, 谓, 宾);
    变量 自己: 字符串 = 推_三元组文(主, 谓, 宾);
    如果 (字符串::字节长度(标记) == 0) { 返回 "不存在：" + 自己; }
    如果 (标记 == "1") { 返回 "断言：" + 自己; }
    变量 j: 整数 = JSON.解码(标记);
    如果 (j == 0) { 返回 "推出：" + 自己; }
    变量 出: 字符串 = "推出：" + 自己 + " ← 规则「" + JSON.获取字符串(j, "rule") + "」，前提：";
    变量 前提们: 整数 = JSON.获取数组(j, "from");
    变量 n: 整数 = JSON.数组长度(前提们);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 f: 整数 = JSON.数组获取对象(前提们, i);
        变量 fs: 字符串 = JSON.获取字符串(f, "s");
        变量 fp: 字符串 = JSON.获取字符串(f, "p");
        变量 fo: 字符串 = JSON.获取字符串(f, "o");
        如果 (i > 0) { 出 = 出 + "；"; }
        出 = 出 + 推_三元组文(fs, fp, fo);
        变量 前标: 字符串 = 三元组标记(本, fs, fp, fo);
        如果 (字符串::字节长度(前标) > 0 与 前标 != "1") { 出 = 出 + "（推出）"; }
        JSON.删除(f);
        i = i + 1;
    }
    JSON.删除(前提们);
    JSON.删除(j);
    返回 出;
}

// ── 链式方法 ──────────────────────────────────────────────────────

公开 函数 (自身 本体库) 所有祖先类(类: 字符串) : 整数 { 返回 所有祖先类(自身.句柄, 类); }
公开 函数 (自身 本体库) 所有子类(类: 字符串) : 整数 { 返回 所有子类(自身.句柄, 类); }
公开 函数 (自身 本体库) 是子类(子: 字符串, 祖: 字符串) : 整数 { 返回 是子类(自身.句柄, 子, 祖); }
公开 函数 (自身 本体库) 所有类型(个体: 字符串) : 整数 { 返回 所有类型(自身.句柄, 个体); }
公开 函数 (自身 本体库) 是实例(个体: 字符串, 类: 字符串) : 整数 { 返回 是实例(自身.句柄, 个体, 类); }
公开 函数 (自身 本体库) 校验() : 字符串 { 返回 校验(自身.句柄); }
公开 函数 (自身 本体库) 物化推理() : 本体库 { 物化推理(自身.句柄); 返回 自身; }
公开 函数 (自身 本体库) 撤销推理() : 本体库 { 撤销推理(自身.句柄); 返回 自身; }
公开 函数 (自身 本体库) 推出三元组数() : 整数 { 返回 推出三元组数(自身.句柄); }
公开 函数 (自身 本体库) 解释(主: 字符串, 谓: 字符串, 宾: 字符串) : 字符串 { 返回 解释(自身.句柄, 主, 谓, 宾); }
