// qi-graph · 图导入导出 —— 整图与 JSON 文本互转
//
// 导出格式（键序固定，跨运行一样）：
//
//   {"nodes":[{"id":..,"labels":[..],"props":{..}}, …],
//    "edges":[{"id":..,"type":..,"from":..,"to":..,"props":{..}}, …]}
//
// 节点 / 边的顺序是 qi-kv 的槽序 = 首次写入的顺序。从一份导出灌进空图再导出，
// 文本逐字节相同 —— 这是测试里盯着的性质。元数据（计数、next_id）不导出，
// 导入时重新计。
//
// 导入是「加进去」不是「换掉」：已存在的 id 跳过，两端不存在的边跳过，
// 返回真正加进去的节点数 + 边数。整个过程走 qi-kv 缓写。

包 Graph;

导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 标准库.输入输出 作为 IO;
导入 KV::{可用};
导入 Graph.图::{图库, 键_节点, 键_边, 读JSON, 列全部节点, 列全部边, 加节点, 加边,
                开始批量, 结束批量, 批量中};

公开 函数 导出JSON(图: 整数) : 字符串 {
    变量 根: 整数 = J.创建对象();
    变量 节点组: 整数 = J.创建数组();
    变量 边组: 整数 = J.创建数组();
    如果 (可用(图) == 1) {
        收集到数组(图, 列全部节点(图), 1, 节点组);
        收集到数组(图, 列全部边(图), 0, 边组);
    }
    J.设置数组(根, "nodes", 节点组);
    J.设置数组(根, "edges", 边组);
    变量 文本: 字符串 = J.转字符串(根);
    J.删除(边组);
    J.删除(节点组);
    J.删除(根);
    返回 文本;
}

// id 列表（接管并释放）→ 逐个读 JSON 追加进 组
函数 收集到数组(图: 整数, id表: 整数, 是节点: 整数, 组: 整数) : 整数 {
    变量 n: 整数 = 表列::字符串列表大小(id表);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 id: 字符串 = 表列::获取字符串(id表, i);
        变量 键: 字符串 = 键_边(id);
        如果 (是节点 == 1) {
            键 = 键_节点(id);
        }
        变量 对象: 整数 = 读JSON(图, 键);
        如果 (对象 > 0) {
            J.数组添加对象(组, 对象);
            J.删除(对象);
        }
        i = i + 1;
    }
    表列::删除列表(id表);
    返回 n;
}

// 返回加进去的节点数 + 边数；文本解不出返回 0
公开 函数 导入JSON(图: 整数, 文本: 字符串) : 整数 {
    如果 (可用(图) == 0) {
        返回 0;
    }
    变量 根: 整数 = J.解码(文本);
    如果 (根 <= 0) {
        返回 0;
    }
    // 调用方已经在批量里就别替它收尾
    变量 自己开的: 整数 = 0;
    如果 (批量中(图) == 0) {
        开始批量(图);
        自己开的 = 1;
    }
    变量 加了: 整数 = 0;

    变量 节点组: 整数 = J.获取数组(根, "nodes");
    如果 (节点组 > 0) {
        变量 n: 整数 = J.数组长度(节点组);
        变量 i: 整数 = 0;
        当 (i < n) {
            变量 节点: 整数 = J.数组获取对象(节点组, i);
            如果 (节点 > 0) {
                加了 = 加了 + 加节点(图, J.获取字符串(节点, "id"),
                                   子文本(节点, "labels", 1), 子文本(节点, "props", 0));
                J.删除(节点);
            }
            i = i + 1;
        }
        J.删除(节点组);
    }

    变量 边组: 整数 = J.获取数组(根, "edges");
    如果 (边组 > 0) {
        变量 m: 整数 = J.数组长度(边组);
        变量 j: 整数 = 0;
        当 (j < m) {
            变量 边: 整数 = J.数组获取对象(边组, j);
            如果 (边 > 0) {
                加了 = 加了 + 加边(图, J.获取字符串(边, "id"), J.获取字符串(边, "type"),
                                 J.获取字符串(边, "from"), J.获取字符串(边, "to"),
                                 子文本(边, "props", 0));
                J.删除(边);
            }
            j = j + 1;
        }
        J.删除(边组);
    }

    J.删除(根);
    如果 (自己开的 == 1) {
        结束批量(图);
    }
    返回 加了;
}

// 对象里某个子数组 / 子对象的 JSON 文本；缺了给空数组 / 空对象
函数 子文本(对象: 整数, 键: 字符串, 是数组: 整数) : 字符串 {
    变量 子: 整数 = 0;
    如果 (是数组 == 1) {
        子 = J.获取数组(对象, 键);
    } 否则 {
        子 = J.获取对象(对象, 键);
    }
    如果 (子 <= 0) {
        如果 (是数组 == 1) {
            返回 "[]";
        }
        返回 "{}";
    }
    变量 出: 字符串 = J.转字符串(子);
    J.删除(子);
    返回 出;
}

// 写到文件；返回 1 / 0
公开 函数 导出到文件(图: 整数, 路径: 字符串) : 整数 {
    如果 (可用(图) == 0) {
        返回 0;
    }
    返回 IO.写入文件(路径, 导出JSON(图));
}

// 从文件读进来；返回加进去的节点数 + 边数（文件读不到返回 0）
公开 函数 从文件导入(图: 整数, 路径: 字符串) : 整数 {
    如果 (IO.文件存在(路径) == 0) {
        返回 0;
    }
    变量 文本: 字符串 = IO.读取文件(路径);
    如果 (字符串::字节长度(文本) == 0) {
        返回 0;
    }
    返回 导入JSON(图, 文本);
}

// ── 链式方法 ──────────────────────────────────────────────────────

公开 函数 (自身 图库) 导出JSON() : 字符串 { 返回 导出JSON(自身.句柄); }
公开 函数 (自身 图库) 导入JSON(文本: 字符串) : 整数 { 返回 导入JSON(自身.句柄, 文本); }
公开 函数 (自身 图库) 导出到文件(路径: 字符串) : 整数 { 返回 导出到文件(自身.句柄, 路径); }
公开 函数 (自身 图库) 从文件导入(路径: 字符串) : 整数 { 返回 从文件导入(自身.句柄, 路径); }
