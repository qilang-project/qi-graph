// qi-graph · 图语句 —— 一句话查图，给人也给模型
//
// 起因是 Borwankar《Vector Databases》第 9 章的 VQL：那一章给向量库设计了一套
// SQL 味的文本语法（`SELECT … SIMILARITY SEARCH [vec] USING METRIC cosine TOP K 10`），
// 而不是让人拼 JSON。理由对图库一样成立，而且在 LLM 这边更要命 ——
// **模型写这种带关键字的一行式远比写嵌套 JSON 可靠**：JSON 少一个括号就整条废掉，
// 而且它得先猜对字段名叫 match 还是 pattern、where 的键要不要带 props. 前缀。
//
// 所以这里给 图查询.模式匹配 加一层文本前端。它**不是新引擎** —— 解析完就编译成
// 那个 JSON，一行执行逻辑都没有重复。
//
//   匹配 (?人:人)-[:认识]->(?友:人)-[:住在]->(成都)
//   其中 ?人.年龄 > 30 且 ?友.城市 = "成都"
//   返回 ?人, ?友
//   限制 10
//
// 语法（方括号是可选）：
//   匹配 路径 [, 路径]*
//   [其中 条件 [且 条件]*]
//   [返回 变量 [, 变量]*]
//   [限制 N]
//
//   路径 := 节点 (连边 节点)+          链式写，(a)-[:x]->(b)-[:y]->(c) 展开成两条三元组
//   节点 := (?变量) | (?变量:标签) | (常量id) | ("带空格的 id")
//   连边 := -[:类型]->   |   <-[:类型]-   |   -[]->（任意类型）
//   条件 := ?变量.属性 运算 值            运算 ∈ > >= < <= = != 包含
//   值   := 数字 | "字符串" | 裸词
//
// 关键字都是中文（匹配/其中/且/返回/限制），跟语言本身一致；`且` 之外不支持 `或` ——
// 底层 where 是「所有条件都要满足」的合取，硬撑一个 或 出来只会让人以为它真支持。
//
// 换行随意：解析前先把换行折成空格。子句顺序固定，写反了按写错处理（返回带 错 字段）。

包 Graph;

导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 KV::{可用};
导入 Graph.图::{图库};
导入 Graph.图查询::{模式匹配};

// ── 对外 ──────────────────────────────────────────────────────────

// 把语句编译成 模式匹配 认的 JSON。编译失败返回 {"错":"…"}，不抛异常 ——
// 这层是给模型用的，模型写错语法是常态，得能把错误原样回给它让它改。
公开 函数 编译语句(语句: 字符串) : 字符串 {
    变量 根: 整数 = J.创建对象();
    变量 文: 字符串 = 折行(语句);

    // 每个子句的终止点是「后面那些关键字里**最早出现**的那个」，不能各钉一个 ——
    // 钉死的话「有 其中、没 返回」时 限制 会被吞进 其中 段里，条件解析当场失败，
    // 而且失败得很安静（查出 0 条，看着像数据不对）。真数据测试逮到的就是这个。
    变量 匹配段: 字符串 = 取段(文, "匹配", "其中,返回,限制");
    如果 (字符串::字节长度(字符串::去空白(匹配段)) == 0) {
        返回 报错(根, "没有 匹配 子句");
    }
    变量 其中段: 字符串 = 取段(文, "其中", "返回,限制");
    变量 返回段: 字符串 = 取段(文, "返回", "限制");
    变量 限制段: 字符串 = 取段(文, "限制", "");

    变量 三元组: 整数 = J.创建数组();
    变量 标签条件: 整数 = J.创建对象();
    变量 错: 字符串 = 解析匹配(匹配段, 三元组, 标签条件);
    如果 (字符串::字节长度(错) > 0) {
        J.删除(三元组);
        J.删除(标签条件);
        返回 报错(根, 错);
    }

    变量 条件: 整数 = 标签条件;
    如果 (字符串::字节长度(字符串::去空白(其中段)) > 0) {
        错 = 解析其中(其中段, 条件);
        如果 (字符串::字节长度(错) > 0) {
            J.删除(三元组);
            J.删除(条件);
            返回 报错(根, 错);
        }
    }

    J.设置数组(根, "match", 三元组);
    J.设置对象(根, "where", 条件);
    如果 (字符串::字节长度(字符串::去空白(返回段)) > 0) {
        J.设置数组(根, "返回", 逗号数组(返回段));
    }
    变量 上限: 整数 = 读整数(字符串::去空白(限制段));
    如果 (上限 > 0) {
        J.设置整数(根, "限制", 上限);
    }
    变量 出: 字符串 = J.转字符串(根);
    J.删除(根);
    返回 出;
}

// 一句话查完：编译 → 跑 模式匹配 → 应用 返回 投影与 限制。
// 结果跟 模式匹配 一样是 JSON 数组文本；语法错时返回 {"错":"…"}。
公开 函数 查(图: 整数, 语句: 字符串) : 字符串 {
    变量 编: 字符串 = 编译语句(语句);
    变量 编对象: 整数 = J.解码(编);
    如果 (编对象 <= 0) {
        返回 "{\"错\":\"编译结果不是合法 JSON\"}";
    }
    变量 错: 字符串 = J.获取字符串(编对象, "错");
    如果 (字符串::字节长度(错) > 0) {
        J.删除(编对象);
        返回 编;
    }
    如果 (可用(图) == 0) {
        J.删除(编对象);
        返回 "[]";
    }

    变量 结果: 字符串 = 模式匹配(图, 编);
    变量 组: 整数 = J.解码(结果);
    如果 (组 <= 0) {
        J.删除(编对象);
        返回 结果;
    }
    变量 想要: 整数 = J.获取数组(编对象, "返回");
    变量 上限: 整数 = J.获取整数(编对象, "限制");
    变量 出组: 整数 = J.创建数组();
    变量 n: 整数 = J.数组长度(组);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (上限 > 0 与 i >= 上限) {
            跳出;
        }
        变量 一行: 整数 = J.数组获取对象(组, i);
        如果 (想要 > 0 与 J.数组长度(想要) > 0) {
            变量 窄: 整数 = J.创建对象();
            变量 k: 整数 = 0;
            当 (k < J.数组长度(想要)) {
                变量 名: 字符串 = J.数组获取字符串(想要, k);
                J.设置字符串(窄, 名, J.获取字符串(一行, 名));
                k = k + 1;
            }
            J.数组添加对象(出组, 窄);
        } 否则 {
            J.数组添加对象(出组, 一行);
        }
        i = i + 1;
    }
    变量 文本: 字符串 = J.转字符串(出组);
    J.删除(出组);
    J.删除(组);
    J.删除(编对象);
    返回 文本;
}

// 只要命中条数
公开 函数 查数(图: 整数, 语句: 字符串) : 整数 {
    变量 文: 字符串 = 查(图, 语句);
    变量 组: 整数 = J.解码(文);
    如果 (组 <= 0) {
        返回 0;
    }
    变量 n: 整数 = J.数组长度(组);
    J.删除(组);
    返回 n;
}

// ── 分段 ──────────────────────────────────────────────────────────

函数 折行(s: 字符串) : 字符串 {
    变量 出: 字符串 = 字符串::替换(s, "\n", " ");
    出 = 字符串::替换(出, "\r", " ");
    出 = 字符串::替换(出, "\t", " ");
    返回 出;
}

// 取 [起关键字 … 最早的止关键字) 之间那段。止词表 是逗号分隔的多个候选，
// 空串表示一直取到结尾。关键字只在**子句位置**出现，所以找第一次出现就够 ——
// 属性名或 id 里正好含「限制」这种字眼会误伤，属于自找，文档里说了。
函数 取段(文: 字符串, 起词: 字符串, 止词表: 字符串) : 字符串 {
    变量 a: 整数 = 字符串::查找(文, 起词);
    如果 (a < 0) {
        返回 "";
    }
    变量 从: 整数 = a + 字符串::字节长度(起词);
    变量 止位: 整数 = 字符串::字节长度(文);
    如果 (字符串::字节长度(止词表) > 0) {
        变量 候选: 整数 = 字符串::分割(止词表, ",");
        变量 i: 整数 = 0;
        当 (i < 表列::字符串列表大小(候选)) {
            变量 词: 字符串 = 字符串::去空白(表列::获取字符串(候选, i));
            如果 (字符串::字节长度(词) > 0) {
                变量 b: 整数 = 字符串::查找从位置(文, 词, 从);
                如果 (b >= 0 与 b < 止位) {
                    止位 = b;
                }
            }
            i = i + 1;
        }
        表列::删除列表(候选);
    }
    返回 字符串::子串(文, 从, 止位 - 从);
}

函数 报错(根: 整数, 说明: 字符串) : 字符串 {
    J.设置字符串(根, "错", 说明);
    变量 出: 字符串 = J.转字符串(根);
    J.删除(根);
    返回 出;
}

函数 逗号数组(段: 字符串) : 整数 {
    变量 组: 整数 = J.创建数组();
    变量 表: 整数 = 字符串::分割(段, ",");
    变量 i: 整数 = 0;
    当 (i < 表列::字符串列表大小(表)) {
        变量 一: 字符串 = 字符串::去空白(表列::获取字符串(表, i));
        如果 (字符串::字节长度(一) > 0) {
            J.数组添加字符串(组, 一);
        }
        i = i + 1;
    }
    表列::删除列表(表);
    返回 组;
}

函数 读整数(s: 字符串) : 整数 {
    变量 n: 整数 = 字符串::字节长度(s);
    如果 (n == 0) {
        返回 0;
    }
    变量 值: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 c: 字符串 = 字符串::子串(s, i, 1);
        如果 (c < "0" 或 c > "9") {
            返回 0;
        }
        值 = 值 * 10 + (字节值(c) - 48);
        i = i + 1;
    }
    返回 值;
}

函数 字节值(c: 字符串) : 整数 {
    如果 (c == "0") { 返回 48; }
    如果 (c == "1") { 返回 49; }
    如果 (c == "2") { 返回 50; }
    如果 (c == "3") { 返回 51; }
    如果 (c == "4") { 返回 52; }
    如果 (c == "5") { 返回 53; }
    如果 (c == "6") { 返回 54; }
    如果 (c == "7") { 返回 55; }
    如果 (c == "8") { 返回 56; }
    返回 57;
}

// ── 解析 匹配 ─────────────────────────────────────────────────────

// 逐条路径解析。节点靠圆括号定位，括号之间的那截就是连边 —— 不做字符级 tokenize，
// 中文是多字节，按字节扫容易切碎。
函数 解析匹配(段: 字符串, 三元组: 整数, 标签条件: 整数) : 字符串 {
    变量 路表: 整数 = 字符串::分割(段, ",");
    变量 p: 整数 = 0;
    变量 错: 字符串 = "";
    变量 条数: 整数 = 0;
    当 (p < 表列::字符串列表大小(路表)) {
        变量 路: 字符串 = 字符串::去空白(表列::获取字符串(路表, p));
        如果 (字符串::字节长度(路) > 0) {
            变量 e: 字符串 = 解析一路(路, 三元组, 标签条件);
            如果 (字符串::字节长度(e) > 0 与 字符串::字节长度(错) == 0) {
                错 = e;
            }
            条数 = 条数 + 1;
        }
        p = p + 1;
    }
    表列::删除列表(路表);
    如果 (字符串::字节长度(错) > 0) {
        返回 错;
    }
    如果 (条数 == 0) {
        返回 "匹配 子句是空的";
    }
    如果 (J.数组长度(三元组) == 0) {
        返回 "匹配 里一条边都没有 —— 至少要写成 (?a)-[:类型]->(?b)";
    }
    返回 "";
}

函数 解析一路(路: 字符串, 三元组: 整数, 标签条件: 整数) : 字符串 {
    变量 位: 整数 = 0;
    变量 上一个: 字符串 = "";
    变量 有上一个: 整数 = 0;
    变量 上一个止: 整数 = 0;
    当 (1 == 1) {
        变量 a: 整数 = 字符串::查找从位置(路, "(", 位);
        如果 (a < 0) {
            跳出;
        }
        变量 b: 整数 = 字符串::查找从位置(路, ")", a);
        如果 (b < 0) {
            返回 "括号没配对：" + 路;
        }
        变量 内: 字符串 = 字符串::去空白(字符串::子串(路, a + 1, b - a - 1));
        变量 本名: 字符串 = 解析节点(内, 标签条件);
        如果 (字符串::字节长度(本名) == 0) {
            返回 "空节点 () —— 至少给个变量名或 id";
        }
        如果 (有上一个 == 1) {
            // 上一个 ) 到这个 ( 之间就是连边
            变量 连: 字符串 = 字符串::去空白(字符串::子串(路, 上一个止 + 1, a - 上一个止 - 1));
            变量 e: 字符串 = 加一条边(连, 上一个, 本名, 三元组);
            如果 (字符串::字节长度(e) > 0) {
                返回 e;
            }
        }
        上一个 = 本名;
        有上一个 = 1;
        上一个止 = b;
        位 = b + 1;
    }
    如果 (有上一个 == 0) {
        返回 "这一段里没有节点：" + 路;
    }
    返回 "";
}

// 节点内文：?变量[:标签] | 常量 | "常量"
// 返回给三元组用的那个词（变量带 ? 前缀，常量是裸 id）；标签约束顺手记进 where。
函数 解析节点(内: 字符串, 标签条件: 整数) : 字符串 {
    如果 (字符串::字节长度(内) == 0) {
        返回 "";
    }
    如果 (字符串::开始于(内, "?") == 1) {
        变量 冒: 整数 = 字符串::查找(内, ":");
        如果 (冒 < 0) {
            返回 内;
        }
        变量 变元: 字符串 = 字符串::去空白(字符串::子串(内, 0, 冒));
        变量 标: 字符串 = 字符串::去空白(
            字符串::子串(内, 冒 + 1, 字符串::字节长度(内) - 冒 - 1));
        如果 (字符串::字节长度(标) > 0) {
            变量 一组: 整数 = J.创建对象();
            J.设置字符串(一组, "包含", 标);
            J.设置对象(标签条件, 变元 + ".labels", 一组);
        }
        返回 变元;
    }
    返回 去引号(内);
}

函数 去引号(s: 字符串) : 字符串 {
    变量 n: 整数 = 字符串::字节长度(s);
    如果 (n >= 2 与 字符串::开始于(s, "\"") == 1) {
        如果 (字符串::子串(s, n - 1, 1) == "\"") {
            返回 字符串::子串(s, 1, n - 2);
        }
    }
    返回 s;
}

// 连边文本：-[:类型]-> | <-[:类型]- | -[]-> | -[]-
函数 加一条边(连: 字符串, 左: 字符串, 右: 字符串, 三元组: 整数) : 字符串 {
    如果 (字符串::字节长度(连) == 0) {
        返回 "两个节点之间少了连边：(" + 左 + ") 和 (" + 右 + ")";
    }
    变量 逆: 整数 = 0;
    如果 (字符串::开始于(连, "<-") == 1) {
        逆 = 1;
    }
    变量 左括: 整数 = 字符串::查找(连, "[");
    变量 右括: 整数 = 字符串::查找(连, "]");
    如果 (左括 < 0 或 右括 < 左括) {
        返回 "连边写法不对：" + 连 + "（应形如 -[:类型]-> 或 <-[:类型]-）";
    }
    变量 型: 字符串 = 字符串::去空白(字符串::子串(连, 左括 + 1, 右括 - 左括 - 1));
    如果 (字符串::开始于(型, ":") == 1) {
        型 = 字符串::去空白(字符串::子串(型, 1, 字符串::字节长度(型) - 1));
    }
    变量 项: 整数 = J.创建对象();
    如果 (逆 == 1) {
        J.设置字符串(项, "from", 右);
        J.设置字符串(项, "to", 左);
    } 否则 {
        J.设置字符串(项, "from", 左);
        J.设置字符串(项, "to", 右);
    }
    J.设置字符串(项, "type", 型);
    J.数组添加对象(三元组, 项);
    返回 "";
}

// ── 解析 其中 ─────────────────────────────────────────────────────

函数 解析其中(段: 字符串, 条件: 整数) : 字符串 {
    变量 表: 整数 = 字符串::分割(段, "且");
    变量 i: 整数 = 0;
    变量 错: 字符串 = "";
    当 (i < 表列::字符串列表大小(表)) {
        变量 一: 字符串 = 字符串::去空白(表列::获取字符串(表, i));
        如果 (字符串::字节长度(一) > 0) {
            变量 e: 字符串 = 解析一条条件(一, 条件);
            如果 (字符串::字节长度(e) > 0 与 字符串::字节长度(错) == 0) {
                错 = e;
            }
        }
        i = i + 1;
    }
    表列::删除列表(表);
    返回 错;
}

// ?变量.属性 运算 值
// 两字符运算符要先试，不然 >= 会被 > 先截走。
函数 解析一条条件(一: 字符串, 条件: 整数) : 字符串 {
    变量 运算: 字符串 = "";
    变量 位: 整数 = 0 - 1;
    位 = 字符串::查找(一, ">=");
    如果 (位 >= 0) { 运算 = ">="; }
    如果 (运算 == "") {
        位 = 字符串::查找(一, "<=");
        如果 (位 >= 0) { 运算 = "<="; }
    }
    如果 (运算 == "") {
        位 = 字符串::查找(一, "!=");
        如果 (位 >= 0) { 运算 = "!="; }
    }
    如果 (运算 == "") {
        位 = 字符串::查找(一, "包含");
        如果 (位 >= 0) { 运算 = "包含"; }
    }
    如果 (运算 == "") {
        位 = 字符串::查找(一, ">");
        如果 (位 >= 0) { 运算 = ">"; }
    }
    如果 (运算 == "") {
        位 = 字符串::查找(一, "<");
        如果 (位 >= 0) { 运算 = "<"; }
    }
    如果 (运算 == "") {
        位 = 字符串::查找(一, "=");
        如果 (位 >= 0) { 运算 = "="; }
    }
    如果 (运算 == "") {
        返回 "条件里没有运算符：" + 一 + "（支持 > >= < <= = != 包含）";
    }
    变量 左: 字符串 = 字符串::去空白(字符串::子串(一, 0, 位));
    变量 右: 字符串 = 字符串::去空白(
        字符串::子串(一, 位 + 字符串::字节长度(运算),
                     字符串::字节长度(一) - 位 - 字符串::字节长度(运算)));
    如果 (字符串::字节长度(左) == 0 或 字符串::字节长度(右) == 0) {
        返回 "条件两边不能空：" + 一;
    }
    如果 (字符串::开始于(左, "?") == 0) {
        返回 "条件左边要是 ?变量.属性：" + 一;
    }
    变量 点: 整数 = 字符串::查找(左, ".");
    变量 键: 字符串 = 左;
    如果 (点 >= 0) {
        变量 变元: 字符串 = 字符串::子串(左, 0, 点);
        变量 属: 字符串 = 字符串::子串(左, 点 + 1, 字符串::字节长度(左) - 点 - 1);
        // labels 是结构字段，不加 props. 前缀；其余都当属性
        如果 (属 == "labels" 或 属 == "id") {
            键 = 变元 + "." + 属;
        } 否则 {
            键 = 变元 + ".props." + 属;
        }
    }
    变量 一组: 整数 = J.创建对象();
    变量 净: 字符串 = 去引号(右);
    如果 (净 == 右 与 是整数串(右) == 1) {
        J.设置整数(一组, 运算, 读整数(右));
    } 否则 {
        J.设置字符串(一组, 运算, 净);
    }
    J.设置对象(条件, 键, 一组);
    返回 "";
}

函数 是整数串(s: 字符串) : 整数 {
    变量 n: 整数 = 字符串::字节长度(s);
    如果 (n == 0) {
        返回 0;
    }
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 c: 字符串 = 字符串::子串(s, i, 1);
        如果 (c < "0" 或 c > "9") {
            返回 0;
        }
        i = i + 1;
    }
    返回 1;
}

// ── 图库 上的方法形式 ─────────────────────────────────────────────

公开 函数 (自身 图库) 查(语句: 字符串) : 字符串 { 返回 查(自身.句柄, 语句); }
公开 函数 (自身 图库) 查数(语句: 字符串) : 整数 { 返回 查数(自身.句柄, 语句); }
