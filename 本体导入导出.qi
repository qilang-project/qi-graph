// qi-graph · 本体导入导出 —— JSON 往返 + 极简 Turtle 子集（给人看）
//
// JSON 形状（键序稳定：类 / 属性 / 个体 / 主语按字典序，同一主语下按 (谓词, 宾键) 排）：
//   {"classes":[{"name","comment","parents":[…]}],
//    "properties":[{"name","domain","range","functional","transitive","symmetric","inverse","parent"}],
//    "individuals":[{"id","types":[…]}],
//    "triples":[{"s","p","o":{"iri"}|{"lit","dt"}}]}        ← 只导断言的，推出来的重跑 物化推理 即可
//
// Turtle 子集：前缀省略，`:主 :谓 :宾 .`；字符串字面量加引号，整数/浮点数裸写，布尔 true/false；
// 推出来的行尾加 `# 推出`。

包 Graph;

导入 标准库.字符串;
导入 标准库.JSON;
导入 标准库.列表 作为 表列;
导入 Graph.本体::{定义类, 类注释, 类存在, 类定义, 定义属性, 加个体, 断言, 断言字面量, 有三元组, 父类, 个体类型,
                  列出类, 列出属性, 列出个体, 列出主语, 属性定义, 邻接, 条目宾键, 宾键显示,
                  排序字符串列表, 字符串列表转JSON数组, 本体可用, 本体开始缓写, 本体刷盘, 本体库};

// 某主语的三元组按 (谓词, 宾键) 排好序；含推出 = 0 只要断言的。返回 JSON 数组（条目是拷贝），归调用方
函数 导_有序邻接(本: 整数, 主: 字符串, 含推出: 整数) : 整数 {
    变量 邻: 整数 = 邻接(本, 主);
    变量 n: 整数 = JSON.数组长度(邻);
    变量 键们: 整数 = 表列::创建字符串列表();
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 条: 整数 = JSON.数组获取对象(邻, i);
        如果 (含推出 == 1 或 JSON.是否包含键(条, "inferred") == 0) {
            表列::添加字符串(键们, JSON.获取字符串(条, "p") + "\t" + 条目宾键(条) + "\t" + i);
        }
        JSON.删除(条);
        i = i + 1;
    }
    变量 有序: 整数 = 排序字符串列表(键们);
    变量 出: 整数 = JSON.创建数组();
    变量 m: 整数 = 表列::字符串列表大小(有序);
    变量 j: 整数 = 0;
    当 (j < m) {
        变量 段: 整数 = 字符串::分割(表列::获取字符串(有序, j), "\t");
        变量 下标: 整数 = 字符串转整数(表列::获取字符串(段, 表列::字符串列表大小(段) - 1));
        表列::删除列表(段);
        变量 条: 整数 = JSON.数组获取对象(邻, 下标);
        JSON.数组添加对象(出, 条);
        JSON.删除(条);
        j = j + 1;
    }
    表列::删除列表(有序);
    表列::删除列表(键们);
    JSON.删除(邻);
    返回 出;
}

// ── JSON ──────────────────────────────────────────────────────────

公开 函数 导出本体JSON(本: 整数) : 字符串 {
    如果 (本体可用(本) == 0) { 返回 "{}"; }
    变量 根: 整数 = JSON.创建对象();

    变量 类数组: 整数 = JSON.创建数组();
    变量 类们: 整数 = 列出类(本);
    变量 nc: 整数 = 表列::字符串列表大小(类们);
    变量 i: 整数 = 0;
    当 (i < nc) {
        变量 c: 字符串 = 表列::获取字符串(类们, i);
        变量 定: 整数 = JSON.创建对象();
        JSON.设置字符串(定, "name", c);
        变量 原: 整数 = JSON.解码(类定义(本, c));
        变量 注: 字符串 = "";
        如果 (原 != 0) {
            注 = JSON.获取字符串(原, "comment");
            JSON.删除(原);
        }
        JSON.设置字符串(定, "comment", 注);
        变量 父们: 整数 = 父类(本, c);
        变量 父序: 整数 = 排序字符串列表(父们);
        变量 父数组: 整数 = 字符串列表转JSON数组(父序);
        JSON.设置数组(定, "parents", 父数组);
        JSON.删除(父数组);
        表列::删除列表(父序);
        表列::删除列表(父们);
        JSON.数组添加对象(类数组, 定);
        JSON.删除(定);
        i = i + 1;
    }
    表列::删除列表(类们);
    JSON.设置数组(根, "classes", 类数组);
    JSON.删除(类数组);

    变量 属性数组: 整数 = JSON.创建数组();
    变量 属性们: 整数 = 列出属性(本);
    变量 na: 整数 = 表列::字符串列表大小(属性们);
    i = 0;
    当 (i < na) {
        变量 定p: 整数 = JSON.解码(属性定义(本, 表列::获取字符串(属性们, i)));
        如果 (定p != 0) {
            JSON.数组添加对象(属性数组, 定p);
            JSON.删除(定p);
        }
        i = i + 1;
    }
    表列::删除列表(属性们);
    JSON.设置数组(根, "properties", 属性数组);
    JSON.删除(属性数组);

    变量 个体数组: 整数 = JSON.创建数组();
    变量 个体们: 整数 = 列出个体(本);
    变量 ni: 整数 = 表列::字符串列表大小(个体们);
    i = 0;
    当 (i < ni) {
        变量 id: 字符串 = 表列::获取字符串(个体们, i);
        变量 个: 整数 = JSON.创建对象();
        JSON.设置字符串(个, "id", id);
        变量 类型们: 整数 = 个体类型(本, id);
        变量 类型序: 整数 = 排序字符串列表(类型们);
        变量 类型数组: 整数 = 字符串列表转JSON数组(类型序);
        JSON.设置数组(个, "types", 类型数组);
        JSON.删除(类型数组);
        表列::删除列表(类型序);
        表列::删除列表(类型们);
        JSON.数组添加对象(个体数组, 个);
        JSON.删除(个);
        i = i + 1;
    }
    表列::删除列表(个体们);
    JSON.设置数组(根, "individuals", 个体数组);
    JSON.删除(个体数组);

    变量 三元组数组: 整数 = JSON.创建数组();
    变量 主们: 整数 = 列出主语(本);
    变量 ns: 整数 = 表列::字符串列表大小(主们);
    i = 0;
    当 (i < ns) {
        变量 s: 字符串 = 表列::获取字符串(主们, i);
        变量 有序: 整数 = 导_有序邻接(本, s, 0);
        变量 n: 整数 = JSON.数组长度(有序);
        变量 k: 整数 = 0;
        当 (k < n) {
            变量 条: 整数 = JSON.数组获取对象(有序, k);
            变量 t: 整数 = JSON.创建对象();
            JSON.设置字符串(t, "s", s);
            JSON.设置字符串(t, "p", JSON.获取字符串(条, "p"));
            变量 o: 整数 = JSON.获取对象(条, "o");
            如果 (o != 0) {
                JSON.设置对象(t, "o", o);
                JSON.删除(o);
            }
            JSON.数组添加对象(三元组数组, t);
            JSON.删除(t);
            JSON.删除(条);
            k = k + 1;
        }
        JSON.删除(有序);
        i = i + 1;
    }
    表列::删除列表(主们);
    JSON.设置数组(根, "triples", 三元组数组);
    JSON.删除(三元组数组);

    变量 文: 字符串 = JSON.转字符串(根);
    JSON.删除(根);
    返回 文;
}

// 把 导出本体JSON 的产物灌回去（可以灌进非空库，已有的会被跳过）。
// 返回 triples 里灌成功（灌完确实在库里）的条数；文本解析不了返回 -1
公开 函数 导入本体JSON(本: 整数, 文本: 字符串) : 整数 {
    如果 (本体可用(本) == 0) { 返回 -1; }
    变量 根: 整数 = JSON.解码(文本);
    如果 (根 == 0) { 返回 -1; }
    变量 数: 整数 = 0;
    本体开始缓写(本);

    变量 类数组: 整数 = JSON.获取数组(根, "classes");
    变量 nc: 整数 = JSON.数组长度(类数组);
    变量 i: 整数 = 0;
    当 (i < nc) {
        变量 定: 整数 = JSON.数组获取对象(类数组, i);
        变量 名: 字符串 = JSON.获取字符串(定, "name");
        定义类(本, 名);
        变量 注: 字符串 = JSON.获取字符串(定, "comment");
        如果 (字符串::字节长度(注) > 0) { 类注释(本, 名, 注); }
        变量 父们: 整数 = JSON.获取数组(定, "parents");
        变量 np: 整数 = JSON.数组长度(父们);
        变量 j: 整数 = 0;
        当 (j < np) {
            定义类(本, 名, JSON.数组获取字符串(父们, j));
            j = j + 1;
        }
        如果 (父们 != 0) { JSON.删除(父们); }
        JSON.删除(定);
        i = i + 1;
    }
    如果 (类数组 != 0) { JSON.删除(类数组); }

    变量 属性数组: 整数 = JSON.获取数组(根, "properties");
    变量 na: 整数 = JSON.数组长度(属性数组);
    i = 0;
    当 (i < na) {
        变量 定p: 整数 = JSON.数组获取对象(属性数组, i);
        定义属性(本, JSON.获取字符串(定p, "name"), JSON.获取字符串(定p, "domain"),
                 JSON.获取字符串(定p, "range"), JSON.转字符串(定p));
        JSON.删除(定p);
        i = i + 1;
    }
    如果 (属性数组 != 0) { JSON.删除(属性数组); }

    变量 个体数组: 整数 = JSON.获取数组(根, "individuals");
    变量 ni: 整数 = JSON.数组长度(个体数组);
    i = 0;
    当 (i < ni) {
        变量 个: 整数 = JSON.数组获取对象(个体数组, i);
        变量 id: 字符串 = JSON.获取字符串(个, "id");
        加个体(本, id, "");
        变量 类型们: 整数 = JSON.获取数组(个, "types");
        变量 nt: 整数 = JSON.数组长度(类型们);
        变量 j: 整数 = 0;
        当 (j < nt) {
            加个体(本, id, JSON.数组获取字符串(类型们, j));
            j = j + 1;
        }
        如果 (类型们 != 0) { JSON.删除(类型们); }
        JSON.删除(个);
        i = i + 1;
    }
    如果 (个体数组 != 0) { JSON.删除(个体数组); }

    变量 三元组数组: 整数 = JSON.获取数组(根, "triples");
    变量 n3: 整数 = JSON.数组长度(三元组数组);
    i = 0;
    当 (i < n3) {
        变量 t: 整数 = JSON.数组获取对象(三元组数组, i);
        变量 s: 字符串 = JSON.获取字符串(t, "s");
        变量 p: 字符串 = JSON.获取字符串(t, "p");
        变量 o: 整数 = JSON.获取对象(t, "o");
        如果 (o != 0) {
            如果 (JSON.是否包含键(o, "iri") == 1) {
                变量 iri: 字符串 = JSON.获取字符串(o, "iri");
                断言(本, s, p, iri);
                数 = 数 + 有三元组(本, s, p, iri);
            } 否则 {
                变量 v: 字符串 = JSON.获取字符串(o, "lit");
                断言字面量(本, s, p, v, JSON.获取字符串(o, "dt"));
                数 = 数 + 有三元组(本, s, p, "lit=" + v);
            }
            JSON.删除(o);
        }
        JSON.删除(t);
        i = i + 1;
    }
    如果 (三元组数组 != 0) { JSON.删除(三元组数组); }

    JSON.删除(根);
    本体刷盘(本);
    返回 数;
}

// ── Turtle ────────────────────────────────────────────────────────

函数 导_转义(s: 字符串) : 字符串 {
    变量 t: 字符串 = 字符串::替换(s, "\\", "\\\\");
    t = 字符串::替换(t, "\"", "\\\"");
    t = 字符串::替换(t, "\n", "\\n");
    返回 t;
}

函数 导_Turtle宾(o: 整数) : 字符串 {
    如果 (JSON.是否包含键(o, "iri") == 1) { 返回 ":" + JSON.获取字符串(o, "iri"); }
    变量 v: 字符串 = JSON.获取字符串(o, "lit");
    变量 dt: 字符串 = JSON.获取字符串(o, "dt");
    如果 (dt == "整数" 或 dt == "浮点数") { 返回 v; }
    如果 (dt == "布尔") {
        如果 (v == "1" 或 v == "真" 或 v == "true") { 返回 "true"; }
        返回 "false";
    }
    返回 "\"" + 导_转义(v) + "\"";
}

// 每行 `:主 :谓 :宾 .`，字面量加引号；推出来的行尾 `# 推出`。顺序同 JSON 导出
公开 函数 导出Turtle(本: 整数) : 字符串 {
    如果 (本体可用(本) == 0) { 返回 ""; }
    变量 出: 字符串 = "";
    变量 主们: 整数 = 列出主语(本);
    变量 ns: 整数 = 表列::字符串列表大小(主们);
    变量 i: 整数 = 0;
    当 (i < ns) {
        变量 s: 字符串 = 表列::获取字符串(主们, i);
        变量 有序: 整数 = 导_有序邻接(本, s, 1);
        变量 n: 整数 = JSON.数组长度(有序);
        变量 k: 整数 = 0;
        当 (k < n) {
            变量 条: 整数 = JSON.数组获取对象(有序, k);
            变量 o: 整数 = JSON.获取对象(条, "o");
            如果 (o != 0) {
                出 = 出 + ":" + s + " :" + JSON.获取字符串(条, "p") + " " + 导_Turtle宾(o) + " .";
                如果 (JSON.是否包含键(条, "inferred") == 1) { 出 = 出 + " # 推出"; }
                出 = 出 + "\n";
                JSON.删除(o);
            }
            JSON.删除(条);
            k = k + 1;
        }
        JSON.删除(有序);
        i = i + 1;
    }
    表列::删除列表(主们);
    返回 出;
}

// ── 链式方法 ──────────────────────────────────────────────────────

公开 函数 (自身 本体库) 导出JSON() : 字符串 { 返回 导出本体JSON(自身.句柄); }
公开 函数 (自身 本体库) 导入JSON(文本: 字符串) : 本体库 { 导入本体JSON(自身.句柄, 文本); 返回 自身; }
公开 函数 (自身 本体库) 导出Turtle() : 字符串 { 返回 导出Turtle(自身.句柄); }
