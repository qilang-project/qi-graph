// qi-graph · 图特征 —— 把节点变成一串数：度 / 三角形 / 密度 / 测地 / 接近 / 介数 / PageRank
//
// 对应 Negro《Knowledge Graphs and LLMs in Action》第 10 章 10.1 节「手工节点特征」。
// 那一章的主张是：图算法的产物不是给人看的排行榜，而是**喂给下游模型的特征向量** ——
// 同一个节点，度告诉你它多忙、三角形告诉你它周围抱不抱团、介数告诉你它卡不卡在要道上、
// PageRank 告诉你顺着边走多容易走到它。单看一个都会骗人，凑成一排才有用。
// 所以本模块的落点是 节点特征JSON / 全图特征JSON，前面那些单项都是它的零件。
//
// ── 方向约定（重要，不统一的话数字之间没法比）──
// **社群结构类**（三角形 / 聚类系数 / 自我网密度 / 测地 / 接近 / 介数）一律当**无向图**算：
// 邻居取 方向_双，自环剔掉。这类指标问的是「谁跟谁挨着」，边的朝向不改变挨着这件事，
// 而且书里的欺诈网络例子也是社交式的无向图。
// **PageRank 按有向算**：它问的是「顺着边随机走，停在谁身上的概率大」，方向就是它的全部内容，
// 抹掉方向等于把它退化成度。要无向的 PageRank，自己把每条边正反各加一次。
// 重复边在这里都只算一条（邻居本来就去重）—— 想让重复边加权，用属性另存权重，本模块不读。
//
// ── 代价（先看这段再决定要不要在大图上跑）──
// 邻接每次都回 kv 读，没有内存里的图。单源 BFS 是 O(点+边) 次读；
// 于是 接近中心性(全图) 和 介数中心性 都是 **O(点 ×(点+边))** —— 几千个点就该考虑
// 先 导出JSON 到内存里算。度 / 三角形 / 密度 / 特征向量 都是局部的，只碰邻居，随便用。

包 Graph;

导入 标准库.JSON 作为 J;
导入 标准库.列表 作为 表列;
导入 标准库.哈希表;
导入 标准库.字节切片;
导入 KV::{可用};
导入 标准库.字符串;
导入 标准库.数学;
导入 Graph.图::{图库, 有节点, 有标签, 列全部节点, 取边};
导入 Graph.遍历::{邻居, 出邻居, 出边, 入边, 度, 出度, 入度};

// ── 小工具 ────────────────────────────────────────────────────────

// 字节序比大小。本模块只拿它给无序的一对邻居定个先后，好让每个三角形 / 每条边
// 只数一次；跟 本体.qi 里那个同名函数是一回事，抄一份是为了不让图层依赖本体层。
函数 比字符串(a: 字符串, b: 字符串) : 整数 {
    变量 x: 整数 = 字节切片::从字符串(a);
    变量 y: 整数 = 字节切片::从字符串(b);
    变量 r: 整数 = 字节切片::比较(x, y);
    字节切片::释放切片(x);
    字节切片::释放切片(y);
    返回 r;
}

// 不分方向的邻居，去掉自环。调用方负责 表列::删除列表。
//
// 自环必须剔：留着的话它既让度虚高一格，又会在三角形那一层被当成一条「回到自己」的边，
// 聚类系数直接算爆（分母是 k(k-1)，k 里混进自己就对不上了）。
公开 函数 无向邻居(图: 整数, id: 字符串) : 整数 {
    变量 出表: 整数 = 表列::创建字符串列表();
    如果 (可用(图) == 0) {
        返回 出表;
    }
    变量 全: 整数 = 邻居(图, id, 2, "");
    变量 n: 整数 = 表列::字符串列表大小(全);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 v: 字符串 = 表列::获取字符串(全, i);
        如果 (v != id) {
            表列::添加字符串(出表, v);
        }
        i = i + 1;
    }
    表列::删除列表(全);
    返回 出表;
}

// 把一串 id 装进集合（值恒为 1），用来做 O(1) 的「在不在里面」。
函数 装成集合(表: 整数) : 整数 {
    变量 集: 整数 = 哈希表::创建整数表();
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 i: 整数 = 0;
    当 (i < n) {
        哈希表::设置整数(集, 表列::获取字符串(表, i), 1);
        i = i + 1;
    }
    返回 集;
}

// 单源 BFS（无向）。返回 id → 跳数 的整数表；同时把访问顺序追加进 序（BFS 层序，
// 介数那边要靠它倒着回溯）。序 由调用方创建和删除，返回的表由调用方 释放表。
//
// 序 同时当队列使：出队就是往后挪游标，不用第二个容器 —— 也正因为如此，
// 传进来的 序 必须是空的。
公开 函数 单源距离(图: 整数, 起: 字符串, 序: 整数) : 整数 {
    变量 距: 整数 = 哈希表::创建整数表();
    如果 (可用(图) == 0 或 有节点(图, 起) == 0) {
        返回 距;
    }
    哈希表::设置整数(距, 起, 0);
    表列::添加字符串(序, 起);
    变量 头: 整数 = 0;
    当 (头 < 表列::字符串列表大小(序)) {
        变量 当前: 字符串 = 表列::获取字符串(序, 头);
        变量 d: 整数 = 哈希表::获取整数(距, 当前);
        头 = 头 + 1;
        变量 邻: 整数 = 无向邻居(图, 当前);
        变量 k: 整数 = 表列::字符串列表大小(邻);
        变量 i: 整数 = 0;
        当 (i < k) {
            变量 v: 字符串 = 表列::获取字符串(邻, i);
            如果 (哈希表::包含键(距, v) == 0) {
                哈希表::设置整数(距, v, d + 1);
                表列::添加字符串(序, v);
            }
            i = i + 1;
        }
        表列::删除列表(邻);
    }
    返回 距;
}

// ── 10.1.1 度 ─────────────────────────────────────────────────────
//
// 全局度（度 / 出度 / 入度）在 遍历.qi 里，那三个是 O(1) 读一条邻接。
// 这里补书里真正当特征用的那个：**按邻居标签分开数**。书中欺诈网络的例子是
// 「这个人连着几个已知骗子、连着几个正常人」—— 光看总度数分不出可疑，
// 分标签一数就分出来了。代价是 O(度) 次读（每个邻居都要取标签）。

公开 函数 按标签度(图: 整数, id: 字符串, 标签: 字符串) : 整数 {
    返回 按标签度(图, id, 标签, 2);
}

// 方向：0 = 出，1 = 入，2 = 不分方向
公开 函数 按标签度(图: 整数, id: 字符串, 标签: 字符串, 方向: 整数) : 整数 {
    如果 (可用(图) == 0) {
        返回 0;
    }
    变量 邻: 整数 = 邻居(图, id, 方向, "");
    变量 n: 整数 = 表列::字符串列表大小(邻);
    变量 数: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 v: 字符串 = 表列::获取字符串(邻, i);
        如果 (v != id 与 有标签(图, v, 标签) == 1) {
            数 = 数 + 1;
        }
        i = i + 1;
    }
    表列::删除列表(邻);
    返回 数;
}

// 按标签度 占 无向度 的比例。书里 10.1.1 的表格最后一列就是这个 ——
// 绝对值受活跃度影响太大，比例才好横向比。度为 0 时返回 0.0。
公开 函数 按标签度占比(图: 整数, id: 字符串, 标签: 字符串) : 浮点数 {
    变量 邻: 整数 = 无向邻居(图, id);
    变量 n: 整数 = 表列::字符串列表大小(邻);
    如果 (n == 0) {
        表列::删除列表(邻);
        返回 0.0;
    }
    变量 数: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (有标签(图, 表列::获取字符串(邻, i), 标签) == 1) {
            数 = 数 + 1;
        }
        i = i + 1;
    }
    表列::删除列表(邻);
    返回 整数转浮点数(数) / 整数转浮点数(n);
}

// ── 10.1.2 三角形 ─────────────────────────────────────────────────

// 这个节点参与了几个三角形（无向，每个三角形只数一次）。
//
// 数法：取邻居集合 N，对每个 u ∈ N 摸一遍 u 的邻居，看有几个 w 同时满足
// w ∈ N 且 u < w（字节序）。定序是为了让 {u,w} 这一对只在 u 那一轮被数到，
// 不然每个三角形会被数两遍。代价 O(Σ 邻居的度) 次读。
公开 函数 三角形数(图: 整数, id: 字符串) : 整数 {
    如果 (可用(图) == 0) {
        返回 0;
    }
    变量 邻: 整数 = 无向邻居(图, id);
    变量 k: 整数 = 表列::字符串列表大小(邻);
    如果 (k < 2) {
        表列::删除列表(邻);
        返回 0;
    }
    变量 集: 整数 = 装成集合(邻);
    变量 三角: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < k) {
        变量 u: 字符串 = 表列::获取字符串(邻, i);
        变量 邻u: 整数 = 无向邻居(图, u);
        变量 m: 整数 = 表列::字符串列表大小(邻u);
        变量 j: 整数 = 0;
        当 (j < m) {
            变量 w: 字符串 = 表列::获取字符串(邻u, j);
            如果 (w != id 与 哈希表::包含键(集, w) == 1 与 比字符串(u, w) < 0) {
                三角 = 三角 + 1;
            }
            j = j + 1;
        }
        表列::删除列表(邻u);
        i = i + 1;
    }
    哈希表::释放表(集);
    表列::删除列表(邻);
    返回 三角;
}

// 局部聚类系数 = 2T / (k(k-1))：邻居之间实际连了几条 ÷ 最多能连几条。
// 1.0 = 邻居们两两都认识（一个小团伙），0.0 = 邻居互不相识（一个中转站）。
// k < 2 时无定义，返回 0.0。
公开 函数 聚类系数(图: 整数, id: 字符串) : 浮点数 {
    变量 k: 整数 = 无向度(图, id);
    如果 (k < 2) {
        返回 0.0;
    }
    变量 t: 整数 = 三角形数(图, id);
    返回 2.0 * 整数转浮点数(t) / 整数转浮点数(k * (k - 1));
}

// 不分方向、去自环之后的度。跟 遍历.度（出度+入度，双向边会数两次）不是一回事，
// 聚类系数那种要求「邻居个数」的地方必须用这个。
公开 函数 无向度(图: 整数, id: 字符串) : 整数 {
    变量 邻: 整数 = 无向邻居(图, id);
    变量 n: 整数 = 表列::字符串列表大小(邻);
    表列::删除列表(邻);
    返回 n;
}

// ── 10.1.3 密度 ───────────────────────────────────────────────────

// 自我网密度：把「这个节点 + 它的邻居」圈出来当一张子图，看里头的边有多满。
// 实际边数 ÷ 完全图边数 n(n-1)/2，值域 [0,1]。
//
// 跟聚类系数的区别：聚类系数只看邻居之间（不含中心点连出去的那些边），
// 自我网密度把中心点自己也算进圈里。书里两个都给，因为它们对「星型 vs 团」
// 的反应不一样 —— 星型的聚类系数是 0，自我网密度却不低。
公开 函数 自我网密度(图: 整数, id: 字符串) : 浮点数 {
    如果 (可用(图) == 0 或 有节点(图, id) == 0) {
        返回 0.0;
    }
    变量 圈: 整数 = 无向邻居(图, id);
    表列::添加字符串(圈, id);
    变量 n: 整数 = 表列::字符串列表大小(圈);
    如果 (n < 2) {
        表列::删除列表(圈);
        返回 0.0;
    }
    变量 集: 整数 = 装成集合(圈);
    // 圈内边数：每个点看自己的邻居，只数排在自己后面的那些，一条边正好数一次
    变量 边数: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 u: 字符串 = 表列::获取字符串(圈, i);
        变量 邻u: 整数 = 无向邻居(图, u);
        变量 m: 整数 = 表列::字符串列表大小(邻u);
        变量 j: 整数 = 0;
        当 (j < m) {
            变量 w: 字符串 = 表列::获取字符串(邻u, j);
            如果 (哈希表::包含键(集, w) == 1 与 比字符串(u, w) < 0) {
                边数 = 边数 + 1;
            }
            j = j + 1;
        }
        表列::删除列表(邻u);
        i = i + 1;
    }
    哈希表::释放表(集);
    表列::删除列表(圈);
    返回 2.0 * 整数转浮点数(边数) / 整数转浮点数(n * (n - 1));
}

// ── 10.1.4 测地距离 ───────────────────────────────────────────────

// 最短路径跳数；不可达返回 -1，自己到自己是 0。
// （遍历.最短路径 给的是路径本身，这里只要长度，省一次列表分配。）
公开 函数 最短跳数(图: 整数, 起: 字符串, 止: 字符串) : 整数 {
    如果 (可用(图) == 0 或 有节点(图, 起) == 0 或 有节点(图, 止) == 0) {
        返回 0 - 1;
    }
    如果 (起 == 止) {
        返回 0;
    }
    变量 序: 整数 = 表列::创建字符串列表();
    变量 距: 整数 = 单源距离(图, 起, 序);
    变量 出: 整数 = 0 - 1;
    如果 (哈希表::包含键(距, 止) == 1) {
        出 = 哈希表::获取整数(距, 止);
    }
    哈希表::释放表(距);
    表列::删除列表(序);
    返回 出;
}

// 到所有**可达**节点的平均跳数（不含自己）。孤点返回 0.0。
// 只对可达的取平均：图不连通时另一半是无穷远，掺进来这个数就没意义了。
公开 函数 平均测地距离(图: 整数, id: 字符串) : 浮点数 {
    变量 序: 整数 = 表列::创建字符串列表();
    变量 距: 整数 = 单源距离(图, id, 序);
    变量 n: 整数 = 表列::字符串列表大小(序);
    变量 和: 整数 = 0;
    变量 i: 整数 = 1;                       // 跳过第 0 个（起点自己，距离 0）
    当 (i < n) {
        和 = 和 + 哈希表::获取整数(距, 表列::获取字符串(序, i));
        i = i + 1;
    }
    哈希表::释放表(距);
    表列::删除列表(序);
    如果 (n < 2) {
        返回 0.0;
    }
    返回 整数转浮点数(和) / 整数转浮点数(n - 1);
}

// 离心率：到最远的可达节点有几跳。孤点 0。
公开 函数 离心率(图: 整数, id: 字符串) : 整数 {
    变量 序: 整数 = 表列::创建字符串列表();
    变量 距: 整数 = 单源距离(图, id, 序);
    变量 n: 整数 = 表列::字符串列表大小(序);
    变量 最远: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 d: 整数 = 哈希表::获取整数(距, 表列::获取字符串(序, i));
        如果 (d > 最远) {
            最远 = d;
        }
        i = i + 1;
    }
    哈希表::释放表(距);
    表列::删除列表(序);
    返回 最远;
}

// ── 10.1.5 接近中心性 ─────────────────────────────────────────────

// Wasserman–Faust 版：((可达数-1)/距离和) × ((可达数-1)/(总点数-1))。
//
// 为什么不用教科书里那个 1/距离和：图一不连通它就废了 —— 每个连通块内部各算各的，
// 小块里的点因为距离和小，反而显得比大块的中心还「接近」。WF 版乘上一个
// 「你够得着全图多大一片」的折扣，跨连通块也能比。全连通时两者只差一个常数倍。
公开 函数 接近中心性(图: 整数, id: 字符串) : 浮点数 {
    如果 (可用(图) == 0 或 有节点(图, id) == 0) {
        返回 0.0;
    }
    变量 全部: 整数 = 列全部节点(图);
    变量 总数: 整数 = 表列::字符串列表大小(全部);
    表列::删除列表(全部);
    如果 (总数 < 2) {
        返回 0.0;
    }
    变量 序: 整数 = 表列::创建字符串列表();
    变量 距: 整数 = 单源距离(图, id, 序);
    变量 可达: 整数 = 表列::字符串列表大小(序);
    变量 和: 整数 = 0;
    变量 i: 整数 = 1;
    当 (i < 可达) {
        和 = 和 + 哈希表::获取整数(距, 表列::获取字符串(序, i));
        i = i + 1;
    }
    哈希表::释放表(距);
    表列::删除列表(序);
    如果 (和 == 0) {
        返回 0.0;
    }
    变量 分子: 浮点数 = 整数转浮点数(可达 - 1);
    返回 (分子 / 整数转浮点数(和)) * (分子 / 整数转浮点数(总数 - 1));
}

// ── 10.1.6 介数中心性 ─────────────────────────────────────────────

// Brandes 算法。返回 id → 分数 的**浮点表句柄**，调用方 哈希表::释放表。
//
// 直觉：全图两两之间的最短路，有多少条要从你身上过。度高不代表介数高 ——
// 桥接两个团伙的那个点可能只有两条边，但所有跨团伙的最短路都得走它。
// 书里 10.1.6 的重点就是这个「结构洞」，欺诈网络里的中间人正是这种形状。
//
// 实现上不显式存前驱表（qi 的哈希表值只有整数/浮点/字符串三种，存不下列表，
// 拼成串又要挑分隔符，而 id 里什么字符都可能有）。改用等价的重算法：
// w 的前驱就是「距离恰好比 w 小 1 的邻居」，回溯时现算，多两次邻接读换掉一个容器。
公开 函数 介数中心性(图: 整数) : 整数 {
    变量 分: 整数 = 哈希表::创建浮点表();
    如果 (可用(图) == 0) {
        返回 分;
    }
    变量 全部: 整数 = 列全部节点(图);
    变量 n: 整数 = 表列::字符串列表大小(全部);
    变量 i: 整数 = 0;
    当 (i < n) {
        哈希表::设置浮点数(分, 表列::获取字符串(全部, i), 0.0);
        i = i + 1;
    }
    变量 s: 整数 = 0;
    当 (s < n) {
        变量 源: 字符串 = 表列::获取字符串(全部, s);
        变量 序: 整数 = 表列::创建字符串列表();
        变量 距: 整数 = 单源距离(图, 源, 序);
        变量 m: 整数 = 表列::字符串列表大小(序);

        // 一、顺着层序数最短路条数：σ(v) = Σ σ(前驱)
        变量 条数: 整数 = 哈希表::创建浮点表();
        变量 增量: 整数 = 哈希表::创建浮点表();
        变量 a: 整数 = 0;
        当 (a < m) {
            变量 v: 字符串 = 表列::获取字符串(序, a);
            哈希表::设置浮点数(条数, v, 0.0);
            哈希表::设置浮点数(增量, v, 0.0);
            a = a + 1;
        }
        哈希表::设置浮点数(条数, 源, 1.0);
        变量 b: 整数 = 0;
        当 (b < m) {
            变量 w: 字符串 = 表列::获取字符串(序, b);
            变量 dw: 整数 = 哈希表::获取整数(距, w);
            变量 本条数: 浮点数 = 哈希表::获取浮点数(条数, w);
            变量 邻: 整数 = 无向邻居(图, w);
            变量 k: 整数 = 表列::字符串列表大小(邻);
            变量 c: 整数 = 0;
            当 (c < k) {
                变量 v: 字符串 = 表列::获取字符串(邻, c);
                如果 (哈希表::包含键(距, v) == 1 与 哈希表::获取整数(距, v) == dw + 1) {
                    哈希表::设置浮点数(条数, v, 哈希表::获取浮点数(条数, v) + 本条数);
                }
                c = c + 1;
            }
            表列::删除列表(邻);
            b = b + 1;
        }

        // 二、倒着回溯摊分：δ(前驱) += σ(前驱)/σ(w) × (1 + δ(w))
        变量 e: 整数 = m - 1;
        当 (e >= 0) {
            变量 w: 字符串 = 表列::获取字符串(序, e);
            变量 dw: 整数 = 哈希表::获取整数(距, w);
            变量 本条数: 浮点数 = 哈希表::获取浮点数(条数, w);
            变量 本增量: 浮点数 = 哈希表::获取浮点数(增量, w);
            如果 (本条数 > 0.0) {
                变量 邻: 整数 = 无向邻居(图, w);
                变量 k: 整数 = 表列::字符串列表大小(邻);
                变量 c: 整数 = 0;
                当 (c < k) {
                    变量 v: 字符串 = 表列::获取字符串(邻, c);
                    如果 (哈希表::包含键(距, v) == 1 与 哈希表::获取整数(距, v) == dw - 1) {
                        变量 邻条数: 浮点数 = 哈希表::获取浮点数(条数, v);
                        哈希表::设置浮点数(增量, v,
                            哈希表::获取浮点数(增量, v) + (邻条数 / 本条数) * (1.0 + 本增量));
                    }
                    c = c + 1;
                }
                表列::删除列表(邻);
            }
            如果 (w != 源) {
                哈希表::设置浮点数(分, w, 哈希表::获取浮点数(分, w) + 本增量);
            }
            e = e - 1;
        }

        哈希表::释放表(增量);
        哈希表::释放表(条数);
        哈希表::释放表(距);
        表列::删除列表(序);
        s = s + 1;
    }
    // 无向图里每对 (s,t) 会被当成源各走一次，所以每条最短路数了两遍
    变量 f: 整数 = 0;
    当 (f < n) {
        变量 v: 字符串 = 表列::获取字符串(全部, f);
        哈希表::设置浮点数(分, v, 哈希表::获取浮点数(分, v) / 2.0);
        f = f + 1;
    }
    表列::删除列表(全部);
    返回 分;
}

// 只要一个节点的介数。**它照样把全图跑一遍**（介数的定义就是全局的），
// 要好几个节点的分数就调 介数中心性(图) 一次拿全表，别在循环里调这个。
//
// 名字里多带「节点」两个字不是啰嗦：qi 的按元数重载要求各版本返回类型一致，
// 而全表版返回句柄（整数）、这个返回分数（浮点数），同名就编不过。
公开 函数 节点介数中心性(图: 整数, id: 字符串) : 浮点数 {
    变量 表: 整数 = 介数中心性(图);
    变量 出: 浮点数 = 哈希表::获取浮点数(表, id);
    哈希表::释放表(表);
    返回 出;
}

// ── 10.1.7 PageRank ───────────────────────────────────────────────

公开 函数 PageRank(图: 整数) : 整数 {
    返回 PageRank(图, 0.85, 20);
}

// 幂迭代。阻尼 0.85 是惯例值；轮数 20 对一般规模的图足够收敛（这里不做收敛判定，
// 跑够轮数就停 —— 判定要多存一份上一轮的表，而省下来的那几轮不值这个内存）。
// 返回 id → 分数 的浮点表句柄，调用方 哈希表::释放表。全部分数之和为 1。
//
// **悬挂节点**（没有出边的）会把概率质量吞掉，不处理的话总和一路漏到 0。
// 标准做法是把它们的质量均摊回全图，这里就是这么做的。
公开 函数 PageRank(图: 整数, 阻尼: 浮点数, 轮数: 整数) : 整数 {
    返回 跑PageRank(图, 阻尼, 轮数, "");
}

// 个性化 PageRank：随机游走不再均匀地重新开始，而是每次都跳回**种子**。
// 算出来的是「从种子出发有多容易走到你」，也就是相对于种子的相关度排序。
// 种子JSON 是 id 的 JSON 数组，例如 ["甲","乙"]；空数组 / 全是不存在的 id 时
// 退化成普通 PageRank。
//
// 这一条是书里 10.1.7「PageRank variations」的落点，也是本模块最该被 agent 用到的
// 一个：拿当前任务节点当种子，就能从一堆召回的边里挑出真正相关的那几条。
公开 函数 个性化PageRank(图: 整数, 种子JSON: 字符串) : 整数 {
    返回 跑PageRank(图, 0.85, 20, 种子JSON);
}

公开 函数 个性化PageRank(图: 整数, 种子JSON: 字符串, 阻尼: 浮点数, 轮数: 整数) : 整数 {
    返回 跑PageRank(图, 阻尼, 轮数, 种子JSON);
}

函数 跑PageRank(图: 整数, 阻尼: 浮点数, 轮数: 整数, 种子JSON: 字符串) : 整数 {
    变量 分: 整数 = 哈希表::创建浮点表();
    如果 (可用(图) == 0) {
        返回 分;
    }
    变量 全部: 整数 = 列全部节点(图);
    变量 n: 整数 = 表列::字符串列表大小(全部);
    如果 (n == 0) {
        表列::删除列表(全部);
        返回 分;
    }
    变量 均: 浮点数 = 1.0 / 整数转浮点数(n);

    // 跳转分布：默认均匀；给了种子就只落在种子上
    变量 跳转: 整数 = 哈希表::创建浮点表();
    变量 种子数: 整数 = 0;
    如果 (字符串长度(种子JSON) > 0) {
        变量 组: 整数 = J.解码(种子JSON);
        如果 (组 > 0) {
            变量 g: 整数 = 0;
            当 (g < J.数组长度(组)) {
                变量 sid: 字符串 = J.数组获取字符串(组, g);
                如果 (有节点(图, sid) == 1) {
                    哈希表::设置浮点数(跳转, sid, 1.0);
                    种子数 = 种子数 + 1;
                }
                g = g + 1;
            }
            J.删除(组);
        }
    }
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 v: 字符串 = 表列::获取字符串(全部, i);
        如果 (种子数 == 0) {
            哈希表::设置浮点数(跳转, v, 均);
        } 否则 {
            如果 (哈希表::获取浮点数(跳转, v) > 0.0) {
                哈希表::设置浮点数(跳转, v, 1.0 / 整数转浮点数(种子数));
            } 否则 {
                哈希表::设置浮点数(跳转, v, 0.0);
            }
        }
        哈希表::设置浮点数(分, v, 哈希表::获取浮点数(跳转, v));
        i = i + 1;
    }

    变量 轮: 整数 = 0;
    当 (轮 < 轮数) {
        变量 新: 整数 = 哈希表::创建浮点表();
        变量 悬挂: 浮点数 = 0.0;
        变量 a: 整数 = 0;
        当 (a < n) {
            变量 v: 字符串 = 表列::获取字符串(全部, a);
            哈希表::设置浮点数(新, v, (1.0 - 阻尼) * 哈希表::获取浮点数(跳转, v));
            a = a + 1;
        }
        变量 b: 整数 = 0;
        当 (b < n) {
            变量 u: 字符串 = 表列::获取字符串(全部, b);
            变量 r: 浮点数 = 哈希表::获取浮点数(分, u);
            变量 出邻: 整数 = 出邻居(图, u);
            变量 k: 整数 = 表列::字符串列表大小(出邻);
            如果 (k == 0) {
                悬挂 = 悬挂 + r;
            } 否则 {
                变量 份: 浮点数 = 阻尼 * r / 整数转浮点数(k);
                变量 c: 整数 = 0;
                当 (c < k) {
                    变量 w: 字符串 = 表列::获取字符串(出邻, c);
                    哈希表::设置浮点数(新, w, 哈希表::获取浮点数(新, w) + 份);
                    c = c + 1;
                }
            }
            表列::删除列表(出邻);
            b = b + 1;
        }
        如果 (悬挂 > 0.0) {
            变量 d: 整数 = 0;
            当 (d < n) {
                变量 v: 字符串 = 表列::获取字符串(全部, d);
                哈希表::设置浮点数(新, v,
                    哈希表::获取浮点数(新, v) + 阻尼 * 悬挂 * 哈希表::获取浮点数(跳转, v));
                d = d + 1;
            }
        }
        哈希表::释放表(分);
        分 = 新;
        轮 = 轮 + 1;
    }
    哈希表::释放表(跳转);
    表列::删除列表(全部);
    返回 分;
}

函数 字符串长度(s: 字符串) : 整数 {
    变量 x: 整数 = 字节切片::从字符串(s);
    变量 n: 整数 = 字节切片::长度(x);
    字节切片::释放切片(x);
    返回 n;
}

// ── 10.1.8 组装成特征向量 ─────────────────────────────────────────

// 一个节点的**局部**特征（只碰它的邻域，随便调）：
//   {"id","度","出度","入度","无向度","三角形数","聚类系数","自我网密度",
//    "离心率","平均测地距离","接近中心性"}
// 离心率 / 平均测地距离 / 接近中心性 要走一次单源 BFS，比前面几项贵。
公开 函数 节点特征JSON(图: 整数, id: 字符串) : 字符串 {
    变量 o: 整数 = J.创建对象();
    J.设置字符串(o, "id", id);
    如果 (可用(图) == 0 或 有节点(图, id) == 0) {
        J.设置布尔(o, "存在", 0);
        变量 缺: 字符串 = J.转字符串(o);
        J.删除(o);
        返回 缺;
    }
    J.设置布尔(o, "存在", 1);
    J.设置整数(o, "度", 度(图, id));
    J.设置整数(o, "出度", 出度(图, id));
    J.设置整数(o, "入度", 入度(图, id));
    J.设置整数(o, "无向度", 无向度(图, id));
    J.设置整数(o, "三角形数", 三角形数(图, id));
    J.设置浮点数(o, "聚类系数", 聚类系数(图, id));
    J.设置浮点数(o, "自我网密度", 自我网密度(图, id));
    J.设置整数(o, "离心率", 离心率(图, id));
    J.设置浮点数(o, "平均测地距离", 平均测地距离(图, id));
    J.设置浮点数(o, "接近中心性", 接近中心性(图, id));
    变量 出: 字符串 = J.转字符串(o);
    J.删除(o);
    返回 出;
}

// 全图每个节点一行，局部特征 + 两个全局特征（PageRank、介数中心性）。
// 全局那两个**只算一次**再分发到各行 —— 这正是不该在循环里调 介数中心性(图,id) 的原因。
// 返回 JSON 数组。代价见文件抬头：O(点 ×(点+边))。
公开 函数 全图特征JSON(图: 整数) : 字符串 {
    变量 组: 整数 = J.创建数组();
    如果 (可用(图) == 0) {
        变量 空: 字符串 = J.转字符串(组);
        J.删除(组);
        返回 空;
    }
    变量 全部: 整数 = 列全部节点(图);
    变量 n: 整数 = 表列::字符串列表大小(全部);
    变量 pr: 整数 = PageRank(图);
    变量 bc: 整数 = 介数中心性(图);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 id: 字符串 = 表列::获取字符串(全部, i);
        变量 行: 整数 = J.解码(节点特征JSON(图, id));
        如果 (行 > 0) {
            J.设置浮点数(行, "PageRank", 哈希表::获取浮点数(pr, id));
            J.设置浮点数(行, "介数中心性", 哈希表::获取浮点数(bc, id));
            J.数组添加对象(组, 行);
        }
        i = i + 1;
    }
    哈希表::释放表(bc);
    哈希表::释放表(pr);
    表列::删除列表(全部);
    变量 出: 字符串 = J.转字符串(组);
    J.删除(组);
    返回 出;
}

// ── 排行 ──────────────────────────────────────────────────────────

// 把一张浮点表（PageRank / 介数中心性 的返回值）按分数从高到低取前几名，
// 输出 [{"id":…,"分数":…}, …]。书里那几张表格（10.5 / 10.6 / 10.7）就是这个形状。
// 取前几 <= 0 或大于节点数时给全部。分数相同的按 id 字节序，保证可复现。
公开 函数 排行JSON(图: 整数, 表: 整数, 取前几: 整数) : 字符串 {
    变量 组: 整数 = J.创建数组();
    如果 (可用(图) == 0) {
        变量 空: 字符串 = J.转字符串(组);
        J.删除(组);
        返回 空;
    }
    变量 全部: 整数 = 列全部节点(图);
    变量 n: 整数 = 表列::字符串列表大小(全部);
    变量 要: 整数 = 取前几;
    如果 (要 <= 0 或 要 > n) {
        要 = n;
    }
    // 选择法取前 要 名：n 小、要 更小，比先整体排序省事，也不用可变字符串列表
    变量 用过: 整数 = 哈希表::创建整数表();
    变量 轮: 整数 = 0;
    当 (轮 < 要) {
        变量 最好: 字符串 = "";
        变量 最高: 浮点数 = 0.0;
        变量 有: 整数 = 0;
        变量 i: 整数 = 0;
        当 (i < n) {
            变量 id: 字符串 = 表列::获取字符串(全部, i);
            如果 (哈希表::包含键(用过, id) == 0) {
                变量 v: 浮点数 = 哈希表::获取浮点数(表, id);
                变量 更好: 整数 = 0;
                如果 (有 == 0) {
                    更好 = 1;
                }
                如果 (有 == 1 与 v > 最高) {
                    更好 = 1;
                }
                如果 (有 == 1 与 v == 最高 与 比字符串(id, 最好) < 0) {
                    更好 = 1;
                }
                如果 (更好 == 1) {
                    最好 = id;
                    最高 = v;
                    有 = 1;
                }
            }
            i = i + 1;
        }
        如果 (有 == 0) {
            跳出;
        }
        哈希表::设置整数(用过, 最好, 1);
        变量 行: 整数 = J.创建对象();
        J.设置字符串(行, "id", 最好);
        J.设置浮点数(行, "分数", 最高);
        J.数组添加对象(组, 行);
        轮 = 轮 + 1;
    }
    哈希表::释放表(用过);
    表列::删除列表(全部);
    变量 出: 字符串 = J.转字符串(组);
    J.删除(组);
    返回 出;
}

// ── 图库 上的方法形式 ─────────────────────────────────────────────

公开 函数 (自身 图库) 无向度(id: 字符串) : 整数 { 返回 无向度(自身.句柄, id); }
公开 函数 (自身 图库) 按标签度(id: 字符串, 标签: 字符串) : 整数 { 返回 按标签度(自身.句柄, id, 标签); }
公开 函数 (自身 图库) 按标签度占比(id: 字符串, 标签: 字符串) : 浮点数 { 返回 按标签度占比(自身.句柄, id, 标签); }
公开 函数 (自身 图库) 三角形数(id: 字符串) : 整数 { 返回 三角形数(自身.句柄, id); }
公开 函数 (自身 图库) 聚类系数(id: 字符串) : 浮点数 { 返回 聚类系数(自身.句柄, id); }
公开 函数 (自身 图库) 自我网密度(id: 字符串) : 浮点数 { 返回 自我网密度(自身.句柄, id); }
公开 函数 (自身 图库) 最短跳数(起: 字符串, 止: 字符串) : 整数 { 返回 最短跳数(自身.句柄, 起, 止); }
公开 函数 (自身 图库) 平均测地距离(id: 字符串) : 浮点数 { 返回 平均测地距离(自身.句柄, id); }
公开 函数 (自身 图库) 离心率(id: 字符串) : 整数 { 返回 离心率(自身.句柄, id); }
公开 函数 (自身 图库) 接近中心性(id: 字符串) : 浮点数 { 返回 接近中心性(自身.句柄, id); }
公开 函数 (自身 图库) 介数中心性() : 整数 { 返回 介数中心性(自身.句柄); }
公开 函数 (自身 图库) 节点介数中心性(id: 字符串) : 浮点数 { 返回 节点介数中心性(自身.句柄, id); }
公开 函数 (自身 图库) PageRank() : 整数 { 返回 PageRank(自身.句柄); }
公开 函数 (自身 图库) 个性化PageRank(种子JSON: 字符串) : 整数 { 返回 个性化PageRank(自身.句柄, 种子JSON); }
公开 函数 (自身 图库) 节点特征JSON(id: 字符串) : 字符串 { 返回 节点特征JSON(自身.句柄, id); }
公开 函数 (自身 图库) 全图特征JSON() : 字符串 { 返回 全图特征JSON(自身.句柄); }
公开 函数 (自身 图库) 排行JSON(表: 整数, 取前几: 整数) : 字符串 { 返回 排行JSON(自身.句柄, 表, 取前几); }

// ── 10.2.2 元路径与 DWPC ──────────────────────────────────────────
//
// 前面那些都是**节点**特征。书里 10.2 讲关系特征：要预测「甲和乙之间会不会有边」，
// 光把两个节点的特征拼一起（10.2.1）是不够的，真正有信息量的是**它们之间的路径长什么样**。
//
// 元路径 = 一串边类型，比如 ["结合", "关联"] 表示「药 --结合--> 基因 --关联--> 病」。
// 沿这条模板从起点走到终点，能走通几条就是 路径计数(PC)。
//
// 但 PC 有个偏差：连得多的中枢节点会让一切都「相关」。书里用的是 Hetionet 那套
// **度加权路径计数(DWPC)** —— 每一步按两端的度打折，度越大贡献越小：
//
//   一条路径的权重 = Π（每一步）(出度_该类型(u) × 入度_该类型(v)) ^ (-阻尼)
//   DWPC = 所有匹配路径的权重之和
//
// 阻尼 0 就退化成 PC；Hetionet 用的是 0.4。
//
// 代价：按元路径 DFS，每步只走该类型的出边，所以是 O(该类型的分支^元路径长度)。
// 别拿它跑长元路径 —— 书里也说了，把所有化合物-疾病对的所有元路径都算一遍
// 「计算上很贵，而且会得到一堆噪声」。

// 某个节点在某个边类型上的出度 / 入度。要读每条边的 JSON 才知道类型，O(度) 次读。
公开 函数 按类型出度(图: 整数, id: 字符串, 边类型: 字符串) : 整数 {
    返回 数一侧(图, 出边(图, id), 边类型);
}

公开 函数 按类型入度(图: 整数, id: 字符串, 边类型: 字符串) : 整数 {
    返回 数一侧(图, 入边(图, id), 边类型);
}

函数 数一侧(图: 整数, 边表: 整数, 边类型: 字符串) : 整数 {
    变量 数: 整数 = 0;
    变量 n: 整数 = 表列::字符串列表大小(边表);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 边对象: 整数 = J.解码(取边(图, 表列::获取字符串(边表, i)));
        如果 (边对象 > 0) {
            如果 (字符串::字节长度(边类型) == 0
                或 J.获取字符串(边对象, "type") == 边类型) {
                数 = 数 + 1;
            }
            J.删除(边对象);
        }
        i = i + 1;
    }
    表列::删除列表(边表);
    返回 数;
}

// 沿元路径能从 起 走到 止 的路径条数。元路径JSON 是边类型的 JSON 数组。
公开 函数 元路径计数(图: 整数, 起: 字符串, 止: 字符串, 元路径JSON: 字符串) : 整数 {
    变量 v: 浮点数 = 走元路径(图, 起, 止, 元路径JSON, 0.0);
    返回 浮点数转整数(v + 0.5);
}

// 度加权路径计数。阻尼 0 = 退化成 元路径计数；Hetionet 惯用 0.4。
公开 函数 度加权路径计数(图: 整数, 起: 字符串, 止: 字符串, 元路径JSON: 字符串,
                          阻尼: 浮点数) : 浮点数 {
    返回 走元路径(图, 起, 止, 元路径JSON, 阻尼);
}

函数 走元路径(图: 整数, 起: 字符串, 止: 字符串, 元路径JSON: 字符串, 阻尼: 浮点数) : 浮点数 {
    如果 (可用(图) == 0 或 有节点(图, 起) == 0 或 有节点(图, 止) == 0) {
        返回 0.0;
    }
    变量 步表: 整数 = J.解码(元路径JSON);
    如果 (步表 <= 0) {
        返回 0.0;
    }
    变量 步数: 整数 = J.数组长度(步表);
    如果 (步数 == 0) {
        J.删除(步表);
        返回 0.0;
    }
    // 路径上已经出现过的点：元路径按惯例不许绕回自己，否则环会让计数发散
    变量 走过: 整数 = 哈希表::创建整数表();
    哈希表::设置整数(走过, 起, 1);
    变量 和: 浮点数 = 递归走(图, 起, 止, 步表, 步数, 0, 阻尼, 1.0, 走过);
    哈希表::释放表(走过);
    J.删除(步表);
    返回 和;
}

函数 递归走(图: 整数, 当前: 字符串, 止: 字符串, 步表: 整数, 步数: 整数, 第几步: 整数,
             阻尼: 浮点数, 已积: 浮点数, 走过: 整数) : 浮点数 {
    如果 (第几步 >= 步数) {
        如果 (当前 == 止) {
            返回 已积;
        }
        返回 0.0;
    }
    变量 型: 字符串 = J.数组获取字符串(步表, 第几步);
    变量 出u: 整数 = 按类型出度(图, 当前, 型);
    变量 邻: 整数 = 出邻居(图, 当前, 型);
    变量 n: 整数 = 表列::字符串列表大小(邻);
    变量 和: 浮点数 = 0.0;
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 v: 字符串 = 表列::获取字符串(邻, i);
        如果 (哈希表::包含键(走过, v) == 0) {
            变量 步权: 浮点数 = 1.0;
            如果 (阻尼 > 0.0) {
                变量 入v: 整数 = 按类型入度(图, v, 型);
                变量 底: 浮点数 = 整数转浮点数(出u * 入v);
                如果 (底 > 0.0) {
                    步权 = 数学.幂(底, 0.0 - 阻尼);
                }
            }
            哈希表::设置整数(走过, v, 1);
            和 = 和 + 递归走(图, v, 止, 步表, 步数, 第几步 + 1, 阻尼, 已积 * 步权, 走过);
            哈希表::删除键(走过, v);
        }
        i = i + 1;
    }
    表列::删除列表(邻);
    返回 和;
}

// ── 10.3 ReFeX（递归特征提取）───────────────────────────────────
//
// 前面那些特征都是人挑的。ReFeX 的想法是：先给每个节点三个**局部**特征
// （度、自我网内部边数、自我网向外的边数），然后**反复**让每个节点把邻居的特征
// 聚合过来（求和 + 求平均），聚合几轮，视野就扩到几跳。
//
// 妙处在于它不需要知道图是干什么的：第 0 轮认出「谁忙」，第 1 轮认出「谁的邻居忙」，
// 第 2 轮认出「谁在一片忙碌区域的边上」—— 这些正是人工特征很难写出来的东西。
//
// 特征数每轮乘 3（原有 + 求和 + 求平均），所以 轮数 超过 2 就会爆
// （3→9→27→81）。书里靠相关性剪枝压回去，这里不剪，只把 轮数 卡在 3 —— 
// 剪枝要定阈值、要跨节点比对，那是调参活，塞进库里只会变成一个没人敢动的魔数。
公开 函数 ReFeX(图: 整数) : 字符串 {
    返回 ReFeX(图, 2);
}

// 返回 {"特征名":[…], "行":[{"id":…,"值":[…]}, …]}，行按 id 字节序，可复现。
公开 函数 ReFeX(图: 整数, 轮数: 整数) : 字符串 {
    变量 根: 整数 = J.创建对象();
    如果 (可用(图) == 0) {
        变量 空: 字符串 = J.转字符串(根);
        J.删除(根);
        返回 空;
    }
    变量 实际轮: 整数 = 轮数;
    如果 (实际轮 < 0) {
        实际轮 = 0;
    }
    如果 (实际轮 > 3) {
        实际轮 = 3;
    }

    变量 全部: 整数 = 列全部节点(图);
    变量 n: 整数 = 表列::字符串列表大小(全部);

    // 第 0 轮：三个局部特征
    变量 名表: 整数 = 表列::创建字符串列表();
    表列::添加字符串(名表, "度");
    表列::添加字符串(名表, "自我网内边数");
    表列::添加字符串(名表, "自我网外连边数");
    变量 值: 整数 = 哈希表::创建浮点表();
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 id: 字符串 = 表列::获取字符串(全部, i);
        哈希表::设置浮点数(值, 格(id, 0), 整数转浮点数(无向度(图, id)));
        哈希表::设置浮点数(值, 格(id, 1), 整数转浮点数(自我网内边数(图, id)));
        哈希表::设置浮点数(值, 格(id, 2), 整数转浮点数(自我网外连边数(图, id)));
        i = i + 1;
    }

    // 递归轮：每个现有特征各生出「邻居之和」与「邻居平均」两个新特征
    变量 轮: 整数 = 0;
    当 (轮 < 实际轮) {
        变量 旧数: 整数 = 表列::字符串列表大小(名表);
        变量 新值: 整数 = 哈希表::创建浮点表();
        变量 a: 整数 = 0;
        当 (a < n) {
            变量 id: 字符串 = 表列::获取字符串(全部, a);
            变量 邻: 整数 = 无向邻居(图, id);
            变量 k: 整数 = 表列::字符串列表大小(邻);
            变量 f: 整数 = 0;
            当 (f < 旧数) {
                变量 和: 浮点数 = 0.0;
                变量 j: 整数 = 0;
                当 (j < k) {
                    和 = 和 + 哈希表::获取浮点数(值, 格(表列::获取字符串(邻, j), f));
                    j = j + 1;
                }
                变量 均: 浮点数 = 0.0;
                如果 (k > 0) {
                    均 = 和 / 整数转浮点数(k);
                }
                哈希表::设置浮点数(新值, 格(id, 旧数 + f * 2), 和);
                哈希表::设置浮点数(新值, 格(id, 旧数 + f * 2 + 1), 均);
                f = f + 1;
            }
            表列::删除列表(邻);
            a = a + 1;
        }
        // 名字与值合并进主表
        变量 f2: 整数 = 0;
        当 (f2 < 旧数) {
            变量 base: 字符串 = 表列::获取字符串(名表, f2);
            表列::添加字符串(名表, "邻居和(" + base + ")");
            表列::添加字符串(名表, "邻居均(" + base + ")");
            f2 = f2 + 1;
        }
        变量 b: 整数 = 0;
        当 (b < n) {
            变量 id: 字符串 = 表列::获取字符串(全部, b);
            变量 f3: 整数 = 0;
            当 (f3 < 旧数 * 2) {
                哈希表::设置浮点数(值, 格(id, 旧数 + f3),
                    哈希表::获取浮点数(新值, 格(id, 旧数 + f3)));
                f3 = f3 + 1;
            }
            b = b + 1;
        }
        哈希表::释放表(新值);
        轮 = 轮 + 1;
    }

    // 组装
    变量 名组: 整数 = J.创建数组();
    变量 总特征: 整数 = 表列::字符串列表大小(名表);
    变量 c: 整数 = 0;
    当 (c < 总特征) {
        J.数组添加字符串(名组, 表列::获取字符串(名表, c));
        c = c + 1;
    }
    J.设置数组(根, "特征名", 名组);

    变量 行组: 整数 = J.创建数组();
    变量 序: 整数 = 序一遍(全部);
    变量 d: 整数 = 0;
    当 (d < 表列::字符串列表大小(序)) {
        变量 id: 字符串 = 表列::获取字符串(序, d);
        变量 行: 整数 = J.创建对象();
        J.设置字符串(行, "id", id);
        变量 值组: 整数 = J.创建数组();
        变量 e: 整数 = 0;
        当 (e < 总特征) {
            J.数组添加浮点数(值组, 哈希表::获取浮点数(值, 格(id, e)));
            e = e + 1;
        }
        J.设置数组(行, "值", 值组);
        J.数组添加对象(行组, 行);
        d = d + 1;
    }
    表列::删除列表(序);
    J.设置数组(根, "行", 行组);

    哈希表::释放表(值);
    表列::删除列表(名表);
    表列::删除列表(全部);
    变量 出: 字符串 = J.转字符串(根);
    J.删除(根);
    返回 出;
}

// 「节点 + 第几个特征」的复合键。节点 id 里不可能有冒号（合法段 拦着），
// 拿 "\x01" 之类更保险但没必要 —— 后半是纯数字，拆不拆得回来都不影响，只当键用。
函数 格(id: 字符串, 下标: 整数) : 字符串 {
    返回 id + ":" + 下标;
}

// 自我网内部边数：中心点 + 邻居这一圈里边的条数
公开 函数 自我网内边数(图: 整数, id: 字符串) : 整数 {
    变量 圈: 整数 = 无向邻居(图, id);
    表列::添加字符串(圈, id);
    变量 集: 整数 = 哈希表::创建整数表();
    变量 n: 整数 = 表列::字符串列表大小(圈);
    变量 i: 整数 = 0;
    当 (i < n) {
        哈希表::设置整数(集, 表列::获取字符串(圈, i), 1);
        i = i + 1;
    }
    变量 数: 整数 = 0;
    变量 a: 整数 = 0;
    当 (a < n) {
        变量 u: 字符串 = 表列::获取字符串(圈, a);
        变量 邻u: 整数 = 无向邻居(图, u);
        变量 m: 整数 = 表列::字符串列表大小(邻u);
        变量 j: 整数 = 0;
        当 (j < m) {
            变量 w: 字符串 = 表列::获取字符串(邻u, j);
            如果 (哈希表::包含键(集, w) == 1 与 比字符串(u, w) < 0) {
                数 = 数 + 1;
            }
            j = j + 1;
        }
        表列::删除列表(邻u);
        a = a + 1;
    }
    哈希表::释放表(集);
    表列::删除列表(圈);
    返回 数;
}

// 自我网向外的边数：圈里的点连到圈外去的边
公开 函数 自我网外连边数(图: 整数, id: 字符串) : 整数 {
    变量 圈: 整数 = 无向邻居(图, id);
    表列::添加字符串(圈, id);
    变量 集: 整数 = 哈希表::创建整数表();
    变量 n: 整数 = 表列::字符串列表大小(圈);
    变量 i: 整数 = 0;
    当 (i < n) {
        哈希表::设置整数(集, 表列::获取字符串(圈, i), 1);
        i = i + 1;
    }
    变量 数: 整数 = 0;
    变量 a: 整数 = 0;
    当 (a < n) {
        变量 u: 字符串 = 表列::获取字符串(圈, a);
        变量 邻u: 整数 = 无向邻居(图, u);
        变量 m: 整数 = 表列::字符串列表大小(邻u);
        变量 j: 整数 = 0;
        当 (j < m) {
            如果 (哈希表::包含键(集, 表列::获取字符串(邻u, j)) == 0) {
                数 = 数 + 1;
            }
            j = j + 1;
        }
        表列::删除列表(邻u);
        a = a + 1;
    }
    哈希表::释放表(集);
    表列::删除列表(圈);
    返回 数;
}

// 排一份有序副本（同 图模式.排一遍，这边不想跨模块依赖，抄一份）
函数 序一遍(表: 整数) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 用过: 整数 = 哈希表::创建整数表();
    变量 轮: 整数 = 0;
    当 (轮 < n) {
        变量 最小: 字符串 = "";
        变量 有: 整数 = 0;
        变量 i: 整数 = 0;
        当 (i < n) {
            变量 s: 字符串 = 表列::获取字符串(表, i);
            如果 (哈希表::包含键(用过, s) == 0) {
                如果 (有 == 0 或 比字符串(s, 最小) < 0) {
                    最小 = s;
                    有 = 1;
                }
            }
            i = i + 1;
        }
        如果 (有 == 0) {
            跳出;
        }
        哈希表::设置整数(用过, 最小, 1);
        表列::添加字符串(出, 最小);
        轮 = 轮 + 1;
    }
    哈希表::释放表(用过);
    返回 出;
}

公开 函数 (自身 图库) 元路径计数(起: 字符串, 止: 字符串, 元路径JSON: 字符串) : 整数 {
    返回 元路径计数(自身.句柄, 起, 止, 元路径JSON);
}
公开 函数 (自身 图库) 度加权路径计数(起: 字符串, 止: 字符串, 元路径JSON: 字符串, 阻尼: 浮点数) : 浮点数 {
    返回 度加权路径计数(自身.句柄, 起, 止, 元路径JSON, 阻尼);
}
公开 函数 (自身 图库) ReFeX() : 字符串 { 返回 ReFeX(自身.句柄); }
公开 函数 (自身 图库) ReFeX(轮数: 整数) : 字符串 { 返回 ReFeX(自身.句柄, 轮数); }
