// qi-graph · 本体 —— 类 / 属性 / 个体 / 三元组，全部落成 qi-kv 里 `o:` 前缀的键
//
// 底层统一表示是三元组 (主语, 谓词, 宾语)。类、属性、个体的断言最终都落成三元组：
//   rdf:type          → 类型是      rdfs:subClassOf    → 父类是
//   rdfs:subPropertyOf→ 父属性是    rdfs:domain/range  → 定义域 / 值域
//
// ── 键空间（全部 `o:` 前缀，段用 `:` 分隔，所以名字里不能有 `:`）──────────
//   o:spo:<主>:<谓>:<宾键>   "1"=断言；否则是一段 JSON（推出来的：规则 + 前提）
//   o:pos:<谓>:<宾键>:<主>   同上，反向标记
//   o:s:<主>                 该主语全部三元组的 JSON 数组 [{"p","o",("inferred":1)}]
//   o:o:<宾键>               以它为宾语的全部三元组 [{"s","p",("inferred":1)}]（只收个体宾语）
//   o:c:<类>                 {"name","comment"}        父类走 父类是 三元组，不双写
//   o:p:<属性>               {"name","domain","range","functional","transitive","symmetric","inverse","parent"}
//   o:i:<个体>               {"id","types":[…直接类型…]}
//
// 宾语两种形状：{"iri":"个体"} 或 {"lit":"值","dt":"字符串|整数|浮点数|布尔"}。
// 键里字面量写成 `lit=<值>`，所以个体 id 不许以 `lit=` 开头。
//
// 邻接查询（按主语 / 按宾语）一律 O(1) 拿 o:s / o:o 那一条；前缀列键 是 O(全部槽) 的
// 线性扫，只留给「列出所有类」这种全局枚举。

包 Graph;

导入 标准库.字符串;
导入 标准库.JSON;
导入 标准库.列表 作为 表列;
导入 标准库.哈希表;
导入 标准库.字节切片;
导入 KV::{打开, 关闭, 放, 取, 存在, 删, 可用, 前缀列键, 开始缓写, 刷盘};

// ── 谓词常量 ──────────────────────────────────────────────────────

公开 函数 谓_类型是() : 字符串 { 返回 "类型是"; }
公开 函数 谓_父类是() : 字符串 { 返回 "父类是"; }
公开 函数 谓_父属性是() : 字符串 { 返回 "父属性是"; }
公开 函数 谓_定义域() : 字符串 { 返回 "定义域"; }
公开 函数 谓_值域() : 字符串 { 返回 "值域"; }

公开 函数 是字面量类型(名: 字符串) : 整数 {
    如果 (名 == "字符串" 或 名 == "整数" 或 名 == "浮点数" 或 名 == "布尔") { 返回 1; }
    返回 0;
}

公开 函数 是模式谓词(谓: 字符串) : 整数 {
    如果 (谓 == "类型是" 或 谓 == "父类是" 或 谓 == "父属性是" 或 谓 == "定义域" 或 谓 == "值域") { 返回 1; }
    返回 0;
}

// ── 打开 / 关闭 ───────────────────────────────────────────────────

公开 函数 打开本体(路径: 字符串) : 整数 { 返回 打开(路径); }
公开 函数 关闭本体(本: 整数) : 整数 { 返回 关闭(本); }
公开 函数 本体可用(本: 整数) : 整数 { 返回 可用(本); }
// 批量灌数据时开缓写（透传 qi-kv），结束 本体刷盘
公开 函数 本体开始缓写(本: 整数) : 整数 { 返回 开始缓写(本); }
公开 函数 本体刷盘(本: 整数) : 整数 { 返回 刷盘(本); }

// 名字不能空、不能含 `:`（键的分段符）、不能以 `lit=` 开头（字面量的键前缀）
公开 函数 名字合法(名: 字符串) : 整数 {
    如果 (字符串::字节长度(名) == 0) { 返回 0; }
    如果 (字符串::包含(名, ":") == 1) { 返回 0; }
    如果 (字符串::开始于(名, "lit=") == 1) { 返回 0; }
    返回 1;
}

// ── 键 ────────────────────────────────────────────────────────────

函数 本_键spo(主: 字符串, 谓: 字符串, 宾键: 字符串) : 字符串 { 返回 "o:spo:" + 主 + ":" + 谓 + ":" + 宾键; }
函数 本_键pos(主: 字符串, 谓: 字符串, 宾键: 字符串) : 字符串 { 返回 "o:pos:" + 谓 + ":" + 宾键 + ":" + 主; }
函数 本_键s(主: 字符串) : 字符串 { 返回 "o:s:" + 主; }
函数 本_键o(宾键: 字符串) : 字符串 { 返回 "o:o:" + 宾键; }

// 宾语对象 → 键里用的宾键：个体就是 id，字面量是 lit=<值>
公开 函数 宾键(宾对象: 整数) : 字符串 {
    如果 (JSON.是否包含键(宾对象, "iri") == 1) { 返回 JSON.获取字符串(宾对象, "iri"); }
    返回 "lit=" + JSON.获取字符串(宾对象, "lit");
}

// 邻接条目的宾键（条目 = {"p","o"}）
公开 函数 条目宾键(条目: 整数) : 字符串 {
    变量 o: 整数 = JSON.获取对象(条目, "o");
    如果 (o == 0) { 返回 ""; }
    变量 k: 字符串 = 宾键(o);
    JSON.删除(o);
    返回 k;
}

// 宾键 → 给人看的宾语：个体原样，字面量去掉 lit=
公开 函数 宾键显示(宾键值: 字符串) : 字符串 {
    如果 (字符串::开始于(宾键值, "lit=") == 1) { 返回 字符串::子串从位置(宾键值, 4); }
    返回 宾键值;
}

函数 本_读数组(本: 整数, 键: 字符串) : 整数 {
    变量 文: 字符串 = 取(本, 键);
    如果 (字符串::字节长度(文) == 0) { 返回 JSON.创建数组(); }
    变量 h: 整数 = JSON.解码(文);
    如果 (h == 0) { 返回 JSON.创建数组(); }
    返回 h;
}

函数 本_写数组(本: 整数, 键: 字符串, 数组句柄: 整数) : 整数 {
    如果 (JSON.数组长度(数组句柄) == 0) { 返回 删(本, 键); }
    返回 放(本, 键, JSON.转字符串(数组句柄));
}

// 某主语的全部三元组：返回 JSON 数组句柄（[{"p","o",("inferred":1)}]），归调用方，用完 JSON.删除
公开 函数 邻接(本: 整数, 主: 字符串) : 整数 {
    如果 (可用(本) == 0) { 返回 JSON.创建数组(); }
    返回 本_读数组(本, 本_键s(主));
}

// ── 三元组的增删（内部统一入口）─────────────────────────────────

// 标记 "1" = 断言；其它非空串 = 推出来的（是一段 JSON：规则 + 前提）。
// 返回 1 = 新写入；0 = 早就有了（断言盖过推出会先拆掉再重放，算 1）
函数 本_加(本: 整数, 主: 字符串, 谓: 字符串, 宾对象: 整数, 标记: 字符串) : 整数 {
    变量 宾键值: 字符串 = 宾键(宾对象);
    变量 spo: 字符串 = 本_键spo(主, 谓, 宾键值);
    变量 旧: 字符串 = 取(本, spo);
    如果 (旧 == "1") { 返回 0; }
    如果 (字符串::字节长度(旧) > 0) {
        如果 (标记 != "1") { 返回 0; }
        本_删(本, 主, 谓, 宾键值);
    }
    放(本, spo, 标记);
    放(本, 本_键pos(主, 谓, 宾键值), 标记);
    变量 是推出: 整数 = 0;
    如果 (标记 != "1") { 是推出 = 1; }

    变量 正: 整数 = 本_读数组(本, 本_键s(主));
    变量 条: 整数 = JSON.创建对象();
    JSON.设置字符串(条, "p", 谓);
    JSON.设置对象(条, "o", 宾对象);
    如果 (是推出 == 1) { JSON.设置整数(条, "inferred", 1); }
    JSON.数组添加对象(正, 条);
    JSON.删除(条);
    本_写数组(本, 本_键s(主), 正);
    JSON.删除(正);

    如果 (JSON.是否包含键(宾对象, "iri") == 1) {
        变量 反: 整数 = 本_读数组(本, 本_键o(宾键值));
        变量 反条: 整数 = JSON.创建对象();
        JSON.设置字符串(反条, "s", 主);
        JSON.设置字符串(反条, "p", 谓);
        如果 (是推出 == 1) { JSON.设置整数(反条, "inferred", 1); }
        JSON.数组添加对象(反, 反条);
        JSON.删除(反条);
        本_写数组(本, 本_键o(宾键值), 反);
        JSON.删除(反);
        如果 (谓 == 谓_类型是()) { 本_个体加类型(本, 主, 宾键值); }
    }
    返回 1;
}

函数 本_删(本: 整数, 主: 字符串, 谓: 字符串, 宾键值: 字符串) : 整数 {
    变量 spo: 字符串 = 本_键spo(主, 谓, 宾键值);
    如果 (存在(本, spo) == 0) { 返回 0; }
    删(本, spo);
    删(本, 本_键pos(主, 谓, 宾键值));

    变量 正: 整数 = 本_读数组(本, 本_键s(主));
    变量 新正: 整数 = JSON.创建数组();
    变量 n: 整数 = JSON.数组长度(正);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 条: 整数 = JSON.数组获取对象(正, i);
        如果 (非 (JSON.获取字符串(条, "p") == 谓 与 条目宾键(条) == 宾键值)) {
            JSON.数组添加对象(新正, 条);
        }
        JSON.删除(条);
        i = i + 1;
    }
    本_写数组(本, 本_键s(主), 新正);
    JSON.删除(新正);
    JSON.删除(正);

    如果 (字符串::开始于(宾键值, "lit=") == 0) {
        变量 反: 整数 = 本_读数组(本, 本_键o(宾键值));
        变量 新反: 整数 = JSON.创建数组();
        变量 m: 整数 = JSON.数组长度(反);
        变量 j: 整数 = 0;
        当 (j < m) {
            变量 反条: 整数 = JSON.数组获取对象(反, j);
            如果 (非 (JSON.获取字符串(反条, "s") == 主 与 JSON.获取字符串(反条, "p") == 谓)) {
                JSON.数组添加对象(新反, 反条);
            }
            JSON.删除(反条);
            j = j + 1;
        }
        本_写数组(本, 本_键o(宾键值), 新反);
        JSON.删除(新反);
        JSON.删除(反);
        如果 (谓 == 谓_类型是()) { 本_个体去类型(本, 主, 宾键值); }
    }
    返回 1;
}

// ── 个体记录 o:i ──────────────────────────────────────────────────

函数 本_个体读(本: 整数, id: 字符串) : 整数 {
    变量 文: 字符串 = 取(本, "o:i:" + id);
    如果 (字符串::字节长度(文) > 0) {
        变量 h: 整数 = JSON.解码(文);
        如果 (h != 0) { 返回 h; }
    }
    变量 新: 整数 = JSON.创建对象();
    JSON.设置字符串(新, "id", id);
    变量 空表: 整数 = JSON.创建数组();
    JSON.设置数组(新, "types", 空表);
    JSON.删除(空表);
    返回 新;
}

函数 本_个体写(本: 整数, id: 字符串, 对象: 整数) : 整数 {
    返回 放(本, "o:i:" + id, JSON.转字符串(对象));
}

函数 本_个体加类型(本: 整数, id: 字符串, 类: 字符串) : 整数 {
    变量 个: 整数 = 本_个体读(本, id);
    变量 类们: 整数 = JSON.获取数组(个, "types");
    如果 (类们 == 0) { 类们 = JSON.创建数组(); }
    变量 n: 整数 = JSON.数组长度(类们);
    变量 i: 整数 = 0;
    变量 有: 整数 = 0;
    当 (i < n) {
        如果 (JSON.数组获取字符串(类们, i) == 类) { 有 = 1; }
        i = i + 1;
    }
    如果 (有 == 0) {
        JSON.数组添加字符串(类们, 类);
        JSON.设置数组(个, "types", 类们);
        本_个体写(本, id, 个);
    } 否则 如果 (存在(本, "o:i:" + id) == 0) {
        本_个体写(本, id, 个);
    }
    JSON.删除(类们);
    JSON.删除(个);
    返回 1;
}

函数 本_个体去类型(本: 整数, id: 字符串, 类: 字符串) : 整数 {
    如果 (存在(本, "o:i:" + id) == 0) { 返回 0; }
    变量 个: 整数 = 本_个体读(本, id);
    变量 类们: 整数 = JSON.获取数组(个, "types");
    变量 新: 整数 = JSON.创建数组();
    变量 n: 整数 = JSON.数组长度(类们);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 t: 字符串 = JSON.数组获取字符串(类们, i);
        如果 (t != 类) { JSON.数组添加字符串(新, t); }
        i = i + 1;
    }
    JSON.设置数组(个, "types", 新);
    本_个体写(本, id, 个);
    JSON.删除(新);
    JSON.删除(类们);
    JSON.删除(个);
    返回 1;
}

// ── 类 ────────────────────────────────────────────────────────────

公开 函数 定义类(本: 整数, 名: 字符串) : 整数 { 返回 定义类(本, 名, ""); }

// 父类可以为空；多次调用同一个类给不同父类 = 多继承
公开 函数 定义类(本: 整数, 名: 字符串, 父类: 字符串) : 整数 {
    如果 (可用(本) == 0 或 名字合法(名) == 0) { 返回 0; }
    如果 (存在(本, "o:c:" + 名) == 0) {
        变量 定: 整数 = JSON.创建对象();
        JSON.设置字符串(定, "name", 名);
        JSON.设置字符串(定, "comment", "");
        放(本, "o:c:" + 名, JSON.转字符串(定));
        JSON.删除(定);
    }
    如果 (字符串::字节长度(父类) > 0) {
        如果 (名字合法(父类) == 0) { 返回 0; }
        断言(本, 名, 谓_父类是(), 父类);
    }
    返回 1;
}

公开 函数 类存在(本: 整数, 名: 字符串) : 整数 {
    如果 (可用(本) == 0) { 返回 0; }
    返回 存在(本, "o:c:" + 名);
}

公开 函数 类注释(本: 整数, 名: 字符串, 注释: 字符串) : 整数 {
    如果 (类存在(本, 名) == 0) { 返回 0; }
    变量 定: 整数 = JSON.解码(取(本, "o:c:" + 名));
    如果 (定 == 0) { 返回 0; }
    JSON.设置字符串(定, "comment", 注释);
    放(本, "o:c:" + 名, JSON.转字符串(定));
    JSON.删除(定);
    返回 1;
}

// {"name","comment","parents":[…]}；没有这个类返回空串
公开 函数 类定义(本: 整数, 名: 字符串) : 字符串 {
    如果 (类存在(本, 名) == 0) { 返回 ""; }
    变量 定: 整数 = JSON.解码(取(本, "o:c:" + 名));
    如果 (定 == 0) { 返回 ""; }
    变量 父们: 整数 = 父类(本, 名);
    变量 父数组: 整数 = 字符串列表转JSON数组(父们);
    JSON.设置数组(定, "parents", 父数组);
    变量 文: 字符串 = JSON.转字符串(定);
    JSON.删除(父数组);
    表列::删除列表(父们);
    JSON.删除(定);
    返回 文;
}

// 直接父类（不含继承），返回字符串列表句柄，归调用方
公开 函数 父类(本: 整数, 类: 字符串) : 整数 { 返回 值(本, 类, 谓_父类是()); }
// 直接子类
公开 函数 子类(本: 整数, 类: 字符串) : 整数 { 返回 主语(本, 谓_父类是(), 类); }
// 全部类名，字典序
公开 函数 列出类(本: 整数) : 整数 { 返回 本_列前缀(本, "o:c:"); }

// ── 属性 ──────────────────────────────────────────────────────────

公开 函数 定义属性(本: 整数, 名: 字符串, 定义域: 字符串, 值域: 字符串) : 整数 {
    返回 定义属性(本, 名, 定义域, 值域, "");
}

// 选项 JSON 的键：functional / transitive / symmetric（1 或 true）、inverse / parent（属性名）。
// 也认中文别名 函数性 / 传递 / 对称 / 逆属性 / 父属性。
公开 函数 定义属性(本: 整数, 名: 字符串, 定义域: 字符串, 值域: 字符串, 选项文本: 字符串) : 整数 {
    如果 (可用(本) == 0 或 名字合法(名) == 0) { 返回 0; }
    如果 (字符串::字节长度(定义域) > 0 与 名字合法(定义域) == 0) { 返回 0; }
    如果 (字符串::字节长度(值域) > 0 与 名字合法(值域) == 0) { 返回 0; }
    变量 选: 整数 = 0;
    如果 (字符串::字节长度(选项文本) > 0) { 选 = JSON.解码(选项文本); }

    变量 定: 整数 = JSON.创建对象();
    JSON.设置字符串(定, "name", 名);
    JSON.设置字符串(定, "domain", 定义域);
    JSON.设置字符串(定, "range", 值域);
    JSON.设置整数(定, "functional", 本_选项开关(选, "functional", "函数性"));
    JSON.设置整数(定, "transitive", 本_选项开关(选, "transitive", "传递"));
    JSON.设置整数(定, "symmetric", 本_选项开关(选, "symmetric", "对称"));
    变量 逆: 字符串 = 本_选项文本(选, "inverse", "逆属性");
    变量 父: 字符串 = 本_选项文本(选, "parent", "父属性");
    如果 (选 != 0) { JSON.删除(选); }
    // 别人先定义时把我登记成了它的逆属性，这边没写也要认
    如果 (字符串::字节长度(逆) == 0) { 逆 = 本_谁的逆是(本, 名); }
    JSON.设置字符串(定, "inverse", 逆);
    JSON.设置字符串(定, "parent", 父);
    放(本, "o:p:" + 名, JSON.转字符串(定));
    JSON.删除(定);

    如果 (字符串::字节长度(定义域) > 0) { 断言(本, 名, 谓_定义域(), 定义域); }
    如果 (字符串::字节长度(值域) > 0) { 断言(本, 名, 谓_值域(), 值域); }
    如果 (字符串::字节长度(父) > 0) { 断言(本, 名, 谓_父属性是(), 父); }
    如果 (字符串::字节长度(逆) > 0 与 属性存在(本, 逆) == 1) { 本_设属性文本(本, 逆, "inverse", 名); }
    返回 1;
}

函数 本_选项开关(选: 整数, 英: 字符串, 中: 字符串) : 整数 {
    如果 (选 == 0) { 返回 0; }
    变量 v: 字符串 = "";
    如果 (JSON.是否包含键(选, 英) == 1) { v = JSON.取显示值(选, 英); }
    否则 如果 (JSON.是否包含键(选, 中) == 1) { v = JSON.取显示值(选, 中); }
    如果 (v == "1" 或 v == "真" 或 v == "true") { 返回 1; }
    返回 0;
}

函数 本_选项文本(选: 整数, 英: 字符串, 中: 字符串) : 字符串 {
    如果 (选 == 0) { 返回 ""; }
    如果 (JSON.是否包含键(选, 英) == 1) { 返回 JSON.获取字符串(选, 英); }
    如果 (JSON.是否包含键(选, 中) == 1) { 返回 JSON.获取字符串(选, 中); }
    返回 "";
}

函数 本_谁的逆是(本: 整数, 名: 字符串) : 字符串 {
    变量 表: 整数 = 列出属性(本);
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 出: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 p: 字符串 = 表列::获取字符串(表, i);
        如果 (属性字符串字段(本, p, "inverse") == 名) { 出 = p; }
        i = i + 1;
    }
    表列::删除列表(表);
    返回 出;
}

函数 本_设属性文本(本: 整数, 名: 字符串, 字段: 字符串, 值文: 字符串) : 整数 {
    变量 定: 整数 = JSON.解码(取(本, "o:p:" + 名));
    如果 (定 == 0) { 返回 0; }
    JSON.设置字符串(定, 字段, 值文);
    放(本, "o:p:" + 名, JSON.转字符串(定));
    JSON.删除(定);
    返回 1;
}

公开 函数 属性存在(本: 整数, 名: 字符串) : 整数 {
    如果 (可用(本) == 0) { 返回 0; }
    返回 存在(本, "o:p:" + 名);
}

// 原样的定义 JSON；没有返回空串
公开 函数 属性定义(本: 整数, 名: 字符串) : 字符串 {
    如果 (可用(本) == 0) { 返回 ""; }
    返回 取(本, "o:p:" + 名);
}

公开 函数 属性字符串字段(本: 整数, 名: 字符串, 字段: 字符串) : 字符串 {
    变量 文: 字符串 = 属性定义(本, 名);
    如果 (字符串::字节长度(文) == 0) { 返回 ""; }
    变量 定: 整数 = JSON.解码(文);
    如果 (定 == 0) { 返回 ""; }
    变量 v: 字符串 = JSON.获取字符串(定, 字段);
    JSON.删除(定);
    返回 v;
}

公开 函数 属性整数字段(本: 整数, 名: 字符串, 字段: 字符串) : 整数 {
    变量 文: 字符串 = 属性定义(本, 名);
    如果 (字符串::字节长度(文) == 0) { 返回 0; }
    变量 定: 整数 = JSON.解码(文);
    如果 (定 == 0) { 返回 0; }
    变量 v: 整数 = JSON.获取整数(定, 字段);
    JSON.删除(定);
    返回 v;
}

公开 函数 列出属性(本: 整数) : 整数 { 返回 本_列前缀(本, "o:p:"); }

// ── 个体 ──────────────────────────────────────────────────────────

// 类可以为空（只登记个体，不给类型）
公开 函数 加个体(本: 整数, id: 字符串, 类: 字符串) : 整数 {
    如果 (可用(本) == 0 或 名字合法(id) == 0) { 返回 0; }
    如果 (字符串::字节长度(类) == 0) {
        如果 (存在(本, "o:i:" + id) == 0) {
            变量 个: 整数 = 本_个体读(本, id);
            本_个体写(本, id, 个);
            JSON.删除(个);
        }
        返回 1;
    }
    如果 (名字合法(类) == 0) { 返回 0; }
    断言(本, id, 谓_类型是(), 类);
    返回 1;
}

公开 函数 个体存在(本: 整数, id: 字符串) : 整数 {
    如果 (可用(本) == 0) { 返回 0; }
    返回 存在(本, "o:i:" + id);
}

// 直接类型（不含继承），字符串列表句柄
公开 函数 个体类型(本: 整数, id: 字符串) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    如果 (个体存在(本, id) == 0) { 返回 出; }
    变量 个: 整数 = 本_个体读(本, id);
    变量 类们: 整数 = JSON.获取数组(个, "types");
    变量 n: 整数 = JSON.数组长度(类们);
    变量 i: 整数 = 0;
    当 (i < n) {
        表列::添加字符串(出, JSON.数组获取字符串(类们, i));
        i = i + 1;
    }
    JSON.删除(类们);
    JSON.删除(个);
    返回 出;
}

公开 函数 列出个体(本: 整数) : 整数 { 返回 本_列前缀(本, "o:i:"); }

// 直接属于该类的个体
公开 函数 按类列个体(本: 整数, 类: 字符串) : 整数 { 返回 主语(本, 谓_类型是(), 类); }

// 含子类 = 1 时把所有后代类的个体也算上（去重）
公开 函数 按类列个体(本: 整数, 类: 字符串, 含子类: 整数) : 整数 {
    如果 (含子类 == 0) { 返回 按类列个体(本, 类); }
    变量 出: 整数 = 表列::创建字符串列表();
    变量 已见: 整数 = 哈希表.创建整数表();
    变量 类们: 整数 = 传递闭包(本, 类, 谓_父类是(), 1);
    表列::添加字符串(类们, 类);
    变量 n: 整数 = 表列::字符串列表大小(类们);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 个们: 整数 = 按类列个体(本, 表列::获取字符串(类们, i));
        变量 m: 整数 = 表列::字符串列表大小(个们);
        变量 j: 整数 = 0;
        当 (j < m) {
            变量 x: 字符串 = 表列::获取字符串(个们, j);
            如果 (哈希表.包含键(已见, x) == 0) {
                哈希表.设置整数(已见, x, 1);
                表列::添加字符串(出, x);
            }
            j = j + 1;
        }
        表列::删除列表(个们);
        i = i + 1;
    }
    表列::删除列表(类们);
    哈希表.释放表(已见);
    返回 出;
}

// 删掉个体本身和所有提到它的三元组（正向 + 反向）
公开 函数 删除个体(本: 整数, id: 字符串) : 整数 {
    如果 (可用(本) == 0) { 返回 0; }
    变量 数: 整数 = 0;
    变量 正: 整数 = 邻接(本, id);
    变量 n: 整数 = JSON.数组长度(正);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 条: 整数 = JSON.数组获取对象(正, i);
        数 = 数 + 本_删(本, id, JSON.获取字符串(条, "p"), 条目宾键(条));
        JSON.删除(条);
        i = i + 1;
    }
    JSON.删除(正);
    变量 反: 整数 = 本_读数组(本, 本_键o(id));
    变量 m: 整数 = JSON.数组长度(反);
    变量 j: 整数 = 0;
    当 (j < m) {
        变量 反条: 整数 = JSON.数组获取对象(反, j);
        数 = 数 + 本_删(本, JSON.获取字符串(反条, "s"), JSON.获取字符串(反条, "p"), id);
        JSON.删除(反条);
        j = j + 1;
    }
    JSON.删除(反);
    删(本, "o:i:" + id);
    返回 数;
}

// ── 三元组 ────────────────────────────────────────────────────────

// 宾语是个体 id。返回 1 = 新写入，0 = 已有或参数非法
公开 函数 断言(本: 整数, 主: 字符串, 谓: 字符串, 宾: 字符串) : 整数 {
    如果 (可用(本) == 0 或 名字合法(主) == 0 或 名字合法(谓) == 0 或 名字合法(宾) == 0) { 返回 0; }
    变量 宾对象: 整数 = JSON.创建对象();
    JSON.设置字符串(宾对象, "iri", 宾);
    变量 r: 整数 = 本_加(本, 主, 谓, 宾对象, "1");
    JSON.删除(宾对象);
    返回 r;
}

// 数据类型：字符串 / 整数 / 浮点数 / 布尔（空串当 字符串）。值一律以文本传入
公开 函数 断言字面量(本: 整数, 主: 字符串, 谓: 字符串, 值文: 字符串, 数据类型: 字符串) : 整数 {
    如果 (可用(本) == 0 或 名字合法(主) == 0 或 名字合法(谓) == 0) { 返回 0; }
    变量 dt: 字符串 = 数据类型;
    如果 (字符串::字节长度(dt) == 0) { dt = "字符串"; }
    如果 (是字面量类型(dt) == 0) { 返回 0; }
    变量 宾对象: 整数 = JSON.创建对象();
    JSON.设置字符串(宾对象, "lit", 值文);
    JSON.设置字符串(宾对象, "dt", dt);
    变量 r: 整数 = 本_加(本, 主, 谓, 宾对象, "1");
    JSON.删除(宾对象);
    返回 r;
}

// 推理层用：宾语给对象句柄（借用），标记是解释 JSON
公开 函数 加推出三元组(本: 整数, 主: 字符串, 谓: 字符串, 宾对象: 整数, 解释文本: 字符串) : 整数 {
    如果 (可用(本) == 0 或 字符串::字节长度(解释文本) == 0 或 解释文本 == "1") { 返回 0; }
    返回 本_加(本, 主, 谓, 宾对象, 解释文本);
}

// 宾 是个体 id，或 lit=<值> 撤销字面量三元组。断言的、推出的都能撤
公开 函数 撤销(本: 整数, 主: 字符串, 谓: 字符串, 宾: 字符串) : 整数 {
    如果 (可用(本) == 0) { 返回 0; }
    返回 本_删(本, 主, 谓, 宾);
}

公开 函数 撤销字面量(本: 整数, 主: 字符串, 谓: 字符串, 值文: 字符串) : 整数 {
    返回 撤销(本, 主, 谓, "lit=" + 值文);
}

公开 函数 有三元组(本: 整数, 主: 字符串, 谓: 字符串, 宾: 字符串) : 整数 {
    如果 (可用(本) == 0) { 返回 0; }
    返回 存在(本, 本_键spo(主, 谓, 宾));
}

// "" 没有；"1" 断言；其它 = 推出来的（解释 JSON）
公开 函数 三元组标记(本: 整数, 主: 字符串, 谓: 字符串, 宾: 字符串) : 字符串 {
    如果 (可用(本) == 0) { 返回 ""; }
    返回 取(本, 本_键spo(主, 谓, 宾));
}

函数 本_收条目(出: 整数, 主: 字符串, 条: 整数) : 整数 {
    变量 t: 整数 = JSON.创建对象();
    JSON.设置字符串(t, "s", 主);
    JSON.设置字符串(t, "p", JSON.获取字符串(条, "p"));
    变量 o: 整数 = JSON.获取对象(条, "o");
    如果 (o != 0) {
        JSON.设置对象(t, "o", o);
        JSON.删除(o);
    }
    如果 (JSON.是否包含键(条, "inferred") == 1) { JSON.设置整数(t, "inferred", 1); }
    JSON.数组添加对象(出, t);
    JSON.删除(t);
    返回 1;
}

函数 本_收主语(本: 整数, 主: 字符串, 谓: 字符串, 宾: 字符串, 出: 整数) : 整数 {
    变量 邻: 整数 = 邻接(本, 主);
    变量 n: 整数 = JSON.数组长度(邻);
    变量 i: 整数 = 0;
    变量 数: 整数 = 0;
    当 (i < n) {
        变量 条: 整数 = JSON.数组获取对象(邻, i);
        变量 要: 整数 = 1;
        如果 (字符串::字节长度(谓) > 0 与 JSON.获取字符串(条, "p") != 谓) { 要 = 0; }
        如果 (要 == 1 与 字符串::字节长度(宾) > 0 与 条目宾键(条) != 宾) { 要 = 0; }
        如果 (要 == 1) { 数 = 数 + 本_收条目(出, 主, 条); }
        JSON.删除(条);
        i = i + 1;
    }
    JSON.删除(邻);
    返回 数;
}

// 三个位置任一传空串当通配。宾 是个体 id 或 lit=<值>。
// 返回 JSON 数组文本：[{"s","p","o":{"iri"}|{"lit","dt"},("inferred":1)}]
公开 函数 查(本: 整数, 主: 字符串, 谓: 字符串, 宾: 字符串) : 字符串 {
    变量 出: 整数 = JSON.创建数组();
    如果 (可用(本) == 0) {
        JSON.删除(出);
        返回 "[]";
    }
    如果 (字符串::字节长度(主) > 0) {
        本_收主语(本, 主, 谓, 宾, 出);
    } 否则 如果 (字符串::字节长度(宾) > 0 与 字符串::开始于(宾, "lit=") == 0) {
        变量 反: 整数 = 本_读数组(本, 本_键o(宾));
        变量 n: 整数 = JSON.数组长度(反);
        变量 i: 整数 = 0;
        当 (i < n) {
            变量 反条: 整数 = JSON.数组获取对象(反, i);
            变量 p: 字符串 = JSON.获取字符串(反条, "p");
            如果 (字符串::字节长度(谓) == 0 或 p == 谓) {
                变量 t: 整数 = JSON.创建对象();
                JSON.设置字符串(t, "s", JSON.获取字符串(反条, "s"));
                JSON.设置字符串(t, "p", p);
                变量 o: 整数 = JSON.创建对象();
                JSON.设置字符串(o, "iri", 宾);
                JSON.设置对象(t, "o", o);
                JSON.删除(o);
                如果 (JSON.是否包含键(反条, "inferred") == 1) { JSON.设置整数(t, "inferred", 1); }
                JSON.数组添加对象(出, t);
                JSON.删除(t);
            }
            JSON.删除(反条);
            i = i + 1;
        }
        JSON.删除(反);
    } 否则 {
        变量 主们: 整数 = 列出主语(本);
        变量 m: 整数 = 表列::字符串列表大小(主们);
        变量 j: 整数 = 0;
        当 (j < m) {
            本_收主语(本, 表列::获取字符串(主们, j), 谓, 宾, 出);
            j = j + 1;
        }
        表列::删除列表(主们);
    }
    变量 文: 字符串 = JSON.转字符串(出);
    JSON.删除(出);
    返回 文;
}

// 主语在该谓词下的全部宾语（个体 id 或字面量的值），字符串列表句柄
公开 函数 值(本: 整数, 主: 字符串, 谓: 字符串) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    变量 邻: 整数 = 邻接(本, 主);
    变量 n: 整数 = JSON.数组长度(邻);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 条: 整数 = JSON.数组获取对象(邻, i);
        如果 (JSON.获取字符串(条, "p") == 谓) {
            表列::添加字符串(出, 宾键显示(条目宾键(条)));
        }
        JSON.删除(条);
        i = i + 1;
    }
    JSON.删除(邻);
    返回 出;
}

// 以该个体为宾语、该谓词的全部主语，字符串列表句柄
公开 函数 主语(本: 整数, 谓: 字符串, 宾: 字符串) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    如果 (可用(本) == 0) { 返回 出; }
    变量 反: 整数 = 本_读数组(本, 本_键o(宾));
    变量 n: 整数 = JSON.数组长度(反);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 反条: 整数 = JSON.数组获取对象(反, i);
        如果 (JSON.获取字符串(反条, "p") == 谓) {
            表列::添加字符串(出, JSON.获取字符串(反条, "s"));
        }
        JSON.删除(反条);
        i = i + 1;
    }
    JSON.删除(反);
    返回 出;
}

// 出现过的全部主语（有三元组的），字典序。这是一次全局扫
公开 函数 列出主语(本: 整数) : 整数 { 返回 本_列前缀(本, "o:s:"); }

公开 函数 三元组数(本: 整数) : 整数 {
    变量 主们: 整数 = 列出主语(本);
    变量 n: 整数 = 表列::字符串列表大小(主们);
    变量 和: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 邻: 整数 = 邻接(本, 表列::获取字符串(主们, i));
        和 = 和 + JSON.数组长度(邻);
        JSON.删除(邻);
        i = i + 1;
    }
    表列::删除列表(主们);
    返回 和;
}

// 沿某谓词走到底的传递闭包（不含起点自己；带环也停）。
// 逆向 = 0 顺着 主→宾 走（祖先），= 1 逆着 宾→主 走（后代）
公开 函数 传递闭包(本: 整数, 起点: 字符串, 谓: 字符串, 逆向: 整数) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    变量 队: 整数 = 表列::创建字符串列表();
    变量 已见: 整数 = 哈希表.创建整数表();
    哈希表.设置整数(已见, 起点, 1);
    表列::添加字符串(队, 起点);
    变量 头: 整数 = 0;
    当 (头 < 表列::字符串列表大小(队)) {
        变量 当前: 字符串 = 表列::获取字符串(队, 头);
        头 = 头 + 1;
        变量 邻: 整数 = 0;
        如果 (逆向 == 0) { 邻 = 值(本, 当前, 谓); } 否则 { 邻 = 主语(本, 谓, 当前); }
        变量 n: 整数 = 表列::字符串列表大小(邻);
        变量 i: 整数 = 0;
        当 (i < n) {
            变量 x: 字符串 = 表列::获取字符串(邻, i);
            如果 (哈希表.包含键(已见, x) == 0) {
                哈希表.设置整数(已见, x, 1);
                表列::添加字符串(出, x);
                表列::添加字符串(队, x);
            }
            i = i + 1;
        }
        表列::删除列表(邻);
    }
    表列::删除列表(队);
    哈希表.释放表(已见);
    返回 出;
}

// ── 列表工具 ──────────────────────────────────────────────────────

// 某前缀下的全部键去掉前缀，字典序。O(全部槽) 的线性扫
函数 本_列前缀(本: 整数, 前缀: 字符串) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    如果 (可用(本) == 0) { 返回 出; }
    变量 键们: 整数 = 前缀列键(本, 前缀);
    变量 长: 整数 = 字符串::字节长度(前缀);
    变量 n: 整数 = 表列::字符串列表大小(键们);
    变量 i: 整数 = 0;
    当 (i < n) {
        表列::添加字符串(出, 字符串::子串从位置(表列::获取字符串(键们, i), 长));
        i = i + 1;
    }
    表列::删除列表(键们);
    变量 有序: 整数 = 排序字符串列表(出);
    表列::删除列表(出);
    返回 有序;
}

// 字节序比较：-1 / 0 / 1（标准库没有字符串比较，借 字节切片 一用）
公开 函数 比较字符串(a: 字符串, b: 字符串) : 整数 {
    变量 x: 整数 = 字节切片::从字符串(a);
    变量 y: 整数 = 字节切片::从字符串(b);
    变量 r: 整数 = 字节切片::比较(x, y);
    字节切片::释放切片(x);
    字节切片::释放切片(y);
    返回 r;
}

// 归并排序，返回**新列表**（原列表不动，两个都归调用方）
公开 函数 排序字符串列表(表: 整数) : 整数 {
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 出: 整数 = 表列::创建字符串列表();
    如果 (n <= 1) {
        如果 (n == 1) { 表列::添加字符串(出, 表列::获取字符串(表, 0)); }
        返回 出;
    }
    变量 中: 整数 = n / 2;
    变量 左: 整数 = 表列::创建字符串列表();
    变量 右: 整数 = 表列::创建字符串列表();
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (i < 中) { 表列::添加字符串(左, 表列::获取字符串(表, i)); }
        否则 { 表列::添加字符串(右, 表列::获取字符串(表, i)); }
        i = i + 1;
    }
    变量 左序: 整数 = 排序字符串列表(左);
    变量 右序: 整数 = 排序字符串列表(右);
    表列::删除列表(左);
    表列::删除列表(右);
    变量 a: 整数 = 0;
    变量 b: 整数 = 0;
    变量 na: 整数 = 表列::字符串列表大小(左序);
    变量 nb: 整数 = 表列::字符串列表大小(右序);
    当 (a < na 或 b < nb) {
        如果 (b >= nb) {
            表列::添加字符串(出, 表列::获取字符串(左序, a));
            a = a + 1;
        } 否则 如果 (a >= na) {
            表列::添加字符串(出, 表列::获取字符串(右序, b));
            b = b + 1;
        } 否则 如果 (比较字符串(表列::获取字符串(左序, a), 表列::获取字符串(右序, b)) <= 0) {
            表列::添加字符串(出, 表列::获取字符串(左序, a));
            a = a + 1;
        } 否则 {
            表列::添加字符串(出, 表列::获取字符串(右序, b));
            b = b + 1;
        }
    }
    表列::删除列表(左序);
    表列::删除列表(右序);
    返回 出;
}

公开 函数 字符串列表转JSON数组(表: 整数) : 整数 {
    变量 出: 整数 = JSON.创建数组();
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 i: 整数 = 0;
    当 (i < n) {
        JSON.数组添加字符串(出, 表列::获取字符串(表, i));
        i = i + 1;
    }
    返回 出;
}

公开 函数 字符串列表含(表: 整数, x: 字符串) : 整数 {
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (表列::获取字符串(表, i) == x) { 返回 1; }
        i = i + 1;
    }
    返回 0;
}

// 调试 / CLI 用：把字符串列表读成一行
公开 函数 字符串列表连成行(表: 整数, 分隔: 字符串) : 字符串 {
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 出: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (i > 0) { 出 = 出 + 分隔; }
        出 = 出 + 表列::获取字符串(表, i);
        i = i + 1;
    }
    返回 出;
}

// ── 链式：本体库 ──────────────────────────────────────────────────
//
// 结构体只装一个 qi-kv 句柄，复制安全；自由函数是本体，方法是一行转发。
// 推理 / 导入导出 的方法在各自模块里补（推理.qi / 本体导入导出.qi）。

公开 类型 本体库 {
    句柄: 整数,
}

公开 函数 开本体(路径: 字符串) : 本体库 {
    返回 新建 本体库 { 句柄: 打开本体(路径) };
}

公开 函数 (自身 本体库) 可用() : 整数 { 返回 本体可用(自身.句柄); }
公开 函数 (自身 本体库) 关() : 整数 { 返回 关闭本体(自身.句柄); }
公开 函数 (自身 本体库) 开始缓写() : 本体库 { 本体开始缓写(自身.句柄); 返回 自身; }
公开 函数 (自身 本体库) 刷盘() : 本体库 { 本体刷盘(自身.句柄); 返回 自身; }

公开 函数 (自身 本体库) 定义类(名: 字符串) : 本体库 { 定义类(自身.句柄, 名); 返回 自身; }
公开 函数 (自身 本体库) 定义类(名: 字符串, 父类: 字符串) : 本体库 { 定义类(自身.句柄, 名, 父类); 返回 自身; }
公开 函数 (自身 本体库) 类注释(名: 字符串, 注释: 字符串) : 本体库 { 类注释(自身.句柄, 名, 注释); 返回 自身; }
公开 函数 (自身 本体库) 定义属性(名: 字符串, 定义域: 字符串, 值域: 字符串) : 本体库 {
    定义属性(自身.句柄, 名, 定义域, 值域);
    返回 自身;
}
公开 函数 (自身 本体库) 定义属性(名: 字符串, 定义域: 字符串, 值域: 字符串, 选项文本: 字符串) : 本体库 {
    定义属性(自身.句柄, 名, 定义域, 值域, 选项文本);
    返回 自身;
}
公开 函数 (自身 本体库) 加个体(id: 字符串, 类: 字符串) : 本体库 { 加个体(自身.句柄, id, 类); 返回 自身; }
公开 函数 (自身 本体库) 删除个体(id: 字符串) : 本体库 { 删除个体(自身.句柄, id); 返回 自身; }
公开 函数 (自身 本体库) 断言(主: 字符串, 谓: 字符串, 宾: 字符串) : 本体库 { 断言(自身.句柄, 主, 谓, 宾); 返回 自身; }
公开 函数 (自身 本体库) 断言字面量(主: 字符串, 谓: 字符串, 值文: 字符串, 数据类型: 字符串) : 本体库 {
    断言字面量(自身.句柄, 主, 谓, 值文, 数据类型);
    返回 自身;
}
公开 函数 (自身 本体库) 撤销(主: 字符串, 谓: 字符串, 宾: 字符串) : 本体库 { 撤销(自身.句柄, 主, 谓, 宾); 返回 自身; }

公开 函数 (自身 本体库) 类存在(名: 字符串) : 整数 { 返回 类存在(自身.句柄, 名); }
公开 函数 (自身 本体库) 类定义(名: 字符串) : 字符串 { 返回 类定义(自身.句柄, 名); }
公开 函数 (自身 本体库) 父类(类: 字符串) : 整数 { 返回 父类(自身.句柄, 类); }
公开 函数 (自身 本体库) 子类(类: 字符串) : 整数 { 返回 子类(自身.句柄, 类); }
公开 函数 (自身 本体库) 列出类() : 整数 { 返回 列出类(自身.句柄); }
公开 函数 (自身 本体库) 属性存在(名: 字符串) : 整数 { 返回 属性存在(自身.句柄, 名); }
公开 函数 (自身 本体库) 属性定义(名: 字符串) : 字符串 { 返回 属性定义(自身.句柄, 名); }
公开 函数 (自身 本体库) 列出属性() : 整数 { 返回 列出属性(自身.句柄); }
