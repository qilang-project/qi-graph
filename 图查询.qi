// qi-graph · 图查询 —— 模式匹配与属性过滤
//
// 模式是三元组列表，`?x` 是变量，其余是常量（节点 id / 边类型；边类型空串 = 任意）：
//
//   [{"from":"?a","type":"认识","to":"?b"},
//    {"from":"?b","type":"住在","to":"成都"}]
//
// 也可以带过滤：
//
//   {"match":[…], "where":{"?a.props.年龄":{">":30}, "?a.labels":{"包含":"员工"}}}
//
// 求解是最朴素的回溯：按三元组顺序，已绑定的一端顺着邻接表往另一端走；
// 两端都没绑定时才走边类型索引（类型也不定时走全边前缀扫 —— 这是唯一会扫全库的分支，
// 把带常量的三元组放前面就能避开）。绑定放在一张哈希表里，回溯就是删键。
//
// 结果是 JSON 数组文本，每个元素是一组变量绑定：[{"?a":"张三","?b":"李四"}, …]

包 Graph;

导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 标准库.哈希表;
导入 KV::{可用};
导入 Graph.图::{图库, 键_出, 键_入, 键_边, 键_节点, 读JSON, 数组含字符串, 按类型列边, 列全部边, 按标签列节点};

// ── 入口 ──────────────────────────────────────────────────────────

公开 函数 模式匹配(图: 整数, 模式JSON: 字符串) : 字符串 {
    变量 出: 整数 = J.创建数组();
    如果 (可用(图) == 1) {
        求解入口(图, 模式JSON, 出);
    }
    变量 文本: 字符串 = J.转字符串(出);
    J.删除(出);
    返回 文本;
}

// 只要解的个数
公开 函数 模式匹配数(图: 整数, 模式JSON: 字符串) : 整数 {
    变量 出: 整数 = J.创建数组();
    如果 (可用(图) == 1) {
        求解入口(图, 模式JSON, 出);
    }
    变量 n: 整数 = J.数组长度(出);
    J.删除(出);
    返回 n;
}

// 带标签的节点里，属性满足条件的那些。条件形如 {"年龄":{">":30},"城市":{"=":"成都"}}
// （键直接是属性名；也接受 "props.年龄" / "id" / "labels"）。返回节点 id 列表句柄。
公开 函数 过滤节点(图: 整数, 标签: 字符串, 条件JSON: 字符串) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    如果 (可用(图) == 0) {
        返回 出;
    }
    变量 条件: 整数 = J.解码(条件JSON);
    变量 候选: 整数 = 按标签列节点(图, 标签);
    变量 n: 整数 = 表列::字符串列表大小(候选);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 id: 字符串 = 表列::获取字符串(候选, i);
        如果 (条件 <= 0 或 节点满足(图, id, 条件) == 1) {
            表列::添加字符串(出, id);
        }
        i = i + 1;
    }
    表列::删除列表(候选);
    如果 (条件 > 0) {
        J.删除(条件);
    }
    返回 出;
}

// ── 求解 ──────────────────────────────────────────────────────────

函数 求解入口(图: 整数, 模式JSON: 字符串, 出: 整数) : 整数 {
    变量 净: 字符串 = 字符串::去空白(模式JSON);
    变量 三元组: 整数 = 0;
    变量 条件: 整数 = 0;
    变量 根: 整数 = 0;
    如果 (字符串::开始于(净, "[") == 1) {
        三元组 = J.解码(净);
    } 否则 {
        根 = J.解码(净);
        如果 (根 > 0) {
            三元组 = J.获取数组(根, "match");
            如果 (三元组 <= 0) {
                三元组 = J.获取数组(根, "pattern");
            }
            条件 = J.获取对象(根, "where");
        }
    }
    如果 (三元组 > 0) {
        变量 n: 整数 = J.数组长度(三元组);
        变量 名单: 整数 = 表列::创建字符串列表();
        收集变元名(三元组, n, 名单);
        变量 绑定: 整数 = 哈希表::创建字符串表();
        回溯(图, 三元组, 0, n, 名单, 绑定, 条件, 出);
        哈希表::释放表(绑定);
        表列::删除列表(名单);
        J.删除(三元组);
    }
    如果 (条件 > 0) {
        J.删除(条件);
    }
    如果 (根 > 0) {
        J.删除(根);
    }
    返回 1;
}

函数 是变量(s: 字符串) : 整数 { 返回 字符串::开始于(s, "?"); }

// 绑定表是 哈希表 字符串表（变元名 → 节点 id / 边类型）；没绑返回空串
//（节点 id 和边类型都非空，所以空串可以当哨兵）。回溯就是 删除键。
函数 查绑定(绑定: 整数, 名: 字符串) : 字符串 {
    如果 (哈希表::包含键(绑定, 名) == 0) {
        返回 "";
    }
    返回 哈希表::获取字符串(绑定, 名);
}

// 收集模式里出现的变元名（按首次出现顺序），结果对象的键序就靠它稳定
函数 收集变元名(三元组: 整数, n: 整数, 名单: 整数) : 整数 {
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 t: 整数 = J.数组获取对象(三元组, i);
        如果 (t > 0) {
            记变元名(J.获取字符串(t, "from"), 名单);
            记变元名(J.获取字符串(t, "type"), 名单);
            记变元名(J.获取字符串(t, "to"), 名单);
            J.删除(t);
        }
        i = i + 1;
    }
    返回 表列::字符串列表大小(名单);
}

函数 记变元名(s: 字符串, 名单: 整数) : 整数 {
    如果 (是变量(s) == 0) {
        返回 0;
    }
    变量 n: 整数 = 表列::字符串列表大小(名单);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (表列::获取字符串(名单, i) == s) {
            返回 0;
        }
        i = i + 1;
    }
    表列::添加字符串(名单, s);
    返回 1;
}

// 模式串 与 实际值 对得上吗：变量看绑定（没绑就绑上），常量直接比；空串常量只对边类型放行。
// 返回 1 = 对上且新绑了，0 = 对上没新绑，-1 = 对不上
函数 对一项(模式: 字符串, 实际: 字符串, 可空: 整数, 绑定: 整数) : 整数 {
    如果 (是变量(模式) == 1) {
        变量 已: 字符串 = 查绑定(绑定, 模式);
        如果 (字符串::字节长度(已) == 0) {
            哈希表::设置字符串(绑定, 模式, 实际);
            返回 1;
        }
        如果 (已 == 实际) {
            返回 0;
        }
        返回 -1;
    }
    如果 (可空 == 1 与 字符串::字节长度(模式) == 0) {
        返回 0;
    }
    如果 (模式 == 实际) {
        返回 0;
    }
    返回 -1;
}

// 用一条边去套一个三元组。返回新绑定的位掩码（1 = from，2 = type，4 = to）；
// 对不上返回 -1（此时已把新绑的撤回）。三项按 from → type → to 顺序试，
// 所以同一个变量出现两次（?a 认识 ?a）也对。
函数 套边(边: 整数, 从: 字符串, 类型模式: 字符串, 至: 字符串, 绑定: 整数) : 整数 {
    变量 掩码: 整数 = 0;
    变量 r: 整数 = 对一项(从, J.获取字符串(边, "from"), 0, 绑定);
    如果 (r < 0) {
        返回 -1;
    }
    掩码 = 掩码 + r;
    r = 对一项(类型模式, J.获取字符串(边, "type"), 1, 绑定);
    如果 (r < 0) {
        撤回(绑定, 掩码, 从, 类型模式, 至);
        返回 -1;
    }
    掩码 = 掩码 + r * 2;
    r = 对一项(至, J.获取字符串(边, "to"), 0, 绑定);
    如果 (r < 0) {
        撤回(绑定, 掩码, 从, 类型模式, 至);
        返回 -1;
    }
    返回 掩码 + r * 4;
}

函数 撤回(绑定: 整数, 掩码: 整数, 从: 字符串, 类型模式: 字符串, 至: 字符串) : 整数 {
    如果 (掩码 % 2 == 1) {
        哈希表::删除键(绑定, 从);
    }
    如果 ((掩码 / 2) % 2 == 1) {
        哈希表::删除键(绑定, 类型模式);
    }
    如果 ((掩码 / 4) % 2 == 1) {
        哈希表::删除键(绑定, 至);
    }
    返回 1;
}

函数 回溯(图: 整数, 三元组: 整数, i: 整数, n: 整数, 名单: 整数, 绑定: 整数, 条件: 整数, 出: 整数) : 整数 {
    如果 (i >= n) {
        如果 (条件 <= 0 或 条件满足(图, 条件, 绑定) == 1) {
            变量 解: 整数 = J.创建对象();
            变量 m: 整数 = 表列::字符串列表大小(名单);
            变量 k: 整数 = 0;
            当 (k < m) {
                变量 名: 字符串 = 表列::获取字符串(名单, k);
                J.设置字符串(解, 名, 查绑定(绑定, 名));
                k = k + 1;
            }
            J.数组添加对象(出, 解);
            J.删除(解);
        }
        返回 1;
    }
    变量 t: 整数 = J.数组获取对象(三元组, i);
    如果 (t <= 0) {
        返回 0;
    }
    变量 从: 字符串 = J.获取字符串(t, "from");
    变量 类型模式: 字符串 = J.获取字符串(t, "type");
    变量 至: 字符串 = J.获取字符串(t, "to");
    J.删除(t);

    // 把已绑定的变量落成常量，决定从哪一端出发
    变量 从值: 字符串 = 从;
    如果 (是变量(从) == 1) {
        从值 = 查绑定(绑定, 从);
    }
    变量 至值: 字符串 = 至;
    如果 (是变量(至) == 1) {
        至值 = 查绑定(绑定, 至);
    }

    变量 候选: 整数 = 0;      // 边 id 列表（字符串列表句柄）
    如果 (字符串::字节长度(从值) > 0) {
        候选 = 边id表(图, 键_出(从值));
    } 否则 {
        如果 (字符串::字节长度(至值) > 0) {
            候选 = 边id表(图, 键_入(至值));
        } 否则 {
            变量 类型值: 字符串 = 类型模式;
            如果 (是变量(类型模式) == 1) {
                类型值 = 查绑定(绑定, 类型模式);
            }
            如果 (字符串::字节长度(类型值) > 0) {
                候选 = 按类型列边(图, 类型值);
            } 否则 {
                候选 = 列全部边(图);
            }
        }
    }

    变量 c: 整数 = 表列::字符串列表大小(候选);
    变量 j: 整数 = 0;
    当 (j < c) {
        变量 边: 整数 = 读JSON(图, 键_边(表列::获取字符串(候选, j)));
        如果 (边 > 0) {
            变量 掩码: 整数 = 套边(边, 从, 类型模式, 至, 绑定);
            如果 (掩码 >= 0) {
                回溯(图, 三元组, i + 1, n, 名单, 绑定, 条件, 出);
                撤回(绑定, 掩码, 从, 类型模式, 至);
            }
            J.删除(边);
        }
        j = j + 1;
    }
    表列::删除列表(候选);
    返回 1;
}

函数 边id表(图: 整数, 键: 字符串) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    变量 组: 整数 = 读JSON(图, 键);
    如果 (组 <= 0) {
        返回 出;
    }
    变量 n: 整数 = J.数组长度(组);
    变量 i: 整数 = 0;
    当 (i < n) {
        表列::添加字符串(出, J.数组获取字符串(组, i));
        i = i + 1;
    }
    J.删除(组);
    返回 出;
}

// ── where 过滤 ────────────────────────────────────────────────────

// where 的每个键形如 "?a.props.年龄" / "?a.id" / "?a.labels"，值是 {运算符: 值} 对象。
// 支持 = != > < >= <= 包含。变量没绑定（模式里没出现）算不满足。
函数 条件满足(图: 整数, 条件: 整数, 绑定: 整数) : 整数 {
    对于 键 在 J.键列表(条件) {
        变量 点: 整数 = 字符串::查找(键, ".");
        如果 (点 < 0) {
            返回 0;
        }
        变量 变元名: 字符串 = 字符串::子串(键, 0, 点);
        变量 路径: 字符串 = 字符串::子串从位置(键, 点 + 1);
        变量 id: 字符串 = 查绑定(绑定, 变元名);
        如果 (字符串::字节长度(id) == 0) {
            返回 0;
        }
        变量 一组: 整数 = J.获取对象(条件, 键);
        如果 (一组 <= 0) {
            返回 0;
        }
        变量 过: 整数 = 节点字段满足(图, id, 路径, 一组);
        J.删除(一组);
        如果 (过 == 0) {
            返回 0;
        }
    }
    返回 1;
}

// 过滤节点 用：条件的键直接是属性名（或 props.x / id / labels）
函数 节点满足(图: 整数, id: 字符串, 条件: 整数) : 整数 {
    对于 键 在 J.键列表(条件) {
        变量 路径: 字符串 = 键;
        如果 (键 != "id" 与 键 != "labels" 与 字符串::开始于(键, "props.") == 0) {
            路径 = "props." + 键;
        }
        变量 一组: 整数 = J.获取对象(条件, 键);
        如果 (一组 <= 0) {
            返回 0;
        }
        变量 过: 整数 = 节点字段满足(图, id, 路径, 一组);
        J.删除(一组);
        如果 (过 == 0) {
            返回 0;
        }
    }
    返回 1;
}

// 节点 id 上 路径 指到的值，是否满足 一组 里的每个 {运算符: 值}
函数 节点字段满足(图: 整数, id: 字符串, 路径: 字符串, 一组: 整数) : 整数 {
    变量 节点: 整数 = 读JSON(图, 键_节点(id));
    如果 (节点 <= 0) {
        返回 0;
    }
    变量 过: 整数 = 1;
    如果 (路径 == "labels") {
        变量 标签组: 整数 = J.获取数组(节点, "labels");
        对于 运算 在 J.键列表(一组) {
            变量 要: 字符串 = J.取显示值(一组, 运算);
            变量 有: 整数 = 0;
            如果 (标签组 > 0) {
                有 = 数组含字符串(标签组, 要);
            }
            如果 (运算 == "包含" 与 有 == 0) {
                过 = 0;
            }
            如果 (运算 == "不含" 与 有 == 1) {
                过 = 0;
            }
        }
        如果 (标签组 > 0) {
            J.删除(标签组);
        }
        J.删除(节点);
        返回 过;
    }

    // 标量：找到承载它的对象和字段名
    变量 载体: 整数 = 节点;
    变量 字段: 字符串 = 路径;
    变量 属性: 整数 = 0;
    如果 (字符串::开始于(路径, "props.") == 1) {
        属性 = J.获取对象(节点, "props");
        载体 = 属性;
        字段 = 字符串::子串从位置(路径, 6);
    }
    如果 (载体 <= 0 或 J.是否包含键(载体, 字段) == 0) {
        过 = 0;
    } 否则 {
        变量 实际串: 字符串 = J.取显示值(载体, 字段);
        变量 实际数: 浮点数 = J.获取浮点数(载体, 字段);
        变量 实际是串: 整数 = 0;
        如果 (字符串::字节长度(J.获取字符串(载体, 字段)) > 0) {
            实际是串 = 1;
        }
        对于 运算 在 J.键列表(一组) {
            变量 要串: 字符串 = J.取显示值(一组, 运算);
            变量 要是串: 整数 = 0;
            如果 (字符串::字节长度(J.获取字符串(一组, 运算)) > 0) {
                要是串 = 1;
            }
            如果 (比较一次(运算, 实际串, 实际数, 实际是串, 要串, J.获取浮点数(一组, 运算), 要是串) == 0) {
                过 = 0;
            }
        }
    }
    如果 (属性 > 0) {
        J.删除(属性);
    }
    J.删除(节点);
    返回 过;
}

// 两边都是数字就按数字比，否则按显示串比；包含 永远按串
函数 比较一次(运算: 字符串, 实际串: 字符串, 实际数: 浮点数, 实际是串: 整数,
              要串: 字符串, 要数: 浮点数, 要是串: 整数) : 整数 {
    如果 (运算 == "包含") {
        返回 字符串::包含(实际串, 要串);
    }
    变量 按数: 整数 = 0;
    如果 (实际是串 == 0 与 要是串 == 0) {
        按数 = 1;
    }
    如果 (运算 == "=" 或 运算 == "==") {
        如果 (按数 == 1) {
            如果 (实际数 == 要数) { 返回 1; }
            返回 0;
        }
        如果 (实际串 == 要串) { 返回 1; }
        返回 0;
    }
    如果 (运算 == "!=") {
        如果 (按数 == 1) {
            如果 (实际数 != 要数) { 返回 1; }
            返回 0;
        }
        如果 (实际串 != 要串) { 返回 1; }
        返回 0;
    }
    如果 (按数 == 0) {
        返回 0;
    }
    如果 (运算 == ">") {
        如果 (实际数 > 要数) { 返回 1; }
        返回 0;
    }
    如果 (运算 == "<") {
        如果 (实际数 < 要数) { 返回 1; }
        返回 0;
    }
    如果 (运算 == ">=") {
        如果 (实际数 >= 要数) { 返回 1; }
        返回 0;
    }
    如果 (运算 == "<=") {
        如果 (实际数 <= 要数) { 返回 1; }
        返回 0;
    }
    返回 0;
}

// ── 链式方法 ──────────────────────────────────────────────────────

公开 函数 (自身 图库) 模式匹配(模式JSON: 字符串) : 字符串 { 返回 模式匹配(自身.句柄, 模式JSON); }
公开 函数 (自身 图库) 模式匹配数(模式JSON: 字符串) : 整数 { 返回 模式匹配数(自身.句柄, 模式JSON); }
公开 函数 (自身 图库) 过滤节点(标签: 字符串, 条件JSON: 字符串) : 整数 { 返回 过滤节点(自身.句柄, 标签, 条件JSON); }
