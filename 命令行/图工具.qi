// qigraph —— qi-graph 图层的命令行工具
//
//   qigraph 加节点 张三 --标签 人,员工 --属性 '{"年龄":30}'
//   qigraph 加边 认识 张三 李四
//   qigraph 取节点 张三
//   qigraph 邻居 张三 [--入] [--类型 认识]
//   qigraph 遍历 张三 --深度 2 [--深搜]
//   qigraph 路径 张三 李四
//   qigraph 匹配 '[{"from":"?a","type":"认识","to":"?b"}]'
//   qigraph 标签 人
//   qigraph 导出 > 图.json      qigraph 导入 图.json
//   qigraph 统计
//   qigraph --库 /data/知识.kv 加节点 …
//
// 库文件默认 $HOME/.qigraph.kv，用 --库 换。每条命令都是「开图 → 做一件事 → 关图」。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 标准库.操作系统 作为 系统;
导入 CLI::{
    创建应用, 创建命令, 创建参数, 执行, 上下文, 应用, 命令, 参数,
    应用版本, 应用作者, 应用简介, 应用执行, 应用添加参数, 应用添加命令,
    命令简介, 命令示例, 命令执行, 命令添加参数, 命令添加别名,
    参数长名, 参数短名, 参数帮助, 参数默认值, 参数标志, 参数持久,
    值, 标志, 存在值
};
导入 Graph::{打开图, 关闭图, 加节点, 取节点, 有节点, 删节点, 改属性, 加标签, 去标签, 按标签列节点,
             新边, 加边, 取边, 删边, 按类型列边, 节点数, 边数, 统计JSON,
             出邻居, 入邻居, 广度遍历, 深度遍历, 最短路径, 连通分量数,
             模式匹配, 过滤节点, 导出JSON, 从文件导入};

// 没给的选项 值() 不是空串（qi-cli 对缺席的参数返回的不是 ""），所以先问 存在值
函数 选项值(上下文值: 上下文, 名: 字符串) : 字符串 {
    如果 (存在值(上下文值, 名) == 0) {
        返回 "";
    }
    返回 值(上下文值, 名);
}

函数 库路径于(上下文值: 上下文) : 字符串 {
    变量 指定: 字符串 = 选项值(上下文值, "库");
    如果 (字符串::字节长度(指定) > 0) {
        返回 指定;
    }
    变量 家: 字符串 = 系统.获取环境变量("HOME");
    如果 (字符串::字节长度(家) == 0) {
        返回 "/tmp/qigraph.kv";
    }
    返回 家 + "/.qigraph.kv";
}

// 打不开返回 -1（调用方直接退出）
函数 开(上下文值: 上下文) : 整数 {
    变量 路径: 字符串 = 库路径于(上下文值);
    变量 g: 整数 = 打开图(路径);
    如果 (g < 0) {
        IO.打印错误行("打不开图库：" + 路径);
        IO.打印错误行("（它存在但不是 qi-kv 文件？qigraph 不会覆盖不认得的文件。）");
    }
    返回 g;
}

// 逐行打印一个字符串列表并释放
函数 打印列表(表: 整数) : 整数 {
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 i: 整数 = 0;
    当 (i < n) {
        IO.打印行(表列::获取字符串(表, i));
        i = i + 1;
    }
    表列::删除列表(表);
    返回 n;
}

// "人,员工" → ["人","员工"]（简单切分，标签里不含引号和逗号）
函数 标签参数转JSON(文本: 字符串) : 字符串 {
    如果 (字符串::字节长度(字符串::去空白(文本)) == 0) {
        返回 "[]";
    }
    变量 段: 整数 = 字符串::分割(文本, ",");
    变量 出: 字符串 = "[";
    变量 n: 整数 = 表列::字符串列表大小(段);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 s: 字符串 = 字符串::去空白(表列::获取字符串(段, i));
        如果 (字符串::字节长度(s) > 0) {
            如果 (出 != "[") {
                出 = 出 + ",";
            }
            出 = 出 + "\"" + s + "\"";
        }
        i = i + 1;
    }
    表列::删除列表(段);
    返回 出 + "]";
}

函数 属性参数(上下文值: 上下文) : 字符串 {
    变量 p: 字符串 = 选项值(上下文值, "属性");
    如果 (字符串::字节长度(p) == 0) {
        返回 "{}";
    }
    返回 p;
}

// ── 节点 ──────────────────────────────────────────────────────────

函数 处理加节点(上下文值: 上下文) : 整数 {
    变量 id: 字符串 = 值(上下文值, "id");
    如果 (字符串::字节长度(id) == 0) {
        IO.打印错误行("用法: qigraph 加节点 <id> [--标签 a,b] [--属性 JSON]");
        返回 1;
    }
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 r: 整数 = 加节点(g, id, 标签参数转JSON(选项值(上下文值, "标签")), 属性参数(上下文值));
    如果 (r == 0) {
        如果 (有节点(g, id) == 1) {
            IO.打印错误行("节点已存在：" + id + "（改属性用 改属性，加标签用 加标签）");
        } 否则 {
            IO.打印错误行("加不进去：id 不能含 ':'，属性必须是 JSON 对象");
        }
    }
    关闭图(g);
    如果 (r == 0) { 返回 1; }
    返回 0;
}

函数 处理取节点(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 文本: 字符串 = 取节点(g, 值(上下文值, "id"));
    关闭图(g);
    如果 (字符串::字节长度(文本) == 0) {
        返回 1;       // 没这个节点：退出码说话，stdout 干净
    }
    IO.打印行(文本);
    返回 0;
}

函数 处理删节点(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 r: 整数 = 删节点(g, 值(上下文值, "id"));
    关闭图(g);
    如果 (r == 0) { 返回 1; }
    返回 0;
}

函数 处理改属性(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 r: 整数 = 改属性(g, 值(上下文值, "id"), 值(上下文值, "属性JSON"));
    如果 (r == 1) {
        IO.打印行(取节点(g, 值(上下文值, "id")));
    }
    关闭图(g);
    如果 (r == 0) { 返回 1; }
    返回 0;
}

函数 处理加标签(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 r: 整数 = 加标签(g, 值(上下文值, "id"), 选项值(上下文值, "标签"));
    关闭图(g);
    如果 (r == 0) { 返回 1; }
    返回 0;
}

函数 处理去标签(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 r: 整数 = 去标签(g, 值(上下文值, "id"), 选项值(上下文值, "标签"));
    关闭图(g);
    如果 (r == 0) { 返回 1; }
    返回 0;
}

函数 处理标签(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 条件: 字符串 = 选项值(上下文值, "条件");
    如果 (字符串::字节长度(条件) > 0) {
        打印列表(过滤节点(g, 选项值(上下文值, "标签"), 条件));
    } 否则 {
        打印列表(按标签列节点(g, 选项值(上下文值, "标签")));
    }
    关闭图(g);
    返回 0;
}

// ── 边 ────────────────────────────────────────────────────────────

函数 处理加边(上下文值: 上下文) : 整数 {
    变量 边类型: 字符串 = 选项值(上下文值, "类型");
    变量 起: 字符串 = 值(上下文值, "起");
    变量 止: 字符串 = 值(上下文值, "止");
    如果 (字符串::字节长度(边类型) == 0 或 字符串::字节长度(起) == 0 或 字符串::字节长度(止) == 0) {
        IO.打印错误行("用法: qigraph 加边 <类型> <起点> <终点> [--id 边id] [--属性 JSON]");
        返回 1;
    }
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 id: 字符串 = 选项值(上下文值, "id");
    变量 得到: 字符串 = "";
    如果 (字符串::字节长度(id) == 0) {
        得到 = 新边(g, 边类型, 起, 止, 属性参数(上下文值));
    } 否则 {
        如果 (加边(g, id, 边类型, 起, 止, 属性参数(上下文值)) == 1) {
            得到 = id;
        }
    }
    如果 (字符串::字节长度(得到) == 0) {
        IO.打印错误行("加不进去：两端节点要先存在，id / 类型不能含 ':'，边 id 不能重复");
    } 否则 {
        IO.打印行(得到);
    }
    关闭图(g);
    如果 (字符串::字节长度(得到) == 0) { 返回 1; }
    返回 0;
}

函数 处理取边(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 文本: 字符串 = 取边(g, 值(上下文值, "id"));
    关闭图(g);
    如果 (字符串::字节长度(文本) == 0) {
        返回 1;
    }
    IO.打印行(文本);
    返回 0;
}

函数 处理删边(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 r: 整数 = 删边(g, 值(上下文值, "id"));
    关闭图(g);
    如果 (r == 0) { 返回 1; }
    返回 0;
}

函数 处理列边(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 表: 整数 = 按类型列边(g, 选项值(上下文值, "类型"));
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 i: 整数 = 0;
    当 (i < n) {
        IO.打印行(取边(g, 表列::获取字符串(表, i)));
        i = i + 1;
    }
    表列::删除列表(表);
    关闭图(g);
    返回 0;
}

// ── 遍历 / 查询 ───────────────────────────────────────────────────

函数 处理邻居(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 边类型: 字符串 = 选项值(上下文值, "类型");
    如果 (标志(上下文值, "入") == 1) {
        打印列表(入邻居(g, 值(上下文值, "id"), 边类型));
    } 否则 {
        打印列表(出邻居(g, 值(上下文值, "id"), 边类型));
    }
    关闭图(g);
    返回 0;
}

函数 处理遍历(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 深度: 整数 = -1;
    变量 深度文本: 字符串 = 选项值(上下文值, "深度");
    如果 (字符串::字节长度(深度文本) > 0) {
        深度 = 字符串转整数(深度文本);
    }
    变量 边类型: 字符串 = 选项值(上下文值, "类型");
    如果 (标志(上下文值, "深搜") == 1) {
        打印列表(深度遍历(g, 值(上下文值, "起点"), 深度, 边类型));
    } 否则 {
        打印列表(广度遍历(g, 值(上下文值, "起点"), 深度, 边类型));
    }
    关闭图(g);
    返回 0;
}

函数 处理路径(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 路: 整数 = 最短路径(g, 值(上下文值, "起"), 值(上下文值, "止"), 选项值(上下文值, "类型"));
    变量 n: 整数 = 表列::字符串列表大小(路);
    变量 出: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (i > 0) {
            出 = 出 + " -> ";
        }
        出 = 出 + 表列::获取字符串(路, i);
        i = i + 1;
    }
    表列::删除列表(路);
    关闭图(g);
    如果 (n == 0) {
        IO.打印错误行("不可达");
        返回 1;
    }
    IO.打印行(出);
    返回 0;
}

函数 处理匹配(上下文值: 上下文) : 整数 {
    变量 模式: 字符串 = 值(上下文值, "模式JSON");
    如果 (字符串::字节长度(模式) == 0) {
        IO.打印错误行("用法: qigraph 匹配 '<模式JSON>'");
        返回 1;
    }
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    IO.打印行(模式匹配(g, 模式));
    关闭图(g);
    返回 0;
}

// ── 整图 ──────────────────────────────────────────────────────────

函数 处理统计(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    如果 (标志(上下文值, "JSON") == 1) {
        IO.打印行(统计JSON(g));
    } 否则 {
        IO.打印行("库    " + 库路径于(上下文值));
        IO.打印行("节点  " + 节点数(g));
        IO.打印行("边    " + 边数(g));
        IO.打印行("分量  " + 连通分量数(g));
    }
    关闭图(g);
    返回 0;
}

函数 处理导出(上下文值: 上下文) : 整数 {
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    IO.打印行(导出JSON(g));
    关闭图(g);
    返回 0;
}

函数 处理导入(上下文值: 上下文) : 整数 {
    变量 文件: 字符串 = 值(上下文值, "文件");
    如果 (IO.文件存在(文件) == 0) {
        IO.打印错误行("文件不存在：" + 文件);
        返回 1;
    }
    变量 g: 整数 = 开(上下文值);
    如果 (g < 0) { 返回 1; }
    变量 n: 整数 = 从文件导入(g, 文件);
    IO.打印行("导入了 " + n + " 项（节点 + 边），现在 " + 节点数(g) + " 节点 / " + 边数(g) + " 边");
    关闭图(g);
    返回 0;
}

函数 处理根(上下文值: 上下文) : 整数 {
    IO.打印行("qigraph —— qi-graph 属性图的命令行工具。用 qigraph --help 看子命令。");
    返回 0;
}

// ── 组装 ──────────────────────────────────────────────────────────

函数 位置参数(命令值: 命令, 名: 字符串, 帮助: 字符串) : 命令 {
    变量 p: 参数 = 创建参数(名);
    p = 参数帮助(p, 帮助);
    返回 命令添加参数(命令值, p);
}

函数 长名参数(命令值: 命令, 名: 字符串, 帮助: 字符串) : 命令 {
    变量 p: 参数 = 创建参数(名);
    p = 参数长名(p, 名);
    p = 参数帮助(p, 帮助);
    返回 命令添加参数(命令值, p);
}

函数 标志参数(命令值: 命令, 名: 字符串, 帮助: 字符串) : 命令 {
    变量 p: 参数 = 创建参数(名);
    p = 参数长名(p, 名);
    p = 参数帮助(p, 帮助);
    p = 参数标志(p);
    返回 命令添加参数(命令值, p);
}

函数 入口() {
    变量 应用值: 应用 = 创建应用("qigraph");
    应用值 = 应用版本(应用值, "0.1.0");
    应用值 = 应用作者(应用值, "Qi Language Team");
    应用值 = 应用简介(应用值, "qi-graph 属性图：节点 / 边 / 遍历 / 模式匹配，建在 qi-kv 上");
    应用值 = 应用执行(应用值, 处理根);

    变量 库参数: 参数 = 创建参数("库");
    库参数 = 参数长名(库参数, "库");
    库参数 = 参数短名(库参数, "d");
    库参数 = 参数帮助(库参数, "图库文件路径（默认 $HOME/.qigraph.kv）");
    库参数 = 参数持久(库参数);
    应用值 = 应用添加参数(应用值, 库参数);

    变量 c: 命令 = 创建命令("加节点");
    c = 命令简介(c, "加一个节点");
    c = 命令示例(c, "qigraph 加节点 张三 --标签 人,员工 --属性 '{\"年龄\":30}'");
    c = 命令执行(c, 处理加节点);
    c = 位置参数(c, "id", "节点 id（不能含 ':'）");
    c = 长名参数(c, "标签", "逗号分隔的标签");
    c = 长名参数(c, "属性", "属性 JSON 对象");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("取节点");
    c = 命令简介(c, "打印节点 JSON（没有则退出码 1）");
    c = 命令执行(c, 处理取节点);
    c = 位置参数(c, "id", "节点 id");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("删节点");
    c = 命令简介(c, "删节点并级联删掉它的所有边");
    c = 命令执行(c, 处理删节点);
    c = 位置参数(c, "id", "节点 id");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("改属性");
    c = 命令简介(c, "合并属性（同名覆盖、其余保留）");
    c = 命令示例(c, "qigraph 改属性 张三 '{\"年龄\":31}'");
    c = 命令执行(c, 处理改属性);
    c = 位置参数(c, "id", "节点 id");
    c = 位置参数(c, "属性JSON", "属性 JSON 对象");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("加标签");
    c = 命令简介(c, "给节点加一个标签");
    c = 命令执行(c, 处理加标签);
    c = 位置参数(c, "id", "节点 id");
    c = 位置参数(c, "标签", "标签");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("去标签");
    c = 命令简介(c, "去掉节点的一个标签");
    c = 命令执行(c, 处理去标签);
    c = 位置参数(c, "id", "节点 id");
    c = 位置参数(c, "标签", "标签");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("标签");
    c = 命令简介(c, "列出带某标签的节点，可加属性条件");
    c = 命令示例(c, "qigraph 标签 人 --条件 '{\"年龄\":{\">\":30}}'");
    c = 命令执行(c, 处理标签);
    c = 位置参数(c, "标签", "标签");
    c = 长名参数(c, "条件", "属性条件 JSON");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("加边");
    c = 命令简介(c, "加一条有向边，打印边 id");
    c = 命令示例(c, "qigraph 加边 认识 张三 李四 --属性 '{\"since\":2020}'");
    c = 命令执行(c, 处理加边);
    c = 位置参数(c, "类型", "边类型");
    c = 位置参数(c, "起", "起点节点 id");
    c = 位置参数(c, "止", "终点节点 id");
    c = 长名参数(c, "id", "指定边 id（默认自动分配）");
    c = 长名参数(c, "属性", "属性 JSON 对象");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("取边");
    c = 命令简介(c, "打印边 JSON（没有则退出码 1）");
    c = 命令执行(c, 处理取边);
    c = 位置参数(c, "id", "边 id");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("删边");
    c = 命令简介(c, "删一条边");
    c = 命令执行(c, 处理删边);
    c = 位置参数(c, "id", "边 id");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("列边");
    c = 命令简介(c, "列出某类型的全部边");
    c = 命令执行(c, 处理列边);
    c = 位置参数(c, "类型", "边类型");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("邻居");
    c = 命令简介(c, "出邻居（--入 看入邻居），可按边类型过滤");
    c = 命令示例(c, "qigraph 邻居 张三 --类型 认识");
    c = 命令执行(c, 处理邻居);
    c = 位置参数(c, "id", "节点 id");
    c = 长名参数(c, "类型", "只走这种边");
    c = 标志参数(c, "入", "看入邻居");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("遍历");
    c = 命令简介(c, "从起点 BFS（--深搜 改 DFS），逐行打印节点");
    c = 命令示例(c, "qigraph 遍历 张三 --深度 2");
    c = 命令执行(c, 处理遍历);
    c = 位置参数(c, "起点", "起点节点 id");
    c = 长名参数(c, "深度", "最多走几跳（默认不限）");
    c = 长名参数(c, "类型", "只走这种边");
    c = 标志参数(c, "深搜", "深度优先");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("路径");
    c = 命令简介(c, "无权最短路径（不可达退出码 1）");
    c = 命令执行(c, 处理路径);
    c = 位置参数(c, "起", "起点");
    c = 位置参数(c, "止", "终点");
    c = 长名参数(c, "类型", "只走这种边");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("匹配");
    c = 命令简介(c, "模式匹配，打印绑定 JSON 数组");
    c = 命令示例(c, "qigraph 匹配 '[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"}]'");
    c = 命令执行(c, 处理匹配);
    c = 位置参数(c, "模式JSON", "三元组数组，或 {\"match\":[…],\"where\":{…}}");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("统计");
    c = 命令简介(c, "节点数 / 边数 / 连通分量");
    c = 命令执行(c, 处理统计);
    c = 标志参数(c, "JSON", "输出 JSON");
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("导出");
    c = 命令简介(c, "整图导出成 JSON（打到 stdout）");
    c = 命令执行(c, 处理导出);
    应用值 = 应用添加命令(应用值, c);

    c = 创建命令("导入");
    c = 命令简介(c, "从 JSON 文件导入（已有的 id 跳过）");
    c = 命令执行(c, 处理导入);
    c = 位置参数(c, "文件", "导出格式的 JSON 文件");
    应用值 = 应用添加命令(应用值, c);

    // 执行 只返回退出码，不退出进程
    系统.退出程序(执行(应用值));
}
