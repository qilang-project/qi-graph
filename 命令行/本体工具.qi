// 本体工具 —— qi-graph 本体层的命令行
//
//   qi compile 命令行/本体工具.qi -o qionto
//
//   qionto 定义类 狗 --父类 哺乳动物
//   qionto 定义属性 年龄 --定义域 动物 --值域 整数 --函数性
//   qionto 加个体 旺财 狗
//   qionto 断言 旺财 年龄 3 --字面量 --类型 整数
//   qionto 查 --主 旺财
//   qionto 类 狗           qionto 个体 旺财
//   qionto 校验            qionto 推理            qionto 解释 旺财 朋友 咪咪
//   qionto 导出 --格式 turtle > 本体.ttl
//   qionto --库 /data/知识.kv 统计
//
// 库文件默认 $HOME/.qigraph.kv，用 --库 换。每条命令都是「开库 → 做一件事 → 关库」。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 标准库.操作系统 作为 系统;
导入 标准库.JSON;
导入 CLI::{
    创建应用, 创建命令, 创建参数, 执行, 上下文, 应用, 命令, 参数,
    应用版本, 应用作者, 应用简介, 应用执行, 应用添加参数, 应用添加命令,
    命令简介, 命令示例, 命令执行, 命令添加参数, 命令添加别名,
    参数长名, 参数短名, 参数帮助, 参数默认值, 参数标志, 参数持久,
    值, 标志
};
导入 Graph::{打开本体, 关闭本体, 本体可用,
             定义类, 类注释, 类存在, 类定义, 父类, 子类, 列出类,
             定义属性, 属性定义, 列出属性,
             加个体, 个体存在, 个体类型, 列出个体, 按类列个体,
             断言, 断言字面量, 撤销, 查, 三元组数, 字符串列表连成行,
             所有祖先类, 所有子类, 所有类型, 校验, 物化推理, 撤销推理, 推出三元组数, 解释,
             导出本体JSON, 导入本体JSON, 导出Turtle};

函数 库路径于(上下文值: 上下文) : 字符串 {
    变量 指定: 字符串 = 值(上下文值, "库");
    如果 (字符串::字节长度(指定) > 0) { 返回 指定; }
    变量 家: 字符串 = 系统.获取环境变量("HOME");
    如果 (字符串::字节长度(家) == 0) { 返回 "/tmp/qigraph.kv"; }
    返回 家 + "/.qigraph.kv";
}

函数 开(上下文值: 上下文) : 整数 {
    变量 路径: 字符串 = 库路径于(上下文值);
    变量 本: 整数 = 打开本体(路径);
    如果 (本体可用(本) == 0) {
        IO.打印错误行("打不开库：" + 路径 + "（它存在但不是 qi-kv 文件？不会覆盖不认得的文件）");
        返回 -1;
    }
    返回 本;
}

函数 行(表: 整数) : 字符串 {
    变量 s: 字符串 = 字符串列表连成行(表, " ");
    表列::删除列表(表);
    返回 s;
}

// 把 查 返回的 JSON 数组按「主 谓 宾」一行一条打出来
函数 打印三元组(文: 字符串) : 整数 {
    变量 a: 整数 = JSON.解码(文);
    如果 (a == 0) { 返回 0; }
    变量 n: 整数 = JSON.数组长度(a);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 t: 整数 = JSON.数组获取对象(a, i);
        变量 o: 整数 = JSON.获取对象(t, "o");
        变量 宾: 字符串 = "";
        如果 (o != 0) {
            如果 (JSON.是否包含键(o, "iri") == 1) { 宾 = JSON.获取字符串(o, "iri"); }
            否则 { 宾 = "\"" + JSON.获取字符串(o, "lit") + "\"^^" + JSON.获取字符串(o, "dt"); }
            JSON.删除(o);
        }
        变量 尾: 字符串 = "";
        如果 (JSON.是否包含键(t, "inferred") == 1) { 尾 = "\t# 推出"; }
        IO.打印行(JSON.获取字符串(t, "s") + " " + JSON.获取字符串(t, "p") + " " + 宾 + 尾);
        JSON.删除(t);
        i = i + 1;
    }
    JSON.删除(a);
    返回 n;
}

函数 处理定义类(上下文值: 上下文) : 整数 {
    变量 名: 字符串 = 值(上下文值, "名");
    如果 (字符串::字节长度(名) == 0) {
        IO.打印错误行("用法: 定义类 <名> [--父类 X] [--注释 T]");
        返回 1;
    }
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 好: 整数 = 定义类(本, 名, 值(上下文值, "父类"));
    变量 注: 字符串 = 值(上下文值, "注释");
    如果 (好 == 1 与 字符串::字节长度(注) > 0) { 类注释(本, 名, 注); }
    关闭本体(本);
    如果 (好 == 0) {
        IO.打印错误行("没写进去：名字不能空、不能含「:」、不能以 lit= 开头");
        返回 1;
    }
    返回 0;
}

函数 处理定义属性(上下文值: 上下文) : 整数 {
    变量 名: 字符串 = 值(上下文值, "名");
    如果 (字符串::字节长度(名) == 0) {
        IO.打印错误行("用法: 定义属性 <名> --定义域 D --值域 R [--函数性] [--传递] [--对称] [--逆属性 Q] [--父属性 P]");
        返回 1;
    }
    变量 选: 整数 = JSON.创建对象();
    JSON.设置整数(选, "functional", 标志(上下文值, "函数性"));
    JSON.设置整数(选, "transitive", 标志(上下文值, "传递"));
    JSON.设置整数(选, "symmetric", 标志(上下文值, "对称"));
    JSON.设置字符串(选, "inverse", 值(上下文值, "逆属性"));
    JSON.设置字符串(选, "parent", 值(上下文值, "父属性"));
    变量 选文: 字符串 = JSON.转字符串(选);
    JSON.删除(选);
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 好: 整数 = 定义属性(本, 名, 值(上下文值, "定义域"), 值(上下文值, "值域"), 选文);
    关闭本体(本);
    如果 (好 == 0) {
        IO.打印错误行("没写进去：名字 / 定义域 / 值域 不能含「:」");
        返回 1;
    }
    返回 0;
}

函数 处理加个体(上下文值: 上下文) : 整数 {
    变量 id: 字符串 = 值(上下文值, "id");
    如果 (字符串::字节长度(id) == 0) {
        IO.打印错误行("用法: 加个体 <id> [<类>]");
        返回 1;
    }
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 好: 整数 = 加个体(本, id, 值(上下文值, "类"));
    关闭本体(本);
    如果 (好 == 0) {
        IO.打印错误行("没写进去：id / 类 不能含「:」，id 不能以 lit= 开头");
        返回 1;
    }
    返回 0;
}

函数 处理断言(上下文值: 上下文) : 整数 {
    变量 主: 字符串 = 值(上下文值, "主");
    变量 谓: 字符串 = 值(上下文值, "谓");
    变量 宾: 字符串 = 值(上下文值, "宾");
    如果 (字符串::字节长度(主) == 0 或 字符串::字节长度(谓) == 0 或 字符串::字节长度(宾) == 0) {
        IO.打印错误行("用法: 断言 <主> <谓> <宾> [--字面量 [--类型 字符串|整数|浮点数|布尔]]");
        返回 1;
    }
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 好: 整数 = 0;
    如果 (标志(上下文值, "字面量") == 1) {
        好 = 断言字面量(本, 主, 谓, 宾, 值(上下文值, "类型"));
    } 否则 {
        好 = 断言(本, 主, 谓, 宾);
    }
    关闭本体(本);
    如果 (好 == 0) {
        IO.打印错误行("没写进去：已经有了，或者名字含「:」/ 数据类型不认识");
        返回 1;
    }
    返回 0;
}

函数 处理撤销(上下文值: 上下文) : 整数 {
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 宾: 字符串 = 值(上下文值, "宾");
    如果 (标志(上下文值, "字面量") == 1) { 宾 = "lit=" + 宾; }
    变量 有: 整数 = 撤销(本, 值(上下文值, "主"), 值(上下文值, "谓"), 宾);
    关闭本体(本);
    如果 (有 == 0) { 返回 1; }
    返回 0;
}

函数 处理查(上下文值: 上下文) : 整数 {
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 宾: 字符串 = 值(上下文值, "宾");
    如果 (标志(上下文值, "字面量") == 1 与 字符串::字节长度(宾) > 0) { 宾 = "lit=" + 宾; }
    变量 文: 字符串 = 查(本, 值(上下文值, "主"), 值(上下文值, "谓"), 宾);
    关闭本体(本);
    如果 (标志(上下文值, "JSON") == 1) {
        IO.打印行(文);
    } 否则 {
        打印三元组(文);
    }
    返回 0;
}

函数 处理类(上下文值: 上下文) : 整数 {
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 名: 字符串 = 值(上下文值, "名");
    如果 (字符串::字节长度(名) == 0) {
        变量 类们: 整数 = 列出类(本);
        变量 n: 整数 = 表列::字符串列表大小(类们);
        变量 i: 整数 = 0;
        当 (i < n) {
            变量 c: 字符串 = 表列::获取字符串(类们, i);
            IO.打印行(c + "\t父类: " + 行(父类(本, c)));
            i = i + 1;
        }
        表列::删除列表(类们);
        关闭本体(本);
        返回 0;
    }
    如果 (类存在(本, 名) == 0) {
        关闭本体(本);
        IO.打印错误行("没有这个类：" + 名);
        返回 1;
    }
    IO.打印行("定义    " + 类定义(本, 名));
    IO.打印行("父类    " + 行(父类(本, 名)));
    IO.打印行("全部祖先 " + 行(所有祖先类(本, 名)));
    IO.打印行("子类    " + 行(子类(本, 名)));
    IO.打印行("全部后代 " + 行(所有子类(本, 名)));
    IO.打印行("直接个体 " + 行(按类列个体(本, 名)));
    IO.打印行("含子类个体 " + 行(按类列个体(本, 名, 1)));
    关闭本体(本);
    返回 0;
}

函数 处理属性(上下文值: 上下文) : 整数 {
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 名: 字符串 = 值(上下文值, "名");
    如果 (字符串::字节长度(名) == 0) {
        变量 表: 整数 = 列出属性(本);
        变量 n: 整数 = 表列::字符串列表大小(表);
        变量 i: 整数 = 0;
        当 (i < n) {
            IO.打印行(属性定义(本, 表列::获取字符串(表, i)));
            i = i + 1;
        }
        表列::删除列表(表);
    } 否则 {
        变量 定: 字符串 = 属性定义(本, 名);
        如果 (字符串::字节长度(定) == 0) {
            关闭本体(本);
            IO.打印错误行("没有这个属性：" + 名);
            返回 1;
        }
        IO.打印行(定);
    }
    关闭本体(本);
    返回 0;
}

函数 处理个体(上下文值: 上下文) : 整数 {
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 id: 字符串 = 值(上下文值, "id");
    如果 (字符串::字节长度(id) == 0) {
        IO.打印行(行(列出个体(本)));
        关闭本体(本);
        返回 0;
    }
    如果 (个体存在(本, id) == 0) {
        关闭本体(本);
        IO.打印错误行("没有这个个体：" + id);
        返回 1;
    }
    IO.打印行("直接类型 " + 行(个体类型(本, id)));
    IO.打印行("全部类型 " + 行(所有类型(本, id)));
    IO.打印行("三元组：");
    打印三元组(查(本, id, "", ""));
    IO.打印行("被引用：");
    打印三元组(查(本, "", "", id));
    关闭本体(本);
    返回 0;
}

函数 处理校验(上下文值: 上下文) : 整数 {
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 文: 字符串 = 校验(本);
    关闭本体(本);
    如果 (标志(上下文值, "JSON") == 1) {
        IO.打印行(文);
        如果 (文 == "[]") { 返回 0; }
        返回 1;
    }
    变量 a: 整数 = JSON.解码(文);
    变量 n: 整数 = JSON.数组长度(a);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 q: 整数 = JSON.数组获取对象(a, i);
        IO.打印行("[" + JSON.获取字符串(q, "kind") + "] " + JSON.获取字符串(q, "msg")
            + "\t" + JSON.获取字符串(q, "s") + " " + JSON.获取字符串(q, "p") + " " + JSON.获取字符串(q, "o"));
        JSON.删除(q);
        i = i + 1;
    }
    JSON.删除(a);
    如果 (n == 0) {
        IO.打印行("没有问题");
        返回 0;
    }
    IO.打印行("共 " + n + " 个问题");
    返回 1;
}

函数 处理推理(上下文值: 上下文) : 整数 {
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    如果 (标志(上下文值, "撤销") == 1) {
        IO.打印行("清掉 " + 撤销推理(本) + " 条推出的三元组");
    } 否则 {
        IO.打印行("推出 " + 物化推理(本) + " 条，库里现有 " + 推出三元组数(本) + " 条推出的三元组");
    }
    关闭本体(本);
    返回 0;
}

函数 处理解释(上下文值: 上下文) : 整数 {
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 宾: 字符串 = 值(上下文值, "宾");
    如果 (标志(上下文值, "字面量") == 1) { 宾 = "lit=" + 宾; }
    IO.打印行(解释(本, 值(上下文值, "主"), 值(上下文值, "谓"), 宾));
    关闭本体(本);
    返回 0;
}

函数 处理导出(上下文值: 上下文) : 整数 {
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 格式: 字符串 = 值(上下文值, "格式");
    如果 (格式 == "turtle" 或 格式 == "ttl") {
        IO.打印(导出Turtle(本));
    } 否则 如果 (标志(上下文值, "美化") == 1) {
        变量 j: 整数 = JSON.解码(导出本体JSON(本));
        IO.打印行(JSON.格式化(j));
        JSON.删除(j);
    } 否则 {
        IO.打印行(导出本体JSON(本));
    }
    关闭本体(本);
    返回 0;
}

函数 处理导入(上下文值: 上下文) : 整数 {
    变量 文件: 字符串 = 值(上下文值, "文件");
    如果 (IO.文件存在(文件) == 0) {
        IO.打印错误行("找不到文件：" + 文件);
        返回 1;
    }
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 数: 整数 = 导入本体JSON(本, IO.读取文件(文件));
    关闭本体(本);
    如果 (数 < 0) {
        IO.打印错误行("不是 导出 产出的 JSON");
        返回 1;
    }
    IO.打印行("导入 " + 数 + " 条三元组");
    返回 0;
}

函数 处理统计(上下文值: 上下文) : 整数 {
    变量 本: 整数 = 开(上下文值);
    如果 (本 < 0) { 返回 1; }
    变量 类们: 整数 = 列出类(本);
    变量 属性们: 整数 = 列出属性(本);
    变量 个体们: 整数 = 列出个体(本);
    IO.打印行("库      " + 库路径于(上下文值));
    IO.打印行("类      " + 表列::字符串列表大小(类们));
    IO.打印行("属性    " + 表列::字符串列表大小(属性们));
    IO.打印行("个体    " + 表列::字符串列表大小(个体们));
    IO.打印行("三元组  " + 三元组数(本) + "（其中推出 " + 推出三元组数(本) + "）");
    表列::删除列表(类们);
    表列::删除列表(属性们);
    表列::删除列表(个体们);
    关闭本体(本);
    返回 0;
}

函数 处理根(上下文值: 上下文) : 整数 {
    IO.打印行("qionto —— qi-graph 本体层的命令行。用 --help 看子命令。");
    返回 0;
}

函数 位置参数(命令值: 命令, 名: 字符串, 帮助: 字符串) : 命令 {
    变量 p: 参数 = 创建参数(名);
    p = 参数帮助(p, 帮助);
    返回 命令添加参数(命令值, p);
}

函数 长参数(命令值: 命令, 名: 字符串, 帮助: 字符串) : 命令 {
    变量 p: 参数 = 创建参数(名);
    p = 参数长名(p, 名);
    p = 参数帮助(p, 帮助);
    返回 命令添加参数(命令值, p);
}

函数 开关(命令值: 命令, 名: 字符串, 帮助: 字符串) : 命令 {
    变量 p: 参数 = 创建参数(名);
    p = 参数长名(p, 名);
    p = 参数帮助(p, 帮助);
    p = 参数标志(p);
    返回 命令添加参数(命令值, p);
}

函数 建命令(名: 字符串, 别名: 字符串, 简介: 字符串, 示例: 字符串, 处理: 函数(上下文): 整数) : 命令 {
    变量 c: 命令 = 创建命令(名);
    c = 命令简介(c, 简介);
    c = 命令示例(c, 示例);
    c = 命令添加别名(c, 别名);
    c = 命令执行(c, 处理);
    返回 c;
}

函数 入口() {
    变量 应用值: 应用 = 创建应用("qionto");
    应用值 = 应用版本(应用值, "0.1.0");
    应用值 = 应用作者(应用值, "Qi Language Team");
    应用值 = 应用简介(应用值, "qi-graph 本体层：类 / 属性 / 个体 / 三元组 / 校验 / 推理");
    应用值 = 应用执行(应用值, 处理根);

    变量 库参数: 参数 = 创建参数("库");
    库参数 = 参数长名(库参数, "库");
    库参数 = 参数短名(库参数, "d");
    库参数 = 参数帮助(库参数, "库文件路径（默认 $HOME/.qigraph.kv）");
    库参数 = 参数持久(库参数);
    应用值 = 应用添加参数(应用值, 库参数);

    变量 c: 命令 = 建命令("定义类", "class", "定义一个类，可带父类和注释", "qionto 定义类 狗 --父类 哺乳动物", 处理定义类);
    c = 位置参数(c, "名", "类名");
    c = 长参数(c, "父类", "父类（可多次执行同一个类给不同父类）");
    c = 长参数(c, "注释", "给人看的注释");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("定义属性", "prop", "定义一个属性", "qionto 定义属性 年龄 --定义域 动物 --值域 整数 --函数性", 处理定义属性);
    c = 位置参数(c, "名", "属性名");
    c = 长参数(c, "定义域", "主语所属的类");
    c = 长参数(c, "值域", "宾语所属的类，或 字符串/整数/浮点数/布尔");
    c = 开关(c, "函数性", "一个主语最多一个值");
    c = 开关(c, "传递", "a p b, b p c ⇒ a p c");
    c = 开关(c, "对称", "a p b ⇒ b p a");
    c = 长参数(c, "逆属性", "a p b ⇒ b q a 的 q");
    c = 长参数(c, "父属性", "a p b ⇒ a q b 的 q");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("加个体", "ind", "登记个体并给类型", "qionto 加个体 旺财 狗", 处理加个体);
    c = 位置参数(c, "id", "个体 id");
    c = 位置参数(c, "类", "所属类（可省）");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("断言", "assert", "写一条三元组", "qionto 断言 旺财 年龄 3 --字面量 --类型 整数", 处理断言);
    c = 位置参数(c, "主", "主语");
    c = 位置参数(c, "谓", "谓词");
    c = 位置参数(c, "宾", "宾语（个体 id，或加 --字面量 当值）");
    c = 开关(c, "字面量", "宾语是字面量");
    c = 长参数(c, "类型", "字面量的数据类型（默认 字符串）");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("撤销", "retract", "删一条三元组（本来没有则退出码 1）", "qionto 撤销 旺财 追 咪咪", 处理撤销);
    c = 位置参数(c, "主", "主语");
    c = 位置参数(c, "谓", "谓词");
    c = 位置参数(c, "宾", "宾语");
    c = 开关(c, "字面量", "宾语是字面量");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("查", "query", "按主/谓/宾任意组合查三元组（都不给就是全部）", "qionto 查 --谓 朋友", 处理查);
    c = 长参数(c, "主", "主语");
    c = 长参数(c, "谓", "谓词");
    c = 长参数(c, "宾", "宾语");
    c = 开关(c, "字面量", "--宾 给的是字面量");
    c = 开关(c, "JSON", "输出 JSON 而不是文本行");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("类", "classes", "列出类，或看一个类的祖先/后代/个体", "qionto 类 狗", 处理类);
    c = 位置参数(c, "名", "类名（可省）");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("属性", "props", "列出属性定义，或看一个", "qionto 属性 年龄", 处理属性);
    c = 位置参数(c, "名", "属性名（可省）");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("个体", "inds", "列出个体，或看一个个体的类型和三元组", "qionto 个体 旺财", 处理个体);
    c = 位置参数(c, "id", "个体 id（可省）");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("校验", "check", "定义域 / 值域 / 函数性 / 未定义引用（有问题退出码 1）", "qionto 校验", 处理校验);
    c = 开关(c, "JSON", "输出 JSON");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("推理", "infer", "物化推理到不动点；--撤销 清掉推出来的", "qionto 推理", 处理推理);
    c = 开关(c, "撤销", "清掉全部推出的三元组");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("解释", "explain", "这条三元组是断言的还是推出来的", "qionto 解释 咪咪 朋友 旺财", 处理解释);
    c = 位置参数(c, "主", "主语");
    c = 位置参数(c, "谓", "谓词");
    c = 位置参数(c, "宾", "宾语");
    c = 开关(c, "字面量", "宾语是字面量");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("导出", "export", "导出 JSON（默认）或 Turtle", "qionto 导出 --格式 turtle", 处理导出);
    c = 长参数(c, "格式", "json 或 turtle");
    c = 开关(c, "美化", "JSON 带缩进");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("导入", "import", "把 导出 的 JSON 灌进库", "qionto 导入 本体.json", 处理导入);
    c = 位置参数(c, "文件", "JSON 文件");
    应用值 = 应用添加命令(应用值, c);

    c = 建命令("统计", "stat", "类 / 属性 / 个体 / 三元组数", "qionto 统计", 处理统计);
    应用值 = 应用添加命令(应用值, c);

    系统.退出程序(执行(应用值));
}
