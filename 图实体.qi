// qi-graph · 图实体 —— 别名、候选、路径转文本、合并
//
// 对应 Negro《Knowledge Graphs and LLMs in Action》第 7、8 章的**命名实体消歧(NED)**。
// 那两章的流程是：文本里认出一个提及（NER）→ 在图里找出它**可能**指的那几个实体（候选）
// → 看每个候选跟上下文里其他实体**怎么连**，把路径翻成人话交给模型判断（消歧）
// → 定下来之后把重复的实体**合并**掉。
//
// 认实体和最后那一下判断是模型的活，本模块只管图这边的四件：
//
//   候选     别名 → 实体 id 的反查（书里 8.4.2 candidate selection）
//   路径转文本  把一条最短路渲染成一句话（书里 8.4.3 "Translating paths to text"）
//   消歧上下文  一次把所有候选到上下文实体的路径都翻好，拼成能直接进提示词的一段
//   合并节点   定下来之后把重复实体并掉，边不丢、别名留着
//
// ── 为什么别名要单独存一份反查索引 ──
// 只把别名塞进节点属性的话，「阿司匹林 指的是哪个实体」就得扫全图。反查索引是
// 一条 kv 键直达。代价是别名和节点要一起维护 —— 删节点时别名索引会成孤儿，
// 所以 删节点带别名 一并清。
//
// ── 别名里什么字符都可能有 ──
// 键靠 ':' 分段，而别名是从真实文本里抠出来的，冒号很常见（"mcp:fetch"、"图 1:2"）。
// 所以键里用**安全名**：能当键段的原样用，不能的整串转十六进制加 x 前缀。
// 反查表里另存一份原名，展示时还原。这套跟 qi-harness 的 图记忆 是同一个办法。

包 Graph;

导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.字节切片;
导入 标准库.列表 作为 表列;
导入 标准库.哈希表;
导入 KV::{可用, 放, 取, 删, 存在, 前缀列键};
导入 Graph.图::{图库, 合法段, 有节点, 取节点, 取属性, 取标签, 改属性, 加标签,
                 键_节点, 读JSON, 数组含字符串, 数组转列表, 加边, 删边, 删节点};
导入 Graph.遍历::{出边, 入边, 无向最短路径};

// ── 键 ────────────────────────────────────────────────────────────

函数 安全名(原名: 字符串) : 字符串 {
    如果 (合法段(原名) == 1) {
        返回 原名;
    }
    变量 切: 整数 = 字节切片::从字符串(原名);
    变量 十六: 字符串 = 字节切片::转十六进制(切);
    字节切片::释放切片(切);
    返回 "x" + 十六;
}

公开 函数 键_别名(别名: 字符串) : 字符串 { 返回 "g:al:" + 安全名(别名); }
公开 函数 前缀_别名() : 字符串 { 返回 "g:al:"; }

// ── 别名 ──────────────────────────────────────────────────────────

// 给实体挂一个别名。同一个别名重复挂到同一个实体是幂等的；
// 挂到**另一个**实体会失败（返回 0）—— 一个别名同时指两个实体，那正是消歧要解决的
// 问题，悄悄覆盖掉只会让「阿司匹林指谁」这种查询给出随机答案。
// 要改指向先 删别名。
公开 函数 加别名(图: 整数, id: 字符串, 别名: 字符串) : 整数 {
    如果 (可用(图) == 0 或 有节点(图, id) == 0) {
        返回 0;
    }
    如果 (字符串::字节长度(别名) == 0) {
        返回 0;
    }
    变量 已有: 字符串 = 别名指向(图, 别名);
    如果 (字符串::字节长度(已有) > 0) {
        如果 (已有 == id) {
            返回 1;
        }
        返回 0;
    }
    变量 项: 整数 = J.创建对象();
    J.设置字符串(项, "id", id);
    J.设置字符串(项, "原名", 别名);
    放(图, 键_别名(别名), J.转字符串(项));
    J.删除(项);
    // 节点上也留一份，好让 列别名 不用扫全库
    变量 属: 整数 = J.解码(取属性(图, id));
    如果 (属 <= 0) {
        属 = J.创建对象();
    }
    变量 组: 整数 = J.获取数组(属, "别名");
    如果 (组 <= 0) {
        组 = J.创建数组();
    }
    如果 (数组含字符串(组, 别名) == 0) {
        J.数组添加字符串(组, 别名);
    }
    J.设置数组(属, "别名", 组);
    改属性(图, id, J.转字符串(属));
    J.删除(属);
    返回 1;
}

// 这个别名指向哪个实体；没有返回空串。
公开 函数 别名指向(图: 整数, 别名: 字符串) : 字符串 {
    如果 (可用(图) == 0) {
        返回 "";
    }
    变量 文: 字符串 = 取(图, 键_别名(别名));
    如果 (字符串::字节长度(文) == 0) {
        返回 "";
    }
    变量 项: 整数 = J.解码(文);
    如果 (项 <= 0) {
        返回 "";
    }
    变量 id: 字符串 = J.获取字符串(项, "id");
    J.删除(项);
    返回 id;
}

// 某个实体的全部别名（字符串列表句柄，调用方删）
公开 函数 列别名(图: 整数, id: 字符串) : 整数 {
    变量 属: 整数 = J.解码(取属性(图, id));
    变量 出: 整数 = 表列::创建字符串列表();
    如果 (属 > 0) {
        变量 组: 整数 = J.获取数组(属, "别名");
        如果 (组 > 0) {
            表列::删除列表(出);
            出 = 数组转列表(组);
            J.删除(组);
        }
        J.删除(属);
    }
    返回 出;
}

公开 函数 删别名(图: 整数, 别名: 字符串) : 整数 {
    如果 (可用(图) == 0) {
        返回 0;
    }
    变量 id: 字符串 = 别名指向(图, 别名);
    如果 (字符串::字节长度(id) == 0) {
        返回 0;
    }
    删(图, 键_别名(别名));
    变量 属: 整数 = J.解码(取属性(图, id));
    如果 (属 > 0) {
        变量 组: 整数 = J.获取数组(属, "别名");
        如果 (组 > 0) {
            变量 新: 整数 = J.创建数组();
            变量 i: 整数 = 0;
            当 (i < J.数组长度(组)) {
                变量 一: 字符串 = J.数组获取字符串(组, i);
                如果 (一 != 别名) {
                    J.数组添加字符串(新, 一);
                }
                i = i + 1;
            }
            J.设置数组(属, "别名", 新);
            J.删除(组);
        }
        改属性(图, id, J.转字符串(属));
        J.删除(属);
    }
    返回 1;
}

// 删节点时把它的别名索引一起清掉，不留孤儿。
// 直接用 图.删节点 不会清 —— 那个模块不知道别名这回事。
公开 函数 删节点带别名(图: 整数, id: 字符串) : 整数 {
    变量 名表: 整数 = 列别名(图, id);
    变量 i: 整数 = 0;
    当 (i < 表列::字符串列表大小(名表)) {
        删(图, 键_别名(表列::获取字符串(名表, i)));
        i = i + 1;
    }
    表列::删除列表(名表);
    返回 删节点(图, id);
}

// ── 8.4.2 候选选择 ────────────────────────────────────────────────

// 一个提及可能指哪些实体。按三条路找，去重后按发现顺序给：
//   1. 提及本身就是一个节点 id
//   2. 提及是某个实体的别名
//   3. 提及是某个别名的**前缀或后缀**（"阿司匹林片" ↔ "阿司匹林"）—— 这条要扫别名索引，
//      所以只在前两条都没命中时才走，避免每次查询都全扫。
// 返回 JSON 数组：[{"id":…,"凭什么":"id|别名|近似","匹配到":…}]
公开 函数 候选(图: 整数, 提及: 字符串) : 字符串 {
    变量 组: 整数 = J.创建数组();
    如果 (可用(图) == 0 或 字符串::字节长度(提及) == 0) {
        变量 空: 字符串 = J.转字符串(组);
        J.删除(组);
        返回 空;
    }
    变量 见过: 整数 = 哈希表::创建整数表();

    如果 (有节点(图, 提及) == 1) {
        收候选(组, 见过, 提及, "id", 提及);
    }
    变量 直: 字符串 = 别名指向(图, 提及);
    如果 (字符串::字节长度(直) > 0) {
        收候选(组, 见过, 直, "别名", 提及);
    }
    如果 (J.数组长度(组) == 0) {
        近似候选(图, 提及, 组, 见过);
    }

    哈希表::释放表(见过);
    变量 出: 字符串 = J.转字符串(组);
    J.删除(组);
    返回 出;
}

函数 收候选(组: 整数, 见过: 整数, id: 字符串, 凭什么: 字符串, 匹配到: 字符串) {
    如果 (哈希表::包含键(见过, id) == 1) {
        返回;
    }
    哈希表::设置整数(见过, id, 1);
    变量 项: 整数 = J.创建对象();
    J.设置字符串(项, "id", id);
    J.设置字符串(项, "凭什么", 凭什么);
    J.设置字符串(项, "匹配到", 匹配到);
    J.数组添加对象(组, 项);
}

函数 近似候选(图: 整数, 提及: 字符串, 组: 整数, 见过: 整数) {
    变量 键表: 整数 = 前缀列键(图, 前缀_别名());
    变量 n: 整数 = 表列::字符串列表大小(键表);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 文: 字符串 = 取(图, 表列::获取字符串(键表, i));
        如果 (字符串::字节长度(文) > 0) {
            变量 项: 整数 = J.解码(文);
            如果 (项 > 0) {
                变量 原: 字符串 = J.获取字符串(项, "原名");
                如果 (字符串::字节长度(原) > 0) {
                    如果 (字符串::包含(提及, 原) == 1 或 字符串::包含(原, 提及) == 1) {
                        收候选(组, 见过, J.获取字符串(项, "id"), "近似", 原);
                    }
                }
                J.删除(项);
            }
        }
        i = i + 1;
    }
    表列::删除列表(键表);
}

// ── 8.4.3 路径翻成人话 ────────────────────────────────────────────

// 把一条节点路径（最短路径 给的那种字符串列表）渲染成一行：
//   阿司匹林 --抑制--> COX-1 --参与--> 炎症反应
// 边类型取两点之间**第一条**边的类型；两点之间没有直接边时写 --?--（理论上不会发生，
// 除非路径不是从这张图上算出来的）。列表由调用方负责删。
公开 函数 路径转文本(图: 整数, 路径: 整数) : 字符串 {
    变量 n: 整数 = 表列::字符串列表大小(路径);
    如果 (n == 0) {
        返回 "";
    }
    变量 出: 字符串 = 表列::获取字符串(路径, 0);
    变量 i: 整数 = 1;
    当 (i < n) {
        变量 上: 字符串 = 表列::获取字符串(路径, i - 1);
        变量 本: 字符串 = 表列::获取字符串(路径, i);
        出 = 出 + " --" + 两点间类型(图, 上, 本) + "--> " + 本;
        i = i + 1;
    }
    返回 出;
}

// 两点之间那条边的类型。先看正向，没有再看反向（反向的话写成 被X）。
函数 两点间类型(图: 整数, 甲: 字符串, 乙: 字符串) : 字符串 {
    变量 出表: 整数 = 出边(图, 甲);
    变量 型: 字符串 = 找一条(图, 出表, 乙, "to");
    表列::删除列表(出表);
    如果 (字符串::字节长度(型) > 0) {
        返回 型;
    }
    变量 入表: 整数 = 入边(图, 甲);
    型 = 找一条(图, 入表, 乙, "from");
    表列::删除列表(入表);
    如果 (字符串::字节长度(型) > 0) {
        返回 "被" + 型;
    }
    返回 "?";
}

函数 找一条(图: 整数, 边表: 整数, 对端: 字符串, 端字段: 字符串) : 字符串 {
    变量 n: 整数 = 表列::字符串列表大小(边表);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 边对象: 整数 = 读JSON(图, "g:e:" + 表列::获取字符串(边表, i));
        如果 (边对象 > 0) {
            变量 型: 字符串 = J.获取字符串(边对象, "type");
            变量 那端: 字符串 = J.获取字符串(边对象, 端字段);
            J.删除(边对象);
            如果 (那端 == 对端) {
                返回 型;
            }
        }
        i = i + 1;
    }
    返回 "";
}

// 一次把消歧要的材料备齐：每个候选到每个上下文实体的最短路，翻成人话。
// 这就是书里 8.4.3 喂给模型的那一段 —— 模型看着这些路径判断「这个提及说的是哪个」。
//
// 提及   文本里认出来的那个词
// 上下文JSON  同一段文本里其他已确定的实体 id 的 JSON 数组
// 返回一段 Markdown，候选一节，节里列它到各上下文实体的路径；走不通就写明走不通
// （**走不通本身是信息** —— 跟上下文一点关系都没有的候选多半就不是答案）。
公开 函数 消歧上下文(图: 整数, 提及: 字符串, 上下文JSON: 字符串) : 字符串 {
    变量 候选文: 字符串 = 候选(图, 提及);
    变量 候选组: 整数 = J.解码(候选文);
    如果 (候选组 <= 0 或 J.数组长度(候选组) == 0) {
        如果 (候选组 > 0) {
            J.删除(候选组);
        }
        返回 "提及「" + 提及 + "」在图里找不到任何候选实体。\n";
    }
    变量 上下文组: 整数 = J.解码(上下文JSON);
    变量 出: 字符串 = "提及「" + 提及 + "」有 "
        + J.数组长度(候选组) + " 个候选：\n";
    变量 i: 整数 = 0;
    当 (i < J.数组长度(候选组)) {
        变量 一: 整数 = J.数组获取对象(候选组, i);
        变量 id: 字符串 = J.获取字符串(一, "id");
        出 = 出 + "\n### " + id + "（" + J.获取字符串(一, "凭什么")
            + "：" + J.获取字符串(一, "匹配到") + "）\n";
        变量 标: 字符串 = 取标签(图, id);
        如果 (字符串::字节长度(标) > 0 与 标 != "[]") {
            出 = 出 + "标签 " + 标 + "\n";
        }
        如果 (上下文组 > 0 与 J.数组长度(上下文组) > 0) {
            变量 k: 整数 = 0;
            当 (k < J.数组长度(上下文组)) {
                变量 锚: 字符串 = J.数组获取字符串(上下文组, k);
                变量 路: 整数 = 无向最短路径(图, id, 锚);
                如果 (表列::字符串列表大小(路) == 0) {
                    出 = 出 + "- 与 " + 锚 + "：图里走不通\n";
                } 否则 {
                    出 = 出 + "- " + 路径转文本(图, 路) + "\n";
                }
                表列::删除列表(路);
                k = k + 1;
            }
        } 否则 {
            出 = 出 + "（没给上下文实体，无从比较）\n";
        }
        i = i + 1;
    }
    如果 (上下文组 > 0) {
        J.删除(上下文组);
    }
    J.删除(候选组);
    返回 出;
}

// ── 实体归并 ──────────────────────────────────────────────────────

// 从 起 出发有没有一条 型 的边指向 止。归并时用来挡重边。
// 走 出边 而不是扫全部边：出边是按节点存的邻接，O(该点的度)。
函数 已有这条边(图: 整数, 起: 字符串, 型: 字符串, 止: 字符串) : 整数 {
    变量 表: 整数 = 出边(图, 起);
    变量 i: 整数 = 0;
    变量 有: 整数 = 0;
    当 (i < 表列::字符串列表大小(表)) {
        变量 边对象: 整数 = 读JSON(图, "g:e:" + 表列::获取字符串(表, i));
        如果 (边对象 > 0) {
            如果 (J.获取字符串(边对象, "type") == 型
                与 J.获取字符串(边对象, "to") == 止) {
                有 = 1;
            }
            J.删除(边对象);
        }
        如果 (有 == 1) {
            跳出;
        }
        i = i + 1;
    }
    表列::删除列表(表);
    返回 有;
}

// 确认「并入」和「保留」是同一个东西之后，把前者并进后者：
//   · 并入方的**入边和出边**全部改挂到保留方（自环丢弃）
//   · **保留方已经有一条同型同端点的边时，改挂的那条直接丢掉，不留重边**
//   · 标签取并集
//   · 属性以**保留方为准**，并入方只补它没有的键（不覆盖已确认的那份）
//   · 并入方的 id 和它所有别名，都变成保留方的别名 —— 这样原文里再出现旧名字还查得到
//   · 并入方节点删除
// 返回改挂了几条边（丢掉的重边不算）；参数不合法返回 -1。
//
// 去重那条是后补的，真跑出来的：LLM 从 README 抽出「qi-graph 依赖 KV」，
// 手工建的图里本来就有「Graph 依赖 KV」，把 qi-graph 并进 Graph 之后
// 「谁依赖 KV」查出来是 [{"?p":"Graph"},{"?p":"Graph"}] —— 同一个答案两遍。
// **两个实体对同一个目标有同样的关系，正是它们该被判为同一个实体的理由**，
// 所以这在归并里不是边角情况，是主线情况。这个库允许平行边（多重图），
// 但归并的语义是「合成一个」，不是「攒成两条」。
公开 函数 合并节点(图: 整数, 保留: 字符串, 并入: 字符串) : 整数 {
    如果 (可用(图) == 0 或 保留 == 并入) {
        返回 0 - 1;
    }
    如果 (有节点(图, 保留) == 0 或 有节点(图, 并入) == 0) {
        返回 0 - 1;
    }
    变量 动了: 整数 = 0;

    // 出边
    变量 出表: 整数 = 出边(图, 并入);
    变量 i: 整数 = 0;
    当 (i < 表列::字符串列表大小(出表)) {
        变量 边id: 字符串 = 表列::获取字符串(出表, i);
        变量 边对象: 整数 = 读JSON(图, "g:e:" + 边id);
        如果 (边对象 > 0) {
            变量 型: 字符串 = J.获取字符串(边对象, "type");
            变量 指向: 字符串 = J.获取字符串(边对象, "to");
            变量 属: 整数 = J.获取对象(边对象, "props");
            变量 属文: 字符串 = "{}";
            如果 (属 > 0) {
                属文 = J.转字符串(属);
                J.删除(属);
            }
            J.删除(边对象);
            删边(图, 边id);
            如果 (指向 != 保留) {                       // 自环丢弃
                如果 (已有这条边(图, 保留, 型, 指向) == 0) {
                    加边(图, "", 型, 保留, 指向, 属文);
                    动了 = 动了 + 1;
                }
            }
        }
        i = i + 1;
    }
    表列::删除列表(出表);

    // 入边
    变量 入表: 整数 = 入边(图, 并入);
    变量 a: 整数 = 0;
    当 (a < 表列::字符串列表大小(入表)) {
        变量 边id2: 字符串 = 表列::获取字符串(入表, a);
        变量 边对象2: 整数 = 读JSON(图, "g:e:" + 边id2);
        如果 (边对象2 > 0) {
            变量 型2: 字符串 = J.获取字符串(边对象2, "type");
            变量 从: 字符串 = J.获取字符串(边对象2, "from");
            变量 属2: 整数 = J.获取对象(边对象2, "props");
            变量 属文2: 字符串 = "{}";
            如果 (属2 > 0) {
                属文2 = J.转字符串(属2);
                J.删除(属2);
            }
            J.删除(边对象2);
            删边(图, 边id2);
            如果 (从 != 保留) {
                如果 (已有这条边(图, 从, 型2, 保留) == 0) {
                    加边(图, "", 型2, 从, 保留, 属文2);
                    动了 = 动了 + 1;
                }
            }
        }
        a = a + 1;
    }
    表列::删除列表(入表);

    // 标签并集
    变量 标组: 整数 = J.解码(取标签(图, 并入));
    如果 (标组 > 0) {
        变量 b: 整数 = 0;
        当 (b < J.数组长度(标组)) {
            加标签(图, 保留, J.数组获取字符串(标组, b));
            b = b + 1;
        }
        J.删除(标组);
    }

    // 属性：保留方优先，只补缺
    变量 留属: 整数 = J.解码(取属性(图, 保留));
    变量 并属: 整数 = J.解码(取属性(图, 并入));
    如果 (留属 > 0 与 并属 > 0) {
        对于 键 在 J.键列表(并属) {
            如果 (键 != "别名") {
                变量 已: 字符串 = J.取显示值(留属, 键);
                如果 (字符串::字节长度(已) == 0) {
                    J.设置字符串(留属, 键, J.取显示值(并属, 键));
                }
            }
        }
        改属性(图, 保留, J.转字符串(留属));
    }
    如果 (留属 > 0) { J.删除(留属); }
    如果 (并属 > 0) { J.删除(并属); }

    // 旧 id 与旧别名统统变成保留方的别名
    变量 旧名表: 整数 = 列别名(图, 并入);
    变量 c: 整数 = 0;
    当 (c < 表列::字符串列表大小(旧名表)) {
        变量 旧: 字符串 = 表列::获取字符串(旧名表, c);
        删(图, 键_别名(旧));
        加别名(图, 保留, 旧);
        c = c + 1;
    }
    表列::删除列表(旧名表);
    删节点(图, 并入);
    加别名(图, 保留, 并入);
    返回 动了;
}

// ── 图库 上的方法形式 ─────────────────────────────────────────────

公开 函数 (自身 图库) 加别名(id: 字符串, 别名: 字符串) : 整数 { 返回 加别名(自身.句柄, id, 别名); }
公开 函数 (自身 图库) 别名指向(别名: 字符串) : 字符串 { 返回 别名指向(自身.句柄, 别名); }
公开 函数 (自身 图库) 列别名(id: 字符串) : 整数 { 返回 列别名(自身.句柄, id); }
公开 函数 (自身 图库) 删别名(别名: 字符串) : 整数 { 返回 删别名(自身.句柄, 别名); }
公开 函数 (自身 图库) 候选(提及: 字符串) : 字符串 { 返回 候选(自身.句柄, 提及); }
公开 函数 (自身 图库) 消歧上下文(提及: 字符串, 上下文JSON: 字符串) : 字符串 {
    返回 消歧上下文(自身.句柄, 提及, 上下文JSON);
}
公开 函数 (自身 图库) 合并节点(保留: 字符串, 并入: 字符串) : 整数 {
    返回 合并节点(自身.句柄, 保留, 并入);
}
