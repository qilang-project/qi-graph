// qi-graph · 图 —— 属性图的打开 / 关闭与节点 / 边的增删改查
//
// 建在 qi-kv 上：一个图就是一个 qi-kv 库，图句柄**就是** qi-kv 句柄。
// 所有键都在 `g:` 前缀下，前缀部分 ASCII，段用 ':' 分隔（所以 id 里不能有 ':'）：
//
//   g:n:<节点id>          节点 JSON  {"id":..,"labels":[..],"props":{..}}
//   g:e:<边id>            边 JSON    {"id":..,"type":..,"from":..,"to":..,"props":{..}}
//   g:out:<节点id>        出边 id 的 JSON 数组
//   g:in:<节点id>         入边 id 的 JSON 数组
//   g:l:<标签>:<节点id>   "1"        标签索引
//   g:t:<边类型>:<边id>   "1"        边类型索引
//   g:meta                {"nodes":N,"edges":M,"next_id":K}
//
// 邻接是「每个节点一条值」而不是靠前缀扫：qi-kv 的 前缀列键 是 O(全部槽) 的线性扫，
// 邻接查询要是走它，节点一多每次都在扫全库。前缀扫只留给「按标签列节点」
// 「按类型列边」这类索引。
//
// 返回约定跟 qi-kv 一致：缺失返回空串或 0，不抛异常。返回列表句柄的用完由调用方
// 列表::删除列表。JSON 走 标准库.JSON 的句柄式 API，子对象取出来是深拷贝，用完释放。

包 Graph;

导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 KV::{打开, 关闭, 可用, 放, 取, 删, 存在, 键数, 前缀列键, 开始缓写, 刷盘, 缓写中};

// ── 键 ────────────────────────────────────────────────────────────

公开 函数 键_节点(id: 字符串) : 字符串 { 返回 "g:n:" + id; }
公开 函数 键_边(id: 字符串) : 字符串 { 返回 "g:e:" + id; }
公开 函数 键_出(id: 字符串) : 字符串 { 返回 "g:out:" + id; }
公开 函数 键_入(id: 字符串) : 字符串 { 返回 "g:in:" + id; }
公开 函数 键_标签(标签: 字符串, id: 字符串) : 字符串 { 返回 "g:l:" + 标签 + ":" + id; }
公开 函数 键_类型(边类型: 字符串, id: 字符串) : 字符串 { 返回 "g:t:" + 边类型 + ":" + id; }
公开 函数 前缀_节点() : 字符串 { 返回 "g:n:"; }
公开 函数 前缀_边() : 字符串 { 返回 "g:e:"; }
函数 键_元() : 字符串 { 返回 "g:meta"; }

// id / 标签 / 边类型 都是键的一段：不能空、不能含 ':'
公开 函数 合法段(段: 字符串) : 整数 {
    如果 (字符串::字节长度(段) == 0) {
        返回 0;
    }
    如果 (字符串::包含(段, ":") == 1) {
        返回 0;
    }
    返回 1;
}

// ── 打开 / 关闭 ───────────────────────────────────────────────────

// 打不开（不是 qi-kv 文件、读不了）返回 -1；之后所有操作都安静地返回 0 / 空串
公开 函数 打开图(路径: 字符串) : 整数 {
    变量 库: 整数 = 打开(路径);
    如果 (可用(库) == 0) {
        返回 -1;
    }
    如果 (存在(库, 键_元()) == 0) {
        变量 元: 整数 = J.创建对象();
        J.设置整数(元, "nodes", 0);
        J.设置整数(元, "edges", 0);
        J.设置整数(元, "next_id", 1);
        放(库, 键_元(), J.转字符串(元));
        J.删除(元);
    }
    返回 库;
}

公开 函数 关闭图(图: 整数) : 整数 { 返回 关闭(图); }
公开 函数 图可用(图: 整数) : 整数 { 返回 可用(图); }

// 批量灌数据时开：qi-kv 缓写，攒一次 append（关闭图 / 结束批量 时落盘）
公开 函数 开始批量(图: 整数) : 整数 { 返回 开始缓写(图); }
公开 函数 结束批量(图: 整数) : 整数 { 返回 刷盘(图); }
公开 函数 批量中(图: 整数) : 整数 { 返回 缓写中(图); }

// ── 元数据 ────────────────────────────────────────────────────────

函数 读元(图: 整数) : 整数 {
    变量 h: 整数 = J.解码(取(图, 键_元()));
    如果 (h > 0) {
        返回 h;
    }
    h = J.创建对象();
    J.设置整数(h, "nodes", 0);
    J.设置整数(h, "edges", 0);
    J.设置整数(h, "next_id", 1);
    返回 h;
}

函数 元加(图: 整数, 字段: 字符串, 增量: 整数) : 整数 {
    变量 元: 整数 = 读元(图);
    J.设置整数(元, 字段, J.获取整数(元, 字段) + 增量);
    放(图, 键_元(), J.转字符串(元));
    J.删除(元);
    返回 1;
}

// 拿一个没用过的自动 id（前缀 n / e），顺带把 next_id 推过去
函数 下一个id(图: 整数, 前缀: 字符串, 已占键前缀: 字符串) : 字符串 {
    变量 元: 整数 = 读元(图);
    变量 k: 整数 = J.获取整数(元, "next_id");
    变量 候选: 字符串 = 前缀 + k;
    当 (存在(图, 已占键前缀 + 候选) == 1) {
        k = k + 1;
        候选 = 前缀 + k;
    }
    J.设置整数(元, "next_id", k + 1);
    放(图, 键_元(), J.转字符串(元));
    J.删除(元);
    返回 候选;
}

公开 函数 节点数(图: 整数) : 整数 {
    如果 (可用(图) == 0) {
        返回 0;
    }
    变量 元: 整数 = 读元(图);
    变量 n: 整数 = J.获取整数(元, "nodes");
    J.删除(元);
    返回 n;
}

公开 函数 边数(图: 整数) : 整数 {
    如果 (可用(图) == 0) {
        返回 0;
    }
    变量 元: 整数 = 读元(图);
    变量 n: 整数 = J.获取整数(元, "edges");
    J.删除(元);
    返回 n;
}

公开 函数 统计JSON(图: 整数) : 字符串 {
    如果 (可用(图) == 0) {
        返回 "{\"open\":false}";
    }
    变量 元: 整数 = 读元(图);
    J.设置布尔(元, "open", 1);
    J.设置整数(元, "kv_keys", 键数(图));
    变量 出: 字符串 = J.转字符串(元);
    J.删除(元);
    返回 出;
}

// ── JSON 小工具（本包内其他模块也用）─────────────────────────────

// 读键上的 JSON，解不出返回 0（调用方释放）
公开 函数 读JSON(图: 整数, 键: 字符串) : 整数 {
    变量 文本: 字符串 = 取(图, 键);
    如果 (字符串::字节长度(文本) == 0) {
        返回 0;
    }
    返回 J.解码(文本);
}

公开 函数 数组含字符串(组: 整数, 值: 字符串) : 整数 {
    变量 n: 整数 = J.数组长度(组);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (J.数组获取字符串(组, i) == 值) {
            返回 1;
        }
        i = i + 1;
    }
    返回 0;
}

// 返回去掉了 值 的新数组（调用方释放）；JSON 没有「删数组元素」，只能重建
公开 函数 数组去字符串(组: 整数, 值: 字符串) : 整数 {
    变量 出: 整数 = J.创建数组();
    变量 n: 整数 = J.数组长度(组);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 s: 字符串 = J.数组获取字符串(组, i);
        如果 (s != 值) {
            J.数组添加字符串(出, s);
        }
        i = i + 1;
    }
    返回 出;
}

// 把 JSON 字符串数组读成字符串列表句柄（调用方 列表::删除列表）
公开 函数 数组转列表(组: 整数) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    如果 (组 <= 0) {
        返回 出;
    }
    变量 n: 整数 = J.数组长度(组);
    变量 i: 整数 = 0;
    当 (i < n) {
        表列::添加字符串(出, J.数组获取字符串(组, i));
        i = i + 1;
    }
    返回 出;
}

// 把 源[键] 原样（保留类型）复制到 目标[键]。
// JSON 模块没有「问一个字段是什么类型」，只能按取值结果推：
// 对象 / 数组 用句柄取（取不到就是不是）；字符串非空就是字符串；
// 剩下看显示值："真"/"假" 是布尔，空是 null 或空串（都当空串），其余是数字。
公开 函数 复制字段(源: 整数, 键: 字符串, 目标: 整数) : 整数 {
    变量 子对象: 整数 = J.获取对象(源, 键);
    如果 (子对象 > 0) {
        J.设置对象(目标, 键, 子对象);
        J.删除(子对象);
        返回 1;
    }
    变量 子数组: 整数 = J.获取数组(源, 键);
    如果 (子数组 > 0) {
        J.设置数组(目标, 键, 子数组);
        J.删除(子数组);
        返回 1;
    }
    变量 串: 字符串 = J.获取字符串(源, 键);
    如果 (字符串::字节长度(串) > 0) {
        J.设置字符串(目标, 键, 串);
        返回 1;
    }
    变量 显示: 字符串 = J.取显示值(源, 键);
    如果 (显示 == "真") {
        J.设置布尔(目标, 键, 1);
        返回 1;
    }
    如果 (显示 == "假") {
        J.设置布尔(目标, 键, 0);
        返回 1;
    }
    如果 (字符串::字节长度(显示) == 0) {
        J.设置字符串(目标, 键, "");
        返回 1;
    }
    如果 (字符串::包含(显示, ".") == 1 或 字符串::包含(显示, "e") == 1 或 字符串::包含(显示, "E") == 1) {
        J.设置浮点数(目标, 键, J.获取浮点数(源, 键));
        返回 1;
    }
    J.设置整数(目标, 键, J.获取整数(源, 键));
    返回 1;
}

// 把 补丁 的每个字段合并进 目标（同名覆盖，其余保留）
公开 函数 合并对象(目标: 整数, 补丁: 整数) : 整数 {
    变量 n: 整数 = 0;
    对于 k 在 J.键列表(补丁) {
        复制字段(补丁, k, 目标);
        n = n + 1;
    }
    返回 n;
}

// 解析属性 JSON："" 当空对象；解不出或不是对象返回 0
函数 解析属性(属性JSON: 字符串) : 整数 {
    变量 净: 字符串 = 字符串::去空白(属性JSON);
    如果 (字符串::字节长度(净) == 0) {
        返回 J.创建对象();
    }
    如果 (字符串::开始于(净, "{") == 0) {
        返回 0;
    }
    返回 J.解码(净);
}

// 解析标签 JSON 数组："" 当空数组；解不出或不是数组返回 0
函数 解析标签(标签JSON: 字符串) : 整数 {
    变量 净: 字符串 = 字符串::去空白(标签JSON);
    如果 (字符串::字节长度(净) == 0) {
        返回 J.创建数组();
    }
    如果 (字符串::开始于(净, "[") == 0) {
        返回 0;
    }
    返回 J.解码(净);
}

// ── 节点 ──────────────────────────────────────────────────────────

// 加一个节点。id 已存在、含 ':'、标签/属性 JSON 解不出都返回 0（不覆盖已有节点）。
// 标签里含 ':' 的那一项会被跳过（它进不了索引键）。
公开 函数 加节点(图: 整数, id: 字符串, 标签JSON: 字符串, 属性JSON: 字符串) : 整数 {
    如果 (可用(图) == 0 或 合法段(id) == 0) {
        返回 0;
    }
    如果 (存在(图, 键_节点(id)) == 1) {
        返回 0;
    }
    变量 标签: 整数 = 解析标签(标签JSON);
    如果 (标签 <= 0) {
        返回 0;
    }
    变量 属性: 整数 = 解析属性(属性JSON);
    如果 (属性 <= 0) {
        J.删除(标签);
        返回 0;
    }

    // 去重 + 过滤掉进不了键的标签
    变量 净标签: 整数 = J.创建数组();
    变量 n: 整数 = J.数组长度(标签);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 l: 字符串 = J.数组获取字符串(标签, i);
        如果 (合法段(l) == 1 与 数组含字符串(净标签, l) == 0) {
            J.数组添加字符串(净标签, l);
            放(图, 键_标签(l, id), "1");
        }
        i = i + 1;
    }

    变量 节点: 整数 = J.创建对象();
    J.设置字符串(节点, "id", id);
    J.设置数组(节点, "labels", 净标签);
    J.设置对象(节点, "props", 属性);
    放(图, 键_节点(id), J.转字符串(节点));
    放(图, 键_出(id), "[]");
    放(图, 键_入(id), "[]");
    元加(图, "nodes", 1);

    J.删除(节点);
    J.删除(净标签);
    J.删除(标签);
    J.删除(属性);
    返回 1;
}

// 自动分配 id（n1、n2 …）并加节点，返回分配到的 id；失败返回空串
公开 函数 新节点(图: 整数, 标签JSON: 字符串, 属性JSON: 字符串) : 字符串 {
    如果 (可用(图) == 0) {
        返回 "";
    }
    变量 id: 字符串 = 下一个id(图, "n", 前缀_节点());
    如果 (加节点(图, id, 标签JSON, 属性JSON) == 0) {
        返回 "";
    }
    返回 id;
}

// 节点 JSON 文本；没有返回空串
公开 函数 取节点(图: 整数, id: 字符串) : 字符串 { 返回 取(图, 键_节点(id)); }
公开 函数 有节点(图: 整数, id: 字符串) : 整数 { 返回 存在(图, 键_节点(id)); }

// 只要属性对象的 JSON 文本；没有节点返回空串
公开 函数 取属性(图: 整数, id: 字符串) : 字符串 {
    变量 节点: 整数 = 读JSON(图, 键_节点(id));
    如果 (节点 <= 0) {
        返回 "";
    }
    变量 属性: 整数 = J.获取对象(节点, "props");
    变量 出: 字符串 = "{}";
    如果 (属性 > 0) {
        出 = J.转字符串(属性);
        J.删除(属性);
    }
    J.删除(节点);
    返回 出;
}

// 只要标签数组的 JSON 文本；没有节点返回空串
公开 函数 取标签(图: 整数, id: 字符串) : 字符串 {
    变量 节点: 整数 = 读JSON(图, 键_节点(id));
    如果 (节点 <= 0) {
        返回 "";
    }
    变量 标签: 整数 = J.获取数组(节点, "labels");
    变量 出: 字符串 = "[]";
    如果 (标签 > 0) {
        出 = J.转字符串(标签);
        J.删除(标签);
    }
    J.删除(节点);
    返回 出;
}

// 合并属性（同名覆盖、其余保留）。要整个换掉先 删节点 再 加节点。
公开 函数 改属性(图: 整数, id: 字符串, 属性JSON: 字符串) : 整数 {
    变量 节点: 整数 = 读JSON(图, 键_节点(id));
    如果 (节点 <= 0) {
        返回 0;
    }
    变量 补丁: 整数 = 解析属性(属性JSON);
    如果 (补丁 <= 0) {
        J.删除(节点);
        返回 0;
    }
    变量 属性: 整数 = J.获取对象(节点, "props");
    如果 (属性 <= 0) {
        属性 = J.创建对象();
    }
    合并对象(属性, 补丁);
    J.设置对象(节点, "props", 属性);
    放(图, 键_节点(id), J.转字符串(节点));
    J.删除(属性);
    J.删除(补丁);
    J.删除(节点);
    返回 1;
}

公开 函数 有标签(图: 整数, id: 字符串, 标签: 字符串) : 整数 {
    返回 存在(图, 键_标签(标签, id));
}

// 返回 1 = 现在有这个标签（本来就有也算），0 = 节点不存在或标签不合法
公开 函数 加标签(图: 整数, id: 字符串, 标签: 字符串) : 整数 {
    如果 (合法段(标签) == 0) {
        返回 0;
    }
    变量 节点: 整数 = 读JSON(图, 键_节点(id));
    如果 (节点 <= 0) {
        返回 0;
    }
    变量 标签组: 整数 = J.获取数组(节点, "labels");
    如果 (标签组 <= 0) {
        标签组 = J.创建数组();
    }
    如果 (数组含字符串(标签组, 标签) == 0) {
        J.数组添加字符串(标签组, 标签);
        J.设置数组(节点, "labels", 标签组);
        放(图, 键_节点(id), J.转字符串(节点));
        放(图, 键_标签(标签, id), "1");
    }
    J.删除(标签组);
    J.删除(节点);
    返回 1;
}

// 返回 1 = 现在没有这个标签，0 = 节点不存在
公开 函数 去标签(图: 整数, id: 字符串, 标签: 字符串) : 整数 {
    变量 节点: 整数 = 读JSON(图, 键_节点(id));
    如果 (节点 <= 0) {
        返回 0;
    }
    变量 标签组: 整数 = J.获取数组(节点, "labels");
    如果 (标签组 > 0 与 数组含字符串(标签组, 标签) == 1) {
        变量 新组: 整数 = 数组去字符串(标签组, 标签);
        J.设置数组(节点, "labels", 新组);
        放(图, 键_节点(id), J.转字符串(节点));
        J.删除(新组);
    }
    删(图, 键_标签(标签, id));
    如果 (标签组 > 0) {
        J.删除(标签组);
    }
    J.删除(节点);
    返回 1;
}

// 走标签索引（前缀扫）；返回节点 id 的字符串列表句柄
公开 函数 按标签列节点(图: 整数, 标签: 字符串) : 整数 {
    返回 去前缀列(图, "g:l:" + 标签 + ":");
}

// 走边类型索引（前缀扫）；返回边 id 的字符串列表句柄
公开 函数 按类型列边(图: 整数, 边类型: 字符串) : 整数 {
    返回 去前缀列(图, "g:t:" + 边类型 + ":");
}

// 全部节点 id / 边 id（前缀扫整库，只给导出、统计这类全量活用）
公开 函数 列全部节点(图: 整数) : 整数 { 返回 去前缀列(图, 前缀_节点()); }
公开 函数 列全部边(图: 整数) : 整数 { 返回 去前缀列(图, 前缀_边()); }

函数 去前缀列(图: 整数, 前缀: 字符串) : 整数 {
    变量 出: 整数 = 表列::创建字符串列表();
    如果 (可用(图) == 0) {
        返回 出;
    }
    变量 键表: 整数 = 前缀列键(图, 前缀);
    变量 n: 整数 = 表列::字符串列表大小(键表);
    变量 切: 整数 = 字符串::字节长度(前缀);
    变量 i: 整数 = 0;
    当 (i < n) {
        表列::添加字符串(出, 字符串::子串从位置(表列::获取字符串(键表, i), 切));
        i = i + 1;
    }
    表列::删除列表(键表);
    返回 出;
}

// 删节点并级联：它的所有出入边一起删，对端的邻接表和类型索引同步维护
公开 函数 删节点(图: 整数, id: 字符串) : 整数 {
    变量 节点: 整数 = 读JSON(图, 键_节点(id));
    如果 (节点 <= 0) {
        返回 0;
    }

    // 出边：对端要改的是它们的 in 表；本节点的 out 表马上整条删，不用逐条改
    变量 出表: 整数 = 读JSON(图, 键_出(id));
    如果 (出表 > 0) {
        变量 n: 整数 = J.数组长度(出表);
        变量 i: 整数 = 0;
        当 (i < n) {
            删边内部(图, J.数组获取字符串(出表, i), 1, 0);
            i = i + 1;
        }
        J.删除(出表);
    }
    变量 入表: 整数 = 读JSON(图, 键_入(id));
    如果 (入表 > 0) {
        变量 m: 整数 = J.数组长度(入表);
        变量 j: 整数 = 0;
        当 (j < m) {
            // 自环在上一轮已经删掉了，这里 删边内部 会找不到边、安静返回 0
            删边内部(图, J.数组获取字符串(入表, j), 0, 1);
            j = j + 1;
        }
        J.删除(入表);
    }

    变量 标签组: 整数 = J.获取数组(节点, "labels");
    如果 (标签组 > 0) {
        变量 k: 整数 = J.数组长度(标签组);
        变量 t: 整数 = 0;
        当 (t < k) {
            删(图, 键_标签(J.数组获取字符串(标签组, t), id));
            t = t + 1;
        }
        J.删除(标签组);
    }
    J.删除(节点);

    删(图, 键_出(id));
    删(图, 键_入(id));
    删(图, 键_节点(id));
    元加(图, "nodes", -1);
    返回 1;
}

// ── 边 ────────────────────────────────────────────────────────────

// 往 键 上的 JSON 数组追加一个字符串
函数 邻接追加(图: 整数, 键: 字符串, 值: 字符串) : 整数 {
    变量 表: 整数 = 读JSON(图, 键);
    如果 (表 <= 0) {
        表 = J.创建数组();
    }
    J.数组添加字符串(表, 值);
    放(图, 键, J.转字符串(表));
    J.删除(表);
    返回 1;
}

函数 邻接去掉(图: 整数, 键: 字符串, 值: 字符串) : 整数 {
    变量 表: 整数 = 读JSON(图, 键);
    如果 (表 <= 0) {
        返回 0;
    }
    变量 新表: 整数 = 数组去字符串(表, 值);
    放(图, 键, J.转字符串(新表));
    J.删除(新表);
    J.删除(表);
    返回 1;
}

// 加一条有向边。id 传空串则自动分配。起点终点不存在、id 已存在或含 ':'、
// 边类型不合法、属性解不出都返回 0。
公开 函数 加边(图: 整数, id: 字符串, 边类型: 字符串, 起: 字符串, 止: 字符串, 属性JSON: 字符串) : 整数 {
    如果 (字符串::字节长度(新边带id(图, id, 边类型, 起, 止, 属性JSON)) == 0) {
        返回 0;
    }
    返回 1;
}

// 自动分配 id（e1、e2 …）并加边，返回分配到的 id；失败返回空串
公开 函数 新边(图: 整数, 边类型: 字符串, 起: 字符串, 止: 字符串, 属性JSON: 字符串) : 字符串 {
    返回 新边带id(图, "", 边类型, 起, 止, 属性JSON);
}

函数 新边带id(图: 整数, 给定id: 字符串, 边类型: 字符串, 起: 字符串, 止: 字符串, 属性JSON: 字符串) : 字符串 {
    如果 (可用(图) == 0 或 合法段(边类型) == 0) {
        返回 "";
    }
    如果 (存在(图, 键_节点(起)) == 0 或 存在(图, 键_节点(止)) == 0) {
        返回 "";
    }
    变量 id: 字符串 = 给定id;
    如果 (字符串::字节长度(id) == 0) {
        id = 下一个id(图, "e", 前缀_边());
    } 否则 {
        如果 (合法段(id) == 0 或 存在(图, 键_边(id)) == 1) {
            返回 "";
        }
    }
    变量 属性: 整数 = 解析属性(属性JSON);
    如果 (属性 <= 0) {
        返回 "";
    }

    变量 边: 整数 = J.创建对象();
    J.设置字符串(边, "id", id);
    J.设置字符串(边, "type", 边类型);
    J.设置字符串(边, "from", 起);
    J.设置字符串(边, "to", 止);
    J.设置对象(边, "props", 属性);
    放(图, 键_边(id), J.转字符串(边));
    邻接追加(图, 键_出(起), id);
    邻接追加(图, 键_入(止), id);
    放(图, 键_类型(边类型, id), "1");
    元加(图, "edges", 1);

    J.删除(边);
    J.删除(属性);
    返回 id;
}

公开 函数 取边(图: 整数, id: 字符串) : 字符串 { 返回 取(图, 键_边(id)); }
公开 函数 有边(图: 整数, id: 字符串) : 整数 { 返回 存在(图, 键_边(id)); }

公开 函数 删边(图: 整数, id: 字符串) : 整数 {
    返回 删边内部(图, id, 0, 0);
}

// 跳过起点/终点 = 那一侧的邻接表马上要被整条删掉，不用逐条改（删节点级联用）
函数 删边内部(图: 整数, id: 字符串, 跳过起点: 整数, 跳过终点: 整数) : 整数 {
    变量 边: 整数 = 读JSON(图, 键_边(id));
    如果 (边 <= 0) {
        返回 0;
    }
    变量 起: 字符串 = J.获取字符串(边, "from");
    变量 止: 字符串 = J.获取字符串(边, "to");
    变量 边类型: 字符串 = J.获取字符串(边, "type");
    J.删除(边);

    如果 (跳过起点 == 0) {
        邻接去掉(图, 键_出(起), id);
    }
    如果 (跳过终点 == 0) {
        邻接去掉(图, 键_入(止), id);
    }
    删(图, 键_类型(边类型, id));
    删(图, 键_边(id));
    元加(图, "edges", -1);
    返回 1;
}

// 合并边属性（同名覆盖、其余保留）
公开 函数 改边属性(图: 整数, id: 字符串, 属性JSON: 字符串) : 整数 {
    变量 边: 整数 = 读JSON(图, 键_边(id));
    如果 (边 <= 0) {
        返回 0;
    }
    变量 补丁: 整数 = 解析属性(属性JSON);
    如果 (补丁 <= 0) {
        J.删除(边);
        返回 0;
    }
    变量 属性: 整数 = J.获取对象(边, "props");
    如果 (属性 <= 0) {
        属性 = J.创建对象();
    }
    合并对象(属性, 补丁);
    J.设置对象(边, "props", 属性);
    放(图, 键_边(id), J.转字符串(边));
    J.删除(属性);
    J.删除(补丁);
    J.删除(边);
    返回 1;
}

// ── 链式：图库 ────────────────────────────────────────────────────
//
// 结构体里只装一个句柄，复制它复制的是句柄不是状态。自由函数是本体，方法是一行转发。
// 遍历 / 查询 / 导入导出 的方法分别定义在各自的模块里。

公开 类型 图库 {
    句柄: 整数,
}

公开 函数 开图(路径: 字符串) : 图库 {
    返回 新建 图库 { 句柄: 打开图(路径) };
}

公开 函数 (自身 图库) 可用() : 整数 { 返回 可用(自身.句柄); }
公开 函数 (自身 图库) 关() : 整数 { 返回 关闭图(自身.句柄); }
公开 函数 (自身 图库) 开始批量() : 图库 { 开始批量(自身.句柄); 返回 自身; }
公开 函数 (自身 图库) 结束批量() : 图库 { 结束批量(自身.句柄); 返回 自身; }

// 写（返回自身，可以接着串；想知道成没成用自由函数）
公开 函数 (自身 图库) 加节点(id: 字符串, 标签JSON: 字符串, 属性JSON: 字符串) : 图库 {
    加节点(自身.句柄, id, 标签JSON, 属性JSON);
    返回 自身;
}
公开 函数 (自身 图库) 加边(id: 字符串, 边类型: 字符串, 起: 字符串, 止: 字符串, 属性JSON: 字符串) : 图库 {
    加边(自身.句柄, id, 边类型, 起, 止, 属性JSON);
    返回 自身;
}
公开 函数 (自身 图库) 连(边类型: 字符串, 起: 字符串, 止: 字符串) : 图库 {
    新边(自身.句柄, 边类型, 起, 止, "{}");
    返回 自身;
}
公开 函数 (自身 图库) 删节点(id: 字符串) : 图库 { 删节点(自身.句柄, id); 返回 自身; }
公开 函数 (自身 图库) 删边(id: 字符串) : 图库 { 删边(自身.句柄, id); 返回 自身; }
公开 函数 (自身 图库) 改属性(id: 字符串, 属性JSON: 字符串) : 图库 { 改属性(自身.句柄, id, 属性JSON); 返回 自身; }
公开 函数 (自身 图库) 加标签(id: 字符串, 标签: 字符串) : 图库 { 加标签(自身.句柄, id, 标签); 返回 自身; }
公开 函数 (自身 图库) 去标签(id: 字符串, 标签: 字符串) : 图库 { 去标签(自身.句柄, id, 标签); 返回 自身; }

// 读
公开 函数 (自身 图库) 新节点(标签JSON: 字符串, 属性JSON: 字符串) : 字符串 { 返回 新节点(自身.句柄, 标签JSON, 属性JSON); }
公开 函数 (自身 图库) 新边(边类型: 字符串, 起: 字符串, 止: 字符串, 属性JSON: 字符串) : 字符串 { 返回 新边(自身.句柄, 边类型, 起, 止, 属性JSON); }
公开 函数 (自身 图库) 取节点(id: 字符串) : 字符串 { 返回 取节点(自身.句柄, id); }
公开 函数 (自身 图库) 有节点(id: 字符串) : 整数 { 返回 有节点(自身.句柄, id); }
公开 函数 (自身 图库) 取属性(id: 字符串) : 字符串 { 返回 取属性(自身.句柄, id); }
公开 函数 (自身 图库) 取标签(id: 字符串) : 字符串 { 返回 取标签(自身.句柄, id); }
公开 函数 (自身 图库) 有标签(id: 字符串, 标签: 字符串) : 整数 { 返回 有标签(自身.句柄, id, 标签); }
公开 函数 (自身 图库) 取边(id: 字符串) : 字符串 { 返回 取边(自身.句柄, id); }
公开 函数 (自身 图库) 有边(id: 字符串) : 整数 { 返回 有边(自身.句柄, id); }
公开 函数 (自身 图库) 按标签列节点(标签: 字符串) : 整数 { 返回 按标签列节点(自身.句柄, 标签); }
公开 函数 (自身 图库) 按类型列边(边类型: 字符串) : 整数 { 返回 按类型列边(自身.句柄, 边类型); }
公开 函数 (自身 图库) 节点数() : 整数 { 返回 节点数(自身.句柄); }
公开 函数 (自身 图库) 边数() : 整数 { 返回 边数(自身.句柄); }
公开 函数 (自身 图库) 统计JSON() : 字符串 { 返回 统计JSON(自身.句柄); }
