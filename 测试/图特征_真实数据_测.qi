    变量 榜: 字符串 = 排行JSON(图, 表, 3);
    断言包含(榜, "\"id\":\"成员00\"", "介数榜首是教练");
    断言包含(榜, "\"id\":\"成员33\"", "第二是会长");
    断言包含(榜, "\"id\":\"成员32\"", "第三是成员32");
    哈希表::释放表(表);
    关闭图(图);
    返回 1;
}

