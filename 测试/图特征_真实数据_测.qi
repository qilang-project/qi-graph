    和 = 和 + 哈希表::获取浮点数(表, "成员27");
    断言约等(哈希表::获取浮点数(表, "成员28"), 0.019573459463, 0.000000001, "成员28 的 PageRank");
    和 = 和 + 哈希表::获取浮点数(表, "成员28");
    断言约等(哈希表::获取浮点数(表, "成员29"), 0.026288537692, 0.000000001, "成员29 的 PageRank");
    和 = 和 + 哈希表::获取浮点数(表, "成员29");
    断言约等(哈希表::获取浮点数(表, "成员30"), 0.024590155247, 0.000000001, "成员30 的 PageRank");
    和 = 和 + 哈希表::获取浮点数(表, "成员30");
    断言约等(哈希表::获取浮点数(表, "成员31"), 0.037158087066, 0.000000001, "成员31 的 PageRank");
    和 = 和 + 哈希表::获取浮点数(表, "成员31");
    断言约等(哈希表::获取浮点数(表, "成员32"), 0.071693225998, 0.000000001, "成员32 的 PageRank");
    和 = 和 + 哈希表::获取浮点数(表, "成员32");
    断言约等(哈希表::获取浮点数(表, "成员33"), 0.100919182323, 0.000000001, "成员33 的 PageRank");
    和 = 和 + 哈希表::获取浮点数(表, "成员33");
    断言约等(和, 1.0, 0.000000001, "PageRank 总和为 1");

    // 孪生点必须同分 —— 这一条钉住的是「不读权重」这件事本身
    断言约等(哈希表::获取浮点数(表, "成员14"), 哈希表::获取浮点数(表, "成员18"),
        0.000000000001, "结构相同的两个点，分数必须一模一样");

    // PageRank 榜首是会长(33)，介数榜首却是教练(00) —— 两个指标问的不是同一件事：
    // 会长连的人多、且连的都是同样连得多的人；教练赢在「不经过我谁也过不去」。
    变量 榜: 字符串 = 排行JSON(图, 表, 1);
    断言包含(榜, "\"id\":\"成员33\"", "PageRank 榜首是会长");
    哈希表::释放表(表);
    关闭图(图);
    返回 1;
}
// ── 按标签度：拿真实的分裂结果当标签 ──
//
// 这张图出名的原因就是「结构预告了站队」。同派邻居占比高的人立场稳，
// 低的就是骑墙的 —— 成员08 是最有名的那个：他自己跟了教练，五个朋友里三个跟了会长。
函数 测_派系() : 整数 {
    变量 图: 整数 = 建空手道();
    断言相等整数(按标签度(图, "成员00", "教练派"), 15, "成员00 的同派邻居数");
    断言约等(按标签度占比(图, "成员00", "教练派"), 0.9375, 0.000000001, "成员00 的同派占比");
    断言相等整数(按标签度(图, "成员33", "会长派"), 14, "成员33 的同派邻居数");
    断言约等(按标签度占比(图, "成员33", "会长派"), 0.823529411765, 0.000000001, "成员33 的同派占比");
    断言相等整数(按标签度(图, "成员02", "教练派"), 6, "成员02 的同派邻居数");
    断言约等(按标签度占比(图, "成员02", "教练派"), 0.6, 0.000000001, "成员02 的同派占比");
    断言相等整数(按标签度(图, "成员08", "教练派"), 2, "成员08 的同派邻居数");
    断言约等(按标签度占比(图, "成员08", "教练派"), 0.4, 0.000000001, "成员08 的同派占比");
    断言相等整数(按标签度(图, "成员09", "会长派"), 1, "成员09 的同派邻居数");
    断言约等(按标签度占比(图, "成员09", "会长派"), 0.5, 0.000000001, "成员09 的同派占比");

    断言为真(按标签度占比(图, "成员00", "教练派") > 按标签度占比(图, "成员08", "教练派"),
        "教练的圈子比骑墙的成员08 纯得多");
    关闭图(图);
    返回 1;
}

函数 入口() {
    运行用例("空手道·局部指标", 测_局部指标);
    运行用例("空手道·介数中心性", 测_介数);
    运行用例("空手道·接近中心性", 测_接近);
    运行用例("空手道·PageRank", 测_PageRank);
    运行用例("空手道·真实派系", 测_派系);
    摘要并退出();
}
