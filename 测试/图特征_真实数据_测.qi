    断言相等整数(三角形数(图, "成员27"), 1, "成员27 的三角形数");
    断言约等(聚类系数(图, "成员27"), 0.166666666667, 0.000000001, "成员27 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员28"), 3, "成员28 的度");
    断言相等整数(三角形数(图, "成员28"), 1, "成员28 的三角形数");
    断言约等(聚类系数(图, "成员28"), 0.333333333333, 0.000000001, "成员28 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员29"), 4, "成员29 的度");
    断言相等整数(三角形数(图, "成员29"), 4, "成员29 的三角形数");
    断言约等(聚类系数(图, "成员29"), 0.666666666667, 0.000000001, "成员29 的聚类系数");
    三角合计 = 三角合计 + 4;
    断言相等整数(无向度(图, "成员30"), 4, "成员30 的度");
    断言相等整数(三角形数(图, "成员30"), 3, "成员30 的三角形数");
    断言约等(聚类系数(图, "成员30"), 0.5, 0.000000001, "成员30 的聚类系数");
    三角合计 = 三角合计 + 3;
    断言相等整数(无向度(图, "成员31"), 6, "成员31 的度");
    断言相等整数(三角形数(图, "成员31"), 3, "成员31 的三角形数");
    断言约等(聚类系数(图, "成员31"), 0.2, 0.000000001, "成员31 的聚类系数");
    三角合计 = 三角合计 + 3;
    断言相等整数(无向度(图, "成员32"), 12, "成员32 的度");
    断言相等整数(三角形数(图, "成员32"), 13, "成员32 的三角形数");
    断言约等(聚类系数(图, "成员32"), 0.19696969697, 0.000000001, "成员32 的聚类系数");
    三角合计 = 三角合计 + 13;
    断言相等整数(无向度(图, "成员33"), 17, "成员33 的度");
    断言相等整数(三角形数(图, "成员33"), 15, "成员33 的三角形数");
    断言约等(聚类系数(图, "成员33"), 0.110294117647, 0.000000001, "成员33 的聚类系数");
    三角合计 = 三角合计 + 15;

    // 每个三角形被它的三个顶点各数一次 —— 合计除以 3 是全图三角形数，networkx 给 45
    断言相等整数(三角合计 / 3, 45, "全图 45 个三角形");

    // 自我网密度：教练(成员00)的圈子 17 人 34 条边 → 0.25；成员11 只有一个朋友 → 1.0
    断言约等(自我网密度(图, "成员00"), 0.25, 0.000000001, "教练的自我网密度");
    断言约等(自我网密度(图, "成员11"), 1.0, 0.000000001, "只有一个朋友时自我网是满的");

    关闭图(图);
    返回 1;
}

// ── 介数中心性：全 34 点跟 networkx 对 ──
