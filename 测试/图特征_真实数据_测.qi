// ── 度 / 三角形 / 聚类：逐点跟 networkx 对 ──
函数 测_局部指标() : 整数 {
    变量 图: 整数 = 建空手道();
    断言相等整数(节点数(图), 34, "34 个成员");

    // 全部 34 个点逐个对：度、三角形数、聚类系数
    变量 三角合计: 整数 = 0;
    断言相等整数(无向度(图, "成员00"), 16, "成员00 的度");
    断言相等整数(三角形数(图, "成员00"), 18, "成员00 的三角形数");
    断言约等(聚类系数(图, "成员00"), 0.15, 0.000000001, "成员00 的聚类系数");
    三角合计 = 三角合计 + 18;
    断言相等整数(无向度(图, "成员01"), 9, "成员01 的度");
    断言相等整数(三角形数(图, "成员01"), 12, "成员01 的三角形数");
    断言约等(聚类系数(图, "成员01"), 0.333333333333, 0.000000001, "成员01 的聚类系数");
    三角合计 = 三角合计 + 12;
    断言相等整数(无向度(图, "成员02"), 10, "成员02 的度");
    断言相等整数(三角形数(图, "成员02"), 11, "成员02 的三角形数");
    断言约等(聚类系数(图, "成员02"), 0.244444444444, 0.000000001, "成员02 的聚类系数");
    三角合计 = 三角合计 + 11;
    断言相等整数(无向度(图, "成员03"), 6, "成员03 的度");
    断言相等整数(三角形数(图, "成员03"), 10, "成员03 的三角形数");
    断言约等(聚类系数(图, "成员03"), 0.666666666667, 0.000000001, "成员03 的聚类系数");
    三角合计 = 三角合计 + 10;
    断言相等整数(无向度(图, "成员04"), 3, "成员04 的度");
    断言相等整数(三角形数(图, "成员04"), 2, "成员04 的三角形数");
    断言约等(聚类系数(图, "成员04"), 0.666666666667, 0.000000001, "成员04 的聚类系数");
    三角合计 = 三角合计 + 2;
    断言相等整数(无向度(图, "成员05"), 4, "成员05 的度");
    断言相等整数(三角形数(图, "成员05"), 3, "成员05 的三角形数");
    断言约等(聚类系数(图, "成员05"), 0.5, 0.000000001, "成员05 的聚类系数");
    三角合计 = 三角合计 + 3;
    断言相等整数(无向度(图, "成员06"), 4, "成员06 的度");
    断言相等整数(三角形数(图, "成员06"), 3, "成员06 的三角形数");
    断言约等(聚类系数(图, "成员06"), 0.5, 0.000000001, "成员06 的聚类系数");
    三角合计 = 三角合计 + 3;
    断言相等整数(无向度(图, "成员07"), 4, "成员07 的度");
    断言相等整数(三角形数(图, "成员07"), 6, "成员07 的三角形数");
    断言约等(聚类系数(图, "成员07"), 1.0, 0.000000001, "成员07 的聚类系数");
    三角合计 = 三角合计 + 6;
    断言相等整数(无向度(图, "成员08"), 5, "成员08 的度");
    断言相等整数(三角形数(图, "成员08"), 5, "成员08 的三角形数");
    断言约等(聚类系数(图, "成员08"), 0.5, 0.000000001, "成员08 的聚类系数");
    三角合计 = 三角合计 + 5;
    断言相等整数(无向度(图, "成员09"), 2, "成员09 的度");
    断言相等整数(三角形数(图, "成员09"), 0, "成员09 的三角形数");
    断言约等(聚类系数(图, "成员09"), 0, 0.000000001, "成员09 的聚类系数");
    三角合计 = 三角合计 + 0;
    断言相等整数(无向度(图, "成员10"), 3, "成员10 的度");
    断言相等整数(三角形数(图, "成员10"), 2, "成员10 的三角形数");
    断言约等(聚类系数(图, "成员10"), 0.666666666667, 0.000000001, "成员10 的聚类系数");
    三角合计 = 三角合计 + 2;
    断言相等整数(无向度(图, "成员11"), 1, "成员11 的度");
    断言相等整数(三角形数(图, "成员11"), 0, "成员11 的三角形数");
    断言约等(聚类系数(图, "成员11"), 0, 0.000000001, "成员11 的聚类系数");
    三角合计 = 三角合计 + 0;
    断言相等整数(无向度(图, "成员12"), 2, "成员12 的度");
    断言相等整数(三角形数(图, "成员12"), 1, "成员12 的三角形数");
    断言约等(聚类系数(图, "成员12"), 1.0, 0.000000001, "成员12 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员13"), 5, "成员13 的度");
    断言相等整数(三角形数(图, "成员13"), 6, "成员13 的三角形数");
    断言约等(聚类系数(图, "成员13"), 0.6, 0.000000001, "成员13 的聚类系数");
    三角合计 = 三角合计 + 6;
    断言相等整数(无向度(图, "成员14"), 2, "成员14 的度");
    断言相等整数(三角形数(图, "成员14"), 1, "成员14 的三角形数");
    断言约等(聚类系数(图, "成员14"), 1.0, 0.000000001, "成员14 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员15"), 2, "成员15 的度");
    断言相等整数(三角形数(图, "成员15"), 1, "成员15 的三角形数");
    断言约等(聚类系数(图, "成员15"), 1.0, 0.000000001, "成员15 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员16"), 2, "成员16 的度");
    断言相等整数(三角形数(图, "成员16"), 1, "成员16 的三角形数");
    断言约等(聚类系数(图, "成员16"), 1.0, 0.000000001, "成员16 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员17"), 2, "成员17 的度");
    断言相等整数(三角形数(图, "成员17"), 1, "成员17 的三角形数");
    断言约等(聚类系数(图, "成员17"), 1.0, 0.000000001, "成员17 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员18"), 2, "成员18 的度");
    断言相等整数(三角形数(图, "成员18"), 1, "成员18 的三角形数");
    断言约等(聚类系数(图, "成员18"), 1.0, 0.000000001, "成员18 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员19"), 3, "成员19 的度");
    断言相等整数(三角形数(图, "成员19"), 1, "成员19 的三角形数");
    断言约等(聚类系数(图, "成员19"), 0.333333333333, 0.000000001, "成员19 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员20"), 2, "成员20 的度");
    断言相等整数(三角形数(图, "成员20"), 1, "成员20 的三角形数");
    断言约等(聚类系数(图, "成员20"), 1.0, 0.000000001, "成员20 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员21"), 2, "成员21 的度");
    断言相等整数(三角形数(图, "成员21"), 1, "成员21 的三角形数");
    断言约等(聚类系数(图, "成员21"), 1.0, 0.000000001, "成员21 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员22"), 2, "成员22 的度");
    断言相等整数(三角形数(图, "成员22"), 1, "成员22 的三角形数");
    断言约等(聚类系数(图, "成员22"), 1.0, 0.000000001, "成员22 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员23"), 5, "成员23 的度");
    断言相等整数(三角形数(图, "成员23"), 4, "成员23 的三角形数");
    断言约等(聚类系数(图, "成员23"), 0.4, 0.000000001, "成员23 的聚类系数");
    三角合计 = 三角合计 + 4;
    断言相等整数(无向度(图, "成员24"), 3, "成员24 的度");
    断言相等整数(三角形数(图, "成员24"), 1, "成员24 的三角形数");
    断言约等(聚类系数(图, "成员24"), 0.333333333333, 0.000000001, "成员24 的聚类系数");
    三角合计 = 三角合计 + 1;
    断言相等整数(无向度(图, "成员25"), 3, "成员25 的度");
    断言相等整数(三角形数(图, "成员25"), 1, "成员25 的三角形数");
    断言约等(聚类系数(图, "成员25"), 0.333333333333, 0.000000001, "成员25 的聚类系数");
    三角合计 = 三角合计 + 1;
