// 遍历_测 —— 邻接、BFS 层序、DFS 先序、最短路径、连通分量，以及 1000 节点 5000 边的规模
//
// 图的形状都写死在每个用例里，断言的是**精确顺序**：邻接表是按加边顺序存的，
// 遍历顺序因此是确定的 —— 顺序一漂就说明邻接表被人动过。

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含};
导入 标准库.列表 作为 表列;
导入 标准库.输入输出 作为 IO;
导入 标准库.时间;
导入 Graph::{打开图, 关闭图, 加节点, 加边, 删边, 节点数, 边数, 开始批量, 结束批量,
             出边, 入边, 出邻居, 入邻居, 双向邻居, 出度, 入度, 度,
             广度遍历, 广度遍历带方向, 深度遍历, 最短路径, 可达, 连通分量数, 模式匹配数};

函数 库路径2(名: 字符串) : 字符串 {
    返回 "/tmp/qigraph-测-" + 名 + ".kv";
}

函数 库路径(名: 字符串) : 字符串 {
    变量 p: 字符串 = 库路径2(名);
    如果 (IO::文件存在(p) == 1) {
        IO::删除文件(p);
    }
    返回 p;
}

函数 行(表: 整数) : 字符串 {
    变量 出: 字符串 = "";
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (i > 0) {
            出 = 出 + ",";
        }
        出 = 出 + 表列::获取字符串(表, i);
        i = i + 1;
    }
    表列::删除列表(表);
    返回 出;
}

函数 长(表: 整数) : 整数 {
    变量 n: 整数 = 表列::字符串列表大小(表);
    表列::删除列表(表);
    返回 n;
}

// 六个人 + 一座城的小社交图，几个用例共用
//
//   甲 →认识→ 乙 →认识→ 丙 →认识→ 丁
//   甲 →认识→ 丙            丙 →住在→ 成都
//   乙 →同事→ 丙（乙丙之间两条边）   戊 孤立
函数 建小图(名: 字符串) : 整数 {
    变量 g: 整数 = 打开图(库路径(名));
    加节点(g, "甲", "[\"人\"]", "{}");
    加节点(g, "乙", "[\"人\"]", "{}");
    加节点(g, "丙", "[\"人\"]", "{}");
    加节点(g, "丁", "[\"人\"]", "{}");
    加节点(g, "戊", "[\"人\"]", "{}");
    加节点(g, "成都", "[\"城市\"]", "{}");
    加边(g, "甲乙", "认识", "甲", "乙", "{}");
    加边(g, "乙丙", "认识", "乙", "丙", "{}");
    加边(g, "丙丁", "认识", "丙", "丁", "{}");
    加边(g, "甲丙", "认识", "甲", "丙", "{}");
    加边(g, "丙成都", "住在", "丙", "成都", "{}");
    加边(g, "乙丙同事", "同事", "乙", "丙", "{}");
    返回 g;
}

函数 测_邻接() : 整数 {
    变量 g: 整数 = 建小图("邻接");
    断言相等(行(出边(g, "甲")), "甲乙,甲丙", "出边按加边顺序");
    断言相等(行(入边(g, "丙")), "乙丙,甲丙,乙丙同事", "入边按加边顺序");
    断言相等(行(出边(g, "没有")), "", "不存在的节点出边空");
    断言相等(行(出邻居(g, "甲")), "乙,丙", "出邻居");
    断言相等(行(出邻居(g, "乙")), "丙", "两条边到同一个人只算一次");
    断言相等(行(出邻居(g, "乙", "同事")), "丙", "按类型过滤到");
    断言相等(行(出邻居(g, "甲", "同事")), "", "按类型过滤没有");
    断言相等(行(出邻居(g, "丙")), "丁,成都", "跨类型的出邻居");
    断言相等(行(出邻居(g, "丙", "住在")), "成都", "只要住在");
    断言相等(行(入邻居(g, "丙")), "乙,甲", "入邻居去重");
    断言相等(行(入邻居(g, "丙", "认识")), "乙,甲", "入邻居按类型");
    断言相等(行(双向邻居(g, "丙")), "丁,成都,乙,甲", "双向：先出后入");
    断言相等(行(出邻居(g, "戊")), "", "孤立点没邻居");
    断言相等整数(出度(g, "丙"), 2, "出度");
    断言相等整数(入度(g, "丙"), 3, "入度（多重边都算）");
    断言相等整数(度(g, "丙"), 5, "度");
    断言相等整数(度(g, "没有"), 0, "不存在的节点度 0");
    关闭图(g);
    返回 0;
}

函数 测_广度遍历() : 整数 {
    变量 g: 整数 = 建小图("广度");
    断言相等(行(广度遍历(g, "甲", -1)), "甲,乙,丙,丁,成都", "层序：甲 | 乙 丙 | 丁 成都");
    断言相等(行(广度遍历(g, "甲", 0)), "甲", "深度 0 只有自己");
    断言相等(行(广度遍历(g, "甲", 1)), "甲,乙,丙", "深度 1");
    断言相等(行(广度遍历(g, "甲", 2)), "甲,乙,丙,丁,成都", "深度 2 到底了");
    断言相等(行(广度遍历(g, "甲", -1, "认识")), "甲,乙,丙,丁", "只走认识边就到不了成都");
    断言相等(行(广度遍历(g, "甲", -1, "住在")), "甲", "甲没有住在边");
    断言相等(行(广度遍历(g, "丁", -1)), "丁", "末端节点只有自己");
    断言相等(行(广度遍历(g, "没有", -1)), "", "起点不存在空表");
    断言相等(行(广度遍历带方向(g, "成都", -1, "", 1)), "成都,丙,乙,甲", "逆着边走");
    断言相等(行(广度遍历带方向(g, "丁", -1, "", 2)), "丁,丙,成都,乙,甲", "不分方向：丙的出邻居（成都）和入邻居（乙 甲）同在第二层");
    关闭图(g);
    返回 0;
}

函数 测_深度遍历() : 整数 {
    变量 g: 整数 = 建小图("深度");
    断言相等(行(深度遍历(g, "甲", -1)), "甲,乙,丙,丁,成都", "先序：一路走到底再回头");
    断言相等(行(深度遍历(g, "甲", 1)), "甲,乙,丙", "深度 1 跟 BFS 一样");
    断言相等(行(深度遍历(g, "甲", -1, "认识")), "甲,乙,丙,丁", "按类型");
    断言相等(行(深度遍历(g, "没有", -1)), "", "起点不存在空表");
    // 一个能区分 BFS / DFS 的形状：甲→乙→丁，甲→丙
    变量 h: 整数 = 打开图(库路径("深度2"));
    加节点(h, "甲", "[]", "{}");
    加节点(h, "乙", "[]", "{}");
    加节点(h, "丙", "[]", "{}");
    加节点(h, "丁", "[]", "{}");
    加边(h, "1", "e", "甲", "乙", "{}");
    加边(h, "2", "e", "甲", "丙", "{}");
    加边(h, "3", "e", "乙", "丁", "{}");
    断言相等(行(广度遍历(h, "甲", -1)), "甲,乙,丙,丁", "BFS 先把同层走完");
    断言相等(行(深度遍历(h, "甲", -1)), "甲,乙,丁,丙", "DFS 先钻到底");
    关闭图(h);
    关闭图(g);
    返回 0;
}

函数 测_最短路径() : 整数 {
    变量 g: 整数 = 建小图("最短");
    断言相等(行(最短路径(g, "甲", "丁")), "甲,丙,丁", "走甲丙不走甲乙丙");
    断言相等(行(最短路径(g, "甲", "成都")), "甲,丙,成都", "跨类型");
    断言相等(行(最短路径(g, "甲", "成都", "认识")), "", "只走认识边到不了成都");
    断言相等(行(最短路径(g, "乙", "丁")), "乙,丙,丁", "从中间出发");
    断言相等(行(最短路径(g, "甲", "甲")), "甲", "起点即终点");
    断言相等(行(最短路径(g, "丁", "甲")), "", "有向：反着走不可达，空表");
    断言相等(行(最短路径(g, "甲", "戊")), "", "孤立点不可达");
    断言相等(行(最短路径(g, "甲", "没有")), "", "终点不存在");
    断言相等(行(最短路径(g, "没有", "甲")), "", "起点不存在");
    断言相等整数(可达(g, "甲", "丁"), 1, "可达");
    断言相等整数(可达(g, "丁", "甲"), 0, "不可达");
    // 删掉捷径之后最短路径要变长
    删边(g, "甲丙");
    断言相等(行(最短路径(g, "甲", "丁")), "甲,乙,丙,丁", "捷径没了走长路");
    关闭图(g);
    返回 0;
}

函数 测_连通分量() : 整数 {
    变量 空图: 整数 = 打开图(库路径("分量空"));
    断言相等整数(连通分量数(空图), 0, "空图 0 个分量");
    关闭图(空图);

    变量 g: 整数 = 建小图("分量");
    断言相等整数(连通分量数(g), 2, "大块 + 孤立的戊");
    加节点(g, "己", "[]", "{}");
    断言相等整数(连通分量数(g), 3, "再加一个孤立点");
    加边(g, "戊己", "认识", "戊", "己", "{}");
    断言相等整数(连通分量数(g), 2, "连起来少一个");
    加边(g, "己甲", "认识", "己", "甲", "{}");
    断言相等整数(连通分量数(g), 1, "全连上（弱连通，不看方向）");
    关闭图(g);
    返回 0;
}

函数 测_规模() : 整数 {
    变量 p: 字符串 = 库路径("规模");
    变量 g: 整数 = 打开图(p);
    变量 起: 整数 = 时间.现在毫秒();
    开始批量(g);
    变量 i: 整数 = 0;
    当 (i < 1000) {
        加节点(g, "n" + i, "[\"人\"]", "{\"i\":" + i + "}");
        i = i + 1;
    }
    变量 节点毫秒: 整数 = 时间.现在毫秒() - 起;
    起 = 时间.现在毫秒();
    // 5 条/节点：环 + 四条伪随机跳边，保证连通且确定
    变量 k: 整数 = 0;
    当 (k < 1000) {
        加边(g, "", "认识", "n" + k, "n" + ((k + 1) % 1000), "{}");
        加边(g, "", "认识", "n" + k, "n" + ((k * 7 + 3) % 1000), "{}");
        加边(g, "", "认识", "n" + k, "n" + ((k * 13 + 5) % 1000), "{}");
        加边(g, "", "同事", "n" + k, "n" + ((k * 17 + 7) % 1000), "{}");
        加边(g, "", "同事", "n" + k, "n" + ((k * 31 + 11) % 1000), "{}");
        k = k + 1;
    }
    结束批量(g);
    变量 边毫秒: 整数 = 时间.现在毫秒() - 起;
    断言相等整数(节点数(g), 1000, "1000 节点");
    断言相等整数(边数(g), 5000, "5000 边");
    断言相等整数(出度(g, "n0"), 5, "每个节点 5 条出边");

    起 = 时间.现在毫秒();
    变量 全: 整数 = 广度遍历(g, "n0", -1);
    变量 BFS毫秒: 整数 = 时间.现在毫秒() - 起;
    断言相等整数(表列::字符串列表大小(全), 1000, "BFS 从 n0 走遍全图");
    断言相等(表列::获取字符串(全, 0), "n0", "起点在第 0 位");
    表列::删除列表(全);

    起 = 时间.现在毫秒();
    变量 路: 整数 = 最短路径(g, "n0", "n999");
    变量 路径毫秒: 整数 = 时间.现在毫秒() - 起;
    变量 步: 整数 = 表列::字符串列表大小(路);
    断言为真(步 >= 2, "n0 到 n999 有路");
    断言相等(表列::获取字符串(路, 步 - 1), "n999", "终点对");
    表列::删除列表(路);

    起 = 时间.现在毫秒();
    变量 j: 整数 = 0;
    变量 邻居总: 整数 = 0;
    当 (j < 1000) {
        邻居总 = 邻居总 + 长(出邻居(g, "n" + j));
        j = j + 1;
    }
    变量 邻居毫秒: 整数 = 时间.现在毫秒() - 起;
    断言为真(邻居总 > 4000, "邻居查询总数合理（去重后略少于 5000）");

    起 = 时间.现在毫秒();
    变量 解数: 整数 = 模式匹配数(g, "[{\"from\":\"n0\",\"type\":\"认识\",\"to\":\"?a\"},{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"}]");
    变量 匹配毫秒: 整数 = 时间.现在毫秒() - 起;
    断言为真(解数 >= 3, "两跳匹配有解");

    起 = 时间.现在毫秒();
    断言相等整数(连通分量数(g), 1, "环保证只有一个分量");
    变量 分量毫秒: 整数 = 时间.现在毫秒() - 起;
    关闭图(g);

    起 = 时间.现在毫秒();
    变量 二: 整数 = 打开图(p);
    变量 重开毫秒: 整数 = 时间.现在毫秒() - 起;
    断言相等整数(节点数(二), 1000, "重开 1000 节点");
    断言相等整数(边数(二), 5000, "重开 5000 边");
    断言相等整数(出度(二, "n999"), 5, "重开邻接表还在");
    关闭图(二);

    IO::打印行("    规模 1000 节点 / 5000 边：加节点 " + 节点毫秒 + " ms，加边 " + 边毫秒
        + " ms，BFS 全图 " + BFS毫秒 + " ms，最短路径 " + 路径毫秒 + " ms，1000 次出邻居 "
        + 邻居毫秒 + " ms，两跳匹配 " + 匹配毫秒 + " ms，连通分量 " + 分量毫秒
        + " ms，重开 " + 重开毫秒 + " ms");
    返回 0;
}

函数 入口() {
    运行用例("邻接", 测_邻接);
    运行用例("广度遍历", 测_广度遍历);
    运行用例("深度遍历", 测_深度遍历);
    运行用例("最短路径", 测_最短路径);
    运行用例("连通分量", 测_连通分量);
    运行用例("规模", 测_规模);
    摘要并退出();
}
