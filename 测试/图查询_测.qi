// 图查询_测 —— 模式匹配（单跳 / 两跳 / 常量 / 变量复用 / 类型变量）与 where 过滤
//
// 结果是 JSON 数组文本，断言直接比整串：解的顺序跟着邻接表顺序走，是确定的。

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含};
导入 标准库.列表 作为 表列;
导入 标准库.输入输出 作为 IO;
导入 Graph::{打开图, 关闭图, 加节点, 加边, 模式匹配, 模式匹配数, 过滤节点};

函数 库路径(名: 字符串) : 字符串 {
    变量 p: 字符串 = "/tmp/qigraph-测-" + 名 + ".kv";
    如果 (IO::文件存在(p) == 1) {
        IO::删除文件(p);
    }
    返回 p;
}

函数 行(表: 整数) : 字符串 {
    变量 出: 字符串 = "";
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (i > 0) {
            出 = 出 + ",";
        }
        出 = 出 + 表列::获取字符串(表, i);
        i = i + 1;
    }
    表列::删除列表(表);
    返回 出;
}

//   张三(35, 成都) →认识→ 李四(28)      李四 →住在→ 成都
//   张三 →认识→ 王五(40)                王五 →住在→ 成都
//   李四 →认识→ 王五                    张三 →住在→ 北京
//   王五 →认识→ 赵六(22)                赵六 →认识→ 赵六（自环）
函数 建图(名: 字符串) : 整数 {
    变量 g: 整数 = 打开图(库路径(名));
    加节点(g, "张三", "[\"人\",\"员工\"]", "{\"年龄\":35,\"爱好\":\"登山摄影\"}");
    加节点(g, "李四", "[\"人\"]", "{\"年龄\":28,\"爱好\":\"摄影\"}");
    加节点(g, "王五", "[\"人\",\"员工\"]", "{\"年龄\":40}");
    加节点(g, "赵六", "[\"人\"]", "{\"年龄\":22,\"活跃\":true}");
    加节点(g, "成都", "[\"城市\"]", "{\"人口\":2100}");
    加节点(g, "北京", "[\"城市\"]", "{\"人口\":2180}");
    加边(g, "1", "认识", "张三", "李四", "{}");
    加边(g, "2", "认识", "张三", "王五", "{}");
    加边(g, "3", "认识", "李四", "王五", "{}");
    加边(g, "4", "认识", "王五", "赵六", "{}");
    加边(g, "5", "住在", "李四", "成都", "{}");
    加边(g, "6", "住在", "王五", "成都", "{}");
    加边(g, "7", "住在", "张三", "北京", "{}");
    加边(g, "8", "认识", "赵六", "赵六", "{}");
    返回 g;
}

函数 测_单跳() : 整数 {
    变量 g: 整数 = 建图("单跳");
    断言相等(模式匹配(g, "[{\"from\":\"张三\",\"type\":\"认识\",\"to\":\"?b\"}]"),
        "[{\"?b\":\"李四\"},{\"?b\":\"王五\"}]", "起点常量，终点变量");
    断言相等(模式匹配(g, "[{\"from\":\"?a\",\"type\":\"住在\",\"to\":\"成都\"}]"),
        "[{\"?a\":\"李四\"},{\"?a\":\"王五\"}]", "终点常量，起点变量（走入边）");
    断言相等(模式匹配(g, "[{\"from\":\"?a\",\"type\":\"住在\",\"to\":\"?c\"}]"),
        "[{\"?a\":\"李四\",\"?c\":\"成都\"},{\"?a\":\"王五\",\"?c\":\"成都\"},{\"?a\":\"张三\",\"?c\":\"北京\"}]", "两端都是变量（走类型索引）");
    断言相等(模式匹配(g, "[{\"from\":\"张三\",\"type\":\"认识\",\"to\":\"李四\"}]"),
        "[{}]", "全常量且成立：一个空绑定");
    断言相等(模式匹配(g, "[{\"from\":\"李四\",\"type\":\"认识\",\"to\":\"张三\"}]"),
        "[]", "全常量不成立（有向）：没有解");
    断言相等(模式匹配(g, "[{\"from\":\"没有\",\"type\":\"认识\",\"to\":\"?b\"}]"),
        "[]", "起点不存在没有解");
    断言相等整数(模式匹配数(g, "[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"}]"), 5, "认识边一共 5 条");
    关闭图(g);
    返回 0;
}

函数 测_两跳与变量复用() : 整数 {
    变量 g: 整数 = 建图("两跳");
    断言相等(模式匹配(g, "[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"},{\"from\":\"?b\",\"type\":\"住在\",\"to\":\"成都\"}]"),
        "[{\"?a\":\"张三\",\"?b\":\"李四\"},{\"?a\":\"张三\",\"?b\":\"王五\"},{\"?a\":\"李四\",\"?b\":\"王五\"}]",
        "认识的人住在成都");
    断言相等(模式匹配(g, "[{\"from\":\"张三\",\"type\":\"认识\",\"to\":\"?b\"},{\"from\":\"?b\",\"type\":\"认识\",\"to\":\"?c\"}]"),
        "[{\"?b\":\"李四\",\"?c\":\"王五\"},{\"?b\":\"王五\",\"?c\":\"赵六\"}]", "朋友的朋友");
    // 三角：?a 认识 ?b，?b 认识 ?c，?a 认识 ?c
    断言相等(模式匹配(g, "[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"},{\"from\":\"?b\",\"type\":\"认识\",\"to\":\"?c\"},{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?c\"}]"),
        "[{\"?a\":\"张三\",\"?b\":\"李四\",\"?c\":\"王五\"},{\"?a\":\"王五\",\"?b\":\"赵六\",\"?c\":\"赵六\"},{\"?a\":\"赵六\",\"?b\":\"赵六\",\"?c\":\"赵六\"}]",
        "三角形：张李王，加上自环撑出来的两个退化三角");
    // 同一变量出现两次：自环
    断言相等(模式匹配(g, "[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?a\"}]"),
        "[{\"?a\":\"赵六\"}]", "?a 认识 ?a 只匹配自环");
    // 同住一城：?a 住在 ?c，?b 住在 ?c —— ?a 和 ?b 可以相同，也可以互换
    断言相等整数(模式匹配数(g, "[{\"from\":\"?a\",\"type\":\"住在\",\"to\":\"?c\"},{\"from\":\"?b\",\"type\":\"住在\",\"to\":\"?c\"}]"), 5,
        "成都 2×2 + 北京 1×1 = 5 组");
    关闭图(g);
    返回 0;
}

函数 测_类型变量与任意类型() : 整数 {
    变量 g: 整数 = 建图("类型");
    断言相等(模式匹配(g, "[{\"from\":\"张三\",\"type\":\"?r\",\"to\":\"?x\"}]"),
        "[{\"?r\":\"认识\",\"?x\":\"李四\"},{\"?r\":\"认识\",\"?x\":\"王五\"},{\"?r\":\"住在\",\"?x\":\"北京\"}]", "边类型也能是变量");
    断言相等(模式匹配(g, "[{\"from\":\"张三\",\"type\":\"\",\"to\":\"?x\"}]"),
        "[{\"?x\":\"李四\"},{\"?x\":\"王五\"},{\"?x\":\"北京\"}]", "空类型 = 任意");
    断言相等整数(模式匹配数(g, "[{\"from\":\"?a\",\"type\":\"?r\",\"to\":\"?b\"}]"), 8, "全变量 = 全部边（走全边扫）");
    // 类型变量绑定后要一致：张三 ?r 李四 且 李四 ?r 王五 → ?r 只能是 认识
    断言相等(模式匹配(g, "[{\"from\":\"张三\",\"type\":\"?r\",\"to\":\"?b\"},{\"from\":\"?b\",\"type\":\"?r\",\"to\":\"?c\"}]"),
        "[{\"?r\":\"认识\",\"?b\":\"李四\",\"?c\":\"王五\"},{\"?r\":\"认识\",\"?b\":\"王五\",\"?c\":\"赵六\"}]", "类型变量跨三元组一致");
    关闭图(g);
    返回 0;
}

函数 测_where过滤() : 整数 {
    变量 g: 整数 = 建图("过滤");
    变量 认识: 字符串 = "[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"}]";
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?a.props.年龄\":{\">\":30}}}"),
        "[{\"?a\":\"张三\",\"?b\":\"李四\"},{\"?a\":\"张三\",\"?b\":\"王五\"},{\"?a\":\"王五\",\"?b\":\"赵六\"}]", "年龄 > 30");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?b.props.年龄\":{\"<\":30}}}"),
        "[{\"?a\":\"张三\",\"?b\":\"李四\"},{\"?a\":\"王五\",\"?b\":\"赵六\"},{\"?a\":\"赵六\",\"?b\":\"赵六\"}]", "对端年龄 < 30（含自环）");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?a.props.年龄\":{\">=\":35,\"<=\":35}}}"),
        "[{\"?a\":\"张三\",\"?b\":\"李四\"},{\"?a\":\"张三\",\"?b\":\"王五\"}]", "同一字段两个条件都要满足");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?a.props.年龄\":{\"=\":28}}}"),
        "[{\"?a\":\"李四\",\"?b\":\"王五\"}]", "数字相等");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?a.props.爱好\":{\"=\":\"摄影\"}}}"),
        "[{\"?a\":\"李四\",\"?b\":\"王五\"}]", "字符串相等");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?a.props.爱好\":{\"包含\":\"摄影\"}}}"),
        "[{\"?a\":\"张三\",\"?b\":\"李四\"},{\"?a\":\"张三\",\"?b\":\"王五\"},{\"?a\":\"李四\",\"?b\":\"王五\"}]", "字符串包含");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?a.props.年龄\":{\"!=\":35}}}"),
        "[{\"?a\":\"李四\",\"?b\":\"王五\"},{\"?a\":\"王五\",\"?b\":\"赵六\"},{\"?a\":\"赵六\",\"?b\":\"赵六\"}]", "不等");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?b.labels\":{\"包含\":\"员工\"}}}"),
        "[{\"?a\":\"张三\",\"?b\":\"王五\"},{\"?a\":\"李四\",\"?b\":\"王五\"}]", "标签包含");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?a.id\":{\"=\":\"张三\"}}}"),
        "[{\"?a\":\"张三\",\"?b\":\"李四\"},{\"?a\":\"张三\",\"?b\":\"王五\"}]", "按 id 过滤");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?a.props.年龄\":{\">\":30},\"?b.props.年龄\":{\"<\":30}}}"),
        "[{\"?a\":\"张三\",\"?b\":\"李四\"},{\"?a\":\"王五\",\"?b\":\"赵六\"}]", "两个变量各自过滤");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?a.props.没有的字段\":{\">\":0}}}"),
        "[]", "字段不存在算不满足");
    断言相等(模式匹配(g, "{\"match\":" + 认识 + ",\"where\":{\"?z.props.年龄\":{\">\":0}}}"),
        "[]", "变量没出现在模式里算不满足");
    // 两跳 + 过滤
    断言相等(模式匹配(g, "{\"match\":[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"},{\"from\":\"?b\",\"type\":\"住在\",\"to\":\"?c\"}],\"where\":{\"?c.props.人口\":{\">\":2150}}}"),
        "[]", "认识的人里没人住在北京");
    断言相等(模式匹配(g, "{\"match\":[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"},{\"from\":\"?b\",\"type\":\"住在\",\"to\":\"?c\"}],\"where\":{\"?c.props.人口\":{\"<\":2150},\"?a.props.年龄\":{\">\":30}}}"),
        "[{\"?a\":\"张三\",\"?b\":\"李四\",\"?c\":\"成都\"},{\"?a\":\"张三\",\"?b\":\"王五\",\"?c\":\"成都\"}]", "两跳 + 两端过滤");
    关闭图(g);
    返回 0;
}

函数 测_过滤节点() : 整数 {
    变量 g: 整数 = 建图("过滤节点");
    断言相等(行(过滤节点(g, "人", "{\"年龄\":{\">=\":35}}")), "张三,王五", "年龄 >= 35");
    断言相等(行(过滤节点(g, "人", "{\"年龄\":{\">\":20,\"<\":30}}")), "李四,赵六", "区间");
    断言相等(行(过滤节点(g, "人", "{\"爱好\":{\"包含\":\"摄影\"}}")), "张三,李四", "包含");
    断言相等(行(过滤节点(g, "人", "{\"props.活跃\":{\"=\":\"真\"}}")), "赵六", "布尔按显示值比");
    断言相等(行(过滤节点(g, "人", "{\"labels\":{\"包含\":\"员工\"}}")), "张三,王五", "标签条件");
    断言相等(行(过滤节点(g, "人", "{\"labels\":{\"不含\":\"员工\"}}")), "李四,赵六", "标签不含");
    断言相等(行(过滤节点(g, "人", "{}")), "张三,李四,王五,赵六", "空条件 = 全部");
    断言相等(行(过滤节点(g, "城市", "{\"人口\":{\">\":2150}}")), "北京", "另一个标签");
    断言相等(行(过滤节点(g, "没有的标签", "{}")), "", "没有的标签空");
    关闭图(g);
    返回 0;
}

函数 测_坏模式() : 整数 {
    变量 g: 整数 = 建图("坏模式");
    断言相等(模式匹配(g, "不是JSON"), "[]", "解不出就是空数组");
    断言相等(模式匹配(g, "{}"), "[]", "没有 match 也是空");
    断言相等(模式匹配(g, "[]"), "[{}]", "空模式：一个空绑定（真空成立）");
    断言相等(模式匹配(g, "[{\"from\":\"?a\"}]"), "[]", "缺 type/to 当空串：to 空串对不上任何节点");
    断言相等整数(模式匹配数(-1, "[]"), 0, "打不开的图没有解");
    关闭图(g);
    返回 0;
}

函数 入口() {
    运行用例("单跳", 测_单跳);
    运行用例("两跳与变量复用", 测_两跳与变量复用);
    运行用例("类型变量与任意类型", 测_类型变量与任意类型);
    运行用例("where过滤", 测_where过滤);
    运行用例("过滤节点", 测_过滤节点);
    运行用例("坏模式", 测_坏模式);
    摘要并退出();
}
