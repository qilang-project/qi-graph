// 推理_测 —— 闭包、类型推断、校验、四条物化规则、幂等与撤销、解释、重开
//
// 每条规则各一个用例，再一个 传递+对称 的组合；物化要迭代到不动点，所以组合用例的
// 期望值是手算的完整闭包（含自反那几条），少一条就是没跑到底。

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含, 断言不含};
导入 标准库.输入输出 作为 IO;
导入 标准库.列表 作为 表列;
导入 标准库.JSON;
导入 标准库.时间;
导入 Graph::{打开本体, 关闭本体, 本体开始缓写, 本体刷盘,
             定义类, 定义属性, 加个体, 断言, 断言字面量, 撤销, 有三元组, 三元组标记, 三元组数, 值, 主语,
             按类列个体, 字符串列表连成行, 字符串列表含,
             所有祖先类, 所有子类, 所有父属性, 是子类, 所有类型, 是实例,
             校验, 物化推理, 撤销推理, 推出三元组数, 解释,
             开本体, 本体库};

函数 库路径(名: 字符串) : 字符串 {
    返回 "/tmp/qigraph-测-推理-" + 名 + ".kv";
}

函数 新库(名: 字符串) : 整数 {
    变量 p: 字符串 = 库路径(名);
    如果 (IO.文件存在(p) == 1) { IO.删除文件(p); }
    返回 打开本体(p);
}

函数 列表行(表: 整数) : 字符串 {
    变量 s: 字符串 = 字符串列表连成行(表, ",");
    表列::删除列表(表);
    返回 s;
}

函数 列表数(表: 整数) : 整数 {
    变量 n: 整数 = 表列::字符串列表大小(表);
    表列::删除列表(表);
    返回 n;
}

// 校验结果里某一种问题有几条
函数 数问题(文: 字符串, 种类: 字符串) : 整数 {
    变量 a: 整数 = JSON.解码(文);
    如果 (a == 0) { 返回 -1; }
    变量 n: 整数 = JSON.数组长度(a);
    变量 数: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 q: 整数 = JSON.数组获取对象(a, i);
        如果 (JSON.获取字符串(q, "kind") == 种类) { 数 = 数 + 1; }
        JSON.删除(q);
        i = i + 1;
    }
    JSON.删除(a);
    返回 数;
}

// 生物 ← 动物 ← {哺乳动物, 水生动物} ← 海豚（菱形）
函数 建菱形(本: 整数) : 整数 {
    定义类(本, "生物");
    定义类(本, "动物", "生物");
    定义类(本, "哺乳动物", "动物");
    定义类(本, "水生动物", "动物");
    定义类(本, "海豚", "哺乳动物");
    定义类(本, "海豚", "水生动物");
    定义类(本, "鸟", "动物");
    返回 0;
}

函数 测_菱形闭包() : 整数 {
    变量 本: 整数 = 新库("菱形");
    建菱形(本);
    变量 祖: 整数 = 所有祖先类(本, "海豚");
    断言相等整数(表列::字符串列表大小(祖), 4, "菱形顶点只出现一次：哺乳动物 水生动物 动物 生物");
    断言相等整数(字符串列表含(祖, "生物"), 1, "到得了根");
    断言相等整数(字符串列表含(祖, "海豚"), 0, "不含自己");
    表列::删除列表(祖);
    断言相等整数(是子类(本, "海豚", "生物"), 1, "多级子类");
    断言相等整数(是子类(本, "海豚", "海豚"), 1, "自反");
    断言相等整数(是子类(本, "动物", "海豚"), 0, "方向不能反");
    断言相等整数(是子类(本, "鸟", "哺乳动物"), 0, "旁系不是子类");
    断言相等整数(列表数(所有子类(本, "动物")), 4, "后代：哺乳动物 水生动物 海豚 鸟");
    断言相等整数(列表数(所有子类(本, "海豚")), 0, "叶子没有后代");
    断言相等整数(列表数(所有祖先类(本, "生物")), 0, "根没有祖先");
    关闭本体(本);
    返回 0;
}

函数 测_自环不死循环() : 整数 {
    变量 本: 整数 = 新库("自环");
    定义类(本, "甲", "乙");
    定义类(本, "乙", "丙");
    定义类(本, "丙", "甲");
    定义类(本, "丁", "丁");
    断言相等(列表行(所有祖先类(本, "甲")), "乙,丙", "三元环的祖先");
    断言相等(列表行(所有子类(本, "甲")), "丙,乙", "三元环的后代");
    断言相等整数(是子类(本, "甲", "丙"), 1, "环上互为子类");
    断言相等整数(列表数(所有祖先类(本, "丁")), 0, "自己指自己：祖先不含自己，也不死循环");
    加个体(本, "x", "甲");
    断言相等整数(列表数(所有类型(本, "x")), 3, "环上个体的全部类型");
    关闭本体(本);
    返回 0;
}

函数 测_实例判断() : 整数 {
    变量 本: 整数 = 新库("实例");
    建菱形(本);
    加个体(本, "小海", "海豚");
    加个体(本, "小鸟", "鸟");
    加个体(本, "小海", "鸟");    // 一只会飞的海豚：多类型
    变量 全: 整数 = 所有类型(本, "小海");
    断言相等整数(表列::字符串列表大小(全), 6, "海豚 鸟 + 哺乳动物 水生动物 动物 生物，去重");
    表列::删除列表(全);
    断言相等整数(是实例(本, "小海", "生物"), 1, "继承到根");
    断言相等整数(是实例(本, "小海", "水生动物"), 1, "菱形的另一边");
    断言相等整数(是实例(本, "小鸟", "哺乳动物"), 0, "不是");
    断言相等整数(是实例(本, "没有的", "生物"), 0, "不存在的个体不是任何类的实例");
    变量 个们: 整数 = 按类列个体(本, "动物", 1);
    断言相等整数(表列::字符串列表大小(个们), 2, "含子类列个体去重（小海 两条路径只算一次）");
    断言相等整数(字符串列表含(个们, "小海") + 字符串列表含(个们, "小鸟"), 2, "两个都在");
    表列::删除列表(个们);
    断言相等整数(列表数(按类列个体(本, "动物", 0)), 0, "不含子类时没有直接个体");
    关闭本体(本);
    返回 0;
}

函数 建校验底座(本: 整数) : 整数 {
    定义类(本, "动物");
    定义类(本, "狗", "动物");
    定义类(本, "人");
    定义属性(本, "养", "人", "动物", "");
    定义属性(本, "年龄", "动物", "整数", "{\"functional\":1}");
    定义属性(本, "外号", "动物", "字符串", "");
    加个体(本, "小明", "人");
    加个体(本, "小红", "人");
    加个体(本, "旺财", "狗");
    加个体(本, "大黄", "狗");
    返回 0;
}

函数 测_校验干净() : 整数 {
    变量 本: 整数 = 新库("校验干净");
    建校验底座(本);
    断言(本, "小明", "养", "旺财");
    断言字面量(本, "旺财", "年龄", "3", "整数");
    断言字面量(本, "旺财", "外号", "财财", "字符串");
    断言字面量(本, "旺财", "外号", "小财", "字符串");     // 非函数性，多值没问题
    断言相等(校验(本), "[]", "合规的本体没有问题");
    关闭本体(本);
    返回 0;
}

函数 测_校验定义域() : 整数 {
    变量 本: 整数 = 新库("校验定义域");
    建校验底座(本);
    断言(本, "小明", "养", "旺财");     // 正例
    断言(本, "旺财", "养", "大黄");     // 反例：狗不是人
    变量 r: 字符串 = 校验(本);
    断言相等整数(数问题(r, "domain"), 1, "一条定义域违反");
    断言包含(r, "\"kind\":\"domain\",\"s\":\"旺财\",\"p\":\"养\",\"o\":\"大黄\"", "指出是哪条");
    断言相等整数(数问题(r, "range"), 0, "值域没问题（大黄是动物）");
    关闭本体(本);
    返回 0;
}

函数 测_校验值域() : 整数 {
    变量 本: 整数 = 新库("校验值域");
    建校验底座(本);
    断言字面量(本, "旺财", "年龄", "3", "整数");           // 正例：整数字面量
    断言字面量(本, "大黄", "年龄", "三", "字符串");         // 反例：数据类型不对
    断言(本, "小明", "养", "小红");                          // 反例：人不是动物
    断言(本, "小红", "养", "旺财");                          // 正例
    断言(本, "小红", "外号", "旺财");                        // 反例：值域是字面量却给了个体
    变量 r: 字符串 = 校验(本);
    断言相等整数(数问题(r, "range"), 3, "三条值域违反");
    断言包含(r, "\"s\":\"大黄\",\"p\":\"年龄\",\"o\":\"三\"", "字面量类型不对");
    断言包含(r, "\"s\":\"小明\",\"p\":\"养\",\"o\":\"小红\"", "类值域不对");
    断言包含(r, "\"s\":\"小红\",\"p\":\"外号\",\"o\":\"旺财\"", "该给字面量给了个体");
    断言相等整数(数问题(r, "domain"), 1, "小红 外号 旺财 同时也违反定义域（小红不是动物）");
    关闭本体(本);
    返回 0;
}

函数 测_校验函数性() : 整数 {
    变量 本: 整数 = 新库("校验函数性");
    建校验底座(本);
    断言字面量(本, "旺财", "年龄", "3", "整数");           // 正例：一个值
    断言字面量(本, "大黄", "年龄", "4", "整数");
    断言字面量(本, "大黄", "年龄", "5", "整数");           // 反例：两个值
    断言字面量(本, "大黄", "年龄", "6", "整数");           // 三个值也只报一次
    断言字面量(本, "大黄", "外号", "黄黄", "字符串");
    断言字面量(本, "大黄", "外号", "老黄", "字符串");       // 非函数性，不报
    变量 r: 字符串 = 校验(本);
    断言相等整数(数问题(r, "functional"), 1, "函数性多值只报一次");
    断言包含(r, "\"kind\":\"functional\",\"s\":\"大黄\",\"p\":\"年龄\"", "报在 大黄 年龄 上");
    断言相等整数(数问题(r, "range"), 0, "值域都对");
    关闭本体(本);
    返回 0;
}

函数 测_校验未定义() : 整数 {
    变量 本: 整数 = 新库("校验未定义");
    建校验底座(本);
    加个体(本, "喵喵", "猫");                                // 类没定义
    断言(本, "小明", "喜欢", "旺财");                        // 谓词没定义
    定义类(本, "柯基", "犬科");                              // 父类没定义
    定义属性(本, "喂", "人", "食物", "{\"parent\":\"照顾\",\"inverse\":\"被喂\"}");  // 值域 / 父属性 / 逆属性都没定义
    变量 r: 字符串 = 校验(本);
    断言相等整数(数问题(r, "unknown_class"), 3, "猫 / 犬科 / 食物");
    断言相等整数(数问题(r, "unknown_property"), 3, "喜欢 / 照顾 / 被喂");
    断言包含(r, "\"s\":\"喵喵\",\"p\":\"类型是\",\"o\":\"猫\"", "个体的未知类");
    断言包含(r, "\"s\":\"柯基\",\"p\":\"父类是\",\"o\":\"犬科\"", "类的未知父类");
    断言包含(r, "\"s\":\"小明\",\"p\":\"喜欢\"", "未知谓词");
    断言包含(r, "\"s\":\"喂\",\"p\":\"父属性是\",\"o\":\"照顾\"", "未知父属性");
    关闭本体(本);
    返回 0;
}

函数 建规则底座(本: 整数) : 整数 {
    定义类(本, "动物");
    定义类(本, "人");
    加个体(本, "甲", "动物");
    加个体(本, "乙", "动物");
    加个体(本, "丙", "动物");
    加个体(本, "丁", "动物");
    加个体(本, "小明", "人");
    加个体(本, "小红", "人");
    返回 0;
}

函数 测_规则子属性() : 整数 {
    变量 本: 整数 = 新库("子属性");
    建规则底座(本);
    定义属性(本, "认识", "动物", "动物", "");
    定义属性(本, "朋友", "动物", "动物", "{\"parent\":\"认识\"}");
    定义属性(本, "亲密朋友", "动物", "动物", "{\"parent\":\"朋友\"}");
    定义属性(本, "名字", "动物", "字符串", "");
    定义属性(本, "昵称", "动物", "字符串", "{\"parent\":\"名字\"}");
    断言相等(列表行(所有父属性(本, "亲密朋友")), "朋友,认识", "父属性闭包");
    断言(本, "甲", "亲密朋友", "乙");
    断言字面量(本, "甲", "昵称", "阿甲", "字符串");
    变量 新: 整数 = 物化推理(本);
    断言相等整数(新, 3, "朋友 + 认识 + 名字");
    断言相等整数(有三元组(本, "甲", "朋友", "乙"), 1, "抬一级");
    断言相等整数(有三元组(本, "甲", "认识", "乙"), 1, "抬两级");
    断言相等(列表行(值(本, "甲", "名字")), "阿甲", "字面量宾语也抬");
    断言相等整数(有三元组(本, "乙", "认识", "甲"), 0, "子属性不管方向");
    断言包含(解释(本, "甲", "认识", "乙"), "规则「子属性」", "解释里是子属性规则");
    关闭本体(本);
    返回 0;
}

函数 测_规则传递() : 整数 {
    变量 本: 整数 = 新库("传递");
    建规则底座(本);
    定义属性(本, "祖先", "动物", "动物", "{\"transitive\":1}");
    定义属性(本, "邻居", "动物", "动物", "");
    断言(本, "甲", "祖先", "乙");
    断言(本, "乙", "祖先", "丙");
    断言(本, "丙", "祖先", "丁");
    断言(本, "甲", "邻居", "乙");
    断言(本, "乙", "邻居", "丙");
    断言相等整数(物化推理(本), 3, "甲丙 乙丁 甲丁");
    断言相等整数(有三元组(本, "甲", "祖先", "丁"), 1, "跨两跳（要第二轮才到）");
    断言相等整数(有三元组(本, "甲", "邻居", "丙"), 0, "非传递属性不动");
    断言相等整数(有三元组(本, "丁", "祖先", "甲"), 0, "不反向");
    断言包含(解释(本, "甲", "祖先", "丙"), "规则「传递」，前提：甲 祖先 乙；乙 祖先 丙", "解释");
    关闭本体(本);
    返回 0;
}

函数 测_规则对称() : 整数 {
    变量 本: 整数 = 新库("对称");
    建规则底座(本);
    定义属性(本, "认识", "动物", "动物", "{\"symmetric\":1}");
    定义属性(本, "养", "人", "动物", "");
    断言(本, "甲", "认识", "乙");
    断言(本, "乙", "认识", "丙");
    断言(本, "小明", "养", "甲");
    断言相等整数(物化推理(本), 2, "乙甲 丙乙");
    断言相等整数(有三元组(本, "乙", "认识", "甲"), 1, "反过来有了");
    断言相等整数(有三元组(本, "甲", "认识", "丙"), 0, "对称不带传递");
    断言相等整数(有三元组(本, "甲", "养", "小明"), 0, "非对称属性不动");
    断言相等(解释(本, "丙", "认识", "乙"), "推出：丙 认识 乙 ← 规则「对称」，前提：乙 认识 丙", "解释全文");
    关闭本体(本);
    返回 0;
}

函数 测_规则逆属性() : 整数 {
    变量 本: 整数 = 新库("逆属性");
    建规则底座(本);
    定义属性(本, "养", "人", "动物", "{\"inverse\":\"被养\"}");
    定义属性(本, "被养", "动物", "人", "");
    断言(本, "小明", "养", "甲");
    断言(本, "乙", "被养", "小红");
    断言相等整数(物化推理(本), 2, "两个方向各一条");
    断言相等整数(有三元组(本, "甲", "被养", "小明"), 1, "养 → 被养");
    断言相等整数(有三元组(本, "小红", "养", "乙"), 1, "被养 → 养");
    断言包含(解释(本, "甲", "被养", "小明"), "规则「逆属性」", "解释");
    断言相等(校验(本), "[]", "推出来的也合规");
    关闭本体(本);
    返回 0;
}

函数 测_规则组合() : 整数 {
    变量 本: 整数 = 新库("组合");
    建规则底座(本);
    定义属性(本, "同族", "动物", "动物", "{\"transitive\":1,\"symmetric\":1}");
    断言(本, "甲", "同族", "乙");
    断言(本, "乙", "同族", "丙");
    // 完整闭包是 {甲,乙,丙} 上的全关系（含自反）：9 条，断言了 2 条
    断言相等整数(物化推理(本), 7, "传递 + 对称 迭代到不动点：7 条新");
    断言相等整数(有三元组(本, "丙", "同族", "甲"), 1, "反向 + 跨跳");
    断言相等整数(有三元组(本, "甲", "同族", "甲"), 1, "自反是传递+对称的必然结论");
    断言相等整数(有三元组(本, "丁", "同族", "甲"), 0, "没关系的不牵连");
    断言相等整数(推出三元组数(本), 7, "推出计数");
    关闭本体(本);
    返回 0;
}

函数 测_幂等与撤销() : 整数 {
    变量 本: 整数 = 新库("幂等");
    建规则底座(本);
    定义属性(本, "认识", "动物", "动物", "{\"symmetric\":1}");
    定义属性(本, "祖先", "动物", "动物", "{\"transitive\":1}");
    断言(本, "甲", "认识", "乙");
    断言(本, "甲", "祖先", "乙");
    断言(本, "乙", "祖先", "丙");
    变量 前: 整数 = 三元组数(本);
    变量 一: 整数 = 物化推理(本);
    断言相等整数(一, 2, "第一次：乙认识甲 + 甲祖先丙");
    断言相等整数(物化推理(本), 0, "第二次没有新东西");
    断言相等整数(物化推理(本), 0, "第三次也没有");
    断言相等整数(推出三元组数(本), 2, "推出的还是 2 条");
    断言相等整数(三元组数(本), 前 + 2, "总数没有重复涨");

    // 断言一条跟推出重合的：升级成断言，撤销推理不能动它
    断言相等整数(断言(本, "乙", "认识", "甲"), 1, "断言盖过推出算写入");
    断言相等(三元组标记(本, "乙", "认识", "甲"), "1", "标记变成断言");
    断言相等整数(推出三元组数(本), 1, "推出的只剩 1 条");
    断言相等整数(撤销推理(本), 1, "撤销 1 条");
    断言相等整数(推出三元组数(本), 0, "推出的清干净");
    断言相等整数(有三元组(本, "乙", "认识", "甲"), 1, "升级成断言的那条留着");
    断言相等整数(有三元组(本, "甲", "祖先", "丙"), 0, "推出的那条没了");
    断言相等整数(三元组数(本), 前 + 1, "总数 = 原来 + 手动断言那条");
    断言相等整数(撤销推理(本), 0, "再撤没东西");
    断言相等整数(物化推理(本), 1, "再推只补回 甲祖先丙");
    断言相等整数(撤销推理(本), 1, "再撤又是 1 条");
    断言相等整数(三元组数(本), 前 + 1, "反复推撤，断言的一条不少");
    关闭本体(本);
    返回 0;
}

函数 测_解释() : 整数 {
    变量 本: 整数 = 新库("解释");
    建规则底座(本);
    定义属性(本, "认识", "动物", "动物", "{\"symmetric\":1}");
    定义属性(本, "朋友", "动物", "动物", "{\"parent\":\"认识\"}");
    定义属性(本, "年龄", "动物", "整数", "");
    断言(本, "甲", "朋友", "乙");
    断言字面量(本, "甲", "年龄", "3", "整数");
    断言相等(解释(本, "甲", "朋友", "乙"), "断言：甲 朋友 乙", "断言的");
    断言相等(解释(本, "甲", "年龄", "lit=3"), "断言：甲 年龄 3", "字面量显示去掉 lit=");
    断言相等(解释(本, "甲", "朋友", "丙"), "不存在：甲 朋友 丙", "没有的");
    物化推理(本);
    断言相等(解释(本, "甲", "认识", "乙"), "推出：甲 认识 乙 ← 规则「子属性」，前提：甲 朋友 乙；朋友 父属性是 认识", "一级推出");
    断言相等(解释(本, "乙", "认识", "甲"), "推出：乙 认识 甲 ← 规则「对称」，前提：甲 认识 乙（推出）", "前提本身是推出来的要标出来");
    关闭本体(本);
    返回 0;
}

函数 测_重开后推理还在() : 整数 {
    变量 本: 整数 = 新库("重开");
    建规则底座(本);
    定义属性(本, "认识", "动物", "动物", "{\"symmetric\":1}");
    断言(本, "甲", "认识", "乙");
    物化推理(本);
    关闭本体(本);
    变量 二: 整数 = 打开本体(库路径("重开"));
    断言相等整数(有三元组(二, "乙", "认识", "甲"), 1, "推出的三元组落盘了");
    断言相等整数(推出三元组数(二), 1, "推出标记还在");
    断言包含(解释(二, "乙", "认识", "甲"), "规则「对称」", "解释还在");
    断言相等整数(物化推理(二), 0, "重开后再推是幂等的");
    断言相等整数(撤销推理(二), 1, "重开后能撤");
    断言相等整数(三元组数(二), 9, "剩断言的 9 条：6 类型是 + 定义域 + 值域 + 甲认识乙");
    关闭本体(二);
    返回 0;
}

函数 测_链式推理() : 整数 {
    变量 p: 字符串 = 库路径("链式");
    如果 (IO.文件存在(p) == 1) { IO.删除文件(p); }
    变量 k: 本体库 = 开本体(p)
        .定义类("动物")
        .定义类("狗", "动物")
        .定义属性("认识", "动物", "动物", "{\"symmetric\":1}")
        .加个体("甲", "狗")
        .加个体("乙", "狗")
        .断言("甲", "认识", "乙")
        .物化推理();
    断言相等整数(k.是实例("甲", "动物"), 1, "链式 是实例");
    断言相等整数(k.有三元组("乙", "认识", "甲"), 1, "链式 物化推理");
    断言相等整数(k.推出三元组数(), 1, "链式 推出三元组数");
    断言相等(k.校验(), "[]", "链式 校验");
    断言包含(k.解释("乙", "认识", "甲"), "对称", "链式 解释");
    断言相等整数(k.撤销推理().推出三元组数(), 0, "链式 撤销推理");
    k.关();
    返回 0;
}

// 2000 个体 / 10000 三元组上跑 校验 和 对称 物化（6000 条 认识 → 6000 条推出）
函数 测_规模() : 整数 {
    变量 本: 整数 = 新库("规模");
    定义类(本, "类0");
    变量 c: 整数 = 1;
    当 (c < 10) {
        定义类(本, "类" + c, "类" + (c - 1));
        c = c + 1;
    }
    定义属性(本, "认识", "类0", "类0", "{\"symmetric\":1}");
    定义属性(本, "年龄", "类0", "整数", "{\"functional\":1}");
    本体开始缓写(本);
    变量 i: 整数 = 0;
    当 (i < 2000) {
        变量 我: 字符串 = "个体" + i;
        加个体(本, 我, "类" + (i % 10));
        断言(本, 我, "认识", "个体" + ((i + 1) % 2000));
        断言(本, 我, "认识", "个体" + ((i + 7) % 2000));
        断言(本, 我, "认识", "个体" + ((i + 13) % 2000));
        断言字面量(本, 我, "年龄", "" + (i % 90), "整数");
        i = i + 1;
    }
    本体刷盘(本);

    变量 起: 整数 = 时间.现在毫秒();
    变量 r: 字符串 = 校验(本);
    变量 校验毫秒: 整数 = 时间.现在毫秒() - 起;
    断言相等(r, "[]", "一万条全合规");

    起 = 时间.现在毫秒();
    本体开始缓写(本);
    变量 新: 整数 = 物化推理(本);
    本体刷盘(本);
    变量 推理毫秒: 整数 = 时间.现在毫秒() - 起;
    断言相等整数(新, 6000, "对称：6000 条反向");
    断言相等整数(有三元组(本, "个体1", "认识", "个体0"), 1, "抽查一条");

    起 = 时间.现在毫秒();
    本体开始缓写(本);
    变量 撤: 整数 = 撤销推理(本);
    本体刷盘(本);
    变量 撤销毫秒: 整数 = 时间.现在毫秒() - 起;
    断言相等整数(撤, 6000, "撤干净");
    IO.打印行("  规模 2000 个体 / 10000 三元组：校验 " + 校验毫秒 + " ms，对称物化 6000 条 " + 推理毫秒
        + " ms，撤销推理 " + 撤销毫秒 + " ms");
    关闭本体(本);
    返回 0;
}

函数 入口() {
    运行用例("推理.菱形闭包", 测_菱形闭包);
    运行用例("推理.自环不死循环", 测_自环不死循环);
    运行用例("推理.实例判断", 测_实例判断);
    运行用例("推理.校验干净", 测_校验干净);
    运行用例("推理.校验定义域", 测_校验定义域);
    运行用例("推理.校验值域", 测_校验值域);
    运行用例("推理.校验函数性", 测_校验函数性);
    运行用例("推理.校验未定义", 测_校验未定义);
    运行用例("推理.规则子属性", 测_规则子属性);
    运行用例("推理.规则传递", 测_规则传递);
    运行用例("推理.规则对称", 测_规则对称);
    运行用例("推理.规则逆属性", 测_规则逆属性);
    运行用例("推理.规则组合", 测_规则组合);
    运行用例("推理.幂等与撤销", 测_幂等与撤销);
    运行用例("推理.解释", 测_解释);
    运行用例("推理.重开后推理还在", 测_重开后推理还在);
    运行用例("推理.链式", 测_链式推理);
    运行用例("推理.规模", 测_规模);
    摘要并退出();
}
