// 图模式_测 —— 抽模式、蒸馏、加说明，最后渲染成能塞进提示词的一段话
//
// 数据仍是 qilang monorepo 自己的包依赖图（对着各仓 qi.toml，2026-09-14 读的），
// 外加两个**故意脏**的东西来测「跳过」和「最少出现」：
//   · 每个包挂一个内部字段 内部构建号（真实项目里这种字段最多，也最不该进提示词）
//   · 只有 Harness 一个包有 一次性调试标记 —— 出现 1 次的属性属于噪声

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含, 断言不含};
导入 标准库.输入输出 作为 IO;
导入 标准库.JSON 作为 J;
导入 Graph::{打开图, 关闭图, 加节点, 加边, 图模式JSON, 图模式文本, 查数};

变量 库路径: 字符串 = "/tmp/qigraph-测-模式.kv";

函数 建包(图: 整数, 名: 字符串, 版本: 字符串, 下载: 整数, 额外: 字符串) {
    变量 属: 字符串 = "{\"版本\":\"" + 版本 + "\",\"下载数\":" + 下载
        + ",\"内部构建号\":\"b" + 下载 + "\"" + 额外 + "}";
    加节点(图, 名, "[\"包\"]", 属);
}

函数 建图() : 整数 {
    如果 (IO::文件存在(库路径) == 1) {
        IO::删除文件(库路径);
    }
    变量 图: 整数 = 打开图(库路径);
    建包(图, "Harness", "0.3.0", 120, ",\"一次性调试标记\":true");
    建包(图, "Web", "0.2.0", 340, "");
    建包(图, "Graph", "0.1.1", 15, "");
    建包(图, "KV", "0.1.1", 22, "");
    建包(图, "CLI", "2026.424.1", 500, "");
    // 人：不是包，用来验「多个类各自成行」
    加节点(图, "李亮", "[\"人\"]", "{\"角色\":\"作者\"}");
    加边(图, "", "依赖", "Harness", "Web", "{\"自\":\"0.2.0\"}");
    加边(图, "", "依赖", "Harness", "Graph", "{\"自\":\"0.1.1\"}");
    加边(图, "", "依赖", "Graph", "KV", "{\"自\":\"0.1.1\"}");
    加边(图, "", "开发依赖", "Harness", "CLI", "{}");
    加边(图, "", "维护", "李亮", "Harness", "{}");
    返回 图;
}

函数 测_抽技术模式() : 整数 {
    变量 图: 整数 = 建图();
    变量 文: 字符串 = 图模式JSON(图);
    变量 根: 整数 = J.解码(文);
    断言为真(根 > 0, "模式是合法 JSON");
    断言相等整数(J.获取整数(根, "节点总数"), 6, "六个节点");
    断言相等整数(J.获取整数(根, "边总数"), 5, "五条边");

    // 两个类：包（5 个）、人（1 个）。按名字排序，稳定输出
    变量 类组: 整数 = J.获取数组(根, "类");
    断言相等整数(J.数组长度(类组), 2, "两个节点类");

    // 找到「包」那一项逐字段核
    变量 包项: 整数 = 找一项(类组, "名", "包");
    断言为真(包项 > 0, "有 包 这个类");
    断言相等整数(J.获取整数(包项, "数量"), 5, "五个包");
    变量 属组: 整数 = J.获取数组(包项, "属性");
    // 版本 STRING 必填、下载数 INTEGER 必填、内部构建号 STRING 必填、
    // 一次性调试标记 BOOLEAN 只出现 1 次
    变量 版本项: 整数 = 找一项(属组, "名", "版本");
    断言相等(J.获取字符串(版本项, "类型"), "STRING", "版本是字符串");
    断言相等整数(J.获取布尔(版本项, "必填"), 1, "每个包都有版本 → 必填");
    变量 下载项: 整数 = 找一项(属组, "名", "下载数");
    断言相等(J.获取字符串(下载项, "类型"), "INTEGER", "下载数是整数，不是字符串");
    变量 调试项: 整数 = 找一项(属组, "名", "一次性调试标记");
    断言相等(J.获取字符串(调试项, "类型"), "BOOLEAN", "布尔认得出来");
    断言相等整数(J.获取整数(调试项, "出现"), 1, "只出现一次");
    断言相等整数(J.获取布尔(调试项, "必填"), 0, "只有一个包有 → 不是必填");

    // 关系：依赖(3) 开发依赖(1) 维护(1)
    变量 关组: 整数 = J.获取数组(根, "关系");
    断言相等整数(J.数组长度(关组), 3, "三种边类型");
    变量 依赖项: 整数 = 找一项(关组, "类型", "依赖");
    断言相等整数(J.获取整数(依赖项, "数量"), 3, "三条依赖边");
    // 端点：依赖 全是 包→包
    变量 端组: 整数 = J.获取数组(依赖项, "端点");
    断言相等整数(J.数组长度(端组), 1, "依赖 只有一种端点组合");
    变量 端: 整数 = J.数组获取对象(端组, 0);
    断言相等(J.获取字符串(端, "起"), "包", "依赖 从 包 出发");
    断言相等(J.获取字符串(端, "止"), "包", "依赖 指向 包");
    // 维护 是 人→包，跟 依赖 不同，说明端点是按实际数据分开记的
    变量 维护项: 整数 = 找一项(关组, "类型", "维护");
    变量 端2: 整数 = J.数组获取对象(J.获取数组(维护项, "端点"), 0);
    断言相等(J.获取字符串(端2, "起"), "人", "维护 从 人 出发");
    断言相等(J.获取字符串(端2, "止"), "包", "维护 指向 包");
    // 边属性也认：依赖 上的 自 是 STRING
    变量 边属: 整数 = 找一项(J.获取数组(依赖项, "属性"), "名", "自");
    断言相等(J.获取字符串(边属, "类型"), "STRING", "边属性的类型也认");

    J.删除(根);
    关闭图(图);
    返回 1;
}

函数 找一项(组: 整数, 字段: 字符串, 值: 字符串) : 整数 {
    变量 i: 整数 = 0;
    当 (i < J.数组长度(组)) {
        变量 项: 整数 = J.数组获取对象(组, i);
        如果 (J.获取字符串(项, 字段) == 值) {
            返回 项;
        }
        i = i + 1;
    }
    返回 0;
}

函数 测_渲染成文本() : 整数 {
    变量 图: 整数 = 建图();
    变量 文: 字符串 = 图模式文本(图);

    断言包含(文, "(:包 {", "包 这一类渲染出来了");
    断言包含(文, "版本: STRING", "属性带类型");
    断言包含(文, "下载数: INTEGER", "整数属性类型对");
    断言包含(文, "(:包)-[:依赖", "关系带端点");
    断言包含(文, "]->(:包)", "关系的箭头方向在");
    断言包含(文, "(:人)-[:维护", "另一种端点组合也在");
    // 非必填带问号
    断言包含(文, "一次性调试标记: BOOLEAN?", "只出现一次的属性标了 ?");
    // 必填的不带 ?（版本 排在属性表最后，后面直接是 }，别按逗号去断言）
    断言不含(文, "版本: STRING?", "每个包都有版本，不该标 ?");
    断言包含(文, "版本: STRING}", "版本 是最后一个属性");

    // 「怎么查」那一段必须教 图语句 的文本语法 —— 这是这个模块的落点
    断言包含(文, "匹配 ", "教了 匹配 关键字");
    断言包含(文, "-[:", "教了边的写法");
    断言包含(文, "其中 ", "教了 其中");
    断言包含(文, "限制 ", "教了 限制");

    关闭图(图);
    返回 1;
}

函数 测_跳过与说明() : 整数 {
    变量 图: 整数 = 建图();

    // 不配置时：内部字段照样出现在提示词里
    变量 素: 字符串 = 图模式文本(图);
    断言包含(素, "内部构建号", "不配置时内部字段也会进去");
    断言包含(素, "(:人 ", "不配置时 人 这一类也在");

    变量 配: 字符串 = "{\"跳过\":{\"类\":[\"人\"],\"关系\":[\"维护\"],"
        + "\"属性\":[\"内部构建号\"]},"
        + "\"说明\":{\"类\":{\"包\":\"一个可发布的 qi 包\"},"
        + "\"关系\":{\"依赖\":\"运行期依赖，装这个包会跟着装\"},"
        + "\"属性\":{\"包\":{\"下载数\":\"注册中心累计下载次数\"}}},"
        + "\"最少出现\":2}";
    变量 净: 字符串 = 图模式文本(图, 配);

    // 跳过 生效
    断言不含(净, "内部构建号", "跳过的属性不出现");
    断言不含(净, "(:人 ", "跳过的类不出现");
    断言不含(净, "维护", "跳过的关系不出现");
    // 最少出现 2 把只出现一次的噪声属性挡掉
    断言不含(净, "一次性调试标记", "出现不足 2 次的属性被挡掉");
    // 该留的还在
    断言包含(净, "(:包 {", "没跳过的类还在");
    断言包含(净, "版本: STRING", "没跳过的属性还在");
    断言包含(净, "-[:依赖", "没跳过的关系还在");
    // 说明 渲染成内联注释
    断言包含(净, "/* 一个可发布的 qi 包 */", "类说明进了注释");
    断言包含(净, "/* 运行期依赖，装这个包会跟着装 */", "关系说明进了注释");
    断言包含(净, "/* 注册中心累计下载次数 */", "属性说明进了注释");

    // 关掉用法段
    变量 无用法: 字符串 = 图模式文本(图, "{\"含用法\":0}");
    断言不含(无用法, "### 怎么查", "含用法=0 时不附语法说明");
    断言包含(无用法, "(:包 {", "但模式本身还在");

    关闭图(图);
    返回 1;
}

// 这一条是整套的落点：**照着模式文本里教的语法写出来的查询，真的能跑**。
// 模式讲得再漂亮，如果教出来的语法这个库不认，那就是在骗模型。
函数 测_照着教的写真能跑() : 整数 {
    变量 图: 整数 = 建图();
    变量 文: 字符串 = 图模式文本(图);

    // 从模式文本里能读到：有 包 这个类、有 依赖 这种边、包 上有 下载数 这个整数属性。
    // 照着「怎么查」那段的语法拼一条查询：
    断言相等整数(查数(图, "匹配 (?a:包)-[:依赖]->(?b:包)"), 3, "照教的写法查依赖边");
    断言相等整数(查数(图, "匹配 (?a:包)-[:依赖]->(?b:包) 其中 ?a.下载数 > 100"), 2,
        "照教的写法加数值条件（Harness 下载 120，两条依赖边）");
    断言相等整数(查数(图, "匹配 (?人:人)-[:维护]->(?p:包) 返回 ?人, ?p 限制 5"), 1,
        "照教的写法用 返回 和 限制");
    断言包含(文, "包", "模式里确实提到了 包 这个类（上面几条查询的前提）");

    关闭图(图);
    返回 1;
}

函数 测_空图() : 整数 {
    变量 空路: 字符串 = "/tmp/qigraph-测-模式空.kv";
    如果 (IO::文件存在(空路) == 1) {
        IO::删除文件(空路);
    }
    变量 空: 整数 = 打开图(空路);
    变量 文: 字符串 = 图模式文本(空);
    断言包含(文, "## 图模式", "空图也给个完整的头");
    断言包含(文, "共 0 个节点", "如实说是空的");
    变量 j: 整数 = J.解码(图模式JSON(空));
    断言相等整数(J.数组长度(J.获取数组(j, "类")), 0, "空图没有类");
    J.删除(j);
    关闭图(空);
    返回 1;
}

函数 入口() {
    运行用例("抽技术模式", 测_抽技术模式);
    运行用例("渲染成 LLM 文本", 测_渲染成文本);
    运行用例("跳过与说明", 测_跳过与说明);
    运行用例("照着教的语法写真能跑", 测_照着教的写真能跑);
    运行用例("空图", 测_空图);
    摘要并退出();
}
