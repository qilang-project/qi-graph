// 图语句_测 —— 文本查询语言，拿真实的包依赖图当数据
//
// 数据是 **qilang monorepo 自己的 qi.toml**（2026-09-14 逐个读出来的）：
//   Harness 0.3.0  依赖 Web、Graph        开发依赖 CLI
//   Graph   0.1.1  依赖 KV                开发依赖 CLI、测试
//   KV      0.1.1  无依赖                 开发依赖 CLI、Web、测试
//   Pkg     0.1.1  无依赖                 开发依赖 CLI
//   Web 0.2.0 / CLI 2026.424.1 / 注册中心 0.1.0 / 测试 0.1.0  都无依赖
//
// 每条断言的期望都能对着那些 qi.toml 数出来，不是编的。
// （顺带纠了一条我记岔的：注册中心 **不**依赖 KV —— 「注册中心依赖 X 尚未安装」
// 是编译器报错的措辞，说的是「来自注册中心的依赖」，不是这个包的依赖。）

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含, 断言不含};
导入 标准库.输入输出 作为 IO;
导入 标准库.JSON 作为 J;
导入 Graph::{打开图, 关闭图, 加节点, 加边, 查, 查数, 编译语句, 模式匹配};

变量 库路径: 字符串 = "/tmp/qigraph-测-语句.kv";

函数 建包(图: 整数, 名: 字符串, 版本: 字符串) {
    加节点(图, 名, "[\"包\"]", "{\"版本\":\"" + 版本 + "\"}");
}

函数 建依赖图() : 整数 {
    如果 (IO::文件存在(库路径) == 1) {
        IO::删除文件(库路径);
    }
    变量 图: 整数 = 打开图(库路径);
    建包(图, "Harness", "0.3.0");
    建包(图, "Web", "0.2.0");
    建包(图, "Graph", "0.1.1");
    建包(图, "KV", "0.1.1");
    建包(图, "CLI", "2026.424.1");
    建包(图, "Pkg", "0.1.1");
    建包(图, "注册中心", "0.1.0");
    建包(图, "测试", "0.1.0");
    加边(图, "", "依赖", "Harness", "Web", "{}");
    加边(图, "", "依赖", "Harness", "Graph", "{}");
    加边(图, "", "依赖", "Graph", "KV", "{}");
    加边(图, "", "开发依赖", "Harness", "CLI", "{}");
    加边(图, "", "开发依赖", "Graph", "CLI", "{}");
    加边(图, "", "开发依赖", "Graph", "测试", "{}");
    加边(图, "", "开发依赖", "KV", "CLI", "{}");
    加边(图, "", "开发依赖", "KV", "Web", "{}");
    加边(图, "", "开发依赖", "KV", "测试", "{}");
    加边(图, "", "开发依赖", "Pkg", "CLI", "{}");
    返回 图;
}

函数 测_编译() : 整数 {
    // 编译只做语法到 JSON 的翻译，不碰库
    变量 出: 字符串 = 编译语句("匹配 (?a:包)-[:依赖]->(?b)");
    断言包含(出, "\"from\":\"?a\"", "起点变量");
    断言包含(出, "\"type\":\"依赖\"", "边类型");
    断言包含(出, "\"to\":\"?b\"", "终点变量");
    // 节点上的 :包 变成 labels 条件，而不是塞进三元组
    断言包含(出, "?a.labels", "标签约束进了 where");
    断言包含(out包含标签(出), "包", "标签值是 包");

    // 逆向边把两端调个个儿
    变量 逆: 字符串 = 编译语句("匹配 (KV)<-[:依赖]-(?p)");
    断言包含(逆, "\"from\":\"?p\"", "逆向边的 from 是右边那个");
    断言包含(逆, "\"to\":\"KV\"", "逆向边的 to 是左边那个");

    // 链式路径展开成两条三元组
    变量 链: 字符串 = 编译语句("匹配 (Harness)-[:依赖]->(?a)-[:依赖]->(?b)");
    变量 对象: 整数 = J.解码(链);
    断言相等整数(J.数组长度(J.获取数组(对象, "match")), 2, "三节点链展开成两条边");
    J.删除(对象);

    // 属性条件要自动补 props. 前缀 —— 这正是让模型手写 JSON 容易错的地方
    变量 条: 字符串 = 编译语句("匹配 (?a)-[:依赖]->(?b) 其中 ?a.版本 = \"0.3.0\"");
    断言包含(条, "?a.props.版本", "属性键补了 props. 前缀");
    断言不含(条, "\"?a.版本\"", "没有漏补前缀的裸键");

    // 语法错要给回一句人话，不是崩
    断言包含(编译语句("返回 ?a"), "\"错\"", "缺 匹配 子句报错");
    断言包含(编译语句("匹配 (?a"), "\"错\"", "括号没配对报错");
    断言包含(编译语句("匹配 (?a)(?b)"), "\"错\"", "两个节点之间少连边报错");
    断言包含(编译语句("匹配 (?a)-[:依赖]->(?b) 其中 ?a.版本"), "\"错\"", "条件没运算符报错");
    返回 1;
}

// 从编译结果里把 labels 条件那一段抠出来（只为让上面那条断言读起来清楚）
函数 out包含标签(出: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(出);
    如果 (对象 <= 0) {
        返回 "";
    }
    变量 w: 整数 = J.获取对象(对象, "where");
    变量 文: 字符串 = "";
    如果 (w > 0) {
        变量 一: 整数 = J.获取对象(w, "?a.labels");
        如果 (一 > 0) {
            文 = J.获取字符串(一, "包含");
        }
    }
    J.删除(对象);
    返回 文;
}

函数 测_查真实依赖() : 整数 {
    变量 图: 整数 = 建依赖图();

    // 谁依赖 KV？对着 qi.toml 数：只有 Graph
    变量 一: 字符串 = 查(图, "匹配 (?p:包)-[:依赖]->(KV) 返回 ?p");
    断言相等整数(查数(图, "匹配 (?p:包)-[:依赖]->(KV)"), 1, "只有一个包依赖 KV");
    断言包含(一, "Graph", "那个包是 Graph");

    // Harness 直接依赖谁？Web 和 Graph 两个（CLI 是开发依赖，不算）
    断言相等整数(查数(图, "匹配 (Harness)-[:依赖]->(?a)"), 2, "Harness 有两个直接依赖");
    变量 直: 字符串 = 查(图, "匹配 (Harness)-[:依赖]->(?a) 返回 ?a");
    断言包含(直, "Web", "依赖里有 Web");
    断言包含(直, "Graph", "依赖里有 Graph");
    断言不含(直, "CLI", "开发依赖不该混进来");

    // 传递依赖：Harness → ? → ?，只有 Harness→Graph→KV 这一条
    变量 传: 字符串 = 查(图, "匹配 (Harness)-[:依赖]->(?a)-[:依赖]->(?b)");
    断言相等整数(查数(图, "匹配 (Harness)-[:依赖]->(?a)-[:依赖]->(?b)"), 1, "只有一条二级依赖链");
    断言包含(传, "\"?a\":\"Graph\"", "中间是 Graph");
    断言包含(传, "\"?b\":\"KV\"", "末端是 KV");

    // 谁把 CLI 当开发依赖？Harness / Graph / KV / Pkg 四个
    断言相等整数(查数(图, "匹配 (?p:包)-[:开发依赖]->(CLI)"), 4, "四个包开发依赖 CLI");

    // 逆向写法应当等价
    断言相等整数(查数(图, "匹配 (CLI)<-[:开发依赖]-(?p)"), 4, "逆向写法结果一样");

    // 任意类型：Harness 出去的所有边 = 2 依赖 + 1 开发依赖
    断言相等整数(查数(图, "匹配 (Harness)-[]->(?a)"), 3, "不指定类型时两种边都算");

    关闭图(图);
    返回 1;
}

函数 测_条件与投影() : 整数 {
    变量 图: 整数 = 建依赖图();

    // 被依赖方版本是 0.1.1 的：Harness→Graph(0.1.1) 和 Graph→KV(0.1.1)
    断言相等整数(查数(图, "匹配 (?p)-[:依赖]->(?q) 其中 ?q.版本 = \"0.1.1\""), 2,
        "两条边指向 0.1.1 的包");

    // 组合条件：且 连接
    变量 组合: 字符串 = 查(图,
        "匹配 (?p)-[:依赖]->(?q) 其中 ?q.版本 = \"0.1.1\" 且 ?p.版本 = \"0.3.0\" 返回 ?p, ?q");
    断言相等整数(查数(图,
        "匹配 (?p)-[:依赖]->(?q) 其中 ?q.版本 = \"0.1.1\" 且 ?p.版本 = \"0.3.0\""), 1,
        "再加一条件只剩 Harness→Graph");
    断言包含(组合, "Graph", "剩下的是 Graph");

    // 返回 投影：只留点名的变量
    变量 窄: 字符串 = 查(图, "匹配 (Harness)-[:依赖]->(?a) 返回 ?a");
    断言不含(窄, "?p", "没点名的变量不出现");
    断言包含(窄, "\"?a\"", "点名的在");

    // 限制：截断结果
    断言相等整数(查数(图, "匹配 (?p:包)-[:开发依赖]->(CLI) 限制 2"), 2, "限制 2 只回两条");
    断言相等整数(查数(图, "匹配 (?p:包)-[:开发依赖]->(CLI) 限制 99"), 4, "限制大于总数时给全部");

    // 标签约束真的起作用：把 :包 换成一个没有的标签，应当查不到
    断言相等整数(查数(图, "匹配 (?p:不存在的标签)-[:开发依赖]->(CLI)"), 0, "标签对不上就没结果");

    // 换行和多余空格不影响
    变量 多行: 整数 = 查数(图,
        "匹配 (?p:包)-[:依赖]->(?q)\n其中 ?q.版本 = \"0.1.1\"\n限制 5");
    断言相等整数(多行, 2, "换行写法结果一致");

    关闭图(图);
    返回 1;
}

函数 测_跟JSON写法等价() : 整数 {
    变量 图: 整数 = 建依赖图();
    // 同一个问题，文本语句和手写 JSON 必须给一样的答案 ——
    // 这一条钉住「文本层只是前端，没有第二套执行逻辑」
    变量 走文本: 字符串 = 查(图, "匹配 (Harness)-[:依赖]->(?a)");
    变量 走JSON: 字符串 = 模式匹配(图,
        "[{\"from\":\"Harness\",\"type\":\"依赖\",\"to\":\"?a\"}]");
    断言相等(走文本, 走JSON, "文本语句与等价 JSON 结果逐字节相同");
    关闭图(图);
    返回 1;
}

函数 入口() {
    运行用例("编译成 JSON", 测_编译);
    运行用例("查真实依赖图", 测_查真实依赖);
    运行用例("条件、投影与限制", 测_条件与投影);
    运行用例("与手写 JSON 等价", 测_跟JSON写法等价);
    摘要并退出();
}
