// 图特征_测 —— 中心性与特征向量
//
// 图小到能用手算，每个断言的期望值都是笔算出来的，不是把实现跑一遍抄下来的。
// 三角形 + 一条尾巴那张图（A-B-C-A，C-D）的手算过程写在各用例的注释里 ——
// 哪天算法被改坏了，看注释就知道该是多少，不用重新推。

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含, 断言不含};
导入 标准库.输入输出 作为 IO;
导入 标准库.哈希表;
导入 标准库.JSON 作为 J;
导入 Graph::{打开图, 关闭图, 加节点, 加边, 加标签,
             无向度, 按标签度, 按标签度占比, 三角形数, 聚类系数, 自我网密度,
             最短跳数, 平均测地距离, 离心率, 接近中心性, 介数中心性, 节点介数中心性,
             PageRank, 个性化PageRank, 节点特征JSON, 全图特征JSON, 排行JSON};

函数 库路径(名: 字符串) : 字符串 {
    变量 p: 字符串 = "/tmp/qigraph-测-" + 名 + ".kv";
    如果 (IO::文件存在(p) == 1) {
        IO::删除文件(p);
    }
    返回 p;
}

// 浮点数没法直接相等比，差在 1e-6 以内就算对。
函数 断言约等(实际: 浮点数, 期望: 浮点数, 说明: 字符串) {
    变量 差: 浮点数 = 实际 - 期望;
    如果 (差 < 0.0) {
        差 = 0.0 - 差;
    }
    断言为真(差 < 0.000001,
        说明 + "（实得 " + 浮点数转字符串(实际) + "，应为 " + 浮点数转字符串(期望) + "）");
}

函数 断言约等松(实际: 浮点数, 期望: 浮点数, 容差: 浮点数, 说明: 字符串) {
    变量 差: 浮点数 = 实际 - 期望;
    如果 (差 < 0.0) {
        差 = 0.0 - 差;
    }
    断言为真(差 < 容差,
        说明 + "（实得 " + 浮点数转字符串(实际) + "，应为 " + 浮点数转字符串(期望) + "）");
}

// ── 三角形 + 一条尾巴 ──────────────────────────────────────────────
//
//   A —— B          无向看：A-B、B-C、C-A 是个三角形，C 再拖一条尾巴到 D
//    \   /
//      C —— D
//
// B、C 打上「骗子」标签，用来验按标签度。
函数 建小图(路径: 字符串) : 整数 {
    变量 图: 整数 = 打开图(路径);
    加节点(图, "A", "[\"人\"]", "{}");
    加节点(图, "B", "[\"人\"]", "{}");
    加节点(图, "C", "[\"人\"]", "{}");
    加节点(图, "D", "[\"人\"]", "{}");
    加边(图, "", "认识", "A", "B", "{}");
    加边(图, "", "认识", "B", "C", "{}");
    加边(图, "", "认识", "C", "A", "{}");
    加边(图, "", "认识", "C", "D", "{}");
    加标签(图, "B", "骗子");
    加标签(图, "C", "骗子");
    返回 图;
}

函数 测_度() : 整数 {
    变量 图: 整数 = 建小图(库路径("特征度"));

    // 无向度 = 去重去自环之后的邻居个数：A{B,C} B{A,C} C{A,B,D} D{C}
    断言相等整数(无向度(图, "A"), 2, "A 的无向度");
    断言相等整数(无向度(图, "B"), 2, "B 的无向度");
    断言相等整数(无向度(图, "C"), 3, "C 的无向度");
    断言相等整数(无向度(图, "D"), 1, "D 的无向度");

    // 按标签度：邻居里带「骗子」的有几个。A 的邻居 B、C 都是 → 2
    断言相等整数(按标签度(图, "A", "骗子"), 2, "A 连着两个骗子");
    断言相等整数(按标签度(图, "B", "骗子"), 1, "B 的邻居里只有 C 是骗子");
    断言相等整数(按标签度(图, "D", "骗子"), 1, "D 只连着 C");
    断言相等整数(按标签度(图, "A", "警察"), 0, "没有这个标签就是 0");

    // 占比：A 两个邻居全是骗子 → 1.0；B 两个里一个 → 0.5
    断言约等(按标签度占比(图, "A", "骗子"), 1.0, "A 的骗子邻居占比");
    断言约等(按标签度占比(图, "B", "骗子"), 0.5, "B 的骗子邻居占比");

    // 方向敏感版：A→B 和 C→A，所以 A 的出邻居只有 B，入邻居只有 C
    断言相等整数(按标签度(图, "A", "骗子", 0), 1, "A 出方向只够到 B");
    断言相等整数(按标签度(图, "A", "骗子", 1), 1, "A 入方向只够到 C");

    关闭图(图);
    返回 1;
}

函数 测_三角形与聚类() : 整数 {
    变量 图: 整数 = 建小图(库路径("特征三角"));

    // A、B、C 各自都在唯一那个三角形里；D 是尾巴，一个都不在
    断言相等整数(三角形数(图, "A"), 1, "A 在一个三角形里");
    断言相等整数(三角形数(图, "B"), 1, "B 在一个三角形里");
    断言相等整数(三角形数(图, "C"), 1, "C 在一个三角形里");
    断言相等整数(三角形数(图, "D"), 0, "D 不在任何三角形里");

    // 聚类系数 2T/(k(k-1))：A 是 2×1/(2×1)=1；C 是 2×1/(3×2)=1/3
    断言约等(聚类系数(图, "A"), 1.0, "A 的邻居彼此也认识 → 1.0");
    断言约等(聚类系数(图, "C"), 0.3333333333333333, "C 多一条尾巴，系数被摊薄");
    断言约等(聚类系数(图, "D"), 0.0, "只有一个邻居时无定义，按 0 给");

    关闭图(图);
    返回 1;
}

函数 测_自我网密度() : 整数 {
    变量 图: 整数 = 建小图(库路径("特征密度"));

    // A 的自我网 {A,B,C}：三条边 A-B、B-C、C-A，满图也是 3 → 1.0
    断言约等(自我网密度(图, "A"), 1.0, "A 的自我网是个满三角");
    // C 的自我网 {C,A,B,D}：边 C-A、C-B、C-D、A-B 共 4，满图 6 → 2/3
    断言约等(自我网密度(图, "C"), 0.6666666666666666, "C 的自我网 4/6");
    // D 的自我网 {D,C}：一条边，满图一条 → 1.0
    断言约等(自我网密度(图, "D"), 1.0, "两个点一条边就是满的");

    // 星型的对照：中心点聚类系数为 0，自我网密度却不是 0 —— 两个指标不是一回事
    变量 星: 整数 = 打开图(库路径("特征星"));
    加节点(星, "心", "[]", "{}");
    加节点(星, "甲", "[]", "{}");
    加节点(星, "乙", "[]", "{}");
    加节点(星, "丙", "[]", "{}");
    加边(星, "", "连", "心", "甲", "{}");
    加边(星, "", "连", "心", "乙", "{}");
    加边(星, "", "连", "心", "丙", "{}");
    断言约等(聚类系数(星, "心"), 0.0, "星型中心的邻居互不相识");
    // 自我网 {心,甲,乙,丙}：3 条边，满图 6 → 0.5
    断言约等(自我网密度(星, "心"), 0.5, "但自我网密度是 0.5，不是 0");
    关闭图(星);

    关闭图(图);
    返回 1;
}

函数 测_测地() : 整数 {
    变量 图: 整数 = 建小图(库路径("特征测地"));

    断言相等整数(最短跳数(图, "A", "A"), 0, "自己到自己 0 跳");
    断言相等整数(最短跳数(图, "A", "B"), 1, "A 到 B 一跳");
    断言相等整数(最短跳数(图, "A", "D"), 2, "A 到 D 要经 C");
    断言相等整数(最短跳数(图, "A", "不存在"), 0 - 1, "点不在图里给 -1");

    // A 到 B/C/D 分别 1/1/2 → 平均 4/3；最远 2
    断言约等(平均测地距离(图, "A"), 1.3333333333333333, "A 的平均测地距离");
    断言相等整数(离心率(图, "A"), 2, "A 最远要走 2 跳");
    // C 到 A/B/D 都是 1 → 平均 1，离心率 1
    断言约等(平均测地距离(图, "C"), 1.0, "C 一跳够到所有人");
    断言相等整数(离心率(图, "C"), 1, "C 的离心率 1");

    关闭图(图);
    返回 1;
}

函数 测_接近中心性() : 整数 {
    变量 图: 整数 = 建小图(库路径("特征接近"));

    // Wasserman–Faust：((可达-1)/距离和) × ((可达-1)/(总点数-1))，这里总点数 4
    // A：可达 4，距离和 1+1+2=4 → (3/4)×(3/3) = 0.75
    断言约等(接近中心性(图, "A"), 0.75, "A 的接近中心性");
    // C：可达 4，距离和 3 → (3/3)×(3/3) = 1.0，全图最高
    断言约等(接近中心性(图, "C"), 1.0, "C 离所有人都最近");
    // D：可达 4，距离和 1+2+2=5 → (3/5)×1 = 0.6
    断言约等(接近中心性(图, "D"), 0.6, "尾巴上的 D 最偏");

    // 不连通时 WF 版才站得住：孤立点够不着别人，分子归零
    变量 断: 整数 = 打开图(库路径("特征断"));
    加节点(断, "甲", "[]", "{}");
    加节点(断, "乙", "[]", "{}");
    加节点(断, "孤", "[]", "{}");
    加边(断, "", "连", "甲", "乙", "{}");
    断言约等(接近中心性(断, "孤"), 0.0, "谁都够不着的点是 0");
    // 甲：可达 2（甲、乙），距离和 1，总点数 3 → (1/1)×(1/2) = 0.5
    断言约等(接近中心性(断, "甲"), 0.5, "只够到一半的图，分数打对折");
    关闭图(断);

    关闭图(图);
    返回 1;
}

函数 测_介数中心性() : 整数 {
    变量 图: 整数 = 建小图(库路径("特征介数"));

    // 六对点里只有 A-D 和 B-D 的最短路要借道，两条都过 C → C 得 2，其余 0。
    // C 的度只比 A、B 多一，介数却从 0 跳到 2 —— 这就是「卡在要道上」和「连得多」的区别。
    变量 表: 整数 = 介数中心性(图);
    断言约等(哈希表::获取浮点数(表, "C"), 2.0, "C 是唯一的必经之路");
    断言约等(哈希表::获取浮点数(表, "A"), 0.0, "A 不在任何人的最短路中间");
    断言约等(哈希表::获取浮点数(表, "B"), 0.0, "B 也不在");
    断言约等(哈希表::获取浮点数(表, "D"), 0.0, "D 是端点，更不在");

    // 排行只取第一名，应该正好是 C
    变量 榜: 字符串 = 排行JSON(图, 表, 1);
    断言包含(榜, "\"id\":\"C\"", "榜首是 C");
    断言不含(榜, "\"id\":\"A\"", "只要一名就别把别人也列出来");
    哈希表::释放表(表);

    // 单点版跟全表版必须给同一个数（它内部照样跑全图，只是包装）
    断言约等(节点介数中心性(图, "C"), 2.0, "单点版与全表版一致");

    // 一条链 甲-乙-丙：中间的乙 被 甲-丙 这一对借道一次
    变量 链: 整数 = 打开图(库路径("特征链"));
    加节点(链, "甲", "[]", "{}");
    加节点(链, "乙", "[]", "{}");
    加节点(链, "丙", "[]", "{}");
    加边(链, "", "连", "甲", "乙", "{}");
    加边(链, "", "连", "乙", "丙", "{}");
    变量 表2: 整数 = 介数中心性(链);
    断言约等(哈希表::获取浮点数(表2, "乙"), 1.0, "三点一线，中间的介数是 1");
    断言约等(哈希表::获取浮点数(表2, "甲"), 0.0, "链头是 0");
    哈希表::释放表(表2);
    关闭图(链);

    关闭图(图);
    返回 1;
}

函数 表和(表: 整数, 图: 整数, a: 字符串, b: 字符串, c: 字符串, d: 字符串) : 浮点数 {
    返回 哈希表::获取浮点数(表, a) + 哈希表::获取浮点数(表, b)
        + 哈希表::获取浮点数(表, c) + 哈希表::获取浮点数(表, d);
}

函数 测_PageRank() : 整数 {
    // 三个人都指向 Z，Z 自己没有出边（悬挂节点）
    变量 图: 整数 = 打开图(库路径("特征PR"));
    加节点(图, "P", "[]", "{}");
    加节点(图, "Q", "[]", "{}");
    加节点(图, "R", "[]", "{}");
    加节点(图, "Z", "[]", "{}");
    加边(图, "", "指向", "P", "Z", "{}");
    加边(图, "", "指向", "Q", "Z", "{}");
    加边(图, "", "指向", "R", "Z", "{}");

    // 手算稳态：对称性给 3p+z=1 且 p=0.0375+0.2125z → p=0.152672，z=0.541985。
    // 悬挂质量没被均摊回去的话，总和会一路漏光 —— 所以「和为 1」是这一条最要紧的断言。
    变量 表: 整数 = PageRank(图, 0.85, 200);
    断言约等松(表和(表, 图, "P", "Q", "R", "Z"), 1.0, 0.000001, "PageRank 总和守恒（悬挂质量没漏）");
    断言约等松(哈希表::获取浮点数(表, "Z"), 0.5419847328244275, 0.0001, "Z 的稳态分数");
    断言约等松(哈希表::获取浮点数(表, "P"), 0.15267175572519084, 0.0001, "P 的稳态分数");
    断言为真(哈希表::获取浮点数(表, "Z") > 哈希表::获取浮点数(表, "P"), "被指的人分数更高");
    哈希表::释放表(表);

    // 默认参数（20 轮）也该收敛到同一个排序，总和照样是 1
    变量 表2: 整数 = PageRank(图);
    断言约等松(表和(表2, 图, "P", "Q", "R", "Z"), 1.0, 0.000001, "默认轮数总和也守恒");
    断言为真(哈希表::获取浮点数(表2, "Z") > 哈希表::获取浮点数(表2, "P"), "默认轮数排序一致");
    变量 榜: 字符串 = 排行JSON(图, 表2, 1);
    断言包含(榜, "\"id\":\"Z\"", "PageRank 榜首是 Z");
    哈希表::释放表(表2);

    关闭图(图);
    返回 1;
}

函数 测_个性化PageRank() : 整数 {
    // 两个互不相连的小圈：甲1↔甲2，乙1↔乙2
    变量 图: 整数 = 打开图(库路径("特征个性化"));
    加节点(图, "甲1", "[]", "{}");
    加节点(图, "甲2", "[]", "{}");
    加节点(图, "乙1", "[]", "{}");
    加节点(图, "乙2", "[]", "{}");
    加边(图, "", "连", "甲1", "甲2", "{}");
    加边(图, "", "连", "甲2", "甲1", "{}");
    加边(图, "", "连", "乙1", "乙2", "{}");
    加边(图, "", "连", "乙2", "乙1", "{}");

    // 普通 PageRank：四个点完全对称，各 0.25
    变量 普通: 整数 = PageRank(图);
    断言约等松(哈希表::获取浮点数(普通, "乙1"), 0.25, 0.0001, "普通 PageRank 下乙圈也有分");
    哈希表::释放表(普通);

    // 种在甲1：跳转只落回甲1，乙圈既够不着也不被跳转选中 → 分数应当是 0
    变量 个性: 整数 = 个性化PageRank(图, "[\"甲1\"]");
    断言为真(哈希表::获取浮点数(个性, "甲1") > 0.5, "种子自己分最高");
    断言为真(哈希表::获取浮点数(个性, "甲2") > 0.0, "同圈的甲2 也分到");
    断言约等松(哈希表::获取浮点数(个性, "乙1"), 0.0, 0.000001, "走不到的乙1 一分没有");
    断言约等松(哈希表::获取浮点数(个性, "乙2"), 0.0, 0.000001, "走不到的乙2 一分没有");
    断言约等松(表和(个性, 图, "甲1", "甲2", "乙1", "乙2"), 1.0, 0.000001, "个性化之后总和仍是 1");
    哈希表::释放表(个性);

    // 种子给了个不存在的 id → 退化成普通 PageRank，而不是全 0
    变量 退化: 整数 = 个性化PageRank(图, "[\"查无此人\"]");
    断言约等松(哈希表::获取浮点数(退化, "乙1"), 0.25, 0.0001, "种子无效时退回普通 PageRank");
    哈希表::释放表(退化);

    关闭图(图);
    返回 1;
}

函数 测_特征向量() : 整数 {
    变量 图: 整数 = 建小图(库路径("特征向量"));

    变量 行: 字符串 = 节点特征JSON(图, "C");
    断言包含(行, "\"id\":\"C\"", "带 id");
    断言包含(行, "\"三角形数\":1", "三角形数进了向量");
    断言包含(行, "\"无向度\":3", "无向度进了向量");
    断言包含(行, "\"离心率\":1", "离心率进了向量");

    // 不存在的点：给一行「存在:false」，而不是崩或者给一堆 0 让人误以为真有这个点
    变量 缺: 字符串 = 节点特征JSON(图, "查无此人");
    断言包含(缺, "\"存在\":false", "不存在的点明说不存在");

    // 全图版：四行，且带上两个只能全局算的指标
    变量 全: 字符串 = 全图特征JSON(图);
    变量 组: 整数 = J.解码(全);
    断言相等整数(J.数组长度(组), 4, "四个节点四行");
    J.删除(组);
    断言包含(全, "\"PageRank\"", "全图版带 PageRank");
    断言包含(全, "\"介数中心性\"", "全图版带介数中心性");

    关闭图(图);
    返回 1;
}

函数 测_空图与边界() : 整数 {
    变量 空: 整数 = 打开图(库路径("特征空"));
    断言相等整数(无向度(空, "没有"), 0, "空图上度是 0");
    断言相等整数(三角形数(空, "没有"), 0, "空图上三角形是 0");
    断言约等(自我网密度(空, "没有"), 0.0, "空图上密度是 0");
    断言约等(接近中心性(空, "没有"), 0.0, "空图上接近中心性是 0");
    变量 表: 整数 = 介数中心性(空);
    断言相等(排行JSON(空, 表, 3), "[]", "空图的排行是空数组");
    哈希表::释放表(表);
    变量 pr: 整数 = PageRank(空);
    哈希表::释放表(pr);
    关闭图(空);

    // 单点图：所有比值型指标都该是 0，不能除零
    变量 单: 整数 = 打开图(库路径("特征单点"));
    加节点(单, "独", "[]", "{}");
    断言约等(聚类系数(单, "独"), 0.0, "单点聚类系数 0");
    断言约等(自我网密度(单, "独"), 0.0, "单点自我网密度 0");
    断言约等(平均测地距离(单, "独"), 0.0, "单点平均测地 0");
    断言相等整数(离心率(单, "独"), 0, "单点离心率 0");
    变量 pr2: 整数 = PageRank(单);
    断言约等松(哈希表::获取浮点数(pr2, "独"), 1.0, 0.000001, "只有一个点时它拿全部质量");
    哈希表::释放表(pr2);
    关闭图(单);

    返回 1;
}

// 排行按标签挑 —— 混着好几类节点的图上，「哪个包最要紧」不该被概念节点占榜。
// 用的是仓库问答那个示例真踩到的形状：包依赖图上叠了 LLM 抽出来的概念节点，
// 概念节点是叶子（只进不出），PageRank 的质量顺着边全流到它们身上。
函数 测_排行按标签() : 整数 {
    变量 图: 整数 = 打开图(库路径("特征排行标签"));
    加节点(图, "Harness", "[\"包\"]", "{}");
    加节点(图, "Graph", "[\"包\"]", "{}");
    加节点(图, "KV", "[\"包\"]", "{}");
    // 三个叶子概念，全是「只进不出」—— PageRank 的质量最后都堆在这儿
    加节点(图, "邻接不前缀扫", "[\"概念\"]", "{}");
    加节点(图, "日志式存储", "[\"概念\"]", "{}");
    加节点(图, "断点续跑", "[\"概念\"]", "{}");
    加边(图, "", "依赖", "Harness", "Graph", "{}");
    加边(图, "", "依赖", "Graph", "KV", "{}");
    加边(图, "", "讲到", "Graph", "邻接不前缀扫", "{}");
    加边(图, "", "讲到", "KV", "日志式存储", "{}");
    加边(图, "", "讲到", "Harness", "断点续跑", "{}");

    变量 表: 整数 = PageRank(图);

    // 不过滤：榜首是概念节点，不是包 —— 这正是那个示例打印出来的怪东西
    变量 全榜: 字符串 = 排行JSON(图, 表, 1);
    断言不含(全榜, "\"id\":\"Harness\"", "不过滤时榜首不是包（质量流到叶子上了）");

    // 按 包 过滤：只在包里排，KV 该在最前（它是唯一被两跳指到的包）
    变量 包榜: 字符串 = 排行JSON(图, 表, 3, "包");
    断言不含(包榜, "概念", "带标签的排行里不该出现概念节点");
    断言不含(包榜, "邻接不前缀扫", "叶子概念被挡在外面");
    断言包含(包榜, "\"id\":\"KV\"", "包里 KV 在");
    断言包含(包榜, "\"id\":\"Graph\"", "包里 Graph 在");
    断言包含(包榜, "\"id\":\"Harness\"", "包里 Harness 在");

    // 分数是**全图**算的，不是把概念删掉重算 —— 过滤前后同一个 id 的分数必须一样
    变量 单: 字符串 = 排行JSON(图, 表, 1, "包");
    断言包含(单, "\"id\":\"KV\"", "只要一名时给的是包里的第一名");

    // 空标签 = 全图，跟三参数那版一字不差
    断言相等(排行JSON(图, 表, 2, ""), 排行JSON(图, 表, 2), "空标签等同于不过滤");
    // 没有这个标签的话给空数组，不是给全图
    断言相等(排行JSON(图, 表, 3, "根本没有这个标签"), "[]", "标签一个都没命中就是空数组");

    哈希表::释放表(表);
    关闭图(图);
    返回 1;
}

函数 入口() {
    运行用例("度与按标签度", 测_度);
    运行用例("三角形与聚类系数", 测_三角形与聚类);
    运行用例("自我网密度", 测_自我网密度);
    运行用例("测地距离", 测_测地);
    运行用例("接近中心性", 测_接近中心性);
    运行用例("介数中心性", 测_介数中心性);
    运行用例("PageRank", 测_PageRank);
    运行用例("个性化 PageRank", 测_个性化PageRank);
    运行用例("特征向量组装", 测_特征向量);
    运行用例("排行按标签挑", 测_排行按标签);
    运行用例("空图与边界", 测_空图与边界);
    摘要并退出();
}
