// 本体导入导出_测 —— JSON 往返等价、键序稳定、只导断言、Turtle 样例
//
// 「等价」用最严的标准：两份导出的**字符串逐字节相等**。这要求导出顺序跟插入顺序无关，
// 所以有一个用例专门用两种不同的插入顺序建同一个本体。

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含, 断言不含};
导入 标准库.输入输出 作为 IO;
导入 标准库.列表 作为 表列;
导入 标准库.字符串;
导入 Graph::{打开本体, 关闭本体, 定义类, 类注释, 类定义, 定义属性, 属性定义, 加个体, 个体类型,
             断言, 断言字面量, 有三元组, 三元组数, 值, 字符串列表连成行,
             物化推理, 推出三元组数, 导出本体JSON, 导入本体JSON, 导出Turtle, 开本体, 本体库};

函数 库路径(名: 字符串) : 字符串 {
    返回 "/tmp/qigraph-测-导出-" + 名 + ".kv";
}

函数 新库(名: 字符串) : 整数 {
    变量 p: 字符串 = 库路径(名);
    如果 (IO.文件存在(p) == 1) { IO.删除文件(p); }
    返回 打开本体(p);
}

函数 列表行(表: 整数) : 字符串 {
    变量 s: 字符串 = 字符串列表连成行(表, ",");
    表列::删除列表(表);
    返回 s;
}

// 数一段文本里某个子串出现几次
函数 数出现(文: 字符串, 子: 字符串) : 整数 {
    变量 数: 整数 = 0;
    变量 从: 整数 = 0;
    变量 步: 整数 = 字符串::字节长度(子);
    当 (真) {
        变量 位: 整数 = 字符串::查找从位置(文, 子, 从);
        如果 (位 < 0) { 返回 数; }
        数 = 数 + 1;
        从 = 位 + 步;
    }
    返回 数;
}

函数 建样例(本: 整数) : 整数 {
    定义类(本, "动物");
    定义类(本, "哺乳动物", "动物");
    定义类(本, "会游泳的", "动物");
    定义类(本, "海豚", "哺乳动物");
    定义类(本, "海豚", "会游泳的");
    类注释(本, "海豚", "聪明");
    定义类(本, "人");
    定义属性(本, "年龄", "动物", "整数", "{\"functional\":1}");
    定义属性(本, "体重", "动物", "浮点数", "");
    定义属性(本, "名字", "动物", "字符串", "");
    定义属性(本, "会飞", "动物", "布尔", "");
    定义属性(本, "认识", "动物", "动物", "{\"symmetric\":1}");
    定义属性(本, "养", "人", "动物", "{\"inverse\":\"被养\"}");
    定义属性(本, "被养", "动物", "人", "");
    加个体(本, "小海", "海豚");
    加个体(本, "小明", "人");
    加个体(本, "小白", "海豚");
    断言字面量(本, "小海", "年龄", "3", "整数");
    断言字面量(本, "小海", "体重", "150.5", "浮点数");
    断言字面量(本, "小海", "名字", "小\"海\"", "字符串");
    断言字面量(本, "小海", "会飞", "0", "布尔");
    断言(本, "小海", "认识", "小白");
    断言(本, "小明", "养", "小海");
    返回 0;
}

函数 测_往返等价() : 整数 {
    变量 本: 整数 = 新库("往返甲");
    建样例(本);
    变量 甲: 字符串 = 导出本体JSON(本);
    变量 数: 整数 = 三元组数(本);
    断言包含(甲, "\"classes\":[{\"name\":\"人\"", "有类");
    断言包含(甲, "\"comment\":\"聪明\"", "有注释");
    断言包含(甲, "\"parents\":[\"会游泳的\",\"哺乳动物\"]", "多父类排了序");
    断言包含(甲, "\"inverse\":\"被养\"", "属性选项");
    断言包含(甲, "{\"id\":\"小海\",\"types\":[\"海豚\"]}", "个体");
    断言包含(甲, "{\"lit\":\"150.5\",\"dt\":\"浮点数\"}", "字面量带数据类型");

    变量 乙: 整数 = 新库("往返乙");
    变量 导入了: 整数 = 导入本体JSON(乙, 甲);
    断言相等整数(导入了, 数, "导入的三元组数 = 原库三元组数");
    断言相等整数(三元组数(乙), 数, "新库三元组数一致");
    断言相等(导出本体JSON(乙), 甲, "再导出逐字节相等");
    断言包含(类定义(乙, "海豚"), "聪明", "注释过来了");
    断言包含(属性定义(乙, "年龄"), "\"functional\":1", "函数性过来了");
    断言相等(列表行(值(乙, "小海", "名字")), "小\"海\"", "带引号的字面量过来了");
    断言相等整数(有三元组(乙, "小明", "养", "小海"), 1, "普通三元组过来了");

    // 导进非空库是幂等的
    断言相等整数(导入本体JSON(乙, 甲), 数, "重复导入报同样的条数");
    断言相等整数(三元组数(乙), 数, "重复导入不涨");
    断言相等(导出本体JSON(乙), 甲, "重复导入后导出不变");
    断言相等整数(导入本体JSON(乙, "这不是 JSON"), -1, "坏文本返回 -1");
    断言相等整数(三元组数(乙), 数, "坏文本没写进任何东西");
    关闭本体(乙);
    关闭本体(本);
    返回 0;
}

函数 测_键序稳定() : 整数 {
    变量 甲: 整数 = 新库("键序甲");
    建样例(甲);
    变量 甲文: 字符串 = 导出本体JSON(甲);
    关闭本体(甲);

    // 同一个本体，反着来：先断言三元组再定义类，父类顺序也反过来
    变量 乙: 整数 = 新库("键序乙");
    断言(乙, "小明", "养", "小海");
    断言(乙, "小海", "认识", "小白");
    断言字面量(乙, "小海", "会飞", "0", "布尔");
    断言字面量(乙, "小海", "名字", "小\"海\"", "字符串");
    断言字面量(乙, "小海", "体重", "150.5", "浮点数");
    断言字面量(乙, "小海", "年龄", "3", "整数");
    加个体(乙, "小白", "海豚");
    加个体(乙, "小明", "人");
    加个体(乙, "小海", "海豚");
    定义属性(乙, "被养", "动物", "人", "");
    定义属性(乙, "养", "人", "动物", "{\"inverse\":\"被养\"}");
    定义属性(乙, "认识", "动物", "动物", "{\"symmetric\":1}");
    定义属性(乙, "会飞", "动物", "布尔", "");
    定义属性(乙, "名字", "动物", "字符串", "");
    定义属性(乙, "体重", "动物", "浮点数", "");
    定义属性(乙, "年龄", "动物", "整数", "{\"functional\":1}");
    定义类(乙, "人");
    定义类(乙, "海豚", "会游泳的");
    类注释(乙, "海豚", "聪明");
    定义类(乙, "海豚", "哺乳动物");
    定义类(乙, "会游泳的", "动物");
    定义类(乙, "哺乳动物", "动物");
    定义类(乙, "动物");
    断言相等(导出本体JSON(乙), 甲文, "插入顺序完全不同，导出逐字节相等");
    关闭本体(乙);
    返回 0;
}

函数 测_只导断言() : 整数 {
    变量 本: 整数 = 新库("只导断言");
    建样例(本);
    变量 前: 字符串 = 导出本体JSON(本);
    变量 推了: 整数 = 物化推理(本);
    断言为真(推了 >= 2, "对称 + 逆属性至少推出两条");
    变量 后: 字符串 = 导出本体JSON(本);
    断言相等(后, 前, "推出来的不进 JSON，导出不变");
    断言不含(后, "inferred", "没有 inferred 字样");

    变量 乙: 整数 = 新库("只导断言乙");
    导入本体JSON(乙, 后);
    断言相等整数(推出三元组数(乙), 0, "导入后没有推出标记");
    断言相等整数(物化推理(乙), 推了, "在新库重推得到同样多");
    关闭本体(乙);
    关闭本体(本);
    返回 0;
}

函数 测_Turtle() : 整数 {
    变量 本: 整数 = 新库("Turtle");
    建样例(本);
    物化推理(本);
    变量 t: 字符串 = 导出Turtle(本);
    断言包含(t, ":小海 :类型是 :海豚 .\n", "个体三元组");
    断言包含(t, ":小海 :年龄 3 .\n", "整数裸写");
    断言包含(t, ":小海 :体重 150.5 .\n", "浮点数裸写");
    断言包含(t, ":小海 :会飞 false .\n", "布尔");
    断言包含(t, ":小海 :名字 \"小\\\"海\\\"\" .\n", "字符串加引号并转义");
    断言包含(t, ":海豚 :父类是 :哺乳动物 .\n", "类层次");
    断言包含(t, ":年龄 :值域 :整数 .\n", "属性的值域");
    断言包含(t, ":小白 :认识 :小海 . # 推出\n", "推出来的带标记");
    断言包含(t, ":小海 :被养 :小明 . # 推出\n", "逆属性推出");
    断言不含(t, ":小海 :认识 :小白 . #", "断言的没有标记");
    断言相等整数(数出现(t, "\n"), 三元组数(本), "一行一条，含推出的");
    断言相等整数(数出现(t, " . # 推出\n") + 数出现(t, " .\n"), 三元组数(本), "每行都以 . 或 . # 推出 结尾");
    断言相等整数(数出现(t, "# 推出"), 推出三元组数(本), "推出行数对得上");
    // 顺序：主语字典序，同主语按谓词
    断言为真(字符串::查找(t, ":小明 ") < 字符串::查找(t, ":小海 "), "小明 排在 小海 前（字节序）");
    断言为真(字符串::查找(t, ":小海 :会飞") < 字符串::查找(t, ":小海 :名字"), "同主语按谓词字节序");
    关闭本体(本);
    返回 0;
}

函数 测_链式导入导出() : 整数 {
    变量 p: 字符串 = 库路径("链式");
    如果 (IO.文件存在(p) == 1) { IO.删除文件(p); }
    变量 k: 本体库 = 开本体(p).定义类("动物").加个体("甲", "动物");
    变量 j: 字符串 = k.导出JSON();
    断言包含(j, "\"individuals\":[{\"id\":\"甲\",\"types\":[\"动物\"]}]", "链式导出");
    断言包含(k.导出Turtle(), ":甲 :类型是 :动物 .", "链式 Turtle");
    变量 p2: 字符串 = 库路径("链式二");
    如果 (IO.文件存在(p2) == 1) { IO.删除文件(p2); }
    变量 k2: 本体库 = 开本体(p2).导入JSON(j);
    断言相等(k2.导出JSON(), j, "链式导入");
    k2.关();
    k.关();
    返回 0;
}

函数 入口() {
    运行用例("导入导出.往返等价", 测_往返等价);
    运行用例("导入导出.键序稳定", 测_键序稳定);
    运行用例("导入导出.只导断言", 测_只导断言);
    运行用例("导入导出.Turtle", 测_Turtle);
    运行用例("导入导出.链式", 测_链式导入导出);
    摘要并退出();
}
