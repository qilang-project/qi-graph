// 图实体_测 —— 别名、候选、路径转文本、合并（NED 的存储侧）
//
// 用的是这个生态里真实存在的一处歧义：**「qi」到底指什么**。
// 它至少指两样东西 —— 奇语这门语言，和那个叫 qi 的编译器命令行。
// 事实取自仓库现状：编译器用 LLVM 21、用 Rust 写；语言由这个编译器实现。
// 书里 8.4.3 的判据就是「看候选跟上下文里已确定的实体怎么连」——
// 上下文提到 LLVM 时，qi编译器 一跳就到，奇语 要绕两跳。

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含, 断言不含};
导入 标准库.输入输出 作为 IO;
导入 标准库.列表 作为 表列;
导入 标准库.JSON 作为 J;
导入 Graph::{打开图, 关闭图, 加节点, 加边, 有节点, 取标签, 取边, 出邻居, 出边, 无向最短路径,
             加别名, 别名指向, 列别名, 删别名, 删节点带别名,
             候选, 路径转文本, 消歧上下文, 合并节点};

函数 建生态图(路径: 字符串) : 整数 {
    如果 (IO::文件存在(路径) == 1) { IO::删除文件(路径); }
    变量 图: 整数 = 打开图(路径);
    加节点(图, "奇语", "[\"编程语言\"]", "{\"关键字\":\"中文\"}");
    加节点(图, "qi编译器", "[\"程序\"]", "{}");
    加节点(图, "LLVM21", "[\"工具链\"]", "{}");
    加节点(图, "Rust", "[\"编程语言\"]", "{}");
    加边(图, "", "实现", "qi编译器", "奇语", "{}");
    加边(图, "", "用", "qi编译器", "LLVM21", "{}");
    加边(图, "", "写于", "qi编译器", "Rust", "{}");
    返回 图;
}

函数 测_别名增删查() : 整数 {
    变量 图: 整数 = 建生态图("/tmp/qigraph-测-实体1.kv");

    断言相等整数(加别名(图, "奇语", "qi 语言"), 1, "挂上别名");
    断言相等整数(加别名(图, "奇语", "Qi"), 1, "再挂一个");
    断言相等(别名指向(图, "qi 语言"), "奇语", "反查得回来");
    断言相等(别名指向(图, "没这个别名"), "", "查不到给空串");

    // 幂等
    断言相等整数(加别名(图, "奇语", "Qi"), 1, "重复挂同一个实体是幂等的");
    // 同一个别名挂到另一个实体要拒绝 —— 悄悄覆盖会让「Qi 指谁」变成随机答案
    断言相等整数(加别名(图, "qi编译器", "Qi"), 0, "别名不能改指另一个实体");
    断言相等(别名指向(图, "Qi"), "奇语", "拒绝之后指向没变");

    变量 名表: 整数 = 列别名(图, "奇语");
    断言相等整数(表列::字符串列表大小(名表), 2, "列出两个别名");
    表列::删除列表(名表);

    // 冒号在别名里很常见（"mcp:fetch" 那种），键要 hex 编码，反查照样通
    断言相等整数(加别名(图, "qi编译器", "cmd:qi"), 1, "带冒号的别名挂得上");
    断言相等(别名指向(图, "cmd:qi"), "qi编译器", "带冒号的别名反查得回来");

    断言相等整数(删别名(图, "Qi"), 1, "删得掉");
    断言相等(别名指向(图, "Qi"), "", "删完就查不到了");
    变量 名表2: 整数 = 列别名(图, "奇语");
    断言相等整数(表列::字符串列表大小(名表2), 1, "节点上那份也同步删了");
    表列::删除列表(名表2);

    // 删节点要把别名索引一起清，不留孤儿
    加别名(图, "Rust", "rustlang");
    删节点带别名(图, "Rust");
    断言相等整数(有节点(图, "Rust"), 0, "节点删了");
    断言相等(别名指向(图, "rustlang"), "", "别名索引没留下孤儿");

    关闭图(图);
    返回 1;
}

函数 测_候选选择() : 整数 {
    变量 图: 整数 = 建生态图("/tmp/qigraph-测-实体2.kv");
    加别名(图, "奇语", "qi 语言");
    加别名(图, "qi编译器", "qi 命令行");

    // 提及正好是 id
    变量 直: 字符串 = 候选(图, "奇语");
    断言包含(直, "\"id\":\"奇语\"", "id 直接命中");
    断言包含(直, "\"凭什么\":\"id\"", "标明是靠 id 命中的");

    // 提及是别名
    变量 别: 字符串 = 候选(图, "qi 语言");
    断言包含(别, "\"id\":\"奇语\"", "别名命中");
    断言包含(别, "\"凭什么\":\"别名\"", "标明是靠别名命中的");

    // 真正的歧义：「qi」既不是 id 也不是完整别名，近似匹配捞出两个候选
    变量 糊: 字符串 = 候选(图, "qi");
    变量 组: 整数 = J.解码(糊);
    断言相等整数(J.数组长度(组), 2, "「qi」是歧义的，两个候选");
    断言包含(糊, "奇语", "候选里有语言");
    断言包含(糊, "qi编译器", "候选里有编译器");
    断言包含(糊, "\"凭什么\":\"近似\"", "标明是近似匹配来的");
    J.删除(组);

    // 查无此人
    断言相等(候选(图, "根本没有这个东西"), "[]", "没候选就是空数组");

    关闭图(图);
    返回 1;
}

函数 测_路径转文本() : 整数 {
    变量 图: 整数 = 建生态图("/tmp/qigraph-测-实体3.kv");

    // qi编译器 --用--> LLVM21
    变量 路1: 整数 = 无向最短路径(图, "qi编译器", "LLVM21");
    断言相等(路径转文本(图, 路1), "qi编译器 --用--> LLVM21", "一跳路径翻成一句话");
    表列::删除列表(路1);

    // 奇语 到 LLVM21 要经过编译器；奇语 是被 实现 的那一端，所以第一跳是反向
    变量 路2: 整数 = 无向最短路径(图, "奇语", "LLVM21");
    断言相等(路径转文本(图, 路2), "奇语 --被实现--> qi编译器 --用--> LLVM21",
        "反向边渲染成 被X，方向没被抹掉");
    表列::删除列表(路2);

    // 空路径给空串，不崩
    变量 空: 整数 = 表列::创建字符串列表();
    断言相等(路径转文本(图, 空), "", "空路径给空串");
    表列::删除列表(空);

    关闭图(图);
    返回 1;
}

函数 测_消歧上下文() : 整数 {
    变量 图: 整数 = 建生态图("/tmp/qigraph-测-实体4.kv");
    加别名(图, "奇语", "qi 语言");
    加别名(图, "qi编译器", "qi 命令行");

    // 书里 8.4.3 的那一步：把每个候选到上下文实体的路径翻成人话交给模型
    变量 段: 字符串 = 消歧上下文(图, "qi", "[\"LLVM21\"]");
    断言包含(段, "有 2 个候选", "先说清有几个候选");
    断言包含(段, "qi编译器 --用--> LLVM21", "编译器一跳到 LLVM");
    断言包含(段, "奇语 --被实现--> qi编译器 --用--> LLVM21", "语言要绕两跳");
    断言包含(段, "标签", "带上标签，模型好判断类别");

    // 走不通也要说出来 —— 「跟上下文毫无关系」本身就是排除的依据
    加节点(图, "无关的东西", "[]", "{}");
    变量 段2: 字符串 = 消歧上下文(图, "qi", "[\"无关的东西\"]");
    断言包含(段2, "走不通", "走不通要明说");

    // 一个候选都没有时给一句话，不是空串
    断言包含(消歧上下文(图, "查无此物", "[\"LLVM21\"]"), "找不到任何候选实体",
        "没候选时说清楚");

    关闭图(图);
    返回 1;
}

函数 测_合并实体() : 整数 {
    变量 图: 整数 = 建生态图("/tmp/qigraph-测-实体5.kv");
    // 常见的脏数据：同一个东西进了两次，一次叫 qi编译器，一次叫 qi-compiler
    加节点(图, "qi-compiler", "[\"编译器\"]", "{\"语言\":\"Rust\",\"许可\":\"MIT\"}");
    加边(图, "", "用", "qi-compiler", "LLVM21", "{}");
    加边(图, "", "维护", "李亮", "qi-compiler", "{}");
    加节点(图, "李亮", "[\"人\"]", "{}");
    加边(图, "", "维护", "李亮", "qi-compiler", "{}");
    加别名(图, "qi-compiler", "qic");

    变量 动了: 整数 = 合并节点(图, "qi编译器", "qi-compiler");
    断言为真(动了 > 0, "有边被改挂过来");

    // 并入方没了
    断言相等整数(有节点(图, "qi-compiler"), 0, "并入的节点删掉了");
    // 但它的旧 id 和旧别名都成了保留方的别名 —— 原文里再出现旧名字还查得到
    断言相等(别名指向(图, "qi-compiler"), "qi编译器", "旧 id 变成别名");
    断言相等(别名指向(图, "qic"), "qi编译器", "旧别名跟着转过来");
    // 边改挂了：李亮 现在维护的是 qi编译器
    变量 维护的: 整数 = 出邻居(图, "李亮", "维护");
    断言相等整数(表列::字符串列表大小(维护的), 1, "李亮 维护一个东西");
    断言相等(表列::获取字符串(维护的, 0), "qi编译器", "改挂到了保留方");
    表列::删除列表(维护的);
    // 标签取并集
    断言包含(取标签(图, "qi编译器"), "编译器", "并入方的标签也留下了");
    断言包含(取标签(图, "qi编译器"), "程序", "保留方原有的标签还在");
    // 属性补缺
    断言包含(候选(图, "qic"), "qi编译器", "从旧别名还能找回实体");

    // 参数不合法
    断言相等整数(合并节点(图, "qi编译器", "qi编译器"), 0 - 1, "自己合并自己是错的");
    断言相等整数(合并节点(图, "qi编译器", "查无此物"), 0 - 1, "并入方不存在是错的");

    关闭图(图);
    返回 1;
}

// 归并不许留重边。
//
// 这是真跑 qi-harness 的 仓库问答 示例撞出来的：LLM 从 README 抽出
// 「qi-graph 依赖 KV」，手工建的图里本来就有「Graph 依赖 KV」，
// 把 qi-graph 并进 Graph 之后「谁依赖 KV」查出来是两个一模一样的 Graph。
// 两个实体对同一个目标有同样的关系，恰恰是判定它们是同一个实体的**理由** ——
// 所以这在归并里是主线情况，不是边角。
函数 测_归并不留重边() : 整数 {
    变量 路: 字符串 = "/tmp/qigraph-测-实体重边.kv";
    如果 (IO::文件存在(路) == 1) { IO::删除文件(路); }
    变量 图: 整数 = 打开图(路);
    加节点(图, "Graph", "[\"包\"]", "{}");
    加节点(图, "qi-graph", "[\"包\"]", "{}");
    加节点(图, "KV", "[\"包\"]", "{}");
    加节点(图, "Harness", "[\"包\"]", "{}");
    // 出边重合：两个写法都说自己依赖 KV
    加边(图, "", "依赖", "Graph", "KV", "{}");
    加边(图, "", "依赖", "qi-graph", "KV", "{}");
    // 入边重合：Harness 对两个写法都有一条 依赖
    加边(图, "", "依赖", "Harness", "Graph", "{}");
    加边(图, "", "依赖", "Harness", "qi-graph", "{}");
    // 这一条不重合，必须保住（加边 要求两端节点都已存在，先建点再连）
    加节点(图, "追加日志", "[\"概念\"]", "{}");
    加边(图, "", "用了", "qi-graph", "追加日志", "{}");

    合并节点(图, "Graph", "qi-graph");

    // ⚠ 这里必须数**边**，不能数邻居：出邻居 给的是去重后的邻居，
    // 两条平行的 Graph-[:依赖]->KV 在它眼里就是一个 KV。
    // 第一版就是这么写的，把去重代码删掉测试照样通过 —— 等于没测。
    断言相等整数(数边(图, "Graph", "依赖", "KV"), 1, "Graph 依赖 KV 只有一条边，不是两条");
    断言相等整数(数边(图, "Harness", "依赖", "Graph"), 1, "Harness 依赖 Graph 也只有一条");
    // 不重合的那条原样保住 —— 去重不能把别的边一起吃掉
    断言相等整数(数边(图, "Graph", "用了", "追加日志"), 1, "不重合的边照常改挂过来");
    变量 用: 整数 = 出邻居(图, "Graph", "用了");
    断言相等整数(表列::字符串列表大小(用), 1, "改挂过来的是那条 用了");
    表列::删除列表(用);

    关闭图(图);
    返回 1;
}

// 数 起 到 止 之间 型 这种边有几条。**边级别**的计数：
// 出邻居 会把平行边折成一个邻居，用它数不出重边来。
函数 数边(图: 整数, 起: 字符串, 型: 字符串, 止: 字符串) : 整数 {
    变量 表: 整数 = 出边(图, 起);
    变量 数: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 表列::字符串列表大小(表)) {
        变量 边: 整数 = J.解码(取边(图, 表列::获取字符串(表, i)));
        如果 (边 > 0) {
            如果 (J.获取字符串(边, "type") == 型 与 J.获取字符串(边, "to") == 止) {
                数 = 数 + 1;
            }
            J.删除(边);
        }
        i = i + 1;
    }
    表列::删除列表(表);
    返回 数;
}

函数 入口() {
    运行用例("别名增删查", 测_别名增删查);
    运行用例("候选选择", 测_候选选择);
    运行用例("路径转文本", 测_路径转文本);
    运行用例("消歧上下文", 测_消歧上下文);
    运行用例("合并实体", 测_合并实体);
    运行用例("归并不留重边", 测_归并不留重边);
    摘要并退出();
}
