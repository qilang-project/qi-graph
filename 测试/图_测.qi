// 图_测 —— 节点 / 边的增删改查、级联删除、持久化、导入导出
//
// 盯的是两处「看着对其实错」的地方：
//   ① 级联删除之后邻接表和索引必须干净 —— 残留一条就是下次遍历时的幽灵节点
//   ② 重开库后一切还在 —— 图层自己不管持久化，全靠 qi-kv，所以要真的关掉再开

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含};
导入 标准库.列表 作为 表列;
导入 标准库.输入输出 作为 IO;
导入 标准库.JSON 作为 J;
导入 Graph::{打开图, 关闭图, 图可用, 加节点, 新节点, 取节点, 有节点, 取属性, 取标签, 改属性,
             加标签, 去标签, 有标签, 按标签列节点, 删节点,
             加边, 新边, 取边, 有边, 删边, 改边属性, 按类型列边,
             出边, 入边, 度, 节点数, 边数, 统计JSON,
             导出JSON, 导入JSON, 导出到文件, 从文件导入,
             开图, 图库};

函数 库路径2(名: 字符串) : 字符串 {
    返回 "/tmp/qigraph-测-" + 名 + ".kv";
}

函数 库路径(名: 字符串) : 字符串 {
    变量 p: 字符串 = 库路径2(名);
    如果 (IO::文件存在(p) == 1) {
        IO::删除文件(p);
    }
    返回 p;
}

// 把字符串列表读成逗号串并释放，断言用
函数 行(表: 整数) : 字符串 {
    变量 出: 字符串 = "";
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (i > 0) {
            出 = 出 + ",";
        }
        出 = 出 + 表列::获取字符串(表, i);
        i = i + 1;
    }
    表列::删除列表(表);
    返回 出;
}

函数 测_节点CRUD() : 整数 {
    变量 g: 整数 = 打开图(库路径("节点"));
    断言为真(g > 0, "打开图");
    断言相等整数(图可用(g), 1, "可用");
    断言相等整数(节点数(g), 0, "新图没节点");
    断言相等(取节点(g, "无"), "", "缺节点返回空串");
    断言相等整数(有节点(g, "无"), 0, "缺节点不存在");

    断言相等整数(加节点(g, "张三", "[\"人\",\"员工\"]", "{\"年龄\":30,\"城市\":\"成都\"}"), 1, "加节点");
    断言相等整数(加节点(g, "张三", "[]", "{}"), 0, "重复 id 拒绝");
    断言相等整数(加节点(g, "李四", "", ""), 1, "空标签空属性也行");
    断言相等整数(加节点(g, "坏", "不是JSON", "{}"), 0, "标签不是 JSON 拒绝");
    断言相等整数(加节点(g, "坏", "[]", "[1]"), 0, "属性不是对象拒绝");
    断言相等整数(节点数(g), 2, "两个节点");
    断言相等整数(有节点(g, "张三"), 1, "有节点");
    断言相等(取节点(g, "张三"), "{\"id\":\"张三\",\"labels\":[\"人\",\"员工\"],\"props\":{\"年龄\":30,\"城市\":\"成都\"}}", "节点 JSON 键序固定");
    断言相等(取节点(g, "李四"), "{\"id\":\"李四\",\"labels\":[],\"props\":{}}", "空节点 JSON");
    断言相等(取属性(g, "张三"), "{\"年龄\":30,\"城市\":\"成都\"}", "取属性");
    断言相等(取标签(g, "张三"), "[\"人\",\"员工\"]", "取标签");
    断言相等(取属性(g, "无"), "", "缺节点取属性空");

    // 改属性是合并：同名覆盖、其余保留、类型保留
    断言相等整数(改属性(g, "张三", "{\"年龄\":31,\"活跃\":true,\"分数\":1.5,\"备注\":\"\"}"), 1, "改属性");
    断言相等(取属性(g, "张三"), "{\"年龄\":31,\"城市\":\"成都\",\"活跃\":true,\"分数\":1.5,\"备注\":\"\"}", "合并后类型和顺序都对");
    断言相等整数(改属性(g, "无", "{}"), 0, "改不存在的节点返回 0");
    断言相等整数(改属性(g, "张三", "[]"), 0, "补丁不是对象返回 0");
    变量 属: 整数 = J.解码(取属性(g, "张三"));
    断言相等整数(J.获取整数(属, "年龄"), 31, "整数字段还是整数");
    断言相等整数(J.获取布尔(属, "活跃"), 1, "布尔字段还是布尔");
    J.删除(属);

    // 标签
    断言相等整数(加标签(g, "李四", "员工"), 1, "加标签");
    断言相等整数(加标签(g, "李四", "员工"), 1, "重复加标签幂等");
    断言相等(取标签(g, "李四"), "[\"员工\"]", "重复加不会出现两次");
    断言相等整数(有标签(g, "李四", "员工"), 1, "有标签");
    断言相等(行(按标签列节点(g, "员工")), "张三,李四", "按标签列节点");
    断言相等整数(去标签(g, "张三", "员工"), 1, "去标签");
    断言相等整数(有标签(g, "张三", "员工"), 0, "去掉后索引里没了");
    断言相等(取标签(g, "张三"), "[\"人\"]", "去掉后节点 JSON 里也没了");
    断言相等(行(按标签列节点(g, "员工")), "李四", "索引只剩李四");
    断言相等(行(按标签列节点(g, "没人")), "", "没有的标签空表");
    断言相等整数(加标签(g, "无", "x"), 0, "给不存在的节点加标签 0");

    // 自动 id
    断言相等(新节点(g, "[]", "{}"), "n1", "自动 id 从 n1 起");
    断言相等(新节点(g, "[]", "{}"), "n2", "递增");
    断言相等整数(加节点(g, "n3", "[]", "{}"), 1, "手工占掉 n3");
    断言相等(新节点(g, "[]", "{}"), "n4", "自动 id 跳过被占的");

    断言相等整数(删节点(g, "n4"), 1, "删节点");
    断言相等整数(删节点(g, "n4"), 0, "重复删 0");
    断言相等整数(有节点(g, "n4"), 0, "删后不存在");
    断言相等整数(节点数(g), 5, "计数对");
    关闭图(g);
    断言相等整数(图可用(g), 0, "关掉后不可用");
    断言相等整数(加节点(g, "x", "[]", "{}"), 0, "关掉后写不进");
    返回 0;
}

函数 测_id含冒号被拒() : 整数 {
    变量 g: 整数 = 打开图(库路径("冒号"));
    加节点(g, "甲", "[]", "{}");
    加节点(g, "乙", "[]", "{}");
    断言相等整数(加节点(g, "a:b", "[]", "{}"), 0, "节点 id 含冒号拒绝");
    断言相等整数(加节点(g, "", "[]", "{}"), 0, "空 id 拒绝");
    断言相等整数(有节点(g, "a:b"), 0, "没写进去");
    断言相等整数(加边(g, "x:y", "认识", "甲", "乙", "{}"), 0, "边 id 含冒号拒绝");
    断言相等整数(加边(g, "e1", "认:识", "甲", "乙", "{}"), 0, "边类型含冒号拒绝");
    断言相等整数(加边(g, "e1", "", "甲", "乙", "{}"), 0, "空边类型拒绝");
    断言相等整数(边数(g), 0, "一条都没进去");
    // 标签含冒号：那一项被跳过，节点照加
    断言相等整数(加节点(g, "丙", "[\"好:坏\",\"人\"]", "{}"), 1, "标签含冒号只跳过那一项");
    断言相等(取标签(g, "丙"), "[\"人\"]", "跳过的标签不在节点里");
    断言相等整数(加标签(g, "丙", "x:y"), 0, "加含冒号的标签 0");
    断言相等整数(节点数(g), 3, "计数对");
    关闭图(g);
    返回 0;
}

函数 测_边CRUD() : 整数 {
    变量 g: 整数 = 打开图(库路径("边2"));
    加节点(g, "甲", "[]", "{}");
    加节点(g, "乙", "[]", "{}");
    加节点(g, "丙", "[]", "{}");
    加边(g, "e1", "认识", "甲", "乙", "{\"since\":2020}");
    断言相等(取边(g, "e1"), "{\"id\":\"e1\",\"type\":\"认识\",\"from\":\"甲\",\"to\":\"乙\",\"props\":{\"since\":2020}}", "边 JSON 键序固定");
    断言相等整数(有边(g, "e1"), 1, "有边");
    断言相等(取边(g, "无"), "", "缺边空串");
    // 自动 id 与节点共用计数器，只是前缀不同
    变量 自动: 字符串 = 新边(g, "同事", "乙", "丙", "{}");
    断言为真(自动 != "", "自动 id 边");
    断言相等整数(有边(g, 自动), 1, "自动 id 的边存在");
    加边(g, "e3", "认识", "甲", "丙", "{}");
    加边(g, "e4", "认识", "甲", "甲", "{}");     // 自环
    断言相等整数(边数(g), 4, "四条边");

    断言相等(行(出边(g, "甲")), "e1,e3,e4", "出边按加入顺序");
    断言相等(行(入边(g, "甲")), "e4", "自环也进入边表");
    断言相等(行(入边(g, "丙")), 自动 + ",e3", "入边");
    断言相等整数(度(g, "甲"), 4, "度 = 出 3 + 入 1");
    断言相等(行(按类型列边(g, "认识")), "e1,e3,e4", "按类型列边");
    断言相等(行(按类型列边(g, "同事")), 自动, "另一个类型");

    断言相等整数(改边属性(g, "e1", "{\"since\":2021,\"close\":true}"), 1, "改边属性");
    断言包含(取边(g, "e1"), "\"props\":{\"since\":2021,\"close\":true}", "边属性合并");

    断言相等整数(删边(g, "e3"), 1, "删边");
    断言相等整数(删边(g, "e3"), 0, "重复删边 0");
    断言相等整数(有边(g, "e3"), 0, "删后没了");
    断言相等(行(出边(g, "甲")), "e1,e4", "起点出边表更新");
    断言相等(行(入边(g, "丙")), 自动, "终点入边表更新");
    断言相等(行(按类型列边(g, "认识")), "e1,e4", "类型索引更新");
    断言相等整数(边数(g), 3, "边数减一");
    断言相等整数(删边(g, "e4"), 1, "删自环");
    断言相等(行(出边(g, "甲")), "e1", "自环从出边表去掉");
    断言相等(行(入边(g, "甲")), "", "自环从入边表去掉");
    关闭图(g);
    返回 0;
}

函数 测_级联删除() : 整数 {
    变量 g: 整数 = 打开图(库路径("级联"));
    加节点(g, "中心", "[\"人\",\"核心\"]", "{}");
    加节点(g, "a", "[\"人\"]", "{}");
    加节点(g, "b", "[\"人\"]", "{}");
    加节点(g, "c", "[\"人\"]", "{}");
    加边(g, "ca", "认识", "中心", "a", "{}");
    加边(g, "cb", "认识", "中心", "b", "{}");
    加边(g, "bc", "认识", "b", "中心", "{}");
    加边(g, "cc", "认识", "中心", "中心", "{}");
    加边(g, "ab", "同事", "a", "b", "{}");      // 跟中心无关，必须留下
    断言相等整数(边数(g), 5, "五条边");
    变量 前: 整数 = J.解码(统计JSON(g));
    变量 前键数: 整数 = J.获取整数(前, "kv_keys");
    J.删除(前);

    断言相等整数(删节点(g, "中心"), 1, "删中心");
    断言相等整数(有节点(g, "中心"), 0, "节点没了");
    断言相等整数(节点数(g), 3, "节点数");
    断言相等整数(边数(g), 1, "只剩 ab");
    断言相等整数(有边(g, "ca"), 0, "出边没了");
    断言相等整数(有边(g, "bc"), 0, "入边没了");
    断言相等整数(有边(g, "cc"), 0, "自环没了");
    断言相等整数(有边(g, "ab"), 1, "无关的边留着");
    断言相等(行(入边(g, "a")), "", "对端 a 的入边表干净");
    断言相等(行(入边(g, "b")), "ab", "对端 b 的入边表只剩 ab");
    断言相等(行(出边(g, "b")), "", "对端 b 的出边表干净");
    断言相等(行(按类型列边(g, "认识")), "", "类型索引干净");
    断言相等(行(按类型列边(g, "同事")), "ab", "另一类型不受影响");
    断言相等(行(按标签列节点(g, "核心")), "", "标签索引干净");
    断言相等(行(按标签列节点(g, "人")), "a,b,c", "共享标签只去掉它自己");
    断言相等(行(出边(g, "中心")), "", "被删节点的邻接表读出来是空");

    // 键数账目：中心 = 节点 1 + out 1 + in 1 + 标签 2 = 5 条；四条边各 = 边 1 + 类型索引 1 = 8 条
    变量 后: 整数 = J.解码(统计JSON(g));
    断言相等整数(J.获取整数(后, "kv_keys"), 前键数 - 5 - 8, "kv 里一条残留都没有");
    J.删除(后);
    关闭图(g);
    返回 0;
}

函数 测_重开持久化() : 整数 {
    变量 p: 字符串 = 库路径("重开");
    变量 g: 整数 = 打开图(p);
    加节点(g, "张三", "[\"人\"]", "{\"年龄\":30}");
    加节点(g, "李四", "[\"人\"]", "{}");
    加节点(g, "临时", "[\"人\"]", "{}");
    加边(g, "e1", "认识", "张三", "李四", "{}");
    新边(g, "认识", "李四", "张三", "{}");
    加边(g, "e9", "认识", "张三", "临时", "{}");
    改属性(g, "张三", "{\"城市\":\"成都\"}");
    加标签(g, "李四", "员工");
    删节点(g, "临时");
    变量 导: 字符串 = 导出JSON(g);
    变量 统: 字符串 = 统计JSON(g);
    关闭图(g);

    变量 二: 整数 = 打开图(p);
    断言为真(二 > 0, "重开");
    断言相等整数(节点数(二), 2, "节点数还在");
    断言相等整数(边数(二), 2, "边数还在");
    断言相等(取属性(二, "张三"), "{\"年龄\":30,\"城市\":\"成都\"}", "合并过的属性还在");
    断言相等(行(按标签列节点(二, "员工")), "李四", "标签索引还在");
    断言相等(行(出边(二, "张三")), "e1", "出边表还在，且被删的边不在");
    断言相等(行(入边(二, "张三")), "e2", "入边表还在");
    断言相等整数(有节点(二, "临时"), 0, "删过的节点不会复活");
    断言相等整数(有边(二, "e9"), 0, "级联删过的边不会复活");
    断言相等(导出JSON(二), 导, "导出文本一字不差");
    断言相等(统计JSON(二), 统, "统计一样");
    // next_id 也持久化：不会重新从 1 数，撞上 e2
    变量 新: 字符串 = 新边(二, "认识", "张三", "李四", "{}");
    断言相等(新, "e3", "自动 id 接着数");
    关闭图(二);
    返回 0;
}

函数 测_导出导入() : 整数 {
    变量 g: 整数 = 打开图(库路径("导出"));
    加节点(g, "张三", "[\"人\",\"员工\"]", "{\"年龄\":30,\"标签\":[\"a\",\"b\"],\"地址\":{\"市\":\"成都\"}}");
    加节点(g, "李四", "[\"人\"]", "{\"活跃\":false,\"分\":2.5}");
    加节点(g, "成都", "[\"城市\"]", "{}");
    加边(g, "e1", "认识", "张三", "李四", "{\"since\":2020}");
    加边(g, "e2", "住在", "李四", "成都", "{}");
    变量 导: 字符串 = 导出JSON(g);
    断言包含(导, "\"nodes\":[{\"id\":\"张三\"", "导出以节点开头");
    断言包含(导, "\"edges\":[{\"id\":\"e1\"", "导出含边");
    断言相等整数(导出到文件(g, "/tmp/qigraph-测-导出.json"), 1, "导出到文件");
    关闭图(g);

    变量 二: 整数 = 打开图(库路径("导入"));
    断言相等整数(导入JSON(二, 导), 5, "导入 3 节点 + 2 边");
    断言相等(导出JSON(二), 导, "导出再导入再导出，文本相同");
    断言相等整数(导入JSON(二, 导), 0, "再导一遍全是重复，加了 0");
    断言相等整数(节点数(二), 3, "重复导入不增加节点");
    断言相等整数(边数(二), 2, "重复导入不增加边");
    断言相等(行(出边(二, "张三")), "e1", "导入后邻接表对");
    断言相等(行(按标签列节点(二, "人")), "张三,李四", "导入后标签索引对");
    断言相等整数(导入JSON(二, "垃圾"), 0, "解不出返回 0");
    // 端点不存在的边跳过
    断言相等整数(导入JSON(二, "{\"nodes\":[{\"id\":\"新\"}],\"edges\":[{\"id\":\"e7\",\"type\":\"x\",\"from\":\"新\",\"to\":\"没有\"}]}"), 1, "缺端点的边跳过，只算节点");
    关闭图(二);

    变量 三: 整数 = 打开图(库路径("文件导入"));
    断言相等整数(从文件导入(三, "/tmp/qigraph-测-导出.json"), 5, "从文件导入");
    断言相等(导出JSON(三), 导, "文件往返文本相同");
    断言相等整数(从文件导入(三, "/tmp/qigraph-测-不存在.json"), 0, "文件不存在 0");
    关闭图(三);
    IO::删除文件("/tmp/qigraph-测-导出.json");
    返回 0;
}

函数 测_链式与打不开() : 整数 {
    变量 g: 图库 = 开图(库路径("链式"))
        .加节点("甲", "[\"人\"]", "{}")
        .加节点("乙", "[\"人\"]", "{}")
        .连("认识", "甲", "乙")
        .加标签("甲", "员工")
        .改属性("甲", "{\"年龄\":20}");
    断言相等整数(g.可用(), 1, "链式可用");
    断言相等整数(g.节点数(), 2, "链式加节点");
    断言相等整数(g.边数(), 1, "链式连边");
    断言相等整数(g.有标签("甲", "员工"), 1, "链式加标签");
    断言相等(g.取属性("甲"), "{\"年龄\":20}", "链式改属性");
    断言相等(行(g.出邻居("甲")), "乙", "链式邻居");
    断言相等(行(g.最短路径("甲", "乙")), "甲,乙", "链式最短路径");
    断言相等整数(g.模式匹配数("[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"}]"), 1, "链式匹配");
    断言包含(g.统计JSON(), "\"nodes\":2", "链式统计");
    断言包含(g.导出JSON(), "\"id\":\"甲\"", "链式导出");
    g.关();
    断言相等整数(g.可用(), 0, "关了");

    变量 坏路径: 字符串 = 库路径("链式陌生");
    IO::写入文件(坏路径, "别人的文件");
    断言相等整数(打开图(坏路径), -1, "陌生文件打不开");
    变量 坏: 图库 = 开图(坏路径);
    断言相等整数(坏.可用(), 0, "链式打不开");
    断言相等整数(坏.加节点("x", "[]", "{}").节点数(), 0, "打不开时写入无效但不崩");
    断言相等(坏.取节点("x"), "", "打不开时读空");
    断言相等(坏.导出JSON(), "{\"nodes\":[],\"edges\":[]}", "打不开时导出是空图");
    IO::删除文件(坏路径);
    返回 0;
}

函数 入口() {
    运行用例("节点CRUD", 测_节点CRUD);
    运行用例("id含冒号被拒", 测_id含冒号被拒);
    运行用例("边CRUD", 测_边CRUD);
    运行用例("级联删除", 测_级联删除);
    运行用例("重开持久化", 测_重开持久化);
    运行用例("导出导入", 测_导出导入);
    运行用例("链式与打不开", 测_链式与打不开);
    摘要并退出();
}
