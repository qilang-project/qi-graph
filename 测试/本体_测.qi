// 本体_测 —— 存储层：类 / 属性 / 个体 / 三元组的增删查、名字校验、重开、链式、规模
//
// 重点盯两处：
//   ① 正反两份邻接（o:s / o:o）和 o:i 的类型列表必须跟三元组同步，删了一条不能留尾巴
//   ② 重开：全部状态都在 qi-kv 里，没有任何进程内缓存，关了再开必须一字不差

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含};
导入 标准库.输入输出 作为 IO;
导入 标准库.列表 作为 表列;
导入 标准库.时间;
导入 Graph::{打开本体, 关闭本体, 本体可用, 本体开始缓写, 本体刷盘, 名字合法,
             定义类, 类存在, 类注释, 类定义, 父类, 子类, 列出类,
             定义属性, 属性存在, 属性定义, 属性字符串字段, 属性整数字段, 列出属性,
             加个体, 个体存在, 个体类型, 列出个体, 按类列个体, 删除个体,
             断言, 断言字面量, 撤销, 撤销字面量, 有三元组, 三元组标记, 查, 值, 主语, 三元组数, 列出主语,
             传递闭包, 排序字符串列表, 比较字符串, 字符串列表含, 字符串列表连成行,
             开本体, 本体库};

函数 库路径(名: 字符串) : 字符串 {
    返回 "/tmp/qigraph-测-本体-" + 名 + ".kv";
}

函数 新库(名: 字符串) : 整数 {
    变量 p: 字符串 = 库路径(名);
    如果 (IO.文件存在(p) == 1) { IO.删除文件(p); }
    返回 打开本体(p);
}

函数 列表行(表: 整数) : 字符串 {
    变量 s: 字符串 = 字符串列表连成行(表, ",");
    表列::删除列表(表);
    返回 s;
}

函数 列表数(表: 整数) : 整数 {
    变量 n: 整数 = 表列::字符串列表大小(表);
    表列::删除列表(表);
    返回 n;
}

函数 测_类() : 整数 {
    变量 本: 整数 = 新库("类");
    断言相等整数(本体可用(本), 1, "打开成功");
    断言相等整数(定义类(本, "动物"), 1, "定义根类");
    断言相等整数(定义类(本, "哺乳动物", "动物"), 1, "定义带父类");
    断言相等整数(定义类(本, "鸟", "动物"), 1, "第二个子类");
    断言相等整数(定义类(本, "狗", "哺乳动物"), 1, "孙类");
    断言相等整数(类存在(本, "狗"), 1, "类存在");
    断言相等整数(类存在(本, "猫"), 0, "没定义的不存在");
    断言相等(列表行(父类(本, "狗")), "哺乳动物", "直接父类");
    断言相等(列表行(父类(本, "动物")), "", "根类没有父类");
    断言相等(列表行(子类(本, "动物")), "哺乳动物,鸟", "直接子类按插入序");
    断言相等(列表行(列出类(本)), "动物,哺乳动物,狗,鸟", "列出类按字典序");

    // 多继承：再给一个父类
    定义类(本, "会飞的", "动物");
    断言相等整数(定义类(本, "鸟", "会飞的"), 1, "追加父类");
    断言相等整数(列表数(父类(本, "鸟")), 2, "两个父类");
    断言相等整数(定义类(本, "鸟", "会飞的"), 1, "重复追加不报错");
    断言相等整数(列表数(父类(本, "鸟")), 2, "重复追加不重复");

    断言相等整数(类注释(本, "狗", "人类的朋友"), 1, "设注释");
    断言包含(类定义(本, "狗"), "\"comment\":\"人类的朋友\"", "类定义里有注释");
    断言包含(类定义(本, "狗"), "\"parents\":[\"哺乳动物\"]", "类定义里有父类");
    断言相等(类定义(本, "猫"), "", "没有的类定义为空串");

    断言相等整数(定义类(本, "a:b"), 0, "类名含冒号被拒");
    断言相等整数(类存在(本, "a:b"), 0, "拒了就没写");
    断言相等整数(定义类(本, ""), 0, "空名被拒");
    断言相等整数(定义类(本, "猫", "x:y"), 0, "父类含冒号被拒");
    关闭本体(本);
    返回 0;
}

函数 测_属性() : 整数 {
    变量 本: 整数 = 新库("属性");
    定义类(本, "人");
    定义类(本, "动物");
    断言相等整数(定义属性(本, "年龄", "动物", "整数", "{\"functional\":1}"), 1, "定义函数性属性");
    断言相等整数(属性存在(本, "年龄"), 1, "属性存在");
    断言相等整数(属性存在(本, "身高"), 0, "没定义的不存在");
    断言包含(属性定义(本, "年龄"), "\"functional\":1", "函数性写进定义");
    断言相等(属性字符串字段(本, "年龄", "domain"), "动物", "定义域");
    断言相等(属性字符串字段(本, "年龄", "range"), "整数", "值域");
    断言相等整数(属性整数字段(本, "年龄", "transitive"), 0, "默认不传递");
    断言相等整数(有三元组(本, "年龄", "定义域", "动物"), 1, "定义域落成三元组");
    断言相等整数(有三元组(本, "年龄", "值域", "整数"), 1, "值域落成三元组");

    // 逆属性：先定义 养，再定义 被养，两边都要认识对方
    定义属性(本, "养", "人", "动物", "{\"inverse\":\"被养\"}");
    断言相等(属性字符串字段(本, "养", "inverse"), "被养", "养 的逆是 被养");
    定义属性(本, "被养", "动物", "人");
    断言相等(属性字符串字段(本, "被养", "inverse"), "养", "后定义的一方自动认领逆属性");

    // 中文别名的选项键
    定义属性(本, "祖先", "动物", "动物", "{\"传递\":1,\"对称\":0}");
    断言相等整数(属性整数字段(本, "祖先", "transitive"), 1, "中文键 传递");
    定义属性(本, "认识", "动物", "动物", "{\"symmetric\":true}");
    断言相等整数(属性整数字段(本, "认识", "symmetric"), 1, "布尔 true 也认");
    定义属性(本, "亲密朋友", "动物", "动物", "{\"parent\":\"认识\"}");
    断言相等(属性字符串字段(本, "亲密朋友", "parent"), "认识", "父属性");
    断言相等整数(有三元组(本, "亲密朋友", "父属性是", "认识"), 1, "父属性落成三元组");

    断言相等(列表行(列出属性(本)), "亲密朋友,养,年龄,祖先,被养,认识", "列出属性字典序");
    断言相等整数(定义属性(本, "坏:名", "人", "人"), 0, "属性名含冒号被拒");
    断言相等整数(定义属性(本, "坏", "人:x", "人"), 0, "定义域含冒号被拒");
    断言相等(属性定义(本, "没有"), "", "没有的属性定义为空串");
    关闭本体(本);
    返回 0;
}

函数 测_个体() : 整数 {
    变量 本: 整数 = 新库("个体");
    定义类(本, "动物");
    定义类(本, "哺乳动物", "动物");
    定义类(本, "狗", "哺乳动物");
    定义类(本, "宠物");
    断言相等整数(加个体(本, "旺财", "狗"), 1, "加个体");
    断言相等整数(个体存在(本, "旺财"), 1, "个体存在");
    断言相等整数(个体存在(本, "咪咪"), 0, "没加的不存在");
    断言相等(列表行(个体类型(本, "旺财")), "狗", "直接类型");
    加个体(本, "旺财", "宠物");
    断言相等(列表行(个体类型(本, "旺财")), "狗,宠物", "多个直接类型");
    加个体(本, "旺财", "宠物");
    断言相等整数(列表数(个体类型(本, "旺财")), 2, "重复加类型不重复");
    断言相等整数(有三元组(本, "旺财", "类型是", "狗"), 1, "类型落成三元组");

    加个体(本, "大黄", "狗");
    加个体(本, "小明", "");
    断言相等整数(个体存在(本, "小明"), 1, "无类型个体也登记");
    断言相等整数(列表数(个体类型(本, "小明")), 0, "无类型");
    加个体(本, "小海", "哺乳动物");
    断言相等(列表行(按类列个体(本, "狗")), "旺财,大黄", "按类列个体（直接）");
    断言相等整数(列表数(按类列个体(本, "动物")), 0, "动物没有直接个体");
    断言相等(列表行(按类列个体(本, "动物", 1)), "小海,旺财,大黄", "含子类：先自己再后代，去重");
    断言相等整数(列表数(按类列个体(本, "哺乳动物", 1)), 3, "含子类的中间层");
    断言相等(列表行(列出个体(本)), "大黄,小明,小海,旺财", "列出个体字典序");

    // 撤销类型三元组要同步 o:i
    撤销(本, "旺财", "类型是", "宠物");
    断言相等(列表行(个体类型(本, "旺财")), "狗", "撤销类型后 o:i 同步");

    // 删除个体：正向反向都要清
    断言(本, "小明", "养", "旺财");
    断言(本, "旺财", "认识", "大黄");
    变量 数前: 整数 = 三元组数(本);
    变量 删了: 整数 = 删除个体(本, "旺财");
    断言相等整数(删了, 3, "删掉了 类型是 + 认识 + 被养（反向）三条");
    断言相等整数(三元组数(本), 数前 - 3, "总数对得上");
    断言相等整数(个体存在(本, "旺财"), 0, "个体没了");
    断言相等整数(列表数(值(本, "小明", "养")), 0, "反向那条也没了");
    断言相等整数(列表数(按类列个体(本, "狗")), 1, "类的个体列表同步");
    断言相等整数(加个体(本, "lit=x", "狗"), 0, "lit= 开头的 id 被拒");
    断言相等整数(加个体(本, "a:b", "狗"), 0, "含冒号的 id 被拒");
    关闭本体(本);
    返回 0;
}

函数 测_三元组() : 整数 {
    变量 本: 整数 = 新库("三元组");
    断言相等整数(断言(本, "旺财", "认识", "大黄"), 1, "断言新三元组");
    断言相等整数(断言(本, "旺财", "认识", "大黄"), 0, "重复断言返回 0");
    断言(本, "旺财", "认识", "老黄");
    断言(本, "大黄", "认识", "老黄");
    断言相等整数(断言字面量(本, "旺财", "年龄", "3", "整数"), 1, "字面量");
    断言相等整数(断言字面量(本, "旺财", "名字", "旺财", ""), 1, "空数据类型当字符串");
    断言相等整数(断言字面量(本, "旺财", "名字", "x", "日期"), 0, "未知数据类型被拒");
    断言相等整数(三元组数(本), 5, "五条");

    断言包含(查(本, "旺财", "", ""), "\"p\":\"认识\",\"o\":{\"iri\":\"大黄\"}", "按主语查");
    断言包含(查(本, "旺财", "", ""), "{\"lit\":\"3\",\"dt\":\"整数\"}", "字面量形状");
    断言包含(查(本, "旺财", "名字", ""), "{\"lit\":\"旺财\",\"dt\":\"字符串\"}", "默认数据类型 字符串");
    断言相等(查(本, "旺财", "没有的", ""), "[]", "没匹配返回空数组");
    断言相等(查(本, "无人", "", ""), "[]", "没这个主语返回空数组");
    断言包含(查(本, "", "认识", "老黄"), "\"s\":\"旺财\"", "按谓宾查主语（反向邻接）");
    断言包含(查(本, "", "认识", "老黄"), "\"s\":\"大黄\"", "反向邻接第二条");
    断言相等(查(本, "", "年龄", "老黄"), "[]", "反向邻接谓词过滤");
    断言包含(查(本, "", "", "老黄"), "\"p\":\"认识\"", "只给宾语");
    断言包含(查(本, "", "年龄", ""), "\"s\":\"旺财\"", "只给谓词（全局扫）");
    断言包含(查(本, "", "年龄", "lit=3"), "\"lit\":\"3\"", "按字面量宾语查（全局扫）");
    断言相等(查(本, "", "年龄", "lit=4"), "[]", "字面量不匹配");
    断言包含(查(本, "旺财", "认识", "大黄"), "\"s\":\"旺财\"", "三个都给");
    断言相等(查(本, "旺财", "认识", "小白"), "[]", "三个都给但没有");

    断言相等(列表行(值(本, "旺财", "认识")), "大黄,老黄", "值列表");
    断言相等(列表行(值(本, "旺财", "年龄")), "3", "字面量的值去掉 lit=");
    断言相等(列表行(主语(本, "认识", "老黄")), "旺财,大黄", "主语列表");
    断言相等(列表行(列出主语(本)), "大黄,旺财", "列出主语");
    断言相等(三元组标记(本, "旺财", "认识", "大黄"), "1", "断言的标记是 1");
    断言相等(三元组标记(本, "旺财", "认识", "无"), "", "没有的标记是空串");

    断言相等整数(撤销(本, "旺财", "认识", "大黄"), 1, "撤销");
    断言相等整数(撤销(本, "旺财", "认识", "大黄"), 0, "重复撤销返回 0");
    断言相等整数(有三元组(本, "旺财", "认识", "大黄"), 0, "撤销后没了");
    断言相等(列表行(主语(本, "认识", "大黄")), "", "反向邻接同步清掉");
    断言相等(列表行(值(本, "旺财", "认识")), "老黄", "正向邻接同步清掉");
    断言相等整数(撤销字面量(本, "旺财", "年龄", "3"), 1, "撤销字面量");
    断言相等整数(撤销(本, "旺财", "名字", "lit=旺财"), 1, "用 lit= 撤销字面量也行");
    断言相等整数(三元组数(本), 2, "剩两条");
    关闭本体(本);
    返回 0;
}

函数 测_名字校验() : 整数 {
    变量 本: 整数 = 新库("名字");
    断言相等整数(名字合法("狗"), 1, "普通名字");
    断言相等整数(名字合法("a:b"), 0, "含冒号");
    断言相等整数(名字合法(""), 0, "空");
    断言相等整数(名字合法("lit=x"), 0, "lit= 前缀");
    断言相等整数(断言(本, "a:b", "p", "o"), 0, "主语含冒号");
    断言相等整数(断言(本, "s", "p:q", "o"), 0, "谓词含冒号");
    断言相等整数(断言(本, "s", "p", "o:x"), 0, "宾语含冒号");
    断言相等整数(断言字面量(本, "s:x", "p", "v", "字符串"), 0, "字面量三元组主语含冒号");
    断言相等整数(断言字面量(本, "s", "p", "http://x:1", "字符串"), 1, "字面量的值可以含冒号");
    断言相等(列表行(值(本, "s", "p")), "http://x:1", "含冒号的字面量能读回");
    断言相等整数(三元组数(本), 1, "只有那一条合法的写进去了");
    关闭本体(本);
    返回 0;
}

函数 测_重开() : 整数 {
    变量 本: 整数 = 新库("重开");
    定义类(本, "动物");
    定义类(本, "狗", "动物");
    类注释(本, "狗", "汪");
    定义属性(本, "年龄", "动物", "整数", "{\"functional\":1}");
    加个体(本, "旺财", "狗");
    断言字面量(本, "旺财", "年龄", "3", "整数");
    断言(本, "旺财", "认识", "大黄");
    撤销(本, "旺财", "认识", "大黄");
    断言(本, "旺财", "认识", "老黄");
    变量 前查: 字符串 = 查(本, "", "", "");
    变量 前数: 整数 = 三元组数(本);
    关闭本体(本);
    断言相等整数(本体可用(本), 0, "关掉后不可用");
    断言相等(查(本, "旺财", "", ""), "[]", "关掉后查是空的");

    变量 二: 整数 = 打开本体(库路径("重开"));
    断言相等整数(本体可用(二), 1, "重开成功");
    断言相等整数(类存在(二, "狗"), 1, "类还在");
    断言相等(列表行(父类(二, "狗")), "动物", "父类还在");
    断言包含(类定义(二, "狗"), "汪", "注释还在");
    断言相等整数(属性整数字段(二, "年龄", "functional"), 1, "属性定义还在");
    断言相等(列表行(个体类型(二, "旺财")), "狗", "个体类型还在");
    断言相等(列表行(值(二, "旺财", "认识")), "老黄", "撤销过的没复活，留下的还在");
    断言相等(列表行(主语(二, "认识", "老黄")), "旺财", "反向邻接还在");
    断言相等(查(二, "", "", ""), 前查, "全量查询一字不差");
    断言相等整数(三元组数(二), 前数, "总数一致");
    关闭本体(二);
    返回 0;
}

函数 测_链式() : 整数 {
    变量 p: 字符串 = 库路径("链式");
    如果 (IO.文件存在(p) == 1) { IO.删除文件(p); }
    变量 k: 本体库 = 开本体(p)
        .定义类("动物")
        .定义类("狗", "动物")
        .定义属性("年龄", "动物", "整数", "{\"functional\":1}")
        .加个体("旺财", "狗")
        .断言字面量("旺财", "年龄", "3", "整数")
        .断言("旺财", "认识", "大黄")
        .撤销("旺财", "认识", "大黄");
    断言相等整数(k.可用(), 1, "链式开库可用");
    断言相等整数(k.类存在("狗"), 1, "链式定义类");
    断言相等整数(k.个体存在("旺财"), 1, "链式加个体");
    断言相等(列表行(k.值("旺财", "年龄")), "3", "链式字面量");
    断言相等整数(k.有三元组("旺财", "认识", "大黄"), 0, "链式撤销");
    断言包含(k.查("旺财", "", ""), "\"p\":\"类型是\"", "链式查");
    断言相等整数(k.三元组数(), 5, "五条：父类是 / 定义域 / 值域 / 类型是 / 年龄");
    k.关();
    断言相等整数(k.可用(), 0, "关掉了");

    // 打不开的文件：链式要安静地不生效
    变量 坏: 字符串 = 库路径("链式陌生");
    IO.写入文件(坏, "别人的文件");
    变量 坏库: 本体库 = 开本体(坏);
    断言相等整数(坏库.可用(), 0, "陌生文件打不开");
    断言相等整数(坏库.定义类("动物").加个体("x", "动物").三元组数(), 0, "打不开时写入无效不崩");
    断言相等(坏库.查("x", "", ""), "[]", "打不开时查空");
    IO.删除文件(坏);
    返回 0;
}

函数 测_列表工具() : 整数 {
    变量 表: 整数 = 表列::创建字符串列表();
    表列::添加字符串(表, "狗");
    表列::添加字符串(表, "b");
    表列::添加字符串(表, "a");
    表列::添加字符串(表, "动物");
    表列::添加字符串(表, "a");
    变量 序: 整数 = 排序字符串列表(表);
    断言相等(字符串列表连成行(序, ","), "a,a,b,动物,狗", "字节序排序，稳定保留重复");
    断言相等(字符串列表连成行(表, ","), "狗,b,a,动物,a", "原列表不动");
    断言相等整数(字符串列表含(表, "动物"), 1, "含");
    断言相等整数(字符串列表含(表, "猫"), 0, "不含");
    断言相等整数(比较字符串("a", "b"), -1, "比较小于");
    断言相等整数(比较字符串("b", "a"), 1, "比较大于");
    断言相等整数(比较字符串("同", "同"), 0, "比较相等");
    表列::删除列表(序);
    表列::删除列表(表);
    变量 空表: 整数 = 表列::创建字符串列表();
    变量 空序: 整数 = 排序字符串列表(空表);
    断言相等整数(表列::字符串列表大小(空序), 0, "空列表排序");
    表列::删除列表(空序);
    表列::删除列表(空表);
    返回 0;
}

函数 测_传递闭包() : 整数 {
    变量 本: 整数 = 新库("闭包");
    定义类(本, "A", "B");
    定义类(本, "B", "C");
    定义类(本, "C", "A");      // 环
    断言相等(列表行(传递闭包(本, "A", "父类是", 0)), "B,C", "带环的闭包能停，不含起点");
    断言相等(列表行(传递闭包(本, "A", "父类是", 1)), "C,B", "逆向闭包");
    断言相等(列表行(传递闭包(本, "孤", "父类是", 0)), "", "没边的起点");
    关闭本体(本);
    返回 0;
}

// 2000 个体 / 10000 条非模式三元组：10 个类成一条链，每个个体 1 条类型 + 3 条 认识 + 1 条 年龄
函数 测_规模() : 整数 {
    变量 本: 整数 = 新库("规模");
    定义类(本, "类0");
    变量 c: 整数 = 1;
    当 (c < 10) {
        定义类(本, "类" + c, "类" + (c - 1));
        c = c + 1;
    }
    定义属性(本, "认识", "类0", "类0", "");
    定义属性(本, "年龄", "类0", "整数", "{\"functional\":1}");

    变量 起: 整数 = 时间.现在毫秒();
    本体开始缓写(本);
    变量 i: 整数 = 0;
    当 (i < 2000) {
        变量 我: 字符串 = "个体" + i;
        加个体(本, 我, "类" + (i % 10));
        断言(本, 我, "认识", "个体" + ((i + 1) % 2000));
        断言(本, 我, "认识", "个体" + ((i + 7) % 2000));
        断言(本, 我, "认识", "个体" + ((i + 13) % 2000));
        断言字面量(本, 我, "年龄", "" + (i % 90), "整数");
        i = i + 1;
    }
    本体刷盘(本);
    变量 写毫秒: 整数 = 时间.现在毫秒() - 起;

    起 = 时间.现在毫秒();
    变量 命中: 整数 = 0;
    变量 j: 整数 = 0;
    当 (j < 2000) {
        变量 v: 整数 = 值(本, "个体" + j, "认识");
        如果 (表列::字符串列表大小(v) == 3) { 命中 = 命中 + 1; }
        表列::删除列表(v);
        j = j + 1;
    }
    变量 查毫秒: 整数 = 时间.现在毫秒() - 起;
    断言相等整数(命中, 2000, "每个个体三个 认识");

    起 = 时间.现在毫秒();
    变量 总: 整数 = 三元组数(本);
    变量 数毫秒: 整数 = 时间.现在毫秒() - 起;
    断言相等整数(总, 10000 + 9 + 4, "10000 条 + 9 条父类是 + 4 条定义域值域");

    起 = 时间.现在毫秒();
    变量 类9: 整数 = 按类列个体(本, "类0", 1);
    变量 含子毫秒: 整数 = 时间.现在毫秒() - 起;
    断言相等整数(表列::字符串列表大小(类9), 2000, "从根类含子类列出全部个体");
    表列::删除列表(类9);
    断言相等整数(列表数(主语(本, "认识", "个体0")), 3, "反向邻接：被三个个体认识");

    变量 路径: 字符串 = 库路径("规模");
    关闭本体(本);
    起 = 时间.现在毫秒();
    变量 二: 整数 = 打开本体(路径);
    变量 重开毫秒: 整数 = 时间.现在毫秒() - 起;
    断言相等整数(列表数(个体类型(二, "个体1999")), 1, "重开后个体还在");
    断言相等(列表行(值(二, "个体5", "年龄")), "5", "重开后字面量还在");
    关闭本体(二);

    IO.打印行("  规模 2000 个体 / 10000 三元组：写 " + 写毫秒 + " ms，2000 次按主语取值 " + 查毫秒
        + " ms，三元组数(全局扫) " + 数毫秒 + " ms，按类含子类列 2000 个体 " + 含子毫秒
        + " ms，重开重放 " + 重开毫秒 + " ms");
    断言为真(写毫秒 < 60000, "写在一分钟内");
    返回 0;
}

函数 入口() {
    运行用例("本体.类", 测_类);
    运行用例("本体.属性", 测_属性);
    运行用例("本体.个体", 测_个体);
    运行用例("本体.三元组", 测_三元组);
    运行用例("本体.名字校验", 测_名字校验);
    运行用例("本体.重开", 测_重开);
    运行用例("本体.链式", 测_链式);
    运行用例("本体.列表工具", 测_列表工具);
    运行用例("本体.传递闭包", 测_传递闭包);
    运行用例("本体.规模", 测_规模);
    摘要并退出();
}
