// 图元路径_测 —— DWPC（度加权路径计数）与 ReFeX（递归特征提取）
//
// 数据还是 monorepo 真实的包依赖图（Harness→Web/Graph、Graph→KV，见 图语句_测 抬头）。
// DWPC 的期望值是手算的，算式写在断言旁边。

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含};
导入 标准库.输入输出 作为 IO;
导入 标准库.JSON 作为 J;
导入 Graph::{打开图, 关闭图, 加节点, 加边, 按类型出度, 按类型入度,
             元路径计数, 度加权路径计数, ReFeX};

函数 断言约等(实际: 浮点数, 期望: 浮点数, 容差: 浮点数, 说明: 字符串) {
    变量 差: 浮点数 = 实际 - 期望;
    如果 (差 < 0.0) { 差 = 0.0 - 差; }
    断言为真(差 < 容差,
        说明 + "（实得 " + 浮点数转字符串(实际) + "，应为 " + 浮点数转字符串(期望) + "）");
}

函数 建依赖图(路径: 字符串) : 整数 {
    如果 (IO::文件存在(路径) == 1) { IO::删除文件(路径); }
    变量 图: 整数 = 打开图(路径);
    加节点(图, "Harness", "[\"包\"]", "{}");
    加节点(图, "Web", "[\"包\"]", "{}");
    加节点(图, "Graph", "[\"包\"]", "{}");
    加节点(图, "KV", "[\"包\"]", "{}");
    加节点(图, "CLI", "[\"包\"]", "{}");
    加边(图, "", "依赖", "Harness", "Web", "{}");
    加边(图, "", "依赖", "Harness", "Graph", "{}");
    加边(图, "", "依赖", "Graph", "KV", "{}");
    加边(图, "", "开发依赖", "Harness", "CLI", "{}");
    加边(图, "", "开发依赖", "Graph", "CLI", "{}");
    返回 图;
}

函数 测_按类型的度() : 整数 {
    变量 图: 整数 = 建依赖图("/tmp/qigraph-测-元路径.kv");
    // Harness 有 2 条 依赖 出边、1 条 开发依赖 出边
    断言相等整数(按类型出度(图, "Harness", "依赖"), 2, "Harness 的依赖出度");
    断言相等整数(按类型出度(图, "Harness", "开发依赖"), 1, "Harness 的开发依赖出度");
    断言相等整数(按类型出度(图, "Harness", ""), 3, "类型留空 = 全部出边");
    // CLI 被两个包开发依赖
    断言相等整数(按类型入度(图, "CLI", "开发依赖"), 2, "CLI 的开发依赖入度");
    断言相等整数(按类型入度(图, "CLI", "依赖"), 0, "没有人把 CLI 当运行期依赖");
    关闭图(图);
    返回 1;
}

函数 测_元路径计数() : 整数 {
    变量 图: 整数 = 建依赖图("/tmp/qigraph-测-元路径2.kv");
    // Harness --依赖--> ? --依赖--> KV：只有 Harness→Graph→KV
    断言相等整数(元路径计数(图, "Harness", "KV", "[\"依赖\",\"依赖\"]"), 1, "两跳依赖到 KV 只有一条");
    // 一跳到 Web
    断言相等整数(元路径计数(图, "Harness", "Web", "[\"依赖\"]"), 1, "一跳依赖到 Web");
    // 换成 开发依赖 就走不通了 —— 元路径认类型
    断言相等整数(元路径计数(图, "Harness", "Web", "[\"开发依赖\"]"), 0, "开发依赖 走不到 Web");
    // 混合元路径：Harness --依赖--> Graph --开发依赖--> CLI
    断言相等整数(元路径计数(图, "Harness", "CLI", "[\"依赖\",\"开发依赖\"]"), 1, "混合类型的元路径");
    // 长度对不上就没有：一跳的元路径到不了两跳外的 KV
    断言相等整数(元路径计数(图, "Harness", "KV", "[\"依赖\"]"), 0, "元路径长度必须正好对上");
    关闭图(图);
    返回 1;
}

函数 测_DWPC按度打折() : 整数 {
    变量 图: 整数 = 建依赖图("/tmp/qigraph-测-元路径3.kv");

    // 阻尼 0 就退化成路径计数
    断言约等(度加权路径计数(图, "Harness", "KV", "[\"依赖\",\"依赖\"]", 0.0), 1.0,
        0.000001, "阻尼 0 时 DWPC 等于 PC");

    // Harness --依赖--> Web（一步）
    //   出度_依赖(Harness)=2，入度_依赖(Web)=1 → 步权 = (2×1)^-0.4 = 2^-0.4 = 0.7578583
    断言约等(度加权路径计数(图, "Harness", "Web", "[\"依赖\"]", 0.4), 0.7578582832551990,
        0.0000001, "被枢纽分薄：Harness 有两条依赖，所以打折");

    // Graph --依赖--> KV（一步）
    //   出度_依赖(Graph)=1，入度_依赖(KV)=1 → 步权 = 1^-0.4 = 1
    断言约等(度加权路径计数(图, "Graph", "KV", "[\"依赖\"]", 0.4), 1.0,
        0.0000001, "两端都只有这一条关系时不打折");

    // 这正是 DWPC 的意义：两条边路径计数都是 1，加权之后专一的那条分数更高
    断言为真(度加权路径计数(图, "Graph", "KV", "[\"依赖\"]", 0.4)
             > 度加权路径计数(图, "Harness", "Web", "[\"依赖\"]", 0.4),
        "同样是一条路径，连得少的那条更有信息量");

    // 两步：Harness→Graph→KV
    //   步1 (出度2 × 入度1)^-0.4 = 2^-0.4；步2 (1×1)^-0.4 = 1  → 0.7578583
    断言约等(度加权路径计数(图, "Harness", "KV", "[\"依赖\",\"依赖\"]", 0.4),
        0.7578582832551990, 0.0000001, "两步的权重是各步相乘");

    关闭图(图);
    返回 1;
}

// ── ReFeX ──
// 用三角形 + 一条尾巴那张图：A-B、B-C、C-A、C-D。
// A 和 B 互换是这张图的自同构（两人都只连着对方和 C），所以它俩的特征向量
// **必须逐位相同** —— 这条比逐个核对数值更能说明递归聚合没写错。
函数 建三角尾巴() : 整数 {
    变量 路: 字符串 = "/tmp/qigraph-测-refex.kv";
    如果 (IO::文件存在(路) == 1) { IO::删除文件(路); }
    变量 图: 整数 = 打开图(路);
    加节点(图, "A", "[]", "{}"); 加节点(图, "B", "[]", "{}");
    加节点(图, "C", "[]", "{}"); 加节点(图, "D", "[]", "{}");
    加边(图, "", "连", "A", "B", "{}");
    加边(图, "", "连", "B", "C", "{}");
    加边(图, "", "连", "C", "A", "{}");
    加边(图, "", "连", "C", "D", "{}");
    返回 图;
}

函数 取行(根: 整数, id: 字符串) : 整数 {
    变量 行组: 整数 = J.获取数组(根, "行");
    变量 i: 整数 = 0;
    当 (i < J.数组长度(行组)) {
        变量 行: 整数 = J.数组获取对象(行组, i);
        如果 (J.获取字符串(行, "id") == id) {
            返回 J.获取数组(行, "值");
        }
        i = i + 1;
    }
    返回 0;
}

函数 测_ReFeX() : 整数 {
    变量 图: 整数 = 建三角尾巴();

    // 第 0 轮：只有三个局部特征
    变量 零: 整数 = J.解码(ReFeX(图, 0));
    断言相等整数(J.数组长度(J.获取数组(零, "特征名")), 3, "0 轮 = 三个局部特征");
    变量 A0: 整数 = 取行(零, "A");
    // A 的度 2；自我网 {A,B,C} 内部三条边；向外只有 C-D 一条
    断言约等(J.数组获取浮点数(A0, 0), 2.0, 0.000001, "A 的度");
    断言约等(J.数组获取浮点数(A0, 1), 3.0, 0.000001, "A 的自我网内边数");
    断言约等(J.数组获取浮点数(A0, 2), 1.0, 0.000001, "A 的自我网外连边数");
    变量 D0: 整数 = 取行(零, "D");
    // D 的度 1；自我网 {D,C} 内部一条边；向外 C-A、C-B 两条
    断言约等(J.数组获取浮点数(D0, 0), 1.0, 0.000001, "D 的度");
    断言约等(J.数组获取浮点数(D0, 1), 1.0, 0.000001, "D 的自我网内边数");
    断言约等(J.数组获取浮点数(D0, 2), 2.0, 0.000001, "D 的自我网外连边数");
    J.删除(零);

    // 一轮之后特征数 ×3
    变量 一: 整数 = J.解码(ReFeX(图, 1));
    断言相等整数(J.数组长度(J.获取数组(一, "特征名")), 9, "1 轮 = 9 个特征");
    断言包含(ReFeX(图, 1), "邻居和(度)", "特征名说明了它是怎么来的");
    断言包含(ReFeX(图, 1), "邻居均(度)", "求和与求平均各一份");
    // A 的邻居是 B(度2) 和 C(度3) → 邻居和(度)=5，邻居均(度)=2.5
    变量 A1: 整数 = 取行(一, "A");
    断言约等(J.数组获取浮点数(A1, 3), 5.0, 0.000001, "A 的邻居度数之和");
    断言约等(J.数组获取浮点数(A1, 4), 2.5, 0.000001, "A 的邻居度数平均");
    J.删除(一);

    // 二轮：27 个特征，且 A 与 B 逐位相同（它俩在这张图上是对称的）
    变量 二: 整数 = J.解码(ReFeX(图, 2));
    断言相等整数(J.数组长度(J.获取数组(二, "特征名")), 27, "2 轮 = 27 个特征");
    变量 Av: 整数 = 取行(二, "A");
    变量 Bv: 整数 = 取行(二, "B");
    变量 不同: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 27) {
        变量 差: 浮点数 = J.数组获取浮点数(Av, i) - J.数组获取浮点数(Bv, i);
        如果 (差 > 0.000001 或 差 < 0.0 - 0.000001) { 不同 = 不同 + 1; }
        i = i + 1;
    }
    断言相等整数(不同, 0, "对称的 A 和 B 特征向量逐位相同");
    // 而 A 和 D 显然不该一样
    变量 Dv: 整数 = 取行(二, "D");
    断言为真(J.数组获取浮点数(Av, 0) != J.数组获取浮点数(Dv, 0), "A 和 D 不一样");
    J.删除(二);

    // 轮数封顶在 3（再往上 81 个特征就没意义了）
    变量 多: 整数 = J.解码(ReFeX(图, 99));
    断言相等整数(J.数组长度(J.获取数组(多, "特征名")), 81, "轮数封顶 3 → 81 个特征");
    J.删除(多);

    关闭图(图);
    返回 1;
}

函数 入口() {
    运行用例("按类型的度", 测_按类型的度);
    运行用例("元路径计数", 测_元路径计数);
    运行用例("DWPC 按度打折", 测_DWPC按度打折);
    运行用例("ReFeX 递归特征", 测_ReFeX);
    摘要并退出();
}
