// 中心性 —— 同一张图，五种「谁重要」的答案各不相同
//
//   qi run 示例/中心性.qi
//
// 两个小团伙靠一个人牵着。度最高的是团伙里的社交达人，介数最高的却是那个牵线的 ——
// 「连得多」和「卡在要道上」是两回事，这也是 Negro《Knowledge Graphs and LLMs in
// Action》第 10 章反复说的：别指望单个指标，要凑成特征向量交给下游。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.哈希表;
导入 Graph::{打开图, 关闭图, 加节点, 加边, 加标签,
             无向度, 三角形数, 聚类系数, 自我网密度, 接近中心性, 介数中心性,
             PageRank, 个性化PageRank, 节点特征JSON, 排行JSON};

变量 库路径: 字符串 = "/tmp/qigraph-示例-中心性.kv";

//   甲团伙：阿甲 阿乙 阿丙（两两相识）
//   乙团伙：阿丁 阿戊 阿己（两两相识）
//   桥　　：小桥 —— 只连阿丙和阿丁，两边各一条
函数 建图() : 整数 {
    如果 (IO.文件存在(库路径) == 1) {
        IO.删除文件(库路径);
    }
    变量 图: 整数 = 打开图(库路径);
    加节点(图, "阿甲", "[\"人\"]", "{}");
    加节点(图, "阿乙", "[\"人\"]", "{}");
    加节点(图, "阿丙", "[\"人\"]", "{}");
    加节点(图, "阿丁", "[\"人\"]", "{}");
    加节点(图, "阿戊", "[\"人\"]", "{}");
    加节点(图, "阿己", "[\"人\"]", "{}");
    加节点(图, "小桥", "[\"人\"]", "{}");
    加边(图, "", "认识", "阿甲", "阿乙", "{}");
    加边(图, "", "认识", "阿乙", "阿丙", "{}");
    加边(图, "", "认识", "阿丙", "阿甲", "{}");
    加边(图, "", "认识", "阿丁", "阿戊", "{}");
    加边(图, "", "认识", "阿戊", "阿己", "{}");
    加边(图, "", "认识", "阿己", "阿丁", "{}");
    加边(图, "", "认识", "阿丙", "小桥", "{}");
    加边(图, "", "认识", "小桥", "阿丁", "{}");
    返回 图;
}

函数 一行(图: 整数, 谁: 字符串, 介: 整数) {
    IO.打印行("  " + 谁
        + "  度=" + 无向度(图, 谁)
        + "  三角形=" + 三角形数(图, 谁)
        + "  聚类=" + 浮点数转字符串(聚类系数(图, 谁))
        + "  自我网密度=" + 浮点数转字符串(自我网密度(图, 谁))
        + "  接近=" + 浮点数转字符串(接近中心性(图, 谁))
        + "  介数=" + 浮点数转字符串(哈希表::获取浮点数(介, 谁)));
}

函数 入口() {
    变量 图: 整数 = 建图();

    IO.打印行("=== 逐人看 ===");
    变量 介: 整数 = 介数中心性(图);
    一行(图, "阿丙", 介);
    一行(图, "小桥", 介);
    一行(图, "阿甲", 介);
    IO.打印行("");
    IO.打印行("阿丙的度比小桥高（团伙内两个熟人 + 小桥），聚类系数也高；");
    IO.打印行("但两个团伙之间的最短路全得过小桥，所以介数是小桥最高。");

    IO.打印行("");
    IO.打印行("=== 介数排行 ===");
    IO.打印行(排行JSON(图, 介, 3));
    哈希表::释放表(介);

    IO.打印行("");
    IO.打印行("=== PageRank 前三 ===");
    变量 pr: 整数 = PageRank(图);
    IO.打印行(排行JSON(图, pr, 3));
    哈希表::释放表(pr);

    // 个性化：站在阿甲的位置上看，谁跟他最相关。乙团伙隔着一座桥，分数被拉得很低 ——
    // agent 从图里召回一堆事实、只能往提示里塞几条时，用的就是这个排序。
    IO.打印行("");
    IO.打印行("=== 以阿甲为种子的个性化 PageRank 前四 ===");
    变量 个: 整数 = 个性化PageRank(图, "[\"阿甲\"]");
    IO.打印行(排行JSON(图, 个, 4));
    哈希表::释放表(个);

    IO.打印行("");
    IO.打印行("=== 小桥的特征向量（喂给下游模型的那一行）===");
    IO.打印行(节点特征JSON(图, "小桥"));

    关闭图(图);
}
