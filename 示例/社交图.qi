// 社交图 —— 用 qi-graph 建一个小社交网络，演示节点 / 边 / 邻居 / 遍历 / 最短路径 / 模式匹配 / 导出
//
//   qi run 示例/社交图.qi

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.列表 作为 表列;
导入 Graph::{开图, 图库, 打开图, 关闭图, 加节点, 新边, 取属性, 改属性, 按标签列节点,
             出邻居, 入邻居, 广度遍历, 最短路径, 连通分量数, 模式匹配, 过滤节点, 导出JSON, 统计JSON};

变量 库路径: 字符串 = "/tmp/qigraph-示例-社交.kv";

函数 行(表: 整数) : 字符串 {
    变量 出: 字符串 = "";
    变量 n: 整数 = 表列::字符串列表大小(表);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (i > 0) {
            出 = 出 + " → ";
        }
        出 = 出 + 表列::获取字符串(表, i);
        i = i + 1;
    }
    表列::删除列表(表);
    返回 出;
}

函数 建图() {
    如果 (IO.文件存在(库路径) == 1) {
        IO.删除文件(库路径);
    }
    变量 g: 整数 = 打开图(库路径);

    加节点(g, "小奇", "[\"人\",\"工程师\"]", "{\"年龄\":29,\"城市\":\"成都\"}");
    加节点(g, "阿明", "[\"人\",\"工程师\"]", "{\"年龄\":34,\"城市\":\"成都\"}");
    加节点(g, "小红", "[\"人\",\"设计师\"]", "{\"年龄\":27,\"城市\":\"北京\"}");
    加节点(g, "老王", "[\"人\"]", "{\"年龄\":45,\"城市\":\"成都\"}");
    加节点(g, "阿花", "[\"人\",\"设计师\"]", "{\"年龄\":31,\"城市\":\"上海\"}");
    加节点(g, "成都", "[\"城市\"]", "{}");
    加节点(g, "北京", "[\"城市\"]", "{}");
    加节点(g, "上海", "[\"城市\"]", "{}");

    新边(g, "认识", "小奇", "阿明", "{\"since\":2019}");
    新边(g, "认识", "阿明", "小红", "{\"since\":2021}");
    新边(g, "认识", "小红", "阿花", "{\"since\":2022}");
    新边(g, "认识", "阿明", "老王", "{\"since\":2015}");
    新边(g, "认识", "老王", "小奇", "{\"since\":2020}");
    新边(g, "住在", "小奇", "成都", "{}");
    新边(g, "住在", "阿明", "成都", "{}");
    新边(g, "住在", "老王", "成都", "{}");
    新边(g, "住在", "小红", "北京", "{}");
    新边(g, "住在", "阿花", "上海", "{}");

    IO.打印行("建好了：" + 统计JSON(g));
    关闭图(g);
}

函数 查一查() {
    变量 g: 整数 = 打开图(库路径);

    IO.打印行("");
    IO.打印行("小奇认识的人：" + 行(出邻居(g, "小奇", "认识")));
    IO.打印行("谁认识小奇：  " + 行(入邻居(g, "小奇", "认识")));
    IO.打印行("小奇两跳以内（层序）：" + 行(广度遍历(g, "小奇", 2, "认识")));
    IO.打印行("小奇 → 阿花 最短路径：" + 行(最短路径(g, "小奇", "阿花", "认识")));
    IO.打印行("阿花 → 小奇 最短路径：" + 行(最短路径(g, "阿花", "小奇", "认识")) + "（有向，反过来不可达）");
    IO.打印行("连通分量：" + 连通分量数(g));

    IO.打印行("");
    IO.打印行("工程师：" + 行(按标签列节点(g, "工程师")));
    IO.打印行("30 岁以上住成都的人：" + 行(过滤节点(g, "人", "{\"年龄\":{\">\":30},\"城市\":{\"=\":\"成都\"}}")));

    IO.打印行("");
    IO.打印行("「?a 认识 ?b，?b 住在 成都」：");
    IO.打印行("  " + 模式匹配(g, "[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"},{\"from\":\"?b\",\"type\":\"住在\",\"to\":\"成都\"}]"));
    IO.打印行("「?a 认识 ?b，且 ?a 是设计师」：");
    IO.打印行("  " + 模式匹配(g, "{\"match\":[{\"from\":\"?a\",\"type\":\"认识\",\"to\":\"?b\"}],\"where\":{\"?a.labels\":{\"包含\":\"设计师\"}}}"));

    // 改属性是合并
    改属性(g, "小奇", "{\"年龄\":30,\"爱好\":\"爬山\"}");
    IO.打印行("");
    IO.打印行("小奇过了个生日：" + 取属性(g, "小奇"));
    关闭图(g);
}

函数 链式写法() {
    // 同一个库再用链式写法接着改
    变量 g: 图库 = 开图(库路径)
        .加节点("小李", "[\"人\"]", "{\"年龄\":26,\"城市\":\"成都\"}")
        .连("认识", "小李", "小奇")
        .连("住在", "小李", "成都");
    IO.打印行("");
    IO.打印行("链式加了小李：现在 " + g.节点数() + " 个节点、" + g.边数() + " 条边");
    IO.打印行("谁认识小奇：" + 行(g.入邻居("小奇", "认识")));
    IO.打印行("");
    IO.打印行("整图导出：");
    IO.打印行(g.导出JSON());
    g.关();
}

函数 入口() {
    建图();
    查一查();
    链式写法();
}
