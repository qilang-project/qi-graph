// 动物本体 —— qi-graph 本体层的完整走一遍
//
//   qi run 示例/动物本体.qi
//
// 类层次（含一处多继承：企鹅 既是 鸟 也是 会游泳的）、属性（函数性 / 对称 / 传递 / 逆 / 子属性）、
// 几个个体、一条故意写错的三元组给 校验 抓，然后 物化推理 并把推出来的解释出来。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.列表 作为 表列;
导入 标准库.JSON;
导入 Graph::{打开本体, 关闭本体, 本体可用,
             定义类, 类注释, 定义属性, 加个体, 断言, 断言字面量, 撤销,
             列出类, 父类, 子类, 按类列个体, 查, 值, 三元组数, 字符串列表连成行,
             所有祖先类, 所有类型, 是实例, 校验, 物化推理, 撤销推理, 推出三元组数, 解释,
             导出Turtle, 导出本体JSON};

常量 库文件: 字符串 = "/tmp/qigraph-示例-动物本体.kv";

函数 行(表: 整数) : 字符串 {
    变量 s: 字符串 = 字符串列表连成行(表, "、");
    表列::删除列表(表);
    如果 (s == "") { 返回 "（无）"; }
    返回 s;
}

// 把 查 / 校验 返回的 JSON 数组一条一行打出来
函数 打印三元组(文: 字符串) {
    变量 a: 整数 = JSON.解码(文);
    如果 (a == 0) { 返回; }
    变量 n: 整数 = JSON.数组长度(a);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 t: 整数 = JSON.数组获取对象(a, i);
        变量 o: 整数 = JSON.获取对象(t, "o");
        变量 宾: 字符串 = "";
        如果 (o != 0) {
            如果 (JSON.是否包含键(o, "iri") == 1) { 宾 = JSON.获取字符串(o, "iri"); }
            否则 { 宾 = "\"" + JSON.获取字符串(o, "lit") + "\"^^" + JSON.获取字符串(o, "dt"); }
            JSON.删除(o);
        }
        变量 尾: 字符串 = "";
        如果 (JSON.是否包含键(t, "inferred") == 1) { 尾 = "   （推出）"; }
        IO.打印行("    " + JSON.获取字符串(t, "s") + " " + JSON.获取字符串(t, "p") + " " + 宾 + 尾);
        JSON.删除(t);
        i = i + 1;
    }
    JSON.删除(a);
}

函数 打印问题(文: 字符串) {
    变量 a: 整数 = JSON.解码(文);
    如果 (a == 0) { 返回; }
    变量 n: 整数 = JSON.数组长度(a);
    如果 (n == 0) { IO.打印行("    没有问题"); }
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 q: 整数 = JSON.数组获取对象(a, i);
        IO.打印行("    [" + JSON.获取字符串(q, "kind") + "] " + JSON.获取字符串(q, "msg")
            + "  ← " + JSON.获取字符串(q, "s") + " " + JSON.获取字符串(q, "p") + " " + JSON.获取字符串(q, "o"));
        JSON.删除(q);
        i = i + 1;
    }
    JSON.删除(a);
}

函数 入口() {
    如果 (IO.文件存在(库文件) == 1) { IO.删除文件(库文件); }
    变量 本: 整数 = 打开本体(库文件);
    如果 (本体可用(本) == 0) {
        IO.打印错误行("打不开 " + 库文件);
        返回;
    }

    // ── 类 ──
    定义类(本, "动物");
    定义类(本, "哺乳动物", "动物");
    定义类(本, "鸟", "动物");
    定义类(本, "会游泳的", "动物");
    定义类(本, "狗", "哺乳动物");
    定义类(本, "猫", "哺乳动物");
    定义类(本, "企鹅", "鸟");
    定义类(本, "企鹅", "会游泳的");          // 多继承
    定义类(本, "人");
    类注释(本, "企鹅", "不会飞的鸟，游得很好");

    // ── 属性 ──
    定义属性(本, "能飞", "动物", "布尔", "");
    定义属性(本, "会游泳", "动物", "布尔", "");
    定义属性(本, "年龄", "动物", "整数", "{\"functional\":1}");
    定义属性(本, "名字", "动物", "字符串", "");
    定义属性(本, "朋友", "动物", "动物", "{\"symmetric\":1}");
    定义属性(本, "亲密朋友", "动物", "动物", "{\"parent\":\"朋友\"}");
    定义属性(本, "追", "动物", "动物", "");
    定义属性(本, "祖先", "动物", "动物", "{\"transitive\":1}");
    定义属性(本, "养", "人", "动物", "{\"inverse\":\"被养\"}");
    定义属性(本, "被养", "动物", "人", "");

    // ── 个体 ──
    加个体(本, "旺财", "狗");
    加个体(本, "小黑", "狗");
    加个体(本, "老黑", "狗");
    加个体(本, "咪咪", "猫");
    加个体(本, "波波", "企鹅");
    加个体(本, "小明", "人");

    // ── 事实 ──
    断言字面量(本, "旺财", "名字", "旺财", "字符串");
    断言字面量(本, "旺财", "年龄", "3", "整数");
    断言字面量(本, "波波", "能飞", "0", "布尔");
    断言字面量(本, "波波", "会游泳", "1", "布尔");
    断言(本, "旺财", "亲密朋友", "咪咪");
    断言(本, "旺财", "追", "咪咪");
    断言(本, "旺财", "祖先", "小黑");
    断言(本, "小黑", "祖先", "老黑");
    断言(本, "小明", "养", "旺财");
    断言(本, "咪咪", "养", "小明");           // 故意写错：猫不是人，人不是动物

    IO.打印行("== 类层次 ==");
    变量 类们: 整数 = 列出类(本);
    变量 n: 整数 = 表列::字符串列表大小(类们);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 c: 字符串 = 表列::获取字符串(类们, i);
        IO.打印行("  " + c + "  父类：" + 行(父类(本, c)) + "  子类：" + 行(子类(本, c)));
        i = i + 1;
    }
    表列::删除列表(类们);
    IO.打印行("  企鹅 的全部祖先类：" + 行(所有祖先类(本, "企鹅")));
    IO.打印行("  动物（含子类）的个体：" + 行(按类列个体(本, "动物", 1)));
    IO.打印行("  波波 的全部类型：" + 行(所有类型(本, "波波")));
    IO.打印行("  波波 是 会游泳的？" + 是实例(本, "波波", "会游泳的") + "   波波 是 哺乳动物？" + 是实例(本, "波波", "哺乳动物"));

    IO.打印行("");
    IO.打印行("== 校验 ==");
    打印问题(校验(本));
    IO.打印行("  撤掉那条错的再校验：");
    撤销(本, "咪咪", "养", "小明");
    打印问题(校验(本));

    IO.打印行("");
    IO.打印行("== 推理 ==");
    变量 前: 整数 = 三元组数(本);
    变量 新: 整数 = 物化推理(本);
    IO.打印行("  断言 " + 前 + " 条，物化推出 " + 新 + " 条，再跑一次推出 " + 物化推理(本) + " 条");
    IO.打印行("  咪咪 的朋友：" + 行(值(本, "咪咪", "朋友")) + "   （亲密朋友 ⊑ 朋友，朋友 对称）");
    IO.打印行("  旺财 的祖先：" + 行(值(本, "旺财", "祖先")) + "   （祖先 传递）");
    IO.打印行("  旺财 被谁养：" + 行(值(本, "旺财", "被养")) + "   （养 的逆属性）");
    IO.打印行("  " + 解释(本, "旺财", "朋友", "咪咪"));
    IO.打印行("  " + 解释(本, "咪咪", "朋友", "旺财"));
    IO.打印行("  " + 解释(本, "旺财", "祖先", "老黑"));
    IO.打印行("  " + 解释(本, "旺财", "被养", "小明"));
    IO.打印行("  " + 解释(本, "旺财", "追", "咪咪"));
    IO.打印行("  " + 解释(本, "咪咪", "追", "旺财"));
    IO.打印行("  旺财 的全部三元组：");
    打印三元组(查(本, "旺财", "", ""));

    IO.打印行("");
    IO.打印行("== Turtle ==");
    IO.打印(导出Turtle(本));

    IO.打印行("");
    IO.打印行("== 收尾 ==");
    IO.打印行("  撤销推理清掉 " + 撤销推理(本) + " 条，剩 " + 推出三元组数(本) + " 条推出，" + 三元组数(本) + " 条三元组");
    IO.打印行("  JSON 导出 " + 导出本体JSON(本) + "");
    关闭本体(本);
    IO.打印行("  库文件：" + 库文件);
}
